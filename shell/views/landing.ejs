<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Choose a tool</title>
  <meta name="theme-color" content="#0a0907">
  <link rel="manifest" href="/manifest.json">
  <!-- Home-screen icons: served from the shell at root paths so iOS's
       "Add to Home Screen" from the landing page uses the mask-crop
       artwork as the home-screen icon. ?v=2 busts iOS's sticky
       apple-touch-icon cache; bump on future icon swaps. -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=2">
  <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png?v=2">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="stylesheet" href="/shell-static/landing.css?v=3">
  <link rel="stylesheet" href="/shell-static/transition.css?v=3">
  <link rel="stylesheet" href="/shell-static/perfin-materialize.css?v=2">
</head>
<body class="landing-body">
  <div class="shell-grain" aria-hidden="true"></div>
  <main class="landing">
    <header class="landing-header">
      <p class="shell-readout" id="shell-clock" aria-hidden="true"></p>
      <form method="POST" action="/logout" class="logout-form">
        <button type="submit" class="logout-btn" aria-label="Sign out">Sign out</button>
      </form>
    </header>
    <h1>What are we doing today?</h1>
    <div class="tiles">
      <a href="/perfin" class="tile" data-perfin-materialize>
        <div class="tile-icon tile-icon-perfin" aria-hidden="true"></div>
        <h2>Perfin</h2>
        <p>Personal finance, transactions, and AI insights.</p>
<% if (typeof status !== 'undefined' && status && status.perfin) { %>
        <p class="tile-status"><%= status.perfin %></p>
<% } %>
      </a>
      <a href="/per-sistant" class="tile" data-atrans="dial">
        <img class="tile-icon" src="/android-chrome-192x192.png?v=2" alt="" aria-hidden="true" width="48" height="48">
        <h2>Per-sistant</h2>
        <p>Tasks, notes, scheduled emails.</p>
<% if (typeof status !== 'undefined' && status && status.persistent) { %>
        <p class="tile-status"><%= status.persistent %></p>
<% } %>
      </a>
    </div>
  </main>

  <!-- Per-sistant entry: the shell dial spins up before Per-sistant loads
       (transition.js builds the dial and binds the tile's data-atrans). -->
  <div class="atrans-overlay" id="atrans-dial" aria-hidden="true">
    <div class="shell-grain"></div>
    <div class="shell-scan"></div>
    <div data-dial><img src="/android-chrome-192x192.png?v=2" alt="" width="60" height="60"></div>
    <div class="dial-status is-ok">Per-sistant</div>
  </div>

  <script src="/shell-static/transition.js?v=3" defer></script>
  <script src="/shell-static/shell-page.js?v=3" defer></script>
  <script src="/shell-static/perfin-materialize.js?v=2" defer></script>
</body>
</html>
