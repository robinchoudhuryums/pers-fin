<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Choose a tool</title>
  <meta name="theme-color" content="#0c0e14">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/shell-static/landing.css">
  <link rel="stylesheet" href="/shell-static/transition.css?v=2">
  <link rel="stylesheet" href="/shell-static/perfin-materialize.css?v=2">
</head>
<body class="landing-body">
  <main class="landing">
    <header class="landing-header">
      <h1>What are we doing today?</h1>
      <form method="POST" action="/logout" class="logout-form">
        <button type="submit" class="logout-btn" aria-label="Sign out">Sign out</button>
      </form>
    </header>
    <div class="tiles">
      <a href="/perfin" class="tile" data-perfin-materialize>
        <div class="tile-icon">$</div>
        <h2>Perfin</h2>
        <p>Personal finance, transactions, and AI insights.</p>
      </a>
      <a href="/per-sistant" class="tile" data-atrans="cosmic">
        <div class="tile-icon">&#10003;</div>
        <h2>Per-sistant</h2>
        <p>Tasks, notes, scheduled emails.</p>
      </a>
    </div>
  </main>

  <!-- Tile-transition overlay (lazy-activated on click of a [data-atrans] tile).
       Decorations (stars, rising particles) are populated by transition.js
       on init. -->
  <div class="atrans-overlay atrans--cosmic" id="atrans-cosmic" aria-hidden="true">
    <div class="atrans-particles"></div>
    <div class="atrans-stage">
      <div class="atrans-stars"></div>
      <div class="atrans-nebula"></div>
      <div class="atrans-ring"></div>
      <div class="atrans-art-wrap">
        <div class="atrans-art"><img src="/per-sistant/android-chrome-mask-crop.png" alt="" aria-hidden="true"></div>
        <div class="atrans-scanline"></div>
      </div>
    </div>
  </div>

  <script src="/shell-static/transition.js?v=2" defer></script>
  <script src="/shell-static/perfin-materialize.js?v=2" defer></script>
</body>
</html>
