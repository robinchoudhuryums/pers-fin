<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Choose a tool</title>
  <meta name="theme-color" content="#0c0e14">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/shell-static/landing.css">
  <link rel="stylesheet" href="/shell-static/transition.css">
</head>
<body class="landing-body">
  <main class="landing">
    <header class="landing-header">
      <h1>What are we doing today?</h1>
      <form method="POST" action="/logout" class="logout-form">
        <button type="submit" class="logout-btn" aria-label="Sign out">Sign out</button>
      </form>
    </header>
    <div class="tiles">
      <a href="/perfin" class="tile" data-atrans="warm">
        <div class="tile-icon">$</div>
        <h2>Perfin</h2>
        <p>Personal finance, transactions, and AI insights.</p>
      </a>
      <a href="/per-sistant" class="tile" data-atrans="cosmic">
        <div class="tile-icon">&#10003;</div>
        <h2>Per-sistant</h2>
        <p>Tasks, notes, scheduled emails.</p>
      </a>
    </div>
  </main>

  <!-- Tile-transition overlays (lazy-activated on click) -->
  <div class="atrans-overlay atrans--warm" id="atrans-warm" aria-hidden="true">
    <div class="atrans-stage">
      <div class="atrans-stars" data-stars></div>
      <div class="atrans-nebula"></div>
      <div class="atrans-ring"></div>
      <div class="atrans-art-wrap">
        <div class="atrans-art atrans-art--mask" style="--atrans-mask: url(/perfin/logo.svg);"></div>
        <div class="atrans-scanline"></div>
      </div>
    </div>
  </div>
  <div class="atrans-overlay atrans--cosmic" id="atrans-cosmic" aria-hidden="true">
    <div class="atrans-stage">
      <div class="atrans-stars" data-stars></div>
      <div class="atrans-nebula"></div>
      <div class="atrans-ring"></div>
      <div class="atrans-art-wrap">
        <div class="atrans-art"><img src="/per-sistant/android-chrome-mask-crop.png" alt="" aria-hidden="true"></div>
        <div class="atrans-scanline"></div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      // Populate twinkling stars in any .atrans-stars container.
      document.querySelectorAll('[data-stars]').forEach(function(box) {
        var html = '';
        for (var i = 0; i < 32; i++) {
          var x = Math.random() * 100, y = Math.random() * 100;
          var size = (Math.random() * 1.6 + 1).toFixed(2);
          var delay = (Math.random() * 2.4).toFixed(2);
          var dur = (Math.random() * 1.6 + 1.6).toFixed(2);
          html += '<span style="left:' + x.toFixed(1) + '%;top:' + y.toFixed(1) +
                  '%;width:' + size + 'px;height:' + size +
                  'px;animation-delay:' + delay + 's;animation-duration:' + dur + 's;"></span>';
        }
        box.innerHTML = html;
      });

      // Tile click → play matching overlay → navigate.
      document.querySelectorAll('.tile[data-atrans]').forEach(function(tile) {
        tile.addEventListener('click', function(e) {
          // Allow ctrl/cmd/middle-click to open in a new tab without animation.
          if (e.ctrlKey || e.metaKey || e.shiftKey || e.button === 1) return;
          e.preventDefault();
          var variant = tile.getAttribute('data-atrans');
          var overlay = document.getElementById('atrans-' + variant);
          if (!overlay) { window.location.href = tile.href; return; }
          overlay.classList.add('active');
          // ~1.35s reveal then navigate; the destination's first paint covers
          // the overlay so a fade-out isn't strictly necessary.
          setTimeout(function() { window.location.href = tile.href; }, 1350);
        });
      });
    })();
  </script>
</body>
</html>
