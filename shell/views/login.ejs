<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Sign In</title>
  <meta name="theme-color" content="#0c0e14">
  <link rel="manifest" href="/manifest.json">
  <!-- Home-screen icons: served from the shell at root paths so iOS's
       "Add to Home Screen" picks them up even from /login (pre-auth).
       Same artwork as the Per-sistant PWA. ?v=2 busts iOS's sticky
       apple-touch-icon cache; bump on future icon swaps. -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=2">
  <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png?v=2">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="stylesheet" href="/shell-static/landing.css">
</head>
<body class="login-body">
  <div class="cosmic-bg" aria-hidden="true">
    <div class="cosmic-nebula"></div>
    <div class="cosmic-stars" id="cosmic-stars"></div>
  </div>
  <main class="login-card">
    <div class="login-glyph"><img src="/android-chrome-512x512.png?v=2" alt="" aria-hidden="true" width="64" height="64"></div>
    <h1>Welcome</h1>
    <p class="subtitle">Enter your PIN to continue.</p>
    <% if (error) { %>
      <div class="login-error" role="alert"><%= error %></div>
    <% } %>
    <form id="login-form" method="POST" action="/login" autocomplete="off">
      <!-- Real PIN field — the only credential the form posts. On JS-capable
           browsers setupPinPad() hides it (+ the Continue button) and reveals
           the keypad below, writing taps straight into this input. With JS off
           it stays a normal numeric field, so login still works. -->
      <input
        type="password"
        name="pin"
        inputmode="numeric"
        pattern="[0-9]*"
        autofocus
        required
        aria-label="PIN"
        class="pin-input"
        id="pin-input"
      >
      <button type="submit" class="btn primary" id="continue-btn">Continue</button>
      <div class="pin-pad-wrap" id="pin-pad-wrap" hidden>
        <div class="pin-dots" id="pin-dots"></div>
        <div class="pin-pad" id="pin-pad"></div>
      </div>
    </form>
    <button type="button" id="biometric-btn" class="btn biometric-btn" style="display:none;">
      Use Biometric
    </button>
    <div id="biometric-status"></div>
  </main>
  <script>
    // Helpers — base64url ↔ Uint8Array. WebAuthn responses use base64url.
    function b64uToBuf(s) {
      var pad = '===='.slice(0, (4 - s.length % 4) % 4);
      var b64 = (s + pad).replace(/-/g, '+').replace(/_/g, '/');
      var bin = atob(b64);
      var buf = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) buf[i] = bin.charCodeAt(i);
      return buf.buffer;
    }
    function bufToB64u(buf) {
      var bytes = new Uint8Array(buf);
      var bin = '';
      for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    // Probe whether any credentials are registered. If so, reveal the button.
    (async function checkBiometricAvailability() {
      if (!window.PublicKeyCredential) return; // browser doesn't support WebAuthn
      try {
        var r = await fetch('/api/shell/webauthn/available');
        if (!r.ok) return;
        var d = await r.json();
        if (d.available) {
          document.getElementById('biometric-btn').style.display = 'block';
        }
      } catch {}
    })();

    document.getElementById('biometric-btn').addEventListener('click', async function() {
      var btn = this;
      var status = document.getElementById('biometric-status');
      btn.disabled = true;
      status.textContent = 'Waiting for biometric…';
      try {
        // Step 1: get challenge + allow-list from server.
        var optsRes = await fetch('/api/shell/webauthn/authenticate-options', { method: 'POST' });
        if (!optsRes.ok) {
          var err = await optsRes.json().catch(function() { return {}; });
          throw new Error(err.error || 'Could not start biometric login');
        }
        var opts = await optsRes.json();
        // Convert base64url challenge + allowed credential ids back to ArrayBuffers
        // for the browser WebAuthn API.
        opts.challenge = b64uToBuf(opts.challenge);
        if (opts.allowCredentials) {
          opts.allowCredentials = opts.allowCredentials.map(function(c) {
            return Object.assign({}, c, { id: b64uToBuf(c.id) });
          });
        }
        // Step 2: invoke the platform authenticator.
        var assertion = await navigator.credentials.get({ publicKey: opts });
        // Step 3: serialize the assertion and post it back for verify.
        var verifyBody = {
          id: assertion.id,
          rawId: bufToB64u(assertion.rawId),
          type: assertion.type,
          response: {
            clientDataJSON: bufToB64u(assertion.response.clientDataJSON),
            authenticatorData: bufToB64u(assertion.response.authenticatorData),
            signature: bufToB64u(assertion.response.signature),
            userHandle: assertion.response.userHandle ? bufToB64u(assertion.response.userHandle) : null,
          },
          clientExtensionResults: assertion.getClientExtensionResults ? assertion.getClientExtensionResults() : {},
          authenticatorAttachment: assertion.authenticatorAttachment || null,
        };
        var verifyRes = await fetch('/api/shell/webauthn/authenticate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(verifyBody),
        });
        if (!verifyRes.ok) {
          var verr = await verifyRes.json().catch(function() { return {}; });
          throw new Error(verr.error || 'Verification failed');
        }
        status.textContent = 'Verified. Redirecting…';
        window.location.href = '/per-sistant';
      } catch (e) {
        status.textContent = 'Biometric login failed: ' + (e.message || e);
        btn.disabled = false;
      }
    });
  </script>
  <script>
    // Cosmic starfield — inject twinkling stars into the backdrop. Sizes/
    // positions/delays randomized so the field doesn't pulse in unison. CSS
    // handles the twinkle (and silences it under prefers-reduced-motion).
    (function populateStars() {
      var box = document.getElementById('cosmic-stars');
      if (!box) return;
      var html = '';
      for (var i = 0; i < 54; i++) {
        var x = (Math.random() * 100).toFixed(2);
        var y = (Math.random() * 100).toFixed(2);
        var size = (Math.random() * 1.8 + 1).toFixed(2);
        var delay = (Math.random() * 2.6).toFixed(2);
        var dur = (Math.random() * 1.8 + 1.8).toFixed(2);
        html += '<span style="left:' + x + '%;top:' + y + '%;width:' + size +
                'px;height:' + size + 'px;animation-delay:' + delay +
                's;animation-duration:' + dur + 's;"></span>';
      }
      box.innerHTML = html;
    })();

    // Numeric PIN pad — progressive enhancement. Replaces the text input with a
    // keypad that writes into the same #pin-input and submits the same form.
    // Fixed 8-dot masked display (length-agnostic, like Perfin's pad). Physical
    // keyboard digits / Backspace / Enter work too.
    (function setupPinPad() {
      var form = document.getElementById('login-form');
      var input = document.getElementById('pin-input');
      var wrap = document.getElementById('pin-pad-wrap');
      var continueBtn = document.getElementById('continue-btn');
      var dotsEl = document.getElementById('pin-dots');
      var padEl = document.getElementById('pin-pad');
      if (!form || !input || !wrap || !dotsEl || !padEl) return;

      var DOTS = 8;
      var pin = '';

      // Swap the plain field for the pad.
      input.style.display = 'none';
      input.removeAttribute('autofocus');
      if (continueBtn) continueBtn.style.display = 'none';
      wrap.hidden = false;

      var dh = '';
      for (var i = 0; i < DOTS; i++) dh += '<div class="pin-dot" id="pd-' + i + '"></div>';
      dotsEl.innerHTML = dh;

      var ph = '';
      [1, 2, 3, 4, 5, 6, 7, 8, 9].forEach(function (n) {
        ph += '<button class="pin-key" type="button" data-digit="' + n + '">' + n + '</button>';
      });
      ph += '<button class="pin-key fn" type="button" data-action="back" aria-label="Delete">&#9003;</button>';
      ph += '<button class="pin-key" type="button" data-digit="0">0</button>';
      ph += '<button class="pin-key fn go" type="button" data-action="go">Go</button>';
      padEl.innerHTML = ph;

      function render() {
        for (var j = 0; j < DOTS; j++) {
          var d = document.getElementById('pd-' + j);
          if (d) d.className = 'pin-dot' + (j < pin.length ? ' filled' : '');
        }
        input.value = pin;
      }
      function add(n) { if (pin.length >= DOTS) return; pin += n; render(); }
      function back() { pin = pin.slice(0, -1); render(); }
      function go() { if (pin.length) form.submit(); }

      padEl.addEventListener('click', function (e) {
        var b = e.target.closest('button');
        if (!b) return;
        e.preventDefault();
        if (b.dataset.digit !== undefined) add(b.dataset.digit);
        else if (b.dataset.action === 'back') back();
        else if (b.dataset.action === 'go') go();
      });
      document.addEventListener('keydown', function (e) {
        if (/^[0-9]$/.test(e.key)) { add(e.key); }
        else if (e.key === 'Backspace') { e.preventDefault(); back(); }
        else if (e.key === 'Enter') { e.preventDefault(); go(); }
      });
      render();
    })();
  </script>
</body>
</html>
