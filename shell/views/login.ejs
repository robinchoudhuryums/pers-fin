<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Sign In</title>
  <meta name="theme-color" content="#0a0907">
  <link rel="manifest" href="/manifest.json">
  <!-- Home-screen icons: served from the shell at root paths so iOS's
       "Add to Home Screen" picks them up even from /login (pre-auth).
       Same artwork as the Per-sistant PWA. ?v=2 busts iOS's sticky
       apple-touch-icon cache; bump on future icon swaps. -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=2">
  <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png?v=2">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="stylesheet" href="/shell-static/landing.css?v=3">
  <link rel="stylesheet" href="/shell-static/transition.css?v=3">
</head>
<body class="login-body">
  <div class="shell-light" id="shell-light" aria-hidden="true"></div>
  <div class="shell-flare" aria-hidden="true"></div>
  <div class="shell-grain" aria-hidden="true"></div>
  <div class="shell-scan" aria-hidden="true"></div>
  <main class="login-card">
    <h1 class="sr-only">Sign in</h1>
    <p class="shell-readout" id="shell-clock" aria-hidden="true"></p>
    <!-- The dial: transition.js draws its rings around the icon; the inner
         ticks light one step per digit, and on a correct PIN the outer ring
         spins up before the page moves on. -->
    <div id="login-dial" data-dial><img src="/android-chrome-192x192.png?v=2" alt="" aria-hidden="true" width="60" height="60"></div>
    <p class="dial-status" id="dial-status" aria-live="polite">Enter PIN</p>
    <% if (error) { %>
      <p class="login-error" id="login-error" role="alert"><%= error %></p>
    <% } %>
    <div class="pin-panel">
      <form id="login-form" method="POST" action="/login" autocomplete="off">
        <!-- Real PIN field — the only credential the form posts. On JS-capable
             browsers setupPinPad() hides it (+ the Continue button) and reveals
             the keypad below, which sends the PIN as JSON so the dial can
             answer before the page changes. With JS off it stays a normal
             numeric field and the form posts as before. -->
        <input
          type="password"
          name="pin"
          inputmode="numeric"
          pattern="[0-9]*"
          autofocus
          required
          aria-label="PIN"
          class="pin-input"
          id="pin-input"
        >
        <% if (typeof returnTo !== 'undefined' && returnTo) { %>
          <%# PSC-9: the page the user was sent here from; safeReturnTo-validated server-side %>
          <input type="hidden" name="return_to" id="return-to" value="<%= returnTo %>">
        <% } %>
        <button type="submit" class="btn primary" id="continue-btn">Continue</button>
        <div class="pin-pad-wrap" id="pin-pad-wrap" hidden>
          <div class="pin-pad" id="pin-pad"></div>
        </div>
      </form>
      <button type="button" id="biometric-btn" class="text-btn" style="display:none;">Use biometric</button>
    </div>
  </main>
  <script src="/shell-static/transition.js?v=3"></script>
  <script src="/shell-static/shell-page.js?v=3" defer></script>
  <script nonce="<%= nonce %>">
    // The dial's side of the page: the status readout and the unlock. Both the
    // keypad and the biometric path finish through unlock(), so every sign-in
    // ends the same way — the outer ring spins up, the panel falls away, then
    // the page navigates (straight away under prefers-reduced-motion).
    var loginUi = (function () {
      var statusEl = document.getElementById('dial-status');
      var dial = window.ShellDial ? window.ShellDial.mount(document.getElementById('login-dial')) : null;
      var UNLOCK_NAVIGATE_MS = 1150;
      function setStatus(text, tone) {
        if (!statusEl) return;
        statusEl.textContent = text;
        statusEl.className = 'dial-status' + (tone ? ' is-' + tone : '');
      }
      function clearServerError() {
        var e = document.getElementById('login-error');
        if (e) e.parentNode.removeChild(e);
      }
      function unlock(navigate) {
        setStatus('Unlocked', 'ok');
        if (dial) { dial.setState(null); dial.setProgress(1); }
        var reduce = window.ShellDial && window.ShellDial.reducedMotion();
        if (reduce || !dial) return navigate();
        document.body.classList.add('is-unlocking');
        setTimeout(navigate, UNLOCK_NAVIGATE_MS);
      }
      return { dial: dial, setStatus: setStatus, clearServerError: clearServerError, unlock: unlock };
    })();

    // Helpers — base64url ↔ Uint8Array. WebAuthn responses use base64url.
    function b64uToBuf(s) {
      var pad = '===='.slice(0, (4 - s.length % 4) % 4);
      var b64 = (s + pad).replace(/-/g, '+').replace(/_/g, '/');
      var bin = atob(b64);
      var buf = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) buf[i] = bin.charCodeAt(i);
      return buf.buffer;
    }
    function bufToB64u(buf) {
      var bytes = new Uint8Array(buf);
      var bin = '';
      for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    // Probe whether any credentials are registered. If so, reveal the button.
    (async function checkBiometricAvailability() {
      if (!window.PublicKeyCredential) return; // browser doesn't support WebAuthn
      try {
        var r = await fetch('/api/shell/webauthn/available');
        if (!r.ok) return;
        var d = await r.json();
        if (d.available) {
          document.getElementById('biometric-btn').style.display = 'block';
        }
      } catch {}
    })();

    document.getElementById('biometric-btn').addEventListener('click', async function() {
      var btn = this;
      btn.disabled = true;
      loginUi.clearServerError();
      loginUi.setStatus('Waiting for biometric');
      if (loginUi.dial) loginUi.dial.setState('checking');
      try {
        // Step 1: get challenge + allow-list from server.
        var optsRes = await fetch('/api/shell/webauthn/authenticate-options', { method: 'POST' });
        if (!optsRes.ok) {
          var err = await optsRes.json().catch(function() { return {}; });
          throw new Error(err.error || 'Could not start biometric login');
        }
        var opts = await optsRes.json();
        // Convert base64url challenge + allowed credential ids back to ArrayBuffers
        // for the browser WebAuthn API.
        opts.challenge = b64uToBuf(opts.challenge);
        if (opts.allowCredentials) {
          opts.allowCredentials = opts.allowCredentials.map(function(c) {
            return Object.assign({}, c, { id: b64uToBuf(c.id) });
          });
        }
        // Step 2: invoke the platform authenticator.
        var assertion = await navigator.credentials.get({ publicKey: opts });
        // Step 3: serialize the assertion and post it back for verify.
        var verifyBody = {
          id: assertion.id,
          rawId: bufToB64u(assertion.rawId),
          type: assertion.type,
          response: {
            clientDataJSON: bufToB64u(assertion.response.clientDataJSON),
            authenticatorData: bufToB64u(assertion.response.authenticatorData),
            signature: bufToB64u(assertion.response.signature),
            userHandle: assertion.response.userHandle ? bufToB64u(assertion.response.userHandle) : null,
          },
          clientExtensionResults: assertion.getClientExtensionResults ? assertion.getClientExtensionResults() : {},
          authenticatorAttachment: assertion.authenticatorAttachment || null,
        };
        var verifyRes = await fetch('/api/shell/webauthn/authenticate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(verifyBody),
        });
        if (!verifyRes.ok) {
          var verr = await verifyRes.json().catch(function() { return {}; });
          throw new Error(verr.error || 'Verification failed');
        }
        var rtEl = document.getElementById('return-to');
        loginUi.unlock(function () {
          window.location.href = (rtEl && rtEl.value) || '/per-sistant';
        });
      } catch (e) {
        if (loginUi.dial) loginUi.dial.setState(null);
        loginUi.setStatus('Biometric login failed: ' + (e.message || e), 'error');
        btn.disabled = false;
      }
    });
  </script>
  <script nonce="<%= nonce %>">
    // Numeric PIN pad — progressive enhancement. Replaces the text input with a
    // keypad that writes into the same #pin-input. The inner dial ticks light
    // one step per digit (8 steps — a mask, not a limit). Go sends the PIN as
    // JSON to the same POST /login: a correct PIN plays the unlock, a refused
    // one shakes the dial and shows why. Physical keyboard digits / Backspace /
    // Enter work too.
    (function setupPinPad() {
      var form = document.getElementById('login-form');
      var input = document.getElementById('pin-input');
      var wrap = document.getElementById('pin-pad-wrap');
      var continueBtn = document.getElementById('continue-btn');
      var padEl = document.getElementById('pin-pad');
      if (!form || !input || !wrap || !padEl) return;

      var STEPS = 8;
      // IF-6: the dial is a fixed-width mask, not a limit — a PIN longer than
      // 8 digits used to be impossible to type on the pad. 64 is just a
      // runaway guard.
      var MAX_PIN = 64;
      var pin = '';
      var busy = false;

      // Swap the plain field for the pad.
      input.style.display = 'none';
      input.removeAttribute('autofocus');
      if (continueBtn) continueBtn.style.display = 'none';
      wrap.hidden = false;

      var ph = '';
      [1, 2, 3, 4, 5, 6, 7, 8, 9].forEach(function (n) {
        ph += '<button class="pin-key" type="button" data-digit="' + n + '">' + n + '</button>';
      });
      ph += '<button class="pin-key fn" type="button" data-action="back" aria-label="Delete last digit">' +
            '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 5H9l-6 7 6 7h12a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1z"/><path d="M17 9l-5 6M12 9l5 6"/></svg></button>';
      ph += '<button class="pin-key" type="button" data-digit="0">0</button>';
      ph += '<button class="pin-key fn go" type="button" data-action="go" aria-label="Unlock">' +
            '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></button>';
      padEl.innerHTML = ph;

      function render(keepStatus) {
        input.value = pin;
        if (loginUi.dial) loginUi.dial.setProgress(Math.min(pin.length, STEPS) / STEPS);
        if (!keepStatus) loginUi.setStatus(pin.length ? pin.length + (pin.length === 1 ? ' digit' : ' digits') : 'Enter PIN');
      }
      function add(n) { if (pin.length >= MAX_PIN) return; if (busy) return; loginUi.clearServerError(); pin += n; render(); }
      function back() { if (busy) return; pin = pin.slice(0, -1); render(); }

      // A same-origin path only (the server already ran safeReturnTo).
      function safeDest(p) {
        return (typeof p === 'string' && /^\/(?!\/)/.test(p) && p.indexOf('\\') === -1) ? p : '/per-sistant';
      }
      function refuse(message) {
        busy = false;
        if (loginUi.dial) loginUi.dial.setState('error');
        loginUi.setStatus(message, 'error');
        // The message stays until the next key; the dial resets after the shake.
        setTimeout(function () {
          pin = '';
          render(true);
          if (loginUi.dial) loginUi.dial.setState(null);
        }, 800);
      }
      function go() {
        if (!pin.length || busy) return;
        busy = true;
        loginUi.setStatus('Checking');
        if (loginUi.dial) loginUi.dial.setState('checking');
        var rtEl = document.getElementById('return-to');
        fetch('/login', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ pin: pin, return_to: rtEl ? rtEl.value : undefined }),
        }).then(function (r) {
          return r.json().catch(function () { return null; }).then(function (d) {
            if (r.ok && d && d.ok) {
              loginUi.unlock(function () { window.location.href = safeDest(d.redirect); });
              return;
            }
            refuse((d && d.error) || (r.status === 429 ? 'Too many attempts, please try again later.' : 'Sign-in failed.'));
          });
        }).catch(function () {
          refuse("Couldn't reach the server. Try again.");
        });
      }

      padEl.addEventListener('click', function (e) {
        var b = e.target.closest('button');
        if (!b) return;
        e.preventDefault();
        if (b.dataset.digit !== undefined) add(b.dataset.digit);
        else if (b.dataset.action === 'back') back();
        else if (b.dataset.action === 'go') go();
      });
      document.addEventListener('keydown', function (e) {
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        // IF-6: leave Enter to another focused control (e.g. the biometric
        // button) — it used to submit the PIN form instead of pressing the
        // focused button. Digits/Backspace always go to the pad.
        var t = e.target;
        if (e.key === 'Enter' && t && t !== document.body && !(t.closest && t.closest('#pin-pad')) &&
            /^(BUTTON|A|INPUT|SELECT|TEXTAREA)$/.test(t.tagName)) return;
        if (/^[0-9]$/.test(e.key)) { add(e.key); }
        else if (e.key === 'Backspace') { e.preventDefault(); back(); }
        else if (e.key === 'Enter') { e.preventDefault(); go(); }
      });
      // A server-rendered error (the form post without JavaScript, or a
      // lockout) keeps its own line; the readout starts at "Enter PIN".
      render();

      // Back / forward cache: a page restored after an unlock would still be
      // mid-spin with the keypad hidden.
      window.addEventListener('pageshow', function (ev) {
        if (!ev.persisted) return;
        document.body.classList.remove('is-unlocking');
        busy = false; pin = ''; render();
      });
    })();
  </script>
</body>
</html>
