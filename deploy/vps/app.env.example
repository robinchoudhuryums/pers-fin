# The application's environment for /opt/pers-fin/app.env (chmod 600).
# Copy these VALUES from the Render dashboard — the same names the app reads
# today. Only the database URLs and RENDER_EXTERNAL_URL change.
# docker-compose.yml adds PORT, PGSSLMODE=disable and NODE_OPTIONS itself.

# --- Databases (the compose network's `db` service; names unchanged) -------
# APP_DB_USER / APP_DB_PASSWORD from .env.
NEON_DATABASE_URL=postgres://app:CHANGE_ME@db:5432/perfin
PERSISTENT_DATABASE_URL=postgres://app:CHANGE_ME@db:5432/persistent
# EXACTLY the value from Render. A different passphrase can't decrypt the
# stored Teller/Plaid tokens or the webhook secret.
TOKEN_ENCRYPTION_PASSPHRASE=

# --- Public address -----------------------------------------------------------
# Render set this automatically. The insight email's "Open Dashboard" link and
# the keep-alive ping are built from it — set it to https://<DOMAIN>.
RENDER_EXTERNAL_URL=https://finance.example.com

# --- Shell -----------------------------------------------------------------------
SHELL_PIN=
SHELL_SECRET=
API_KEY=
CALENDAR_FEED_TOKEN=
APP_TIMEZONE=America/New_York

# --- Teller (base64 PEMs, as on Render) -----------------------------------------
TELLER_APPLICATION_ID=
TELLER_ENV=development
TELLER_CERT=
TELLER_KEY=

# --- Plaid ----------------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET_PROD=
PLAID_ENV=production

# --- AI ----------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
INSIGHTS_MONTHLY_BUDGET_CENTS=
PERSISTENT_AI_BUDGET_CENTS=
VOYAGE_API_KEY=

# --- Per-sistant ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAULT_GITHUB_TOKEN=
VAULT_GITHUB_WRITE_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Push notifications ---------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# --- Google Sheets (optional) --------------------------------------------------------------
# The key FILE must be mounted into the container — see the commented volume
# under `app` in docker-compose.yml.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=/app/service-account-key.json

# --- Operator checks (optional) ------------------------------------------------------------
GITHUB_OPS_TOKEN=
GITHUB_OPS_REPO=robinchoudhuryums/pers-fin
