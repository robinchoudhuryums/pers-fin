# Compose settings for /opt/pers-fin/.env — read by docker-compose.yml's
# ${...} substitutions only (the app container gets app.env, not this file).
# chmod 600 .env

# Public hostname (an A/AAAA record pointing at this server) and the address
# Let's Encrypt uses for expiry notices.
DOMAIN=finance.example.com
ACME_EMAIL=you@example.com

# Postgres. The superuser password is used only by the init script, backups
# and restores; the app connects as APP_DB_USER. Generate each with
#   openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_USER=app
APP_DB_PASSWORD=
# Must be >= Neon's major version (RUNBOOK.md step 4 checks it).
PG_MAJOR=16

# Image to run. The deploy workflow passes APP_TAG on each deploy; this is the
# fallback for a manual `docker compose up -d`.
GHCR_OWNER=robinchoudhuryums
APP_TAG=latest

# backup.sh — see RUNBOOK.md "Backups".
BACKUP_PASSPHRASE_FILE=/root/.pers-fin-backup-passphrase
BACKUP_DIR=/var/backups/pers-fin
BACKUP_KEEP_DAYS=7
# An rclone remote:path for the offsite copy (e.g. b2:pers-fin-backups). Leave
# blank to keep backups on this server only (not recommended).
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=90
# Optional: a dead-man's-switch URL (e.g. healthchecks.io) pinged on success,
# with /fail on failure.
BACKUP_HEALTHCHECK_URL=
