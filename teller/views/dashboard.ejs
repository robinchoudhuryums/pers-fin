          html += '<tr><td style="padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + fmtMonth(m.month) + '</td>';
          html += '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:var(--green);">' + fmt(m.income) + '</td>';
          html += '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:var(--warm);">' + fmt(m.spending) + '</td>';
          html += '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:' + (m.saved >= 0 ? 'var(--green)' : 'var(--red)') + ';">' + fmt(m.saved) + '</td>';
          html += '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:' + rc + ';">' + m.savings_rate + '%</td></tr>';
