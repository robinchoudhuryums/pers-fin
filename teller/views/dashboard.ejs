    (function wireQuickAddBill() {
      var modal = document.getElementById('quick-add-bill-modal');
      var openBtn = document.getElementById('quick-add-bill-btn');
      var saveBtn = document.getElementById('qab-save');
      var cancelBtn = document.getElementById('qab-cancel');
