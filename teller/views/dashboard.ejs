            esc(h.ticker || h.name) + ' <span style="color:' + col + ';">' + sign + (h.return_pct == null ? '?' : h.return_pct.toFixed(1)) + '%</span></div>';
        }
        winEl.innerHTML = (data.top_winners || []).map(holdingRow).join('') || '<div style="color:var(--text-muted);">—</div>';
        loseEl.innerHTML = (data.top_losers || []).map(holdingRow).join('') || '<div style="color:var(--text-muted);">—</div>';
      } catch (e) { /* silently hide */ }
    })();

    // Portfolio value vs S&P 500 — performance-history sub-card. Independent
    // of the Plaid-holdings loader above: Teller-linked + manual investment
    // accounts have snapshot history too, so this can light up the card even
    // when there are no holdings (the cost-basis "Total return" row stays
    // hidden in that case). Both series are normalized to 100 at the first
    // common date so the two lines are visually comparable regardless of
    // scale. No Chart.js — same inline-SVG approach as the sparklines.
    (function loadInvestmentHistory() {
      var box = document.getElementById('investments-performance');
      var hist = document.getElementById('invperf-history');
      var chartEl = document.getElementById('invperf-history-chart');
      var statsEl = document.getElementById('invperf-history-stats');
      if (!box || !hist || !chartEl) return;

      function renderDualLine(portfolio, benchmark) {
        var w = 560, h = 96, pad = 2;
        function norm(series, key) {
          var base = series[0][key];
          if (!base) return null;
          return series.map(function(p) { return { date: p.date, v: (p[key] / base) * 100 }; });
        }
        var pn = norm(portfolio, 'value');
        var bn = benchmark && benchmark.series && benchmark.series.length >= 2 ? norm(benchmark.series, 'close') : null;
        if (!pn) return '';
        var all = pn.map(function(p) { return p.v; }).concat(bn ? bn.map(function(p) { return p.v; }) : []);
        var min = Math.min.apply(null, all), max = Math.max.apply(null, all);
        var range = max - min || 1;
        var t0 = new Date(pn[0].date).getTime();
        var t1 = new Date(pn[pn.length - 1].date).getTime();
        var span = (t1 - t0) || 1;
        function line(series, color, width, dash) {
          var pts = series.map(function(p) {
            var x = (((new Date(p.date).getTime() - t0) / span) * (w - 2 * pad) + pad).toFixed(1);
            var y = (h - pad - ((p.v - min) / range) * (h - 2 * pad)).toFixed(1);
            return x + ',' + y;
          }).join(' ');
          return '<polyline points="' + pts + '" fill="none" stroke="' + color + '" stroke-width="' + width + '"' +
            (dash ? ' stroke-dasharray="4,3" opacity="0.75"' : '') +
            ' stroke-linecap="round" stroke-linejoin="round"/>';
        }
        var pColor = pn[pn.length - 1].v >= 100 ? 'var(--green)' : 'var(--red)';
        return '<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none" ' +
          'style="display:block;width:100%;height:' + h + 'px;" role="img" ' +
          'aria-label="Portfolio value versus S and P 500, normalized">' +
          (bn ? line(bn, 'var(--text-muted)', 1.2, true) : '') +
          line(pn, pColor, 1.8, false) +
          '</svg>' +
          '<div style="display:flex;gap:14px;font-size:10px;color:var(--text-muted);margin-top:2px;">' +
            '<span><span style="display:inline-block;width:14px;height:2px;background:' + pColor + ';vertical-align:middle;margin-right:4px;"></span>Portfolio</span>' +
            (bn ? '<span><span style="display:inline-block;width:14px;border-top:2px dashed var(--text-muted);vertical-align:middle;margin-right:4px;"></span>S&amp;P 500</span>' : '') +
          '</div>';
      }

      async function load(months) {
        try {
          var res = await apiFetch('/api/investments/performance-history?months=' + months);
          if (!res.ok) return;
          var data = await res.json();
          if (!data.portfolio || data.portfolio.length < 2) return;
          box.style.display = 'block';
          hist.style.display = 'block';
          chartEl.innerHTML = renderDualLine(data.portfolio, data.benchmark);
          var parts = [];
          if (data.portfolio_return_pct !== null && data.portfolio_return_pct !== undefined) {
            var ps = data.portfolio_return_pct >= 0 ? '+' : '';
            parts.push('Portfolio <strong style="color:' + (data.portfolio_return_pct >= 0 ? 'var(--green)' : 'var(--red)') + ';">' +
              ps + data.portfolio_return_pct.toFixed(1) + '%</strong>');
          }
          if (data.benchmark && data.benchmark.return_pct !== null) {
            var bs = data.benchmark.return_pct >= 0 ? '+' : '';
            parts.push('S&amp;P 500 <strong>' + bs + data.benchmark.return_pct.toFixed(1) + '%</strong>');
          }
          if (data.excess_return_pct !== null && data.excess_return_pct !== undefined) {
            var es = data.excess_return_pct >= 0 ? '+' : '';
            parts.push('<span style="color:' + (data.excess_return_pct >= 0 ? 'var(--green)' : 'var(--red)') + ';">' +
              es + data.excess_return_pct.toFixed(1) + '% vs market</span>');
          }
          // Contributions count as portfolio growth here (value-based line);
          // the cost-basis Total return row above is the contribution-adjusted one.
          statsEl.innerHTML = parts.join(' &nbsp;·&nbsp; ');

          // Flow-adjusted figures (TWR cumulative for the window, XIRR
          // annualized), scoped to flow-covered accounts.
          var twrEl = document.getElementById('invperf-twr-stats');
          var twrParts = [];
          if (data.twr_pct !== null && data.twr_pct !== undefined) {
            var ts = data.twr_pct >= 0 ? '+' : '';
            twrParts.push('TWR <strong style="color:' + (data.twr_pct >= 0 ? 'var(--green)' : 'var(--red)') + ';" ' +
              'title="Time-weighted return: contributions and withdrawals removed, pure investment performance">' +
              ts + data.twr_pct.toFixed(1) + '%</strong>');
          }
          if (data.xirr_pct !== null && data.xirr_pct !== undefined) {
            var xs = data.xirr_pct >= 0 ? '+' : '';
            twrParts.push('XIRR <strong title="Money-weighted (annualized): what your actual dollars earned per year">' +
              xs + data.xirr_pct.toFixed(1) + '%/yr</strong>');
          }
          if (twrParts.length && data.flow_coverage && data.flow_coverage.scope === 'partial') {
            twrParts.push('<span style="color:var(--text-muted);">(covers ' +
              data.flow_coverage.coverage_pct.toFixed(0) + '% of portfolio — log flows for the rest)</span>');
          }
          if (twrEl) twrEl.innerHTML = twrParts.join(' &nbsp;·&nbsp; ');
        } catch (e) { /* leave hidden */ }
      }

      // Manual flow logging (Teller-linked / manual accounts). Account list
      // is fetched lazily on first open; Plaid-synced accounts are excluded
      // (their flows come from investmentsTransactionsGet automatically).
      (function wireFlowForm() {
        var det = document.getElementById('invflow-log');
        var form = document.getElementById('invflow-form');
        var acctSel = document.getElementById('invflow-account');
        if (!det || !form || !acctSel) return;
        document.getElementById('invflow-date').value = new Date().toISOString().slice(0, 10);
        var loaded = false;
        det.addEventListener('toggle', async function() {
          if (!det.open || loaded) return;
          loaded = true;
          try {
            var res = await apiFetch('/api/investments');
            if (!res.ok) return;
            var data = await res.json();
            (data.accounts || []).forEach(function(a) {
              if (a.source === 'plaid') return; // auto-synced — manual entry would double-count
              var opt = document.createElement('option');
              // Teller-linked accounts live in linked_accounts → source 'linked';
              // manual investment accounts live in investment_accounts.
              opt.value = (a.source === 'teller' ? 'linked' : 'investment') + ':' + a.id;
              opt.textContent = (a.name || 'Account') + (a.institution ? ' — ' + a.institution : '');
              acctSel.appendChild(opt);
            });
          } catch (e) {}
        });
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          var sel = acctSel.value.split(':');
          if (sel.length !== 2) { showMsg('Pick an account', false); return; }
          try {
            var res = await apiFetch('/api/investment-flows', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                source: sel[0],
                source_id: parseInt(sel[1]),
                flow_date: document.getElementById('invflow-date').value,
                amount: parseFloat(document.getElementById('invflow-amount').value),
                flow_type: document.getElementById('invflow-type').value,
              }),
            });
            if (!res.ok) {
              var err = await res.json().catch(function() { return {}; });
              showMsg(err.error || 'Could not save flow', false);
              return;
            }
            showMsg('Flow logged', true);
            document.getElementById('invflow-amount').value = '';
            var active = document.querySelector('.invperf-range-btn.active');
            load(active ? parseInt(active.getAttribute('data-months')) || 12 : 12);
          } catch (e) { showMsg('Could not save flow', false); }
        });
      })();

      document.getElementById('invperf-history-range').addEventListener('click', function(e) {
        var btn = e.target.closest('.invperf-range-btn');
        if (!btn) return;
        document.querySelectorAll('.invperf-range-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        load(parseInt(btn.getAttribute('data-months')) || 12);
      });

      load(12);
    })();

    // S3: "What's new since last visit" widget. Reads /api/whats-new (which
    // honors last_dashboard_view_at) and POSTs /seen on first render so the
    // window slides forward. Auto-hides when there's nothing new.
    (async function loadWhatsNew() {
      var wrap = document.getElementById('whats-new-widget');
      var body = document.getElementById('whats-new-body');
      var since = document.getElementById('whats-new-since');
      if (!wrap || !body) return;
      try {
        var res = await apiFetch('/api/whats-new');
        if (!res.ok) return;
        var data = await res.json();
        var total = (data.counts.transactions || 0) + (data.counts.subscriptions || 0) +
                    (data.counts.notifications || 0) + (data.counts.balance_changes || 0);
        if (!total) return;
        wrap.style.display = 'block';
        if (data.since) {
          var d = new Date(data.since);
          since.textContent = '— since ' + d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
        }
        var html = [];
        function pill(label, n, color) {
          return '<span style="display:inline-block;padding:2px 8px;background:' + color + ';color:#fff;border-radius:10px;font-size:11px;margin-right:6px;">' + label + ': ' + n + '</span>';
        }
        html.push('<div style="margin-bottom:4px;">' +
          (data.counts.transactions ? pill('New txns', data.counts.transactions, 'var(--accent)') : '') +
          (data.counts.balance_changes ? pill('Balance Δ', data.counts.balance_changes, 'var(--teal)') : '') +
          (data.counts.subscriptions ? pill('New subs', data.counts.subscriptions, 'var(--yellow)') : '') +
          (data.counts.notifications ? pill('Alerts', data.counts.notifications, 'var(--red)') : '') +
        '</div>');
        if ((data.balance_changes || []).length) {
          html.push('<div><strong style="font-size:12px;color:var(--text-secondary);">Balance changes</strong>');
          for (var i = 0; i < Math.min(5, data.balance_changes.length); i++) {
            var bc = data.balance_changes[i];
            var sgn = bc.delta >= 0 ? '+' : '';
            var col = bc.delta >= 0 ? 'var(--green)' : 'var(--red)';
            html.push('<div style="font-size:12px;color:var(--text-muted);">' +
              esc(bc.account_name || ('Account #' + bc.source_id)) +
              ' <span style="color:' + col + ';">' + sgn + '$' + Math.abs(bc.delta).toFixed(2) + '</span>' +
              ' <span style="color:var(--text-muted);">($' + bc.baseline_balance.toFixed(2) + ' → $' + bc.current_balance.toFixed(2) + ')</span>' +
            '</div>');
          }
          html.push('</div>');
        }
        if ((data.subscriptions || []).length) {
          html.push('<div><strong style="font-size:12px;color:var(--text-secondary);">New subscriptions</strong>');
          for (var j = 0; j < Math.min(5, data.subscriptions.length); j++) {
            var s = data.subscriptions[j];
            html.push('<div style="font-size:12px;color:var(--text-muted);">' + esc(s.display_name) +
              ' <span style="color:var(--yellow);">$' + parseFloat(s.amount).toFixed(2) + '</span>' +
              ' every ' + s.cadence_days + 'd</div>');
          }
          html.push('</div>');
        }
        if ((data.notifications || []).length) {
          html.push('<div><strong style="font-size:12px;color:var(--text-secondary);">Recent notifications</strong>');
          for (var k = 0; k < Math.min(5, data.notifications.length); k++) {
            var n = data.notifications[k];
            html.push('<div style="font-size:12px;color:var(--text-muted);">' + esc(n.title) +
              ' <span style="color:var(--text-secondary);">— ' + esc(n.body) + '</span></div>');
          }
          html.push('</div>');
        }
        body.innerHTML = html.join('');
        // Advance the watermark after a short delay so navigating away
        // immediately doesn't lose the unseen state. Fire-and-forget.
