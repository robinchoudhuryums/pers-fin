<%- include('partials/head', { title: 'Dashboard', extraStyles: `
    .container { max-width: 1060px; }
    .top-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
                 gap: 16px; margin-bottom: 36px; }
    .accounts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
                     gap: 12px; margin-bottom: 28px; animation: fadeInUp 0.4s ease both; animation-delay: 0.25s; }
    .acct-card { padding: 18px; border-radius: var(--radius); background: var(--surface);
                 border: 1px solid var(--border); transition: all 0.2s; }
    .acct-card:hover { border-color: var(--border-hover); }
    .acct-card .acct-inst { font-size: 10px; color: var(--text-muted); text-transform: uppercase;
                            letter-spacing: 1px; font-weight: 500; }
    .acct-card .acct-name { font-size: 14px; font-weight: 400; margin-top: 4px; }
    .acct-card .acct-mask { color: var(--text-muted); font-weight: 300; }
    .acct-card .acct-balance { font-size: 22px; font-weight: 300; margin-top: 10px;
                               font-variant-numeric: tabular-nums; }
    .acct-card .acct-balance.positive { color: var(--green); }
    .acct-card .acct-balance.negative { color: var(--red); }
    .acct-card .acct-balance.neutral { color: var(--warm-glow); }
    .acct-card .acct-type { font-size: 10px; color: var(--text-muted); margin-top: 4px;
                            text-transform: uppercase; letter-spacing: 0.5px; font-weight: 400; }
    .bar-container { width: 100%; height: 6px; background: rgba(255,255,255,0.06);
                     border-radius: 3px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 3px; transition: width 0.5s ease; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
    @media (max-width: 768px) { .two-col { grid-template-columns: 1fr; } }
    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 28px;
                   animation: fadeInUp 0.4s ease both; animation-delay: 0.15s; }
    .chart-card { padding: 20px; border-radius: var(--radius); background: var(--surface);
                  border: 1px solid var(--border); backdrop-filter: blur(12px); }
    .chart-card h3 { font-size: 10px; font-weight: 500; color: var(--text-muted); text-transform: uppercase;
                     letter-spacing: 1.5px; margin-bottom: 16px; }
    .chart-card canvas { width: 100% !important; display: block; }
    .chart-wrap { position: relative; width: 100%; height: 240px; }
    @media (max-width: 640px) {
      .charts-grid { grid-template-columns: 1fr; }
      .two-col { grid-template-columns: 1fr; }
      .accounts-grid { grid-template-columns: 1fr; }
      .chart-wrap { height: 220px; }
    }

    /* ── Pyramid View Switcher ── */
    .pyramid-wrapper { display: flex; align-items: flex-start; justify-content: center; gap: 12px; }
    .pyramid-switcher { display: flex; flex-direction: column; gap: 6px; padding-top: 40px; }
    .pyramid-switcher button {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      color: var(--text-muted); font-size: 10px; padding: 8px 12px; cursor: pointer;
      text-transform: uppercase; letter-spacing: 0.8px; font-weight: 500;
      transition: all 0.2s; white-space: nowrap; text-align: left;
    }
    .pyramid-switcher button:hover { border-color: var(--border-hover); color: var(--text); }
    .pyramid-switcher button.active {
      border-color: var(--teal); color: var(--teal);
      box-shadow: 0 0 8px rgba(90,143,143,0.2);
    }
    .pyramid-debt-baseline {
      margin-top: 8px; font-size: 10px; color: var(--text-muted);
      display: flex; align-items: center; gap: 4px;
    }
    .pyramid-debt-baseline input {
      width: 90px; background: var(--surface); border: 1px solid var(--border);
      border-radius: 4px; padding: 3px 6px; color: var(--text); font-size: 10px;
      font-variant-numeric: tabular-nums;
    }
    .pyramid-debt-baseline button {
      background: var(--teal); border: none; border-radius: 4px; padding: 3px 8px;
      color: #1a1a2e; font-size: 9px; font-weight: 600; cursor: pointer;
    }
    @media (max-width: 640px) {
      .pyramid-wrapper { flex-direction: column; align-items: center; }
      .pyramid-switcher { flex-direction: row; flex-wrap: wrap; justify-content: center; padding-top: 0; }
    }


    /* ── Financial Pyramid — Separated Layers with Neon Hologram ── */
    .wellness-section {
      display: flex; flex-direction: column; align-items: center;
      margin-bottom: 44px; animation: fadeInUp 0.6s ease both; animation-delay: 0.08s;
    }
    .wellness-section h3 {
      font-size: 10px; font-weight: 500; color: var(--text-muted); text-transform: uppercase;
      letter-spacing: 2px; margin-bottom: 8px;
    }
    .pyramid-stage {
      position: relative; width: 340px; height: 360px;
      display: flex; align-items: center; justify-content: center;
    }
    .pyramid-scene {
      perspective: 700px; width: 180px; height: 260px;
      position: relative;
    }
    .pyramid-3d {
      width: 180px; height: 260px; position: relative;
      transform-style: preserve-3d;
      transform: rotateX(-20deg) rotateY(45deg);
      animation: pyramidSpin 20s linear infinite;
      will-change: transform;
    }
    @keyframes pyramidSpin {
      from { transform: rotateX(-20deg) rotateY(45deg); }
      to   { transform: rotateX(-20deg) rotateY(405deg); }
    }

    /* Each layer is an anchor point at the pyramid center axis */
    .pyramid-layer {
      position: absolute;
      left: 90px; /* center of 180px parent */
      width: 0; height: 0;
      transform-style: preserve-3d;
      /* NEVER set opacity on this element — it flattens preserve-3d children */
    }

    /* Trapezoidal/triangular faces — positioned and transformed by JS */
    .layer-face {
      position: absolute;
      background: transparent;
      transform-origin: center center;
      transition: opacity 1.5s ease;
    }
    .layer-face .face-fill {
      position: absolute; inset: 0;
      transition: background 1.5s ease, opacity 1.5s ease;
      opacity: 0.8;
    }
    .layer-face .face-edges {
      position: absolute; inset: 0; overflow: visible;
    }
    .layer-face .face-edges line {
      stroke: rgba(90,143,143,0.8);
      stroke-width: 1.5;
      filter: drop-shadow(0 0 4px rgba(90,143,143,0.6)) drop-shadow(0 0 8px rgba(90,143,143,0.3));
      transition: stroke 1s, filter 1s;
      animation: edgePulse 3s ease-in-out infinite;
    }
    @keyframes edgePulse {
      0%, 100% { opacity: 0.75; }
      50%      { opacity: 1; }
    }

    /* Scanline sweep within each face */
    .layer-face .scanline {
      position: absolute; bottom: 0; left: 0; width: 100%; height: 3px;
      background: linear-gradient(90deg, transparent 0%, rgba(90,143,143,0.9) 20%, rgba(127,181,230,1) 50%, rgba(90,143,143,0.9) 80%, transparent 100%);
      filter: blur(1.5px); opacity: 0;
      animation: scanSweep 4s ease-in-out infinite;
    }
    @keyframes scanSweep {
      0%   { bottom: 0%; opacity: 0; }
      10%  { opacity: 0.9; }
      90%  { opacity: 0.5; }
      100% { bottom: 95%; opacity: 0; }
    }

    /* Neon wireframe base — sized/positioned by JS */
    .pyramid-base {
      position: absolute;
      transform-style: preserve-3d;
      transform: rotateX(-90deg) translateZ(0px);
      background: transparent;
      border: 1px solid rgba(90,143,143,0.4);
      box-shadow: inset 0 0 20px rgba(90,143,143,0.08), 0 0 8px rgba(90,143,143,0.15);
      animation: basePulse 3s ease-in-out infinite;
    }
    .pyramid-base::before {
      content: ''; position: absolute; inset: 0;
      background:
        linear-gradient(90deg, rgba(90,143,143,0.12) 1px, transparent 1px),
        linear-gradient(0deg, rgba(90,143,143,0.12) 1px, transparent 1px);
      background-size: 37px 37px;
    }
    @keyframes basePulse {
      0%, 100% { border-color: rgba(90,143,143,0.3); box-shadow: inset 0 0 20px rgba(90,143,143,0.05), 0 0 8px rgba(90,143,143,0.1); }
      50%      { border-color: rgba(90,143,143,0.6); box-shadow: inset 0 0 30px rgba(90,143,143,0.1), 0 0 15px rgba(90,143,143,0.25); }
    }

    /* Holographic container — no opacity/filter to preserve 3D context */
    .pyramid-holo {
      position: absolute; inset: 0; pointer-events: none;
      transform-style: preserve-3d;
    }
    /* Flicker applied per-face via edge pulse instead */

    /* Neon glow underneath */
    .pyramid-glow {
      position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%);
      width: 240px; height: 55px; border-radius: 50%;
      background: radial-gradient(ellipse, rgba(90,143,143,0.5) 0%, rgba(127,181,230,0.2) 30%, transparent 65%);
      filter: blur(16px); animation: glowPulse 3s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes glowPulse {
      0%, 100% { opacity: 0.5; transform: translateX(-50%) scale(1); }
      50%      { opacity: 1; transform: translateX(-50%) scale(1.12); }
    }

    /* Rising orbs */
    .pyramid-orbs {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none; overflow: hidden;
    }
    .orb {
      position: absolute; border-radius: 50%; opacity: 0;
      animation: orbRise linear infinite;
    }
    .orb.orb-teal {
      background: radial-gradient(circle, rgba(90,143,143,1) 0%, rgba(90,143,143,0.4) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(90,143,143,0.6);
    }
    .orb.orb-blue {
      background: radial-gradient(circle, rgba(127,181,230,1) 0%, rgba(127,181,230,0.4) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(127,181,230,0.6);
    }
    .orb.orb-cyan {
      background: radial-gradient(circle, rgba(100,220,220,1) 0%, rgba(100,220,220,0.3) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(100,220,220,0.5);
    }
    @keyframes orbRise {
      0%   { opacity: 0; transform: translateY(0) scale(0.6); }
      12%  { opacity: 0.9; }
      70%  { opacity: 0.4; }
      100% { opacity: 0; transform: translateY(-320px) scale(0.15); }
    }

    /* Score display */
    .wellness-score {
      font-size: 38px; font-weight: 200; color: var(--teal);
      margin-top: 6px; font-variant-numeric: tabular-nums;
      letter-spacing: -1px; transition: color 0.5s;
      text-shadow: 0 0 20px rgba(90,143,143,0.3);
    }
    .wellness-status {
      font-size: 12px; color: var(--text-muted); font-weight: 300;
      margin-top: 2px; letter-spacing: 0.3px; text-align: center;
      max-width: 240px; transition: color 0.5s;
    }

    .orb.orb-amber {
      background: radial-gradient(circle, rgba(212,165,116,1) 0%, rgba(200,133,108,0.5) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(212,165,116,0.6);
    }
    .orb.orb-orange {
      background: radial-gradient(circle, rgba(230,160,80,1) 0%, rgba(200,133,108,0.4) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(230,160,80,0.5);
    }

    /* Tier labels — pushed further right to avoid overlap during rotation */
    .pyramid-tiers {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none;
    }
    .tier-label {
      position: absolute; font-size: 9px; font-weight: 500;
      text-transform: uppercase; letter-spacing: 1.2px;
      color: var(--text-muted); white-space: nowrap;
      transition: color 0.5s, opacity 0.5s, text-shadow 0.5s; opacity: 0.4;
    }
    .tier-label.active { opacity: 1; text-shadow: 0 0 8px currentColor; }
    .tier-label.t-0 { bottom: 68px; right: -58px; }
    .tier-label.t-1 { bottom: 128px; right: -52px; }
    .tier-label.t-2 { bottom: 184px; right: -44px; }
    .tier-label.t-3 { bottom: 236px; right: -36px; }

    /* Light theme adjustments */
    [data-theme="light"] .layer-face .face-edges line {
      stroke: rgba(61,114,114,0.7);
      filter: drop-shadow(0 0 3px rgba(61,114,114,0.4)) drop-shadow(0 0 6px rgba(61,114,114,0.2));
    }
    [data-theme="light"] .pyramid-base {
      border-color: rgba(61,114,114,0.35);
    }
    [data-theme="light"] .pyramid-glow {
      background: radial-gradient(ellipse, rgba(61,114,114,0.35) 0%, rgba(74,138,191,0.15) 30%, transparent 65%);
    }
    [data-theme="light"] .orb.orb-teal {
      background: radial-gradient(circle, rgba(61,114,114,0.9) 0%, rgba(61,114,114,0.3) 50%, transparent 100%);
    }
    [data-theme="light"] .orb.orb-blue {
      background: radial-gradient(circle, rgba(74,138,191,0.9) 0%, rgba(74,138,191,0.3) 50%, transparent 100%);
    }
    [data-theme="light"] .orb.orb-amber {
      background: radial-gradient(circle, rgba(176,122,74,0.9) 0%, rgba(160,104,76,0.4) 50%, transparent 100%);
    }
    [data-theme="light"] .orb.orb-orange {
      background: radial-gradient(circle, rgba(190,130,50,0.9) 0%, rgba(160,104,76,0.3) 50%, transparent 100%);
    }

    @media (max-width: 640px) {
      .pyramid-stage { width: 280px; height: 310px; }
      .pyramid-scene { transform: scale(0.78); }
      .tier-label { display: none; }
      /* Mobile perf: stop rotation, remove expensive filters/shadows */
      .pyramid-3d { animation: none; }
      .layer-face .face-edges line {
        filter: none !important;
        stroke-width: 1;
      }
      .layer-face .scanline { display: none; }
      .pyramid-glow { filter: none; }
      .orb { box-shadow: none; }
      @keyframes basePulse {
        0%, 100% { border-color: rgba(90,143,143,0.4); }
        50%      { border-color: rgba(90,143,143,0.6); }
      }
    }
    /* Respect reduced-motion preference */
    @media (prefers-reduced-motion: reduce) {
      .pyramid-3d { animation: none; }
      .layer-face .scanline { display: none; }
      .orb { display: none; }
    }
` }) %>
<%- include('partials/nav', { activePage: 'dashboard' }) %>

  <h1>Dashboard</h1>
  <p class="subtitle">Personal finance overview</p>

  <!-- Sync-degradation strip: surfaces /api/data-health issues[] up front so a
       disconnected link / stale sync / decryption_failed is visible without
       digging into Settings → Sync Health. Hidden when everything's healthy. -->
  <div id="sync-health-strip" role="status" style="display:none;margin:0 0 16px;border:1px solid var(--yellow,#d9b25f);border-left-width:4px;border-radius:8px;padding:10px 14px;background:color-mix(in srgb, var(--yellow,#d9b25f) 8%, transparent);font-size:13px;">
    <div style="display:flex;align-items:flex-start;gap:10px;">
      <span aria-hidden="true" style="font-size:15px;line-height:1.2;">&#9888;</span>
      <div style="flex:1;min-width:0;">
        <strong style="display:block;margin-bottom:2px;">Sync needs attention</strong>
        <div id="sync-health-strip-list" style="color:var(--text-muted);"></div>
        <a href="<%= basePath %>/settings#sync-health" style="display:inline-block;margin-top:6px;color:var(--teal);font-size:12px;">Open Sync Health &rarr;</a>
      </div>
      <button type="button" id="sync-health-strip-dismiss" aria-label="Dismiss" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:18px;line-height:1;padding:0 2px;">&times;</button>
    </div>
  </div>

  <!-- Financial Pyramid — Separated Layers -->
  <div class="wellness-section">
    <h3 id="pyramid-title">Financial Wellness</h3>
    <div class="pyramid-wrapper">
    <div class="pyramid-switcher" id="pyramid-switcher">
      <button class="active" data-mode="wellness" title="Overall financial health">Wellness</button>
      <button data-mode="debt_payoff" title="Credit card debt payoff progress">Debt</button>
      <button data-mode="goal_progress" title="Individual goal progress">Goals</button>
      <button data-mode="spending_categories" title="Spending category balance">Spending</button>
      <button data-mode="net_worth" title="Net worth breakdown">Net Worth</button>
      <div class="pyramid-debt-baseline" id="debt-baseline-ctrl" style="display:none;">
        <span>Baseline $</span>
        <input type="number" id="debt-baseline-input" placeholder="0" min="0" step="100">
        <button id="debt-baseline-save">Set</button>
      </div>
    </div>
    <div class="pyramid-stage">
      <div class="pyramid-orbs" id="pyramid-orbs"></div>
      <div class="pyramid-scene">
        <div class="pyramid-holo">
          <div class="pyramid-3d" id="pyramid-3d">
            <!-- Layers generated by buildPyramidGeometry() -->
            <div class="pyramid-base" id="pyramid-base"></div>
          </div>
        </div>
      </div>
      <div class="pyramid-glow" id="pyramid-glow"></div>
      <div class="pyramid-tiers" id="pyramid-tiers">
        <div class="tier-label t-0" id="tier-0">Accounts</div>
        <div class="tier-label t-1" id="tier-1">Budgets</div>
        <div class="tier-label t-2" id="tier-2">Subs</div>
        <div class="tier-label t-3" id="tier-3">Goals</div>
      </div>
    </div>
    </div><!-- .pyramid-wrapper -->
    <div class="wellness-score" id="wellness-score">--</div>
    <div class="wellness-status" id="wellness-status">Calculating...</div>
  </div>

  <!-- Charts -->
  <div class="charts-grid">
    <div class="chart-card">
      <h3>Monthly Spending Trend</h3>
      <div class="chart-wrap"><canvas id="trend-chart" role="img" aria-label="Line chart showing monthly spending trend over time"></canvas></div>
    </div>
    <div class="chart-card">
      <h3>Spending by Category</h3>
      <div class="chart-wrap"><canvas id="category-chart" role="img" aria-label="Doughnut chart showing spending breakdown by category"></canvas></div>
    </div>
  </div>

  <div class="actions">
    <button class="primary" id="sync-btn">Sync Transactions</button>
    <button id="balance-btn">Refresh Balances</button>
    <button id="detect-btn">Run Detection</button>
  </div>

  <div id="status-msg" class="status-msg"></div>

  <!-- Summary cards -->
  <div class="top-cards" id="summary-cards">
    <div class="card"><div class="label">Net Balance</div><div class="value warm" id="net-balance">--</div></div>
    <div class="card"><div class="label">Monthly Spend</div><div class="value warm" id="avg-monthly">--</div><div class="sub" id="avg-monthly-sub"></div></div>
    <div class="card"><div class="label">Subscriptions /mo</div><div class="value teal" id="subs-monthly">--</div></div>
    <div class="card"><div class="label">Active Subs</div><div class="value teal" id="active-subs">--</div></div>
    <div class="card"><div class="label">Avg Daily Spend</div><div class="value warm" id="avg-daily">--</div></div>
    <div class="card"><div class="label">Linked Accounts</div><div class="value teal" id="acct-count">--</div></div>
  </div>

  <!-- Account balances -->
  <div id="accounts-section" style="margin-bottom:28px;">
    <div style="font-size:10px;font-weight:500;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:14px;">Account Balances</div>
    <div class="accounts-grid" id="accounts-grid">
      <div class="empty-msg">Loading accounts...</div>
    </div>
  </div>

  <!-- Ask Perfin — NL finance Q&A (Claude tool-use over the shared helpers,
       so cited numbers match the dashboard). Widget key: ask. -->
  <div class="section" id="ask-section" style="margin-bottom:28px;">
    <h2>Ask Perfin</h2>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <input id="ask-input" type="text" maxlength="500" placeholder="e.g. How much did I spend on dining last month?"
             style="flex:1;min-width:220px;" aria-label="Ask a question about your finances">
      <button class="btn primary" id="ask-btn" type="button">Ask</button>
    </div>
    <div id="ask-answer" style="display:none;margin-top:12px;padding:14px;background:var(--bg-elevated);border:1px solid var(--card-border);border-radius:8px;font-size:13px;line-height:1.6;white-space:pre-wrap;"></div>
    <div id="ask-meta" style="margin-top:6px;font-size:10px;color:var(--text-muted);"></div>
  </div>

  <!-- Two-column: Monthly trend + Categories -->
  <div class="two-col">
    <div class="section collapsible" data-collapse-key="monthlySpend">
      <h2>Monthly Spending</h2>
      <div class="table-wrap">
      <table class="responsive-cards">
        <thead><tr><th>Month</th><th>Total</th><th>Txns</th><th>Avg</th></tr></thead>
        <tbody id="monthly-body"><tr><td colspan="4" class="empty-msg">Loading...</td></tr></tbody>
      </table>
      </div>
    </div>
    <div class="section collapsible" data-collapse-key="categories">
      <h2>Spending by Category
        <select id="cat-month-select" aria-label="Category breakdown month"
                style="font-size:11px;text-transform:none;letter-spacing:normal;padding:2px 6px;max-width:140px;">
          <option value="">Recent months</option>
        </select>
      </h2>
      <div class="table-wrap">
      <table class="responsive-cards">
        <thead><tr><th>Category</th><th>Total</th><th style="width:30%">Share</th></tr></thead>
        <tbody id="category-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
      </div>
    </div>
  </div>

  <!-- Two-column: Top merchants + Upcoming subscriptions -->
  <div class="two-col">
    <div class="section collapsible" data-collapse-key="merchants">
      <h2>Top Merchants</h2>
      <div class="table-wrap">
      <table class="responsive-cards">
        <thead><tr><th>Merchant</th><th>Total</th><th>Txns</th></tr></thead>
        <tbody id="merchant-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
      </div>
    </div>
    <div class="section collapsible" data-collapse-key="upcoming">
      <h2>Upcoming Charges</h2>
      <div class="table-wrap">
      <table class="responsive-cards">
        <thead><tr><th>Service</th><th>Amount</th><th>Next</th></tr></thead>
        <tbody id="upcoming-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
      </div>
    </div>
  </div>

  <!-- 30-day forecast -->
  <div class="section" id="forecast-section" style="display:none;">
    <h2>Next 30 Days Forecast</h2>
    <div id="forecast-summary" style="font-size:13px;color:var(--text-muted);margin-bottom:12px;"></div>
    <div id="forecast-list"></div>
  </div>

  <!-- CSV Import Reminder Banner -->
  <div id="csv-reminder-banner" style="display:none;padding:14px 18px;background:var(--yellow-bg);border:1px solid rgba(240,195,109,0.2);border-radius:var(--radius);margin-bottom:20px;font-size:13px;color:var(--yellow);font-weight:400;">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <div id="csv-reminder-text"></div>
      <a href="/" style="color:var(--warm);font-weight:500;text-decoration:none;white-space:nowrap;margin-left:12px;">Import CSV &rarr;</a>
    </div>
  </div>

  <!-- Budget Velocity Alerts -->
  <div id="budget-alerts-section" style="display:none;margin-bottom:20px;">
    <div id="budget-alerts-list"></div>
  </div>

  <!-- AI Memory — surfaces the structured running summary so the user can
       see what the AI is currently tracking (post-S5 visibility). Auto-hides
       when no summary exists. -->
  <div class="section" id="ai-memory-section" style="display:none;margin-bottom:28px;">
    <details>
      <summary style="cursor:pointer;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <h2 style="margin:0;display:inline;">AI Memory</h2>
        <span id="ai-memory-counts" style="font-size:11px;color:var(--text-muted);"></span>
      </summary>
      <div style="margin-top:12px;font-size:12px;">
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:10px;">
          Long-term context the AI uses on every analysis. Updated automatically when you generate insights.
        </div>
        <div id="ai-memory-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;"></div>
      </div>
    </details>
  </div>

  <!-- Review Uncategorized (engagement loop — turn AI cost into rules) -->
  <div class="section" id="review-queue-section" style="display:none;margin-bottom:28px;">
    <details open>
      <summary style="cursor:pointer;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <h2 style="margin:0;display:inline;">Review Uncategorized</h2>
        <span id="review-queue-count" style="font-size:11px;color:var(--text-muted);"></span>
      </summary>
      <div id="review-queue-body" style="margin-top:12px;font-size:13px;">
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:10px;">
          These would otherwise be sent to Claude on the next AI categorize run. Pick a category — check "Remember" to create a rule and skip future AI cost for the same merchant.
        </div>
        <div id="review-queue-list"></div>
      </div>
    </details>
  </div>

  <!-- Settle-up: combined shared-card + housing even-up net (who-owes-who) -->
  <div class="section" id="settlement-section" style="display:none;margin-bottom:28px;">
    <details open>
      <summary style="cursor:pointer;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <h2 style="margin:0;display:inline;">Settle Up</h2>
        <span style="display:flex;gap:8px;align-items:center;">
          <select id="settlement-month-pick" style="font-size:11px;padding:3px 6px;background:var(--bg-elevated);color:var(--text);border:1px solid var(--card-border);border-radius:4px;"></select>
        </span>
      </summary>
      <div id="settlement-headline" style="margin-top:12px;"></div>
      <div id="settlement-body" style="margin-top:12px;font-size:13px;"></div>
    </details>
  </div>

  <!-- Rent & Utilities — balance owed to the payee -->
  <div class="section" id="housing-widget-section" style="display:none;margin-bottom:28px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
      <h2 style="margin:0;">Rent &amp; Utilities</h2>
      <a href="<%= basePath %>/housing" style="font-size:12px;color:var(--teal);text-decoration:none;">Manage &rarr;</a>
    </div>
    <div id="housing-widget-body" style="margin-top:10px;font-size:13px;"></div>
  </div>

  <!-- Investments (Teller-linked + Plaid + manual, unified) -->
  <div class="section" id="investments-section" style="margin-bottom:28px;">
    <details open>
      <summary style="cursor:pointer;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <h2 style="margin:0;display:inline;">Investments</h2>
        <span id="investments-total" style="font-size:14px;color:var(--green);font-weight:500;">--</span>
      </summary>
      <div style="margin-top:12px;">
        <div id="investments-by-source" style="display:flex;gap:18px;flex-wrap:wrap;font-size:11px;color:var(--text-muted);margin-bottom:12px;"></div>
        <!-- S4: portfolio return + asset allocation. Only renders when Plaid
             holdings exist (cost_basis / current_value per security). -->
        <div id="investments-performance" style="display:none;margin-bottom:14px;padding:12px;background:var(--bg-elevated);border:1px solid var(--card-border);border-radius:8px;">
          <div id="invperf-return-row" style="display:none;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:8px;">
            <span style="font-size:13px;color:var(--text-muted);">Total return</span>
            <span id="invperf-return" style="font-size:14px;font-weight:500;"></span>
          </div>
          <div id="invperf-allocation" style="margin-top:8px;display:flex;flex-direction:column;gap:4px;font-size:11px;color:var(--text-secondary);"></div>
          <!-- Portfolio value vs S&P 500 (performance-history). Hidden until
               the series has >= 2 snapshot days; benchmark line + numbers
               drop out gracefully when the benchmark source is unavailable. -->
          <div id="invperf-history" style="display:none;margin-top:12px;border-top:1px solid var(--card-border);padding-top:10px;">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
              <span style="font-size:13px;color:var(--text-muted);">Value vs S&amp;P 500</span>
              <span id="invperf-history-range" role="group" aria-label="History range">
                <button type="button" class="invperf-range-btn" data-months="3" style="font-size:10px;padding:2px 8px;">3M</button>
                <button type="button" class="invperf-range-btn" data-months="6" style="font-size:10px;padding:2px 8px;">6M</button>
                <button type="button" class="invperf-range-btn active" data-months="12" style="font-size:10px;padding:2px 8px;">12M</button>
              </span>
            </div>
            <div id="invperf-history-chart" style="margin-top:8px;"></div>
            <div id="invperf-history-stats" style="margin-top:6px;font-size:11px;color:var(--text-secondary);"></div>
            <div id="invperf-twr-stats" style="margin-top:4px;font-size:11px;color:var(--text-secondary);"></div>
            <details id="invflow-log" style="margin-top:8px;">
              <summary style="cursor:pointer;font-size:11px;color:var(--text-muted);">Log contribution / withdrawal</summary>
              <form id="invflow-form" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;align-items:center;font-size:11px;">
                <select id="invflow-account" required style="max-width:160px;"><option value="">Account…</option></select>
                <select id="invflow-type">
                  <option value="contribution">Contribution</option>
                  <option value="withdrawal">Withdrawal</option>
                </select>
                <input id="invflow-date" type="date" required>
                <input id="invflow-amount" type="number" step="0.01" min="0.01" placeholder="Amount" inputmode="decimal" required style="width:100px;">
                <button type="submit">Save</button>
              </form>
              <div style="margin-top:4px;font-size:10px;color:var(--text-muted);">
                For accounts Plaid can't see (Teller-linked / manual). Plaid-linked
                accounts get deposits &amp; withdrawals synced automatically.
              </div>
            </details>
          </div>
          <details style="margin-top:10px;">
            <summary style="cursor:pointer;font-size:11px;color:var(--text-muted);">Top winners &amp; losers</summary>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px;font-size:11px;">
              <div>
                <div style="color:var(--green);margin-bottom:4px;">Winners</div>
                <div id="invperf-winners"></div>
              </div>
              <div>
                <div style="color:var(--red);margin-bottom:4px;">Losers</div>
                <div id="invperf-losers"></div>
              </div>
            </div>
          </details>
        </div>
        <div id="investments-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;"></div>
      </div>
    </details>
  </div>

  <!-- S3: What's new since last visit -->
  <div class="section" id="whats-new-widget" style="margin-bottom:28px;display:none;">
    <details open>
      <summary style="cursor:pointer;display:flex;align-items:center;gap:8px;">
        <h2 style="margin:0;">Since you last looked</h2>
        <span id="whats-new-since" style="font-size:11px;color:var(--text-muted);"></span>
      </summary>
      <div id="whats-new-body" style="margin-top:12px;display:flex;flex-direction:column;gap:10px;font-size:13px;"></div>
    </details>
  </div>

  <!-- Credit Score widget — manual-entry trend tracker -->
  <div class="section" id="credit-score-widget" style="margin-bottom:28px;">
    <details open>
      <summary style="cursor:pointer;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <h2 style="margin:0;">Credit Score</h2>
        <span id="credit-score-current" style="font-size:16px;font-weight:600;color:var(--green);"></span>
      </summary>
      <div id="credit-score-body" style="margin-top:12px;">
        <div id="credit-score-trend" style="margin-bottom:12px;font-size:13px;color:var(--text-secondary);"></div>
        <div id="credit-score-history" style="font-size:12px;color:var(--text-muted);margin-bottom:12px;"></div>
        <!-- Quick log form -->
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
          <input id="cs-score-input" type="number" min="300" max="850" inputmode="numeric" placeholder="Score (300-850)"
                 style="width:120px;padding:8px 10px;font-size:13px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text);font-family:inherit;min-height:40px;">
          <select id="cs-type-input" style="padding:8px 10px;font-size:13px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text);font-family:inherit;min-height:40px;">
            <option value="vantagescore">VantageScore</option>
            <option value="fico">FICO</option>
            <option value="other">Other</option>
          </select>
          <input id="cs-source-input" placeholder="Source (e.g. Chase)" style="width:120px;padding:8px 10px;font-size:13px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text);font-family:inherit;min-height:40px;">
          <button class="btn" id="cs-log-btn" style="min-height:40px;cursor:pointer;font-family:inherit;">Log Score</button>
          <span id="cs-status" style="font-size:11px;color:var(--text-muted);"></span>
        </div>
      </div>
    </details>
  </div>

  <!-- Bill Calendar Quick View -->
  <div class="section" id="calendar-widget" style="margin-bottom:28px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">
      <h2 style="margin:0;">Upcoming Bills</h2>
      <div style="display:flex;align-items:center;gap:12px;">
        <button class="btn-sm" id="quick-add-bill-btn" style="font-size:12px;padding:6px 12px;border:1px solid var(--teal);border-radius:6px;background:transparent;color:var(--teal);cursor:pointer;font-family:inherit;min-height:36px;">+ Add Bill</button>
        <a href="<%= basePath %>/calendar" style="color:var(--teal);font-size:12px;text-decoration:none;">Full Calendar &rarr;</a>
      </div>
    </div>
    <div id="calendar-widget-body" style="margin-top:12px;font-size:13px;color:var(--text-muted);">Loading...</div>
  </div>

  <!-- Quick Add Bill modal — opens from the Upcoming Bills widget. POSTs
       directly to /api/manual-bills then refreshes the widget. Mobile-
       optimized: large tap targets, autofocus on first field, full-width
       inputs. -->
  <div id="quick-add-bill-modal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);">
    <div style="max-width:420px;margin:60px auto;padding:24px;background:var(--surface, var(--bg));border:1px solid var(--border);border-radius:var(--radius);box-shadow:0 20px 60px rgba(0,0,0,0.3);">
      <h3 style="margin:0 0 6px;">Add Bill</h3>
      <div style="font-size:11px;color:var(--text-muted);margin-bottom:16px;">For utilities, rent, or anything not auto-detected from transactions.</div>
      <div style="display:flex;flex-direction:column;gap:12px;">
        <input id="qab-name" placeholder="Bill name (e.g. Electricity)" style="padding:12px;font-size:14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;min-height:44px;" autocomplete="off">
        <input id="qab-amount" type="number" step="0.01" min="0" inputmode="decimal" placeholder="Amount ($)" style="padding:12px;font-size:14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;min-height:44px;">
        <div style="display:flex;gap:8px;">
          <input id="qab-day" type="number" min="1" max="31" inputmode="numeric" placeholder="Due day (1-31)" style="flex:1;padding:12px;font-size:14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;min-height:44px;">
          <select id="qab-cadence" style="flex:1;padding:12px;font-size:14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;min-height:44px;">
            <option value="monthly">Monthly</option>
            <option value="quarterly">Quarterly</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>
        <select id="qab-category" style="padding:12px;font-size:14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;min-height:44px;">
          <option value="utility">Utility</option>
          <option value="bill">Bill</option>
          <option value="subscription">Subscription</option>
          <option value="insurance">Insurance</option>
          <option value="housing">Housing</option>
        </select>
        <div id="qab-status" style="font-size:12px;min-height:18px;"></div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:4px;">
          <button class="btn-sm" id="qab-cancel" style="font-size:13px;padding:10px 16px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text);cursor:pointer;font-family:inherit;min-height:40px;">Cancel</button>
          <button class="btn-sm" id="qab-save" style="font-size:13px;padding:10px 16px;border:1px solid var(--teal);border-radius:6px;background:var(--teal);color:#000;cursor:pointer;font-family:inherit;font-weight:500;min-height:40px;">Save Bill</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Savings Rate (collapsible) -->
  <div class="section" id="savings-rate-section" style="display:none;margin-bottom:28px;">
    <details open>
      <summary style="cursor:pointer;"><h2 style="margin:0;display:inline;">Savings Rate</h2></summary>
      <div id="savings-rate-content" style="margin-top:12px;"></div>
    </details>
  </div>

  <!-- Cash Flow Forecast (collapsible) -->
  <div class="section" id="cashflow-section" style="display:none;margin-bottom:28px;">
    <details open>
      <summary style="cursor:pointer;"><h2 style="margin:0;display:inline;">Cash Flow Projection</h2></summary>
      <div style="margin-top:12px;">
        <div id="cashflow-summary" style="font-size:13px;color:var(--text-muted);margin-bottom:12px;"></div>
        <div id="cashflow-list"></div>
      </div>
    </details>
  </div>

  <!-- Year-over-Year Comparison (collapsible) -->
  <div class="section" id="yoy-section" style="display:none;margin-bottom:28px;">
    <details open>
      <summary style="cursor:pointer;"><h2 style="margin:0;display:inline;">Year-over-Year Comparison</h2></summary>
      <div id="yoy-content" style="margin-top:12px;"></div>
    </details>
  </div>

  <!-- AI Insights Widget (collapsible) -->
  <div class="section" id="insights-widget" style="margin-bottom:28px;">
    <details open>
      <summary style="cursor:pointer;display:flex;align-items:center;gap:8px;">
        <h2 style="margin:0;">AI Financial Insights</h2>
        <span id="insights-widget-meta" style="font-size:11px;color:var(--text-muted);"></span>
      </summary>
      <div id="insights-widget-body" style="margin-top:12px;font-size:13px;line-height:1.6;color:var(--text-secondary);">
        Loading...
      </div>
      <!-- S1: per-insight feedback (thumbs up/down + optional correction) -->
      <div id="insights-widget-feedback" style="display:none;margin-top:14px;padding-top:12px;border-top:1px solid var(--card-border);">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <span style="font-size:12px;color:var(--text-muted);">Was this useful?</span>
          <button class="btn btn-sm" data-fb="positive" title="Mark as helpful" style="min-width:44px;">👍</button>
          <button class="btn btn-sm" data-fb="negative" title="Mark as incorrect or unhelpful" style="min-width:44px;">👎</button>
          <button class="btn btn-sm" data-fb="mixed" title="Mixed — partly useful, partly off" style="min-width:44px;">±</button>
          <button class="btn btn-sm btn-link" id="insights-feedback-note-toggle" style="font-size:11px;">add note…</button>
          <span id="insights-feedback-status" style="font-size:11px;color:var(--text-muted);"></span>
        </div>
        <div id="insights-feedback-note-wrap" style="display:none;margin-top:8px;">
          <textarea id="insights-feedback-note" rows="2"
            placeholder="What was wrong? (e.g. 'numbers were off', 'wrong merchant attribution')"
            style="width:100%;font-size:12px;padding:6px 8px;background:var(--bg-elevated);color:var(--text-primary);border:1px solid var(--card-border);border-radius:6px;"></textarea>
          <button class="btn btn-sm" id="insights-feedback-note-save" style="margin-top:6px;">Save note</button>
        </div>
      </div>
    </details>
  </div>

  <!-- Quick Links -->
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px;">
    <a href="<%= basePath %>/calendar" class="btn" style="text-decoration:none;">Bill Calendar</a>
    <a href="<%= basePath %>/transactions" class="btn" style="text-decoration:none;">Search Transactions</a>
    <button class="btn" id="dash-upload-csv-btn" style="cursor:pointer;font-family:inherit;">Upload CSV</button>
    <button class="btn" id="dash-sync-sheets-btn" style="cursor:pointer;font-family:inherit;">Sync to Sheets</button>
  </div>

  <!-- Dashboard Quick CSV Upload modal — mirrors the Accounts page form but
       lives on the dashboard so mobile users don't have to navigate.
       POSTs to the same /api/import-csv endpoint. -->
  <div id="dash-csv-modal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);">
    <div style="max-width:420px;margin:60px auto;padding:24px;background:var(--surface, var(--bg));border:1px solid var(--border);border-radius:var(--radius);box-shadow:0 20px 60px rgba(0,0,0,0.3);">
      <h3 style="margin:0 0 6px;">Import Transactions CSV</h3>
      <div style="font-size:11px;color:var(--text-muted);margin-bottom:16px;">Pick a CSV export from your bank's app. Supports Chase, Wells Fargo, Capital One, Discover, Schwab, and generic.</div>
      <div style="display:flex;flex-direction:column;gap:12px;">
        <select id="dash-csv-institution" style="padding:12px;font-size:14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;min-height:44px;">
          <option value="Chase">Chase</option>
          <option value="Wells Fargo">Wells Fargo</option>
          <option value="Capital One">Capital One</option>
          <option value="Discover">Discover</option>
          <option value="Charles Schwab">Charles Schwab</option>
          <option value="Other">Other</option>
        </select>
        <input id="dash-csv-custom" placeholder="Institution name" style="display:none;padding:12px;font-size:14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;min-height:44px;">
        <input id="dash-csv-label" placeholder="Account label (e.g. Chase Checking)" style="padding:12px;font-size:14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;min-height:44px;">
        <input id="dash-csv-file" type="file" accept=".csv,text/csv,.CSV" style="padding:8px;font-size:13px;color:var(--text-muted);">
        <div id="dash-csv-preview" style="display:none;font-size:12px;border:1px solid var(--border);border-radius:8px;padding:10px 12px;max-height:240px;overflow:auto;"></div>
        <div id="dash-csv-status" style="font-size:12px;min-height:18px;"></div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:4px;">
          <button class="btn-sm" id="dash-csv-cancel" style="font-size:13px;padding:10px 16px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text);cursor:pointer;font-family:inherit;min-height:40px;">Cancel</button>
          <button class="btn-sm" id="dash-csv-submit" style="font-size:13px;padding:10px 16px;border:1px solid var(--teal);border-radius:6px;background:var(--teal);color:#000;cursor:pointer;font-family:inherit;font-weight:500;min-height:40px;">Preview</button>
        </div>
      </div>
    </div>
  </div>

<%- include('partials/foot') %>
  <script src="<%= basePath %>/vendor/chart.umd.js"></script>
  <script nonce="<%= nonce %>">if(typeof Chart==='undefined'){var s=document.createElement('script');s.src='<%= basePath %>/vendor/chart.umd.js?v=<%= v %>';document.head.appendChild(s);}</script>
  <script nonce="<%= nonce %>">
    const barColors = ['#c8856c','#d4a574','#5a8f8f','#6fcf97','#7fb5e6','#f0c36d','#eb6b6b','#b07cc6','#e8a87c','#85dcb0','#7bb5d4','#d4a0a0','#9fd4c9','#c4b28f','#a8c3d4'];

    // Build true 3D pyramid geometry — frustum layers with trapezoidal faces
    (function buildPyramidGeometry() {
      var container = document.getElementById('pyramid-3d');
      if (!container) return;
      var B = 75;   // half-base of pyramid
      var H = 212;  // total pyramid height (base to apex)
      var GAP = 10;  // vertical gap between layers
      // Layer vertical slices (from bottom)
      var layers = [
        { y0: 0, y1: 52 },     // base
        { y0: 62, y1: 110 },   // +10 gap
        { y0: 120, y1: 164 },  // +10 gap
        { y0: 174, y1: H }     // apex, +10 gap
      ];
      var ALPHA_DEG = Math.atan(B / H) * (180 / Math.PI); // ~19.5°
      var faceNames = ['lf-front', 'lf-right', 'lf-back', 'lf-left'];
      var faceRotY = [0, 90, 180, 270];
      var faceOpacities = [0.2, 0.15, 0.12, 0.15];
      var SVG_NS = 'http://www.w3.org/2000/svg';

      // Position base grid
      var base = document.getElementById('pyramid-base');
      if (base) {
        var baseW = B * 2;
        base.style.width = baseW + 'px';
        base.style.height = baseW + 'px';
        base.style.bottom = '0';
        base.style.left = (90 - B) + 'px';
      }

      layers.forEach(function(L, li) {
        var h = L.y1 - L.y0;
        var bw = B * (H - L.y0) / H;  // bottom half-width
        var tw = B * (H - L.y1) / H;  // top half-width (0 for apex)
        var diff = bw - tw;
        var sh = Math.sqrt(h * h + diff * diff); // slant height
        var avgZ = (bw + tw) / 2;
        var faceW = bw * 2;
        var isApex = tw < 0.5; // effectively zero = triangle

        // Create layer container (0×0 anchor at pyramid center, at layer vertical center)
        var layerEl = document.createElement('div');
        layerEl.className = 'pyramid-layer layer-' + li;
        layerEl.id = 'layer-' + li;
        // Position anchor at the vertical center of this layer
        layerEl.style.bottom = (L.y0 + h / 2) + 'px';
        container.insertBefore(layerEl, base);

        // Create 4 faces (front, right, back, left)
        for (var fi = 0; fi < 4; fi++) {
          var face = document.createElement('div');
          face.className = 'layer-face ' + faceNames[fi];
          // Size: width = bottom width (2*bw), height = slant height
          face.style.width = faceW + 'px';
          face.style.height = sh + 'px';
          // Center on the 0×0 anchor point
          face.style.left = -bw + 'px';
          face.style.top = (-sh / 2) + 'px';
          // Clip to trapezoid (or triangle for apex)
          if (isApex) {
            face.style.clipPath = 'polygon(50% 0%, 0% 100%, 100% 100%)';
          } else {
            var inset = (diff / faceW) * 100;
            face.style.clipPath = 'polygon(' + inset.toFixed(1) + '% 0%, ' + (100 - inset).toFixed(1) + '% 0%, 100% 100%, 0% 100%)';
          }
          // 3D transform: rotateY to orient face, translateZ to push outward, rotateX to tilt inward
          face.style.transform = 'rotateY(' + faceRotY[fi] + 'deg) translateZ(' + avgZ.toFixed(1) + 'px) rotateX(' + ALPHA_DEG.toFixed(1) + 'deg)';

          // Face fill gradient
          var fill = document.createElement('div');
          fill.className = 'face-fill';
          fill.style.background = 'linear-gradient(to top, rgba(200,133,108,' + faceOpacities[fi] + '), transparent 70%)';
          if (isApex) {
            fill.style.clipPath = 'polygon(50% 0%, 0% 100%, 100% 100%)';
          }
          face.appendChild(fill);

          // SVG wireframe edges
          var svg = document.createElementNS(SVG_NS, 'svg');
          svg.setAttribute('class', 'face-edges');
          svg.setAttribute('viewBox', '0 0 ' + faceW.toFixed(1) + ' ' + sh.toFixed(1));
          svg.setAttribute('xmlns', SVG_NS);
          if (isApex) {
            // Triangle: apex at top center, base at bottom
            var cx = bw;
            addLine(svg, cx, 0, 0, sh);
            addLine(svg, cx, 0, faceW, sh);
            addLine(svg, 0, sh, faceW, sh);
          } else {
            // Trapezoid: narrower at top
            addLine(svg, diff, 0, 0, sh);          // top-left to bottom-left
            addLine(svg, diff, 0, faceW - diff, 0); // top edge
            addLine(svg, faceW - diff, 0, faceW, sh); // top-right to bottom-right
            addLine(svg, 0, sh, faceW, sh);         // bottom edge
          }
          face.appendChild(svg);

          // Scanline
          var scan = document.createElement('div');
          scan.className = 'scanline';
          if (fi > 0) scan.style.animationDelay = fi + 's';
          face.appendChild(scan);

          layerEl.appendChild(face);
        }
      });

      function addLine(svg, x1, y1, x2, y2) {
        var line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', x1.toFixed(1));
        line.setAttribute('y1', y1.toFixed(1));
        line.setAttribute('x2', x2.toFixed(1));
        line.setAttribute('y2', y2.toFixed(1));
        svg.appendChild(line);
      }
    })();

    async function loadAccounts() {
      try {
        const [res, invRes] = await Promise.all([
          apiFetch('/api/accounts'),
          apiFetch('/api/investment-accounts'),
        ]);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        let accounts = await res.json();
        const investments = invRes.ok ? await invRes.json() : [];
        // Dedupe the Plaid brokerage twin: an investment account linked via the
        // combined Plaid flow lands in BOTH linked_accounts (often $0 from
        // accountsGet) AND investment_accounts (correct balance from holdings
        // sync). Drop the linked_accounts copy so it doesn't show as a phantom
        // $0 card — the investment_accounts row renders it correctly below.
        var invPlaidIds = new Set(investments.filter(function(i){ return i.plaid_account_id; }).map(function(i){ return String(i.plaid_account_id); }));
        accounts = accounts.filter(function(a){ return !(a.account_id && invPlaidIds.has(String(a.account_id))); });
        const grid = document.getElementById('accounts-grid');

        animateInt(document.getElementById('acct-count'), accounts.length + investments.length);

        if (!accounts.length && !investments.length) {
          grid.innerHTML = '<div class="empty-msg">No accounts linked. <a href="/">Link an account</a> to get started.</div>';
          return;
        }

        let netBalance = 0;
        const hasBalances = accounts.some(a => a.available_balance !== null || a.current_balance !== null) || investments.length > 0;

        // Render a single account card. Pulled out of the grouping render
        // below so cash/credit/investment branches can share the same
        // markup without duplicating the per-card HTML.
        function renderAcctCard(a) {
          const isCredit = a.type === 'credit';
          // Loans are debt like credit: the reported balance is what's OWED,
          // so display it negative and subtract from the grid's net total
          // (a $18k auto loan must not render as +$18k green).
          const isLoan = a.type === 'loan';
          const isDebt = isCredit || isLoan;
          const bal = isDebt
            ? parseFloat(a.current_balance || 0)
            : parseFloat(a.available_balance || a.current_balance || 0);
          const displayBal = isDebt ? -bal : bal;
          netBalance += displayBal;

          const balClass = !hasBalances ? 'neutral' : displayBal > 0 ? 'positive' : displayBal < 0 ? 'negative' : 'neutral';
          const balDisplay = hasBalances ? (displayBal < 0 ? '-' + fmt(Math.abs(displayBal)) : fmt(displayBal)) : '\u2014';

          let creditExtra = '';
          if (isCredit && hasBalances) {
            const owed = parseFloat(a.current_balance || 0);
            const avail = parseFloat(a.available_balance || 0);
            const storedLimit = parseFloat(a.credit_limit);
            // Prefer the reported credit_limit; only DERIVE from owed+avail when
            // we actually have an available figure. When neither is known (e.g.
            // Discover reports no limit AND no available), the limit is genuinely
            // unknown — show "—" instead of collapsing to `owed` and implying a
            // misleading 100% utilization.
            const limit = storedLimit > 0 ? storedLimit : (avail > 0 ? owed + avail : null);
            if (limit && limit > 0) {
              const util = Math.round((owed / limit) * 100);
              const utilColor = util <= 10 ? 'var(--green)' : util <= 30 ? 'var(--teal)' : util <= 50 ? 'var(--warm)' : 'var(--red)';
              creditExtra += '<div style="font-size:11px;margin-top:4px;color:var(--text-muted);">Utilization: <span style="color:' + utilColor + ';font-weight:500;">' + util + '%</span> of ' + fmt(limit) + '</div>';
            } else {
              creditExtra += '<div style="font-size:11px;margin-top:4px;color:var(--text-muted);">Utilization: <span>—</span> <span style="font-size:10px;">(credit limit not reported by bank)</span></div>';
            }
            // Manual credit-limit entry — some issuers (e.g. Discover via Plaid)
            // never report a limit, so let the user set it to get real
            // utilization. Saved to credit_limit via PATCH /:id/balance.
            creditExtra += '<div style="font-size:11px;margin-top:4px;display:flex;align-items:center;gap:6px;color:var(--text-muted);">Limit: $<input type="number" step="1" min="0" value="' + (storedLimit > 0 ? storedLimit : '') + '" placeholder="—" data-limit-account="' + a.id + '" style="width:80px;padding:2px 6px;font-size:11px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text);font-family:inherit;"></div>';
            creditExtra += '<div style="font-size:11px;margin-top:4px;display:flex;align-items:center;gap:6px;color:var(--text-muted);">APR: <input type="number" step="0.01" min="0" max="99.99" value="' + (a.apr || '') + '" placeholder="\u2014" data-apr-account="' + a.id + '" style="width:60px;padding:2px 6px;font-size:11px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text);font-family:inherit;">%</div>';
          }
          if (isLoan && hasBalances) {
            // Auto-loan terms are MANUAL fields: Plaid's Liabilities product
            // covers only credit/student/mortgage, so APR + payment are never
            // reported for an auto loan (same pattern as the manual Discover
            // credit limit). With both set, show the payoff projection.
            const owed = parseFloat(a.current_balance || 0);
            const aprVal = parseFloat(a.apr);
            const payVal = parseFloat(a.monthly_payment);
            creditExtra += '<div style="font-size:11px;margin-top:4px;display:flex;align-items:center;gap:6px;color:var(--text-muted);">APR: <input type="number" step="0.01" min="0" max="99.99" value="' + (a.apr || '') + '" placeholder="\u2014" data-apr-account="' + a.id + '" style="width:60px;padding:2px 6px;font-size:11px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text);font-family:inherit;">%</div>';
            creditExtra += '<div style="font-size:11px;margin-top:4px;display:flex;align-items:center;gap:6px;color:var(--text-muted);">Payment: $<input type="number" step="1" min="1" value="' + (a.monthly_payment ? parseFloat(a.monthly_payment) : '') + '" placeholder="\u2014" data-payment-account="' + a.id + '" style="width:80px;padding:2px 6px;font-size:11px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text);font-family:inherit;">/mo</div>';
            if (owed > 0 && payVal > 0) {
              const p = loanPayoff(owed, isNaN(aprVal) ? 0 : aprVal, payVal);
              if (p.insufficient) {
                creditExtra += '<div style="font-size:11px;margin-top:4px;color:var(--red);">Payment is below the monthly interest \u2014 balance grows</div>';
              } else if (p.months) {
                const yrs = Math.floor(p.months / 12), mos = p.months % 12;
                const horizon = (yrs ? yrs + 'y ' : '') + mos + 'mo';
                creditExtra += '<div style="font-size:11px;margin-top:4px;color:var(--text-muted);">Paid off in <span style="color:var(--teal);font-weight:500;">' + horizon + '</span> (' + p.label + ') \u00b7 ' + fmt(p.interest) + ' interest remaining</div>';
              }
            } else {
              creditExtra += '<div style="font-size:11px;margin-top:4px;color:var(--text-muted);">Set APR + payment to see the payoff projection</div>';
            }
          }
          return '<div class="acct-card">' +
            '<div class="acct-inst">' + esc(a.institution_name || 'Unknown') + '</div>' +
            '<div class="acct-name">' + esc(a.name) + (a.mask ? ' <span class="acct-mask">\u2022\u2022\u2022\u2022 ' + esc(a.mask) + '</span>' : '') + '</div>' +
            '<div class="acct-balance ' + balClass + '">' + balDisplay + '</div>' +
            '<div class="acct-type">' + esc(a.subtype || a.type || '') + '</div>' +
            creditExtra +
            ((a.is_manual || a.provider === 'manual') ? '<button class="btn-sm" data-edit-balance="' + a.id + '" style="margin-top:4px;font-size:10px;padding:3px 8px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--warm);cursor:pointer;font-family:inherit;">Update Balance</button>' : '') +
            (a.is_shared ? '<div style="margin-top:6px;font-size:10px;color:var(--teal);">Shared \u2022 Your split: ' + (a.spending_split_pct || 100) + '%</div>' : '') +
            '<button data-shared-toggle="' + a.id + '" style="margin-top:4px;font-size:10px;padding:3px 8px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text-muted);cursor:pointer;font-family:inherit;">' + (a.is_shared ? 'Edit Split' : 'Mark Shared') + '</button>' +
          '</div>';
        }

        // Group accounts: Cash (depository, non-investment), Credit, Investments,
        // Other. is_investment comes from the new SQL fragment in the API
        // response so Teller-linked brokerage/IRA/401k accounts surface under
        // their own header instead of mixed in with checking/savings.
        const cashAccts = accounts.filter(a => !a.is_investment && a.type === 'depository');
        const creditAccts = accounts.filter(a => a.type === 'credit');
        const loanAccts = accounts.filter(a => a.type === 'loan');
        const investmentAccts = accounts.filter(a => a.is_investment);
        const otherAccts = accounts.filter(a => !a.is_investment && a.type !== 'depository' && a.type !== 'credit' && a.type !== 'loan');

        const groupHeader = (label, count) =>
          '<div style="grid-column:1/-1;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin:8px 0 4px;padding-top:8px;border-top:1px solid var(--border);">' +
          label + ' <span style="color:var(--text-secondary);font-weight:400;">(' + count + ')</span></div>';

        let html = '';
        if (cashAccts.length) {
          html += groupHeader('Cash', cashAccts.length);
          html += cashAccts.map(renderAcctCard).join('');
        }
        if (creditAccts.length) {
          html += groupHeader('Credit', creditAccts.length);
          html += creditAccts.map(renderAcctCard).join('');
        }
        if (loanAccts.length) {
          html += groupHeader('Loans', loanAccts.length);
          html += loanAccts.map(renderAcctCard).join('');
        }
        if (investmentAccts.length || investments.length) {
          html += groupHeader('Investments', investmentAccts.length + investments.length);
          html += investmentAccts.map(renderAcctCard).join('');
          // Manual + Plaid investments live in the investment_accounts table
          // (not linked_accounts) so they need their own simpler card render.
          html += investments.map(inv => {
            const bal = parseFloat(inv.balance);
            netBalance += bal;
            const balClass = bal > 0 ? 'positive' : bal < 0 ? 'negative' : 'neutral';
            return '<div class="acct-card">' +
              '<div class="acct-inst">' + esc(inv.institution || 'Investment') + '</div>' +
              '<div class="acct-name">' + esc(inv.name) + '</div>' +
              '<div class="acct-balance ' + balClass + '">' + fmt(bal) + '</div>' +
              '<div class="acct-type">' + esc(inv.account_type) + '</div>' +
            '</div>';
          }).join('');
        }
        if (otherAccts.length) {
          html += groupHeader('Other', otherAccts.length);
          html += otherAccts.map(renderAcctCard).join('');
        }

        grid.innerHTML = html;

        if (hasBalances) {
          animateCurrency(document.getElementById('net-balance'), netBalance);
        } else {
          document.getElementById('net-balance').textContent = '\u2014';
        }
        if (hasBalances) {
          document.getElementById('net-balance').className = 'value ' + (netBalance >= 0 ? 'green' : 'red');
        }
      } catch (e) {
        document.getElementById('accounts-grid').innerHTML = '<div class="empty-msg">Could not load accounts: ' + esc(e.message) + '</div>';
      }
    }

    async function editManualBalance(id) {
      var val = prompt('Enter current balance:');
      if (val === null) return;
      var num = parseFloat(val);
      if (isNaN(num)) return;
      try {
        await apiFetch('/api/accounts/' + id + '/balance', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ current_balance: num, available_balance: num }) });
        loadAccounts();
      } catch (e) {}
    }

    async function loadSpendingSummary() {
      try {
        const res = await apiFetch('/api/spending-summary?months=6');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();

        const monthBody = document.getElementById('monthly-body');
        if (data.monthly_trend.length) {
          monthBody.innerHTML = data.monthly_trend.map(m =>
            '<tr><td class="cell-primary">' + fmtMonth(m.month) + '</td>' +
            '<td class="amount warm" data-label="Total">' + fmt(m.total_spend) + '</td>' +
            '<td data-label="Txns">' + m.txn_count + '</td>' +
            '<td class="amount" data-label="Avg">' + fmt(m.avg_transaction) + '</td></tr>'
          ).join('');

          const totalSpend = data.monthly_trend.reduce((s, m) => s + parseFloat(m.total_spend), 0);
          const avgMonthly = totalSpend / data.monthly_trend.length;
          animateCurrency(document.getElementById('avg-monthly'), avgMonthly);
          document.getElementById('avg-monthly-sub').textContent = data.monthly_trend.length + '-month avg';

          const totalDays = data.monthly_trend.length * 30;
          animateCurrency(document.getElementById('avg-daily'), totalSpend / totalDays);
        } else {
          monthBody.innerHTML = '<tr><td colspan="4" class="empty-msg">No spending data yet.</td></tr>';
        }

        const catBody = document.getElementById('category-body');
        function renderCategoryRows(rows) {
          if (!rows.length) {
            catBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No category data yet.</td></tr>';
            return;
          }
          const maxCat = parseFloat(rows[0].total);
          catBody.innerHTML = rows.map((c, i) => {
            const pct = maxCat > 0 ? Math.round((parseFloat(c.total) / maxCat) * 100) : 0;
            const color = barColors[i % barColors.length];
            return '<tr><td class="cell-primary">' + esc(c.category) + '</td>' +
              '<td class="amount warm" data-label="Total">' + fmt(c.total) + '</td>' +
              '<td data-label="Share"><div class="bar-container"><div class="bar-fill" style="width:' + pct + '%;background:' + color + '"></div></div></td></tr>';
          }).join('');
        }
        renderCategoryRows(data.by_category);
        // Per-month category breakdown: default option = the N-month aggregate
        // already in this response; picking a month fetches
        // /api/spending-categories (same splits/reimbursed/share-adjusted
        // helper the budgets use, so the numbers match everywhere).
        const catSel = document.getElementById('cat-month-select');
        if (catSel && !catSel.dataset.wired) {
          catSel.dataset.wired = '1';
          (data.monthly_trend || []).forEach(function(m) {
            const opt = document.createElement('option');
            opt.value = m.month; opt.textContent = m.month;
            catSel.appendChild(opt);
          });
          catSel.addEventListener('change', async function() {
            if (!catSel.value) { renderCategoryRows(data.by_category); return; }
            catBody.innerHTML = '<tr><td colspan="3" class="empty-msg">Loading...</td></tr>';
            try {
              const r = await apiFetch('/api/spending-categories?month=' + encodeURIComponent(catSel.value));
              if (!r.ok) throw new Error('HTTP ' + r.status);
              const dm = await r.json();
              renderCategoryRows((dm.categories || []).map(function(c) {
                return { category: c.category, total: c.spent };
              }));
            } catch (e) {
              catBody.innerHTML = '<tr><td colspan="3" class="empty-msg">Could not load that month.</td></tr>';
            }
          });
        }

        const merchBody = document.getElementById('merchant-body');
        if (data.top_merchants.length) {
          merchBody.innerHTML = data.top_merchants.map(m =>
            '<tr><td class="cell-primary">' + esc(m.merchant) + '</td>' +
            '<td class="amount warm" data-label="Total">' + fmt(m.total_spent) + '</td>' +
            '<td data-label="Txns">' + m.txn_count + '</td></tr>'
          ).join('');
        } else {
          merchBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No merchant data yet.</td></tr>';
        }

        const upBody = document.getElementById('upcoming-body');
        if (data.upcoming_subscriptions.length) {
          upBody.innerHTML = data.upcoming_subscriptions.map(s =>
            '<tr><td class="cell-primary">' + esc(s.display_name) + '</td>' +
            '<td class="amount teal" data-label="Amount">' + fmt(s.amount) + '</td>' +
            '<td data-label="Next">' + fmtDate(s.next_expected) + '</td></tr>'
          ).join('');

          const subsMonthly = data.upcoming_subscriptions.reduce((s, sub) => s + parseFloat(sub.monthly_cost || 0), 0);
          animateCurrency(document.getElementById('subs-monthly'), subsMonthly);
          animateInt(document.getElementById('active-subs'), data.upcoming_subscriptions.length);
        } else {
          upBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No upcoming charges.</td></tr>';
        }
        // Recent Transactions moved to the Activity (Transactions) page,
        // which auto-loads the latest transactions in a compact list.

      } catch (e) {
        showMsg('Could not load spending data: ' + e.message, false);
      }
    }

    async function syncTransactions() {
