        var pctTxt = (data.total_return_pct === null || data.total_return_pct === undefined) ? '' :
          ' (' + sign + data.total_return_pct.toFixed(2) + '%)';
        retEl.style.color = color;
        retEl.textContent = '$' + sign + data.total_return.toFixed(2) + pctTxt +
          '  ·  $' + data.total_value.toFixed(2) + ' / $' + data.total_cost_basis.toFixed(2) + ' cost';
        var allocEl = document.getElementById('invperf-allocation');
        allocEl.innerHTML = (data.by_asset_class || []).slice(0, 6).map(function(c) {
          var w = Math.max(1, c.pct_of_portfolio || 0);
          return '<div style="display:flex;align-items:center;gap:8px;">' +
            '<span style="display:inline-block;min-width:80px;text-transform:capitalize;">' + esc(c.security_type) + '</span>' +
            '<span style="display:inline-block;height:8px;background:var(--accent);width:' + w.toFixed(1) + '%;max-width:60%;border-radius:2px;"></span>' +
            '<span style="color:var(--text-muted);">' + w.toFixed(1) + '%</span>' +
