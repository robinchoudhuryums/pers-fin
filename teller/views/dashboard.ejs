    // Render a tiny inline SVG sparkline from a series of numbers. Returns
    // an HTML string. No Chart.js dependency — keeps this widget cheap.
    function renderSparkline(values, width, height) {
      if (!values || values.length < 2) return '';
      var w = width || 80, h = height || 20;
      var min = Math.min.apply(null, values);
      var max = Math.max.apply(null, values);
      var range = max - min || 1;
      var step = w / (values.length - 1);
      var points = values.map(function(v, i) {
        var x = (i * step).toFixed(1);
        var y = (h - ((v - min) / range) * h).toFixed(1);
        return x + ',' + y;
      }).join(' ');
      var trend = values[values.length - 1] >= values[0] ? 'var(--green)' : 'var(--red)';
      return '<svg width="' + w + '" height="' + h + '" style="display:block;margin-top:4px;">' +
        '<polyline points="' + points + '" fill="none" stroke="' + trend + '" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }

    async function loadInvestments() {
      try {
        var res = await apiFetch('/api/investments');
        if (!res.ok) return;
        var data = await res.json();
        if (!data.accounts || data.accounts.length === 0) {
          // Hide the entire section if no investment accounts exist
          var sec = document.getElementById('investments-section');
          if (sec) sec.style.display = 'none';
          return;
        }
        document.getElementById('investments-total').textContent = fmt(data.total_value);
        // Per-source totals
        var bySrc = data.by_source || {};
        var srcEl = document.getElementById('investments-by-source');
        var srcParts = [];
        if (bySrc.teller > 0) srcParts.push('<span>Teller: <strong style="color:var(--text);">' + fmt(bySrc.teller) + '</strong></span>');
        if (bySrc.plaid > 0) srcParts.push('<span>Plaid: <strong style="color:var(--text);">' + fmt(bySrc.plaid) + '</strong></span>');
        if (bySrc.manual > 0) srcParts.push('<span>Manual: <strong style="color:var(--text);">' + fmt(bySrc.manual) + '</strong></span>');
        srcEl.innerHTML = srcParts.join('');

        // Per-account list (initial render — sparklines fetch lazily below)
        var listEl = document.getElementById('investments-list');
        listEl.innerHTML = data.accounts.map(function(a) {
          var sparkId = 'spark-' + a.source + '-' + a.id;
          var holdingsBadge = a.supports_holdings
            ? '<span style="font-size:9px;padding:1px 5px;border-radius:3px;background:var(--green-bg);color:var(--green);margin-left:4px;">holdings</span>'
            : '';
          // History pages exist for both linked and investment sources;
          // 'manual' rows live in investment_accounts, so source=investment.
          var histSource = a.source === 'teller' ? 'linked' : 'investment';
          var histHref = (window.BASE_PATH || '') + '/accounts/' + a.id + '/history?source=' + histSource;
          return '<div class="acct-card" style="padding:10px;">' +
            '<div class="acct-inst" style="font-size:10px;">' + esc(a.institution || a.source) + holdingsBadge + '</div>' +
            '<div class="acct-name" style="font-size:13px;">' + esc(a.name) + '</div>' +
            '<div class="acct-balance positive" style="font-size:18px;">' + fmt(a.balance) + '</div>' +
            '<div class="acct-type" style="font-size:10px;">' + esc(a.account_type || '') + '</div>' +
            '<div id="' + sparkId + '" style="height:20px;"></div>' +
            '<a href="' + histHref + '" style="display:block;margin-top:6px;font-size:10px;color:var(--teal);text-decoration:none;">View history &rarr;</a>' +
          '</div>';
        }).join('');

        // Lazy-load sparklines per account from balance-history endpoint.
        // Cap concurrency loosely by serializing — investment accounts are
        // typically <10 per user so this is fine without a queue.
        for (var i = 0; i < data.accounts.length; i++) {
          (function(a) {
            var url = '/api/accounts/' + a.id + '/balance-history?source=' + a.source + '&months=6';
            apiFetch(url).then(function(r) {
              if (!r.ok) return;
              return r.json();
            }).then(function(hist) {
              if (!hist || !hist.snapshots || hist.snapshots.length < 2) return;
              var values = hist.snapshots.map(function(s) { return s.balance; });
              var el = document.getElementById('spark-' + a.source + '-' + a.id);
              if (el) el.innerHTML = renderSparkline(values, 200, 20);
            }).catch(function() {});
          })(data.accounts[i]);
        }
      } catch (e) { /* non-critical */ }
    }

    // Categorization engagement loop — surfaces transactions that would
    // otherwise go to AI on the next /api/categorize call. User can review
    // 5-10 at a time, set a category, and optionally create a rule so the
    // same merchant pattern auto-categorizes next time. Drives down AI cost
    // over time as the rule base grows.
    var REVIEW_CATEGORIES = [
      "Food & Drink", "Groceries", "Transportation", "Gas & Fuel",
      "Shopping", "Entertainment", "Health & Fitness", "Healthcare",
      "Housing", "Utilities", "Insurance", "Education",
      "Travel", "Personal Care", "Gifts & Donations", "Fees & Charges",
      "Transfer", "Income", "Investment", "Subscription", "Other",
    ];
