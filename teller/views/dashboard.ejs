        document.getElementById('qab-day').value = '';
        document.getElementById('qab-cadence').value = 'monthly';
        document.getElementById('qab-category').value = 'utility';
        document.getElementById('qab-status').textContent = '';
        document.getElementById('qab-status').style.color = '';
        modal.style.display = 'block';
        // Autofocus on first field after the modal becomes visible. setTimeout
        // because mobile Safari occasionally drops focus when display flips
        // from none → block in the same tick.
        setTimeout(function() { document.getElementById('qab-name').focus(); }, 50);
      }
      function closeModal() { modal.style.display = 'none'; }
      function showStatus(msg, ok) {
        var el = document.getElementById('qab-status');
        el.textContent = msg;
        el.style.color = ok ? 'var(--green)' : 'var(--red)';
      }

      openBtn.addEventListener('click', openModal);
      cancelBtn.addEventListener('click', closeModal);
      // Close when clicking the dim backdrop (not the card itself).
      modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
      // Esc to close.
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display !== 'none') closeModal();
      });

      saveBtn.addEventListener('click', async function() {
        var name = document.getElementById('qab-name').value.trim();
        var amount = parseFloat(document.getElementById('qab-amount').value);
        var dueDay = parseInt(document.getElementById('qab-day').value, 10);
        var cadence = document.getElementById('qab-cadence').value;
        var category = document.getElementById('qab-category').value;
        if (!name) { showStatus('Bill name is required.', false); return; }
        if (!isFinite(amount) || amount <= 0) { showStatus('Amount must be > 0.', false); return; }
        if (!isFinite(dueDay) || dueDay < 1 || dueDay > 31) { showStatus('Due day must be 1-31.', false); return; }
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving…';
        try {
          var res = await apiFetch('/api/manual-bills', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, amount: amount, due_day: dueDay, cadence: cadence, category: category }),
          });
          if (!res.ok) {
            var err = await res.json().catch(function() { return {}; });
            throw new Error(err.error || ('HTTP ' + res.status));
          }
          showStatus('Saved. Refreshing…', true);
          // Fire-and-forget Sheets sync so the new manual_bills row lands
          // in the Utilities tab right away instead of waiting for the next
          // scheduled sync. Endpoint returns 400/501 gracefully when Sheets
          // isn't configured, so the .catch swallow is safe.
          apiFetch('/api/sheets/sync', { method: 'POST' }).catch(function() {});
          setTimeout(function() {
            closeModal();
            location.reload();
          }, 600);
        } catch (e) {
          showStatus('Failed: ' + (e.message || e), false);
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Bill';
        }
      });
    })();

    // Sync-degradation strip — fetch /api/data-health and surface warning-level
    // issues at the top of the dashboard. Dismissible per-session (sessionStorage),
    // so it re-appears on the next visit if the issue persists (i.e. the operator
    // can't permanently silence a real degradation).
    (function wireSyncHealthStrip() {
      var strip = document.getElementById('sync-health-strip');
      if (!strip) return;
      var list = document.getElementById('sync-health-strip-list');
      var dismiss = document.getElementById('sync-health-strip-dismiss');
      if (dismiss) dismiss.addEventListener('click', function () {
        strip.style.display = 'none';
        try { sessionStorage.setItem('perfin_synchealth_dismissed', '1'); } catch (e) {}
      });
      (async function () {
        try {
          var res = await apiFetch('/api/data-health');
          if (!res.ok) return;
          var h = await res.json();
          var warnings = (h.issues || []).filter(function (i) { return i.severity === 'warning'; });
          if (!warnings.length) return; // healthy (or info-only) → stay hidden
          try { if (sessionStorage.getItem('perfin_synchealth_dismissed') === '1') return; } catch (e) {}
          var esc = (window.esc) || function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
          list.innerHTML = warnings.slice(0, 3).map(function (i) { return esc(i.message); }).join('<br>') +
            (warnings.length > 3 ? '<br>+' + (warnings.length - 3) + ' more' : '');
          strip.style.display = 'block';
        } catch (e) { /* health probe is best-effort — never block the dashboard */ }
      })();
    })();

    // Dashboard CSV upload modal + Sync-to-Sheets button.
    // The CSV modal POSTs to /api/import-csv (same endpoint the Accounts
    // page uses); the Sheets button POSTs to /api/sheets/sync. Both are
    // fire-and-forget from the user's perspective — status shows in a
    // small inline message.
    (function wireDashboardQuickActions() {
      // ---- CSV upload modal ----
      var csvModal = document.getElementById('dash-csv-modal');
      var csvOpenBtn = document.getElementById('dash-upload-csv-btn');
      var csvCancelBtn = document.getElementById('dash-csv-cancel');
      var csvSubmitBtn = document.getElementById('dash-csv-submit');
      var csvInstitution = document.getElementById('dash-csv-institution');
      var csvCustom = document.getElementById('dash-csv-custom');
      var csvLabel = document.getElementById('dash-csv-label');
      var csvFile = document.getElementById('dash-csv-file');
      var csvStatus = document.getElementById('dash-csv-status');
      var csvPreview = document.getElementById('dash-csv-preview');
      // Two-step flow: 'preview' → dry-run classify, 'confirm' → real import.
      var csvStage = 'preview';
      function closeCsvModal() { if (csvModal) csvModal.style.display = 'none'; }
      function clearPreview() {
        csvStage = 'preview';
        if (csvPreview) { csvPreview.style.display = 'none'; csvPreview.innerHTML = ''; }
        if (csvSubmitBtn) csvSubmitBtn.textContent = 'Preview';
      }
      function resetCsv() {
        if (csvFile) csvFile.value = '';
        if (csvLabel) csvLabel.value = '';
        if (csvCustom) { csvCustom.value = ''; csvCustom.style.display = 'none'; }
        if (csvInstitution) csvInstitution.value = 'Chase';
        if (csvStatus) { csvStatus.textContent = ''; csvStatus.style.color = ''; }
        clearPreview();
      }
      // Any change to the inputs invalidates a shown preview (the dedup counts
      // were computed for the prior file/label) — drop back to the preview step.
      [csvFile, csvLabel, csvCustom, csvInstitution].forEach(function (el) {
        if (el) el.addEventListener('change', clearPreview);
      });
      function csvEsc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function csvFormData() {
        var institution = csvInstitution.value === 'Other'
          ? (csvCustom.value.trim() || 'Unknown')
          : csvInstitution.value;
        var label = (csvLabel.value || '').trim() || (institution + ' Account');
        var fd = new FormData();
        fd.append('file', csvFile.files[0]);
        fd.append('institution', institution);
        fd.append('account_label', label);
        return fd;
      }
      function renderPreview(d) {
        var rows = (d.sample || []).map(function (r) {
          var color = r.status === 'duplicate' ? 'var(--text-muted)' : 'var(--text)';
          var badge = r.status === 'duplicate'
            ? '<span style="color:var(--yellow,#d9b25f);">dup</span>'
            : '<span style="color:var(--green,#6fcf97);">new</span>';
          return '<tr style="color:' + color + ';"><td style="padding:2px 6px 2px 0;">' + csvEsc(r.date) +
            '</td><td style="padding:2px 6px;text-align:right;">' + (typeof fmt === 'function' ? fmt(r.amount) : r.amount) +
            '</td><td style="padding:2px 6px;overflow:hidden;text-overflow:ellipsis;max-width:160px;white-space:nowrap;">' + csvEsc(r.merchant) +
            '</td><td style="padding:2px 0 2px 6px;">' + badge + '</td></tr>';
        }).join('');
        csvPreview.innerHTML =
          '<div style="margin-bottom:8px;"><strong>' + csvEsc(d.format_detected) + '</strong> &middot; ' + csvEsc(d.account_label) + '</div>' +
          '<div style="margin-bottom:8px;">' +
            '<span style="color:var(--green,#6fcf97);">' + d.rows_new + ' new</span> &middot; ' +
            '<span style="color:var(--yellow,#d9b25f);">' + d.rows_duplicate + ' already imported</span> &middot; ' +
            '<span style="color:var(--text-muted);">' + d.rows_skipped + ' skipped</span>' +
          '</div>' +
          (d.sample && d.sample.length ? '<table style="width:100%;border-collapse:collapse;font-size:11px;">' + rows + '</table>' : '') +
          (d.rows_new === 0 ? '<div style="margin-top:8px;color:var(--text-muted);">Nothing new to import.</div>' : '');
        csvPreview.style.display = 'block';
      }
      if (csvOpenBtn && csvModal) {
        csvOpenBtn.addEventListener('click', function() {
          resetCsv();
          csvModal.style.display = 'block';
          setTimeout(function() { csvInstitution && csvInstitution.focus(); }, 100);
        });
      }
      if (csvCancelBtn) csvCancelBtn.addEventListener('click', closeCsvModal);
      if (csvModal) csvModal.addEventListener('click', function(e) {
        if (e.target === csvModal) closeCsvModal();
      });
      if (csvInstitution) csvInstitution.addEventListener('change', function() {
        if (csvCustom) csvCustom.style.display = this.value === 'Other' ? 'block' : 'none';
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && csvModal && csvModal.style.display === 'block') closeCsvModal();
      });
      async function doPreview() {
        csvSubmitBtn.disabled = true;
        csvSubmitBtn.textContent = 'Previewing…';
        csvStatus.style.color = 'var(--text-muted)';
        csvStatus.textContent = 'Reading file…';
        try {
          var res = await apiFetch('/api/import-csv/preview', { method: 'POST', body: csvFormData() });
          var data = await res.json().catch(function() { return {}; });
          if (res.ok) {
            csvStatus.textContent = '';
            renderPreview(data);
            csvStage = 'confirm';
            csvSubmitBtn.textContent = data.rows_new > 0 ? ('Import ' + data.rows_new + ' new') : 'Nothing to import';
            csvSubmitBtn.disabled = data.rows_new === 0;
          } else {
            csvStatus.style.color = 'var(--red, #eb6b6b)';
            csvStatus.textContent = 'Preview failed: ' + (data.error || ('HTTP ' + res.status));
            csvSubmitBtn.textContent = 'Preview';
          }
        } catch (err) {
          csvStatus.style.color = 'var(--red, #eb6b6b)';
          csvStatus.textContent = 'Preview failed: ' + err.message;
          csvSubmitBtn.textContent = 'Preview';
        } finally {
          if (csvStage !== 'confirm') csvSubmitBtn.disabled = false;
        }
      }
      async function doImport() {
        csvSubmitBtn.disabled = true;
        csvSubmitBtn.textContent = 'Importing…';
        csvStatus.style.color = 'var(--text-muted)';
        csvStatus.textContent = 'Uploading…';
        try {
          var res = await apiFetch('/api/import-csv', { method: 'POST', body: csvFormData() });
          var data = await res.json().catch(function() { return {}; });
          if (res.ok) {
            csvStatus.style.color = 'var(--green, #6fcf97)';
            csvStatus.textContent = 'Imported ' + data.rows_imported + ' transactions (' +
              (data.rows_duplicate || 0) + ' already imported, ' + data.rows_skipped + ' skipped) — ' +
              (data.format_detected || 'unknown format');
            // Fire-and-forget targeted Transactions-tab refresh (faster
            // than a full syncAll which touches all 16 tabs). Endpoint
            // returns 400/501 cleanly if Sheets isn't configured.
            apiFetch('/api/sheets/sync-transactions', { method: 'POST' }).catch(function() {});
            setTimeout(function() { closeCsvModal(); window.location.reload(); }, 2200);
          } else {
            csvStatus.style.color = 'var(--red, #eb6b6b)';
            csvStatus.textContent = 'Import failed: ' + (data.error || ('HTTP ' + res.status));
            csvSubmitBtn.disabled = false;
            csvSubmitBtn.textContent = 'Import';
          }
        } catch (err) {
          csvStatus.style.color = 'var(--red, #eb6b6b)';
          csvStatus.textContent = 'Import failed: ' + err.message;
          csvSubmitBtn.disabled = false;
          csvSubmitBtn.textContent = 'Import';
        }
      }
      if (csvSubmitBtn) csvSubmitBtn.addEventListener('click', function() {
        if (!csvFile || !csvFile.files[0]) {
          csvStatus.textContent = 'Please select a CSV file.';
          csvStatus.style.color = 'var(--red, #eb6b6b)';
          return;
        }
        if (csvStage === 'confirm') doImport(); else doPreview();
      });

      // ---- Sync to Sheets button ----
      // POSTs /api/sheets/sync directly. Returns 400 if Sheets isn't
      // configured (no GOOGLE_SHEETS_ID env var) and 501 if googleapis
      // isn't installed — both surface as inline error.
      var syncBtn = document.getElementById('dash-sync-sheets-btn');
      if (syncBtn) syncBtn.addEventListener('click', async function() {
        var orig = syncBtn.textContent;
        syncBtn.disabled = true;
        syncBtn.textContent = 'Syncing…';
        try {
          var res = await apiFetch('/api/sheets/sync', { method: 'POST' });
          var data = await res.json().catch(function() { return {}; });
          if (res.ok) {
            syncBtn.textContent = 'Synced ✓';
            setTimeout(function() { syncBtn.textContent = orig; syncBtn.disabled = false; }, 2000);
          } else {
            syncBtn.textContent = data.error ? 'Failed' : ('HTTP ' + res.status);
            // Use a status-msg toast if available so the error is readable.
            if (typeof showStatus === 'function') {
              showStatus(data.error || 'Sheets sync failed', false);
            }
            setTimeout(function() { syncBtn.textContent = orig; syncBtn.disabled = false; }, 3000);
          }
        } catch (err) {
          syncBtn.textContent = 'Failed';
          setTimeout(function() { syncBtn.textContent = orig; syncBtn.disabled = false; }, 3000);
        }
      });
    })();

    // Load latest AI insight for the dashboard widget
    (async function loadInsightWidget() {
      var body = document.getElementById('insights-widget-body');
      var meta = document.getElementById('insights-widget-meta');
      var fbWrap = document.getElementById('insights-widget-feedback');
      var fbStatus = document.getElementById('insights-feedback-status');
      if (!body) return;
      try {
        var res = await apiFetch('/api/insights');
        if (!res.ok) { body.textContent = 'No insights yet \u2014 generate from Settings.'; return; }
        var data = await res.json();
        if (!data.length) { body.textContent = 'No insights yet \u2014 generate from Settings.'; return; }
        var latest = data[0];
        var text = esc(latest.insight_text || '');
        text = text
          .replace(/^#{3}\s*(.+)$/gm, '<h4 style="margin:12px 0 6px;font-size:14px;font-weight:600;color:var(--text-primary);">$1</h4>')
          .replace(/^#{2}\s*(.+)$/gm, '<h3 style="margin:12px 0 6px;font-size:15px;font-weight:600;color:var(--text-primary);">$1</h3>')
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
          .replace(/^[\-\*] (.+)$/gm, '<li>$1</li>')
          .replace(/(<li>.*<\/li>)/gs, '<ul style="margin:4px 0 8px 16px;padding:0;">$1</ul>')
          .replace(/\n/g, '<br>');
        body.innerHTML = text;
        if (latest.created_at) {
          var d = new Date(latest.created_at);
          meta.textContent = '\u2014 ' + d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }

        // S1: feedback panel. Pre-fills if the user already rated this insight.
        if (fbWrap) {
          fbWrap.style.display = 'block';
          fbWrap.dataset.insightId = latest.id;
          var current = latest.user_feedback || '';
          fbWrap.querySelectorAll('button[data-fb]').forEach(function(b) {
            b.style.opacity = (b.dataset.fb === current) ? '1' : '0.55';
            b.style.outline = (b.dataset.fb === current) ? '2px solid var(--accent)' : 'none';
          });
          var noteField = document.getElementById('insights-feedback-note');
          if (noteField) noteField.value = latest.user_feedback_text || '';
          if (fbStatus && current) fbStatus.textContent = 'Marked ' + current;
        }
      } catch (e) { body.textContent = 'Unable to load insights.'; }
    })();

    // S1: wire feedback buttons. Each click PATCHes the insight, refreshes
    // the highlighted state, and (for negative/mixed) reveals the note
    // textarea. Clicking the currently-active button clears feedback.
    (function wireInsightFeedback() {
      var fbWrap = document.getElementById('insights-widget-feedback');
      var noteWrap = document.getElementById('insights-feedback-note-wrap');
      var noteToggle = document.getElementById('insights-feedback-note-toggle');
      var noteField = document.getElementById('insights-feedback-note');
      var noteSave = document.getElementById('insights-feedback-note-save');
      var status = document.getElementById('insights-feedback-status');
      if (!fbWrap) return;
      async function send(feedback, text) {
        var id = fbWrap.dataset.insightId;
        if (!id) return;
        try {
          var res = await apiFetch('/api/insights/' + id + '/feedback', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ feedback: feedback, text: text || null }),
          });
          if (!res.ok) { if (status) status.textContent = 'Failed to save'; return; }
          var body = await res.json();
          fbWrap.querySelectorAll('button[data-fb]').forEach(function(b) {
            b.style.opacity = (b.dataset.fb === body.user_feedback) ? '1' : '0.55';
            b.style.outline = (b.dataset.fb === body.user_feedback) ? '2px solid var(--accent)' : 'none';
          });
          if (status) status.textContent = body.user_feedback ? 'Marked ' + body.user_feedback : 'Cleared';
        } catch (e) { if (status) status.textContent = 'Failed to save'; }
      }
      fbWrap.querySelectorAll('button[data-fb]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          // Click currently active = clear; otherwise set to clicked value.
          var current = fbWrap.querySelector('button[data-fb][style*="2px solid"]');
          var newVal = (current && current.dataset.fb === btn.dataset.fb) ? null : btn.dataset.fb;
          if (newVal === 'negative' || newVal === 'mixed') {
            noteWrap.style.display = 'block';
          }
          send(newVal, noteField ? noteField.value : null);
        });
      });
      if (noteToggle) noteToggle.addEventListener('click', function(e) {
        e.preventDefault();
        noteWrap.style.display = noteWrap.style.display === 'none' ? 'block' : 'none';
      });
      if (noteSave) noteSave.addEventListener('click', function() {
        var current = fbWrap.querySelector('button[data-fb][style*="2px solid"]');
        var val = current ? current.dataset.fb : 'mixed';
        send(val, noteField.value);
      });
    })();

    // Credit Score widget — loads history, shows current + trend, log form
    (function wireCreditScore() {
      var currentEl = document.getElementById('credit-score-current');
      var trendEl = document.getElementById('credit-score-trend');
      var historyEl = document.getElementById('credit-score-history');
      var logBtn = document.getElementById('cs-log-btn');
      var scoreInput = document.getElementById('cs-score-input');
      var typeInput = document.getElementById('cs-type-input');
      var sourceInput = document.getElementById('cs-source-input');
      var status = document.getElementById('cs-status');
      if (!logBtn) return;

      function scoreColor(s) {
        if (s >= 740) return 'var(--green, #6fcf97)';
        if (s >= 670) return 'var(--teal, #5a8f8f)';
        if (s >= 580) return 'var(--yellow, #f0c36d)';
        return 'var(--red, #eb6b6b)';
      }

      async function load() {
        try {
          var res = await apiFetch('/api/credit-scores?limit=12');
          if (!res.ok) return;
          var data = await res.json();
          if (!data.scores || !data.scores.length) {
            if (currentEl) currentEl.textContent = '';
            if (trendEl) trendEl.textContent = 'No scores logged yet — enter your score below.';
            if (historyEl) historyEl.textContent = '';
            return;
          }
          var latest = data.scores[0];
          if (currentEl) {
            currentEl.textContent = latest.score;
            currentEl.style.color = scoreColor(latest.score);
          }
          if (trendEl && data.trend) {
            var t = data.trend;
            var parts = [];
            if (t.delta_vs_prior !== null && t.delta_vs_prior !== undefined) {
              var sign = t.delta_vs_prior >= 0 ? '+' : '';
              var col = t.delta_vs_prior >= 0 ? 'var(--green)' : 'var(--red)';
              parts.push('<span style="color:' + col + ';">' + sign + t.delta_vs_prior + ' vs prior</span>');
            }
            if (t.delta_vs_6mo !== null) {
              var sign6 = t.delta_vs_6mo >= 0 ? '+' : '';
              var col6 = t.delta_vs_6mo >= 0 ? 'var(--green)' : 'var(--red)';
              parts.push('<span style="color:' + col6 + ';">' + sign6 + t.delta_vs_6mo + ' vs 6mo ago</span>');
            }
            trendEl.innerHTML = parts.length ? parts.join(' · ') : '';
          }
          if (historyEl && data.scores.length > 1) {
            historyEl.innerHTML = '<details><summary style="cursor:pointer;font-size:11px;">History (' + data.scores.length + ' entries)</summary>' +
              '<div style="margin-top:6px;display:flex;flex-direction:column;gap:2px;">' +
              data.scores.map(function(s) {
                return '<div style="display:flex;justify-content:space-between;gap:12px;">' +
                  '<span>' + new Date(s.checked_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + '</span>' +
                  '<span style="font-weight:500;color:' + scoreColor(s.score) + ';">' + s.score + '</span>' +
                  '<span style="color:var(--text-muted);">' + esc(s.source || s.score_type) + '</span>' +
                '</div>';
              }).join('') +
              '</div></details>';
          }
        } catch (e) { /* silently hide */ }
      }

      logBtn.addEventListener('click', async function() {
        var s = parseInt(scoreInput.value, 10);
        if (!s || s < 300 || s > 850) {
          if (status) { status.textContent = 'Score must be 300-850'; status.style.color = 'var(--red)'; }
          return;
        }
        logBtn.disabled = true;
        if (status) { status.textContent = 'Saving…'; status.style.color = 'var(--text-muted)'; }
        try {
          var res = await apiFetch('/api/credit-scores', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              score: s,
              score_type: typeInput.value,
              source: (sourceInput.value || '').trim() || null,
            }),
          });
          if (!res.ok) {
            var err = await res.json().catch(function() { return {}; });
            if (status) { status.textContent = err.error || 'Failed'; status.style.color = 'var(--red)'; }
          } else {
            scoreInput.value = '';
            sourceInput.value = '';
            if (status) { status.textContent = 'Logged ✓'; status.style.color = 'var(--green)'; }
            load();
            setTimeout(function() { if (status) status.textContent = ''; }, 2000);
          }
        } catch (e) {
          if (status) { status.textContent = 'Failed'; status.style.color = 'var(--red)'; }
        } finally {
          logBtn.disabled = false;
        }
      });

      load();
    })();

    // S4: Investment performance widget — auto-hides when no Plaid holdings
    (async function loadInvestmentPerformance() {
      var box = document.getElementById('investments-performance');
      if (!box) return;
      try {
        var res = await apiFetch('/api/investments/performance');
        if (!res.ok) return;
