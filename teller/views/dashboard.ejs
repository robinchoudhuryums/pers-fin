    // --- Budget Velocity Alerts ---
    async function loadBudgetAlerts() {
      try {
        var res = await apiFetch('/api/budgets/alerts');
        if (!res.ok) return;
        var data = await res.json();
        if (!data.alerts || data.alerts.length === 0) return;
        var section = document.getElementById('budget-alerts-section');
        section.style.display = 'block';
        document.getElementById('budget-alerts-list').innerHTML = data.alerts.map(function(a) {
          var bgColor, borderColor, textColor;
          if (a.severity === 'critical') { bgColor = 'var(--red-bg)'; borderColor = 'rgba(235,107,107,0.2)'; textColor = 'var(--red)'; }
          else if (a.severity === 'warning') { bgColor = 'var(--yellow-bg)'; borderColor = 'rgba(240,195,109,0.2)'; textColor = 'var(--yellow)'; }
          else { bgColor = 'var(--surface)'; borderColor = 'var(--border)'; textColor = 'var(--text-muted)'; }
          var extra = '';
          if (a.daily_budget_remaining) extra = ' ($' + a.daily_budget_remaining.toFixed(2) + '/day remaining)';
          if (a.projected_total) extra = ' (projected: ' + fmt(a.projected_total) + ')';
          return '<div style="padding:10px 14px;background:' + bgColor + ';border:1px solid ' + borderColor +
            ';border-radius:var(--radius);margin-bottom:6px;font-size:12px;color:' + textColor + ';font-weight:400;">' +
            esc(a.message) + extra + '</div>';
        }).join('');
      } catch (e) { /* non-critical */ }
    }

    // --- Savings Rate ---
    async function loadSavingsRate() {
      try {
        var res = await apiFetch('/api/savings-rate?months=3');
        if (!res.ok) return;
        var data = await res.json();
        if (!data.months || data.months.length === 0) return;
        var section = document.getElementById('savings-rate-section');
        section.style.display = 'block';
        var avg = data.averages;
        var rateColor = avg.savings_rate >= 20 ? 'var(--green)' : avg.savings_rate >= 10 ? 'var(--yellow)' : avg.savings_rate > 0 ? 'var(--warm)' : 'var(--red)';
        var html = '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:12px;">';
        html += '<div class="card" style="min-width:0;overflow:hidden;"><div class="label">Avg Income</div><div class="value green" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + fmt(avg.income) + '</div></div>';
