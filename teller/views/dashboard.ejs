            html += '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + fmt(c.current) + '</td>';
            html += '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + fmt(c.previous) + '</td>';
            html += '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:' + cc + ';">' + (c.change > 0 ? '+' : '') + fmt(c.change) + '</td></tr>';
