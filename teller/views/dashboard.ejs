    // Mirrors services/projections.js computeLoanPayoff (the browser can't
    // require the services layer) — iterative amortization at APR/12, exact
    // partial final payment. Pinned against the canonical by tests.
    function loanPayoff(balance, aprPct, payment) {
      const r = (aprPct || 0) / 100 / 12;
      if (r > 0 && payment <= balance * r) return { insufficient: true };
      let b = balance, interest = 0;
      for (let m = 1; m <= 1200; m++) {
        const i = b * r;
        interest += i;
        b = b + i - payment;
        if (b <= 0) {
          const d = new Date();
          d.setMonth(d.getMonth() + m);
          // F12: format in UTC so the displayed month matches the API's
          // payoff_date (computeLoanPayoff uses toISOString → UTC 'YYYY-MM');
          // otherwise near a month boundary the label could show a different
          // month than the API in a non-UTC timezone.
          return { months: m, interest: interest, label: d.toLocaleDateString(undefined, { timeZone: 'UTC', month: 'short', year: 'numeric' }) };
        }
      }
      return {};
    }

