<%- include('partials/head', { title: 'Dashboard', extraStyles: `
    .container { max-width: 1060px; }
    .top-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
                 gap: 16px; margin-bottom: 36px; }
    .accounts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
                     gap: 12px; margin-bottom: 28px; animation: fadeInUp 0.4s ease both; animation-delay: 0.25s; }
    .acct-card { padding: 18px; border-radius: var(--radius); background: var(--surface);
                 border: 1px solid var(--border); transition: all 0.2s; }
    .acct-card:hover { border-color: var(--border-hover); }
    .acct-card .acct-inst { font-size: 10px; color: var(--text-muted); text-transform: uppercase;
                            letter-spacing: 1px; font-weight: 500; }
    .acct-card .acct-name { font-size: 14px; font-weight: 400; margin-top: 4px; }
    .acct-card .acct-mask { color: var(--text-muted); font-weight: 300; }
    .acct-card .acct-balance { font-size: 22px; font-weight: 300; margin-top: 10px;
                               font-variant-numeric: tabular-nums; }
    .acct-card .acct-balance.positive { color: var(--green); }
    .acct-card .acct-balance.negative { color: var(--red); }
    .acct-card .acct-balance.neutral { color: var(--warm-glow); }
    .acct-card .acct-type { font-size: 10px; color: var(--text-muted); margin-top: 4px;
                            text-transform: uppercase; letter-spacing: 0.5px; font-weight: 400; }
    .bar-container { width: 100%; height: 6px; background: rgba(255,255,255,0.06);
                     border-radius: 3px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 3px; transition: width 0.5s ease; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
    @media (max-width: 768px) { .two-col { grid-template-columns: 1fr; } }
    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 28px;
                   animation: fadeInUp 0.4s ease both; animation-delay: 0.15s; }
    .chart-card { padding: 20px; border-radius: var(--radius); background: var(--surface);
                  border: 1px solid var(--border); backdrop-filter: blur(12px); }
    .chart-card h3 { font-size: 10px; font-weight: 500; color: var(--text-muted); text-transform: uppercase;
                     letter-spacing: 1.5px; margin-bottom: 16px; }
    .chart-card canvas { width: 100% !important; display: block; }
    .chart-wrap { position: relative; width: 100%; height: 240px; }
    @media (max-width: 640px) {
      .charts-grid { grid-template-columns: 1fr; }
      .two-col { grid-template-columns: 1fr; }
      .accounts-grid { grid-template-columns: 1fr; }
      .chart-wrap { height: 220px; }
    }

    /* ── Financial Wellness Pyramid — Neon Wireframe ──────────── */
    .wellness-section {
      display: flex; flex-direction: column; align-items: center;
      margin-bottom: 44px; animation: fadeInUp 0.6s ease both; animation-delay: 0.08s;
    }
    .wellness-section h3 {
      font-size: 10px; font-weight: 500; color: var(--text-muted); text-transform: uppercase;
      letter-spacing: 2px; margin-bottom: 8px;
    }
    .pyramid-stage {
      position: relative; width: 280px; height: 320px;
      display: flex; align-items: center; justify-content: center;
    }
    .pyramid-scene {
      perspective: 600px; width: 160px; height: 200px;
      position: relative;
    }
    .pyramid-3d {
      width: 160px; height: 200px; position: relative;
      transform-style: preserve-3d;
      transform: rotateX(-20deg) rotateY(45deg);
      animation: pyramidSpin 20s linear infinite;
    }
    @keyframes pyramidSpin {
      from { transform: rotateX(-20deg) rotateY(45deg); }
      to   { transform: rotateX(-20deg) rotateY(405deg); }
    }

    /* Neon wireframe faces — transparent with glowing edges */
    .pyramid-face {
      position: absolute; width: 160px; height: 186px;
      clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
      transform-origin: 50% 100%; bottom: 0; left: 0;
      background: transparent;
      transition: all 1.5s ease;
    }
    /* Inner edge glow via layered borders using box-shadow on a nested element */
    .pyramid-face::before {
      content: ''; position: absolute; inset: 0;
      clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
      background: linear-gradient(to top, rgba(90,143,143,0.06) 0%, transparent 60%);
      transition: background 1.5s ease;
    }
    /* Edge lines via SVG-like border effect */
    .pyramid-face::after {
      content: ''; position: absolute; inset: 0;
      clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
      background:
        linear-gradient(to bottom right, rgba(90,143,143,0.8) 0%, transparent 2%),
        linear-gradient(to bottom left, rgba(90,143,143,0.8) 0%, transparent 2%),
        linear-gradient(to top, rgba(90,143,143,0.6) 0%, transparent 2%);
      filter: blur(0.5px);
      transition: filter 1.5s, background 1.5s;
      animation: edgePulse 3s ease-in-out infinite;
    }
    @keyframes edgePulse {
      0%, 100% { opacity: 0.7; }
      50%      { opacity: 1; }
    }

    .pyramid-face.f-front  { transform: translateZ(80px) rotateX(25deg); }
    .pyramid-face.f-right  { transform: rotateY(90deg) translateZ(80px) rotateX(25deg); }
    .pyramid-face.f-back   { transform: rotateY(180deg) translateZ(80px) rotateX(25deg); }
    .pyramid-face.f-left   { transform: rotateY(270deg) translateZ(80px) rotateX(25deg); }

    /* Scanline sweep — horizontal line that moves upward */
    .pyramid-face .scanline {
      position: absolute; bottom: 0; left: 0; width: 100%; height: 2px;
      background: linear-gradient(90deg, transparent 0%, rgba(90,143,143,0.9) 30%, rgba(127,181,230,0.9) 50%, rgba(90,143,143,0.9) 70%, transparent 100%);
      filter: blur(1px); opacity: 0;
      animation: scanSweep 4s ease-in-out infinite;
      clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
    }
    @keyframes scanSweep {
      0%   { bottom: 0%; opacity: 0; }
      10%  { opacity: 0.9; }
      90%  { opacity: 0.5; }
      100% { bottom: 95%; opacity: 0; }
    }

    /* Neon wireframe base */
    .pyramid-base {
      position: absolute; width: 160px; height: 160px; bottom: 0; left: 0;
      transform-style: preserve-3d;
      transform: rotateX(-90deg) translateZ(0px);
      background: transparent;
      border: 1px solid rgba(90,143,143,0.4);
      box-shadow: inset 0 0 20px rgba(90,143,143,0.08), 0 0 8px rgba(90,143,143,0.15);
      animation: basePulse 3s ease-in-out infinite;
    }
    /* Base grid lines */
    .pyramid-base::before {
      content: ''; position: absolute; inset: 0;
      background:
        linear-gradient(90deg, rgba(90,143,143,0.12) 1px, transparent 1px),
        linear-gradient(0deg, rgba(90,143,143,0.12) 1px, transparent 1px);
      background-size: 40px 40px;
    }
    @keyframes basePulse {
      0%, 100% { border-color: rgba(90,143,143,0.3); box-shadow: inset 0 0 20px rgba(90,143,143,0.05), 0 0 8px rgba(90,143,143,0.1); }
      50%      { border-color: rgba(90,143,143,0.6); box-shadow: inset 0 0 30px rgba(90,143,143,0.1), 0 0 15px rgba(90,143,143,0.25); }
    }

    /* Holographic flicker overlay */
    .pyramid-holo {
      position: absolute; inset: 0; pointer-events: none;
      animation: holoFlicker 8s ease-in-out infinite;
    }
    @keyframes holoFlicker {
      0%, 100% { opacity: 1; }
      48% { opacity: 1; }
      49% { opacity: 0.7; }
      50% { opacity: 1; }
      77% { opacity: 1; }
      78% { opacity: 0.85; }
      79% { opacity: 1; }
    }

    /* Neon glow underneath */
    .pyramid-glow {
      position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%);
      width: 220px; height: 50px; border-radius: 50%;
      background: radial-gradient(ellipse, rgba(90,143,143,0.5) 0%, rgba(127,181,230,0.2) 30%, transparent 65%);
      filter: blur(16px); animation: glowPulse 3s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes glowPulse {
      0%, 100% { opacity: 0.5; transform: translateX(-50%) scale(1); }
      50%      { opacity: 1; transform: translateX(-50%) scale(1.12); }
    }

    /* Rising orbs — neon style */
    .pyramid-orbs {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none; overflow: hidden;
    }
    .orb {
      position: absolute; border-radius: 50%; opacity: 0;
      animation: orbRise linear infinite;
    }
    .orb.orb-teal {
      background: radial-gradient(circle, rgba(90,143,143,1) 0%, rgba(90,143,143,0.4) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(90,143,143,0.6);
    }
    .orb.orb-blue {
      background: radial-gradient(circle, rgba(127,181,230,1) 0%, rgba(127,181,230,0.4) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(127,181,230,0.6);
    }
    .orb.orb-cyan {
      background: radial-gradient(circle, rgba(100,220,220,1) 0%, rgba(100,220,220,0.3) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(100,220,220,0.5);
    }
    @keyframes orbRise {
      0%   { opacity: 0; transform: translateY(0) scale(0.6); }
      12%  { opacity: 0.9; }
      70%  { opacity: 0.4; }
      100% { opacity: 0; transform: translateY(-280px) scale(0.15); }
    }

    /* Score display */
    .wellness-score {
      font-size: 38px; font-weight: 200; color: var(--teal);
      margin-top: 6px; font-variant-numeric: tabular-nums;
      letter-spacing: -1px; transition: color 0.5s;
      text-shadow: 0 0 20px rgba(90,143,143,0.3);
    }
    .wellness-status {
      font-size: 12px; color: var(--text-muted); font-weight: 300;
      margin-top: 2px; letter-spacing: 0.3px; text-align: center;
      max-width: 220px; transition: color 0.5s;
    }

    /* Tier labels — neon style */
    .pyramid-tiers {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none;
    }
    .tier-label {
      position: absolute; font-size: 9px; font-weight: 500;
      text-transform: uppercase; letter-spacing: 1.2px;
      color: var(--text-muted); white-space: nowrap;
      transition: color 0.5s, opacity 0.5s, text-shadow 0.5s; opacity: 0.4;
    }
    .tier-label.active { opacity: 1; text-shadow: 0 0 8px currentColor; }
    .tier-label.t-base    { bottom: 32px; right: -4px; }
    .tier-label.t-budget  { bottom: 100px; right: -18px; }
    .tier-label.t-subs    { bottom: 164px; right: -10px; }
    .tier-label.t-goals   { bottom: 224px; right: 14px; }

    /* Light theme adjustments */
    [data-theme="light"] .pyramid-face::after {
      background:
        linear-gradient(to bottom right, rgba(61,114,114,0.7) 0%, transparent 2%),
        linear-gradient(to bottom left, rgba(61,114,114,0.7) 0%, transparent 2%),
        linear-gradient(to top, rgba(61,114,114,0.5) 0%, transparent 2%);
    }
    [data-theme="light"] .pyramid-base {
      border-color: rgba(61,114,114,0.35);
    }
    [data-theme="light"] .pyramid-glow {
      background: radial-gradient(ellipse, rgba(61,114,114,0.35) 0%, rgba(74,138,191,0.15) 30%, transparent 65%);
    }
    [data-theme="light"] .orb.orb-teal {
      background: radial-gradient(circle, rgba(61,114,114,0.9) 0%, rgba(61,114,114,0.3) 50%, transparent 100%);
    }
    [data-theme="light"] .orb.orb-blue {
      background: radial-gradient(circle, rgba(74,138,191,0.9) 0%, rgba(74,138,191,0.3) 50%, transparent 100%);
    }

    @media (max-width: 640px) {
      .pyramid-stage { width: 240px; height: 280px; }
      .pyramid-scene { transform: scale(0.8); }
      .tier-label { display: none; }
    }
` }) %>
<%- include('partials/nav', { activePage: 'dashboard' }) %>

  <h1>Dashboard</h1>
  <p class="subtitle">Personal finance overview</p>

  <!-- Financial Wellness Pyramid -->
  <div class="wellness-section">
    <h3>Financial Wellness</h3>
    <div class="pyramid-stage">
      <div class="pyramid-orbs" id="pyramid-orbs"></div>
      <div class="pyramid-scene">
        <div class="pyramid-holo">
          <div class="pyramid-3d" id="pyramid-3d">
            <div class="pyramid-face f-front" id="face-front"><div class="scanline"></div></div>
            <div class="pyramid-face f-right" id="face-right"><div class="scanline" style="animation-delay:1s"></div></div>
            <div class="pyramid-face f-back"  id="face-back"><div class="scanline" style="animation-delay:2s"></div></div>
            <div class="pyramid-face f-left"  id="face-left"><div class="scanline" style="animation-delay:3s"></div></div>
            <div class="pyramid-base"></div>
          </div>
        </div>
      </div>
      <div class="pyramid-glow" id="pyramid-glow"></div>
      <div class="pyramid-tiers">
        <div class="tier-label t-base"   id="tier-accounts">Accounts</div>
        <div class="tier-label t-budget" id="tier-budget">Budgets</div>
        <div class="tier-label t-subs"   id="tier-subs">Subs</div>
        <div class="tier-label t-goals"  id="tier-goals">Goals</div>
      </div>
    </div>
    <div class="wellness-score" id="wellness-score">--</div>
    <div class="wellness-status" id="wellness-status">Calculating...</div>
  </div>

  <!-- Charts -->
  <div class="charts-grid">
    <div class="chart-card">
      <h3>Monthly Spending Trend</h3>
      <div class="chart-wrap"><canvas id="trend-chart"></canvas></div>
    </div>
    <div class="chart-card">
      <h3>Spending by Category</h3>
      <div class="chart-wrap"><canvas id="category-chart"></canvas></div>
    </div>
  </div>

  <div class="actions">
    <button class="primary" id="sync-btn">Sync Transactions</button>
    <button id="balance-btn">Refresh Balances</button>
    <button id="detect-btn">Run Detection</button>
  </div>

  <div id="status-msg" class="status-msg"></div>

  <!-- Summary cards -->
  <div class="top-cards" id="summary-cards">
    <div class="card"><div class="label">Net Balance</div><div class="value warm" id="net-balance">--</div></div>
    <div class="card"><div class="label">Monthly Spend</div><div class="value warm" id="avg-monthly">--</div><div class="sub" id="avg-monthly-sub"></div></div>
    <div class="card"><div class="label">Subscriptions /mo</div><div class="value teal" id="subs-monthly">--</div></div>
    <div class="card"><div class="label">Active Subs</div><div class="value teal" id="active-subs">--</div></div>
    <div class="card"><div class="label">Avg Daily Spend</div><div class="value warm" id="avg-daily">--</div></div>
    <div class="card"><div class="label">Linked Accounts</div><div class="value teal" id="acct-count">--</div></div>
  </div>

  <!-- Account balances -->
  <div id="accounts-section" style="margin-bottom:28px;">
    <div style="font-size:10px;font-weight:500;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:14px;">Account Balances</div>
    <div class="accounts-grid" id="accounts-grid">
      <div class="empty-msg">Loading accounts...</div>
    </div>
  </div>

  <!-- Two-column: Monthly trend + Categories -->
  <div class="two-col">
    <div class="section">
      <h2>Monthly Spending</h2>
      <table>
        <thead><tr><th>Month</th><th>Total</th><th>Txns</th><th>Avg</th></tr></thead>
        <tbody id="monthly-body"><tr><td colspan="4" class="empty-msg">Loading...</td></tr></tbody>
      </table>
    </div>
    <div class="section">
      <h2>Spending by Category</h2>
      <table>
        <thead><tr><th>Category</th><th>Total</th><th style="width:30%">Share</th></tr></thead>
        <tbody id="category-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
    </div>
  </div>

  <!-- Two-column: Top merchants + Upcoming subscriptions -->
  <div class="two-col">
    <div class="section">
      <h2>Top Merchants</h2>
      <table>
        <thead><tr><th>Merchant</th><th>Total</th><th>Txns</th></tr></thead>
        <tbody id="merchant-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
    </div>
    <div class="section">
      <h2>Upcoming Charges</h2>
      <table>
        <thead><tr><th>Service</th><th>Amount</th><th>Next</th></tr></thead>
        <tbody id="upcoming-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
    </div>
  </div>

  <!-- 30-day forecast -->
  <div class="section" id="forecast-section" style="display:none;">
    <h2>Next 30 Days Forecast</h2>
    <div id="forecast-summary" style="font-size:13px;color:var(--text-muted);margin-bottom:12px;"></div>
    <div id="forecast-list"></div>
  </div>
<%- include('partials/foot', { apiKey: apiKey }) %>
  <script src="/chart.umd.js?v=<%= v %>"></script>
  <script>
    const barColors = ['#c8856c','#d4a574','#5a8f8f','#6fcf97','#7fb5e6','#f0c36d','#eb6b6b','#b07cc6','#e8a87c','#85dcb0','#7bb5d4','#d4a0a0','#9fd4c9','#c4b28f','#a8c3d4'];

    async function loadAccounts() {
      try {
        const [res, invRes] = await Promise.all([
          apiFetch('/api/accounts'),
          apiFetch('/api/investment-accounts'),
        ]);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const accounts = await res.json();
        const investments = invRes.ok ? await invRes.json() : [];
        const grid = document.getElementById('accounts-grid');

        animateInt(document.getElementById('acct-count'), accounts.length + investments.length);

        if (!accounts.length && !investments.length) {
          grid.innerHTML = '<div class="empty-msg">No accounts linked. <a href="/">Link an account</a> to get started.</div>';
          return;
        }

        let netBalance = 0;
        const hasBalances = accounts.some(a => a.available_balance !== null || a.current_balance !== null) || investments.length > 0;

        let html = accounts.map(a => {
          const isCredit = a.type === 'credit';
          const bal = isCredit
            ? parseFloat(a.current_balance || 0)
            : parseFloat(a.available_balance || a.current_balance || 0);
          const displayBal = isCredit ? -bal : bal;
          netBalance += displayBal;

          const balClass = !hasBalances ? 'neutral' : displayBal > 0 ? 'positive' : displayBal < 0 ? 'negative' : 'neutral';
          const balDisplay = hasBalances ? (displayBal < 0 ? '-' + fmt(Math.abs(displayBal)) : fmt(displayBal)) : '\u2014';

          let creditExtra = '';
          if (isCredit && hasBalances) {
            const owed = parseFloat(a.current_balance || 0);
            const avail = parseFloat(a.available_balance || 0);
            const limit = owed + avail;
            const util = limit > 0 ? Math.round((owed / limit) * 100) : 0;
            const utilColor = util <= 10 ? 'var(--green)' : util <= 30 ? 'var(--teal)' : util <= 50 ? 'var(--warm)' : 'var(--red)';
            creditExtra += '<div style="font-size:11px;margin-top:4px;color:var(--text-muted);">Utilization: <span style="color:' + utilColor + ';font-weight:500;">' + util + '%</span> of ' + fmt(limit) + '</div>';
            creditExtra += '<div style="font-size:11px;margin-top:4px;display:flex;align-items:center;gap:6px;color:var(--text-muted);">APR: <input type="number" step="0.01" min="0" max="99.99" value="' + (a.apr || '') + '" placeholder="\u2014" data-apr-account="' + a.id + '" style="width:60px;padding:2px 6px;font-size:11px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text);font-family:inherit;">%</div>';
          }
          return '<div class="acct-card">' +
            '<div class="acct-inst">' + esc(a.institution_name || 'Unknown') + '</div>' +
            '<div class="acct-name">' + esc(a.name) + (a.mask ? ' <span class="acct-mask">\u2022\u2022\u2022\u2022 ' + esc(a.mask) + '</span>' : '') + '</div>' +
            '<div class="acct-balance ' + balClass + '">' + balDisplay + '</div>' +
            '<div class="acct-type">' + esc(a.subtype || a.type || '') + '</div>' +
            creditExtra +
          '</div>';
        }).join('');

        html += investments.map(inv => {
          const bal = parseFloat(inv.balance);
          netBalance += bal;
          const balClass = bal > 0 ? 'positive' : bal < 0 ? 'negative' : 'neutral';
          return '<div class="acct-card">' +
            '<div class="acct-inst">' + esc(inv.institution || 'Investment') + '</div>' +
            '<div class="acct-name">' + esc(inv.name) + '</div>' +
            '<div class="acct-balance ' + balClass + '">' + fmt(bal) + '</div>' +
            '<div class="acct-type">' + esc(inv.account_type) + '</div>' +
          '</div>';
        }).join('');

        grid.innerHTML = html;

        if (hasBalances) {
          animateCurrency(document.getElementById('net-balance'), netBalance);
        } else {
          document.getElementById('net-balance').textContent = '\u2014';
        }
        if (hasBalances) {
          document.getElementById('net-balance').className = 'value ' + (netBalance >= 0 ? 'green' : 'red');
        }
      } catch (e) {
        document.getElementById('accounts-grid').innerHTML = '<div class="empty-msg">Could not load accounts: ' + e.message + '</div>';
      }
    }

    async function loadSpendingSummary() {
      try {
        const res = await apiFetch('/api/spending-summary?months=6');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();

        const monthBody = document.getElementById('monthly-body');
        if (data.monthly_trend.length) {
          monthBody.innerHTML = data.monthly_trend.map(m =>
            '<tr><td>' + fmtMonth(m.month) + '</td>' +
            '<td class="amount warm">' + fmt(m.total_spend) + '</td>' +
            '<td>' + m.txn_count + '</td>' +
            '<td class="amount">' + fmt(m.avg_transaction) + '</td></tr>'
          ).join('');

          const totalSpend = data.monthly_trend.reduce((s, m) => s + parseFloat(m.total_spend), 0);
          const avgMonthly = totalSpend / data.monthly_trend.length;
          animateCurrency(document.getElementById('avg-monthly'), avgMonthly);
          document.getElementById('avg-monthly-sub').textContent = data.monthly_trend.length + '-month avg';

          const totalDays = data.monthly_trend.length * 30;
          animateCurrency(document.getElementById('avg-daily'), totalSpend / totalDays);
        } else {
          monthBody.innerHTML = '<tr><td colspan="4" class="empty-msg">No spending data yet.</td></tr>';
        }

        const catBody = document.getElementById('category-body');
        if (data.by_category.length) {
          const maxCat = parseFloat(data.by_category[0].total);
          catBody.innerHTML = data.by_category.map((c, i) => {
            const pct = Math.round((parseFloat(c.total) / maxCat) * 100);
            const color = barColors[i % barColors.length];
            return '<tr><td>' + esc(c.category) + '</td>' +
              '<td class="amount warm">' + fmt(c.total) + '</td>' +
              '<td><div class="bar-container"><div class="bar-fill" style="width:' + pct + '%;background:' + color + '"></div></div></td></tr>';
          }).join('');
        } else {
          catBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No category data yet.</td></tr>';
        }

        const merchBody = document.getElementById('merchant-body');
        if (data.top_merchants.length) {
          merchBody.innerHTML = data.top_merchants.map(m =>
            '<tr><td>' + esc(m.merchant) + '</td>' +
            '<td class="amount warm">' + fmt(m.total_spent) + '</td>' +
            '<td>' + m.txn_count + '</td></tr>'
          ).join('');
        } else {
          merchBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No merchant data yet.</td></tr>';
        }

        const upBody = document.getElementById('upcoming-body');
        if (data.upcoming_subscriptions.length) {
          upBody.innerHTML = data.upcoming_subscriptions.map(s =>
            '<tr><td>' + esc(s.display_name) + '</td>' +
            '<td class="amount teal">' + fmt(s.amount) + '</td>' +
            '<td>' + fmtDate(s.next_expected) + '</td></tr>'
          ).join('');

          const subsMonthly = data.upcoming_subscriptions.reduce((s, sub) => s + parseFloat(sub.monthly_cost || 0), 0);
          animateCurrency(document.getElementById('subs-monthly'), subsMonthly);
          animateInt(document.getElementById('active-subs'), data.upcoming_subscriptions.length);
        } else {
          upBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No upcoming charges.</td></tr>';
        }
      } catch (e) {
        showMsg('Could not load spending data: ' + e.message, false);
      }
    }

    async function syncTransactions() {
      const btn = document.getElementById('sync-btn');
      btnLoading(btn, true);
      try {
        const res = await apiFetch('/api/sync', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          showMsg('Synced: ' + (data.transactions_added || 0) + ' transactions added.', true);
          loadSpendingSummary();
        } else {
          showMsg('Sync error: ' + (data.error || 'HTTP ' + res.status), false);
        }
      } catch (e) { showMsg('Sync failed: ' + e.message, false); }
      btnLoading(btn, false, 'Sync Transactions');
    }

    async function syncBalances() {
      const btn = document.getElementById('balance-btn');
      btnLoading(btn, true);
      try {
        const res = await apiFetch('/api/sync-balances', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          showMsg('Balances updated for ' + (data.accounts_updated || 0) + ' accounts.', true);
          loadAccounts();
        } else {
          showMsg('Balance sync error: ' + (data.error || 'HTTP ' + res.status), false);
        }
      } catch (e) { showMsg('Balance sync failed: ' + e.message, false); }
      btnLoading(btn, false, 'Refresh Balances');
    }

    async function runDetection() {
      const btn = document.getElementById('detect-btn');
      btnLoading(btn, true);
      try {
        const res = await apiFetch('/api/detect', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          showMsg('Detection complete: ' + (data.detected_count || 0) + ' subscriptions found.', true);
          loadSpendingSummary();
        } else {
          showMsg('Detection error: ' + (data.error || 'HTTP ' + res.status), false);
        }
      } catch (e) { showMsg('Detection failed: ' + e.message, false); }
      btnLoading(btn, false, 'Run Detection');
    }

    async function setApr(accountId, value) {
      try {
        const apr = value === '' ? null : parseFloat(value);
        const res = await apiFetch('/api/accounts/' + accountId, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ apr: apr })
        });
        if (res.ok) showMsg('APR saved.', true);
        else { const d = await res.json().catch(() => ({})); showMsg(d.error || 'Failed to save APR', false); }
      } catch (e) { showMsg(e.message, false); }
    }

    async function loadForecast() {
      try {
        var res = await apiFetch('/api/forecast?days=30'); var data = await res.json();
        if (data.charge_count === 0) return;
        document.getElementById('forecast-section').style.display = 'block';
        document.getElementById('forecast-summary').innerHTML =
          '<strong>' + data.charge_count + ' charges</strong> totaling <strong style="color:var(--warm);">$' + data.total_expected.toFixed(2) +
          '</strong> expected in the next ' + data.forecast_days + ' days';
        var html = '<table style="width:100%;font-size:12px;border-collapse:collapse;">' +
          '<thead><tr><th style="text-align:left;padding:6px 0;border-bottom:1px solid var(--border);">Service</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Amount</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Date</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">In</th></tr></thead><tbody>';
        data.charges.forEach(function(c) {
          html += '<tr><td style="padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + esc(c.name) + '</td>' +
            '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:var(--warm);">$' + c.amount.toFixed(2) + '</td>' +
            '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + c.date + '</td>' +
            '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:var(--text-muted);">' + c.days_away + 'd</td></tr>';
        });
        html += '</tbody></table>';
        document.getElementById('forecast-list').innerHTML = html;
      } catch {}
    }

    // --- Bind event handlers (CSP-safe) ---
    bindEvents([
      ['sync-btn', 'click', syncTransactions],
      ['balance-btn', 'click', syncBalances],
      ['detect-btn', 'click', runDetection],
    ]);
    onDelegate('accounts-grid', 'change', 'input[data-apr-account]', function() {
      setApr(parseInt(this.dataset.aprAccount), this.value);
    });

    // Initialize
    loadAccounts();
    loadSpendingSummary();
    loadForecast();

    // PWA
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});

    // ── Financial Wellness Pyramid ──────────────────────────────
    // Spawn rising neon orbs
    (function spawnOrbs() {
      const container = document.getElementById('pyramid-orbs');
      if (!container) return;
      const orbClasses = ['orb-teal', 'orb-blue', 'orb-cyan'];
      function createOrb() {
        const orb = document.createElement('div');
        orb.className = 'orb ' + orbClasses[Math.floor(Math.random() * orbClasses.length)];
        const size = 3 + Math.random() * 6;
        const x = 80 + (Math.random() - 0.5) * 140;
        const duration = 3.5 + Math.random() * 3.5;
        const delay = Math.random() * 1.5;
        orb.style.cssText = 'width:' + size + 'px;height:' + size + 'px;left:' + x + 'px;bottom:40px;animation-duration:' + duration + 's;animation-delay:' + delay + 's;';
        container.appendChild(orb);
        setTimeout(function() { orb.remove(); }, (duration + delay) * 1000);
      }
      // Initial burst
      for (var i = 0; i < 8; i++) setTimeout(createOrb, i * 300);
      // Continuous spawning
      setInterval(function() { createOrb(); }, 900);
    })();

    // Compute wellness score from API data
    async function computeWellness() {
      var score = 0;
      var tiers = { accounts: false, budget: false, subs: false, goals: false };
      var statusMsg = '';

      try {
        // Tier 1: Accounts & Tracking (25 pts) — linked accounts exist
        var acctRes = await apiFetch('/api/accounts');
        var accounts = acctRes.ok ? await acctRes.json() : [];
        if (accounts.length > 0) {
          score += 25;
          tiers.accounts = true;
        }

        // Tier 2: Budget Discipline (25 pts) — budgets exist and avg under limit
        try {
          var budRes = await apiFetch('/api/budgets');
          var budgets = budRes.ok ? await budRes.json() : [];
          if (budgets.length > 0) {
            var underBudget = budgets.filter(function(b) { return b.percent_used <= 100; }).length;
            var budgetRatio = underBudget / budgets.length;
            score += Math.round(25 * budgetRatio);
            if (budgetRatio >= 0.5) tiers.budget = true;
          }
        } catch (e) {}

        // Tier 3: Subscription Control (25 pts) — actively tracking subscriptions
        try {
          var subRes = await apiFetch('/api/subscriptions?filter=all');
          var subs = subRes.ok ? await subRes.json() : [];
          if (subs.length > 0) {
            // Points for having detected subs + bonus for dismissed/canceled ones
            score += 15;
            tiers.subs = true;
            var managed = subs.filter(function(s) { return s.is_dismissed || s.is_canceled; }).length;
            if (managed > 0) score += Math.min(10, Math.round(10 * (managed / subs.length)));
          }
        } catch (e) {}

        // Tier 4: Goal Progress (25 pts) — goals set with progress
        try {
          var goalRes = await apiFetch('/api/goals');
          var goals = goalRes.ok ? await goalRes.json() : [];
          var activeGoals = goals.filter(function(g) { return g.is_active; });
          if (activeGoals.length > 0) {
            tiers.goals = true;
            var avgProgress = activeGoals.reduce(function(s, g) { return s + Math.min(100, g.percent_complete); }, 0) / activeGoals.length;
            score += Math.round(25 * (avgProgress / 100));
          }
        } catch (e) {}

        // Cap at 100
        score = Math.min(100, score);

        // Status message
        if (score >= 90) statusMsg = 'Excellent financial health';
        else if (score >= 70) statusMsg = 'Strong financial foundation';
        else if (score >= 50) statusMsg = 'Building good habits';
        else if (score >= 25) statusMsg = 'Getting started on your journey';
        else statusMsg = 'Link accounts to begin tracking';

      } catch (e) {
        statusMsg = 'Could not compute score';
      }

      updatePyramid(score, tiers, statusMsg);
    }

    function updatePyramid(score, tiers, statusMsg) {
      var fill = score / 100;
      var fillPct = Math.round(fill * 100);

      // Neon color based on score level
      var neonColor, neonRgb;
      if (score >= 75) {
        neonColor = 'rgba(111,207,151,'; neonRgb = '111,207,151';
      } else if (score >= 50) {
        neonColor = 'rgba(90,143,143,'; neonRgb = '90,143,143';
      } else if (score >= 25) {
        neonColor = 'rgba(127,181,230,'; neonRgb = '127,181,230';
      } else {
        neonColor = 'rgba(90,143,143,'; neonRgb = '90,143,143';
      }

      // Update face inner glow (::before) via CSS variable on each face
      var faces = document.querySelectorAll('.pyramid-face');
      var faceOpacities = [1, 0.9, 0.7, 0.9];
      faces.forEach(function(face, i) {
        // Inner fill glow from bottom up
        var innerBg = 'linear-gradient(to top, ' + neonColor + (0.15 + fill * 0.15) + ') 0%, ' +
          neonColor + (0.1 + fill * 0.12) + ') ' + fillPct + '%, transparent ' + Math.min(100, fillPct + 15) + '%)';
        face.querySelector('.scanline') && (face.querySelector('.scanline').style.background =
          'linear-gradient(90deg, transparent 0%, ' + neonColor + '0.9) 30%, rgba(' + neonRgb + ',1) 50%, ' + neonColor + '0.9) 70%, transparent 100%)');
        face.style.opacity = faceOpacities[i];
        // Set edge glow intensity via filter
        var edgeGlow = face.querySelector('::after');
      });

      // Update face ::before backgrounds using inline style on a style tag
      var neonStyle = document.getElementById('neon-dynamic');
      if (!neonStyle) {
        neonStyle = document.createElement('style');
        neonStyle.id = 'neon-dynamic';
        document.head.appendChild(neonStyle);
      }
      neonStyle.textContent =
        '.pyramid-face::before { background: linear-gradient(to top, ' + neonColor + (0.18 + fill * 0.18) + ') 0%, ' +
        neonColor + (0.12 + fill * 0.12) + ') ' + fillPct + '%, transparent ' + Math.min(100, fillPct + 20) + '%) !important; }' +
        '.pyramid-face::after { background: ' +
        'linear-gradient(to bottom right, ' + neonColor + (0.6 + fill * 0.4) + ') 0%, transparent 2%), ' +
        'linear-gradient(to bottom left, ' + neonColor + (0.6 + fill * 0.4) + ') 0%, transparent 2%), ' +
        'linear-gradient(to top, ' + neonColor + (0.4 + fill * 0.3) + ') 0%, transparent 2%) !important; ' +
        'filter: blur(0.5px) drop-shadow(0 0 ' + Math.round(3 + fill * 6) + 'px ' + neonColor + '0.5)) !important; }' +
        '.pyramid-base { border-color: ' + neonColor + (0.3 + fill * 0.4) + ') !important; ' +
        'box-shadow: inset 0 0 ' + Math.round(15 + fill * 25) + 'px ' + neonColor + '0.08), ' +
        '0 0 ' + Math.round(6 + fill * 15) + 'px ' + neonColor + (0.15 + fill * 0.25) + ') !important; }' +
        '.pyramid-base::before { background: ' +
        'linear-gradient(90deg, ' + neonColor + (0.08 + fill * 0.1) + ') 1px, transparent 1px), ' +
        'linear-gradient(0deg, ' + neonColor + (0.08 + fill * 0.1) + ') 1px, transparent 1px) !important; ' +
        'background-size: 40px 40px !important; }';

      // Update glow underneath
      var glow = document.getElementById('pyramid-glow');
      if (glow) {
        var glowIntensity = 0.3 + fill * 0.7;
        glow.style.opacity = glowIntensity;
        glow.style.background = 'radial-gradient(ellipse, ' + neonColor + (0.4 + fill * 0.3) + ') 0%, ' +
          neonColor + '0.15) 35%, transparent 65%)';
      }

      // Animate score number
      animateCounter(document.getElementById('wellness-score'), score, '%');

      // Score color + neon text glow
      var scoreEl = document.getElementById('wellness-score');
      if (score >= 75) { scoreEl.style.color = 'var(--green)'; scoreEl.style.textShadow = '0 0 20px rgba(111,207,151,0.4)'; }
      else if (score >= 50) { scoreEl.style.color = 'var(--teal)'; scoreEl.style.textShadow = '0 0 20px rgba(90,143,143,0.4)'; }
      else if (score >= 25) { scoreEl.style.color = 'var(--blue)'; scoreEl.style.textShadow = '0 0 20px rgba(127,181,230,0.4)'; }
      else { scoreEl.style.color = 'var(--teal)'; scoreEl.style.textShadow = '0 0 15px rgba(90,143,143,0.3)'; }

      // Status message
      document.getElementById('wellness-status').textContent = statusMsg;

      // Tier labels — neon glow when active
      if (tiers.accounts) document.getElementById('tier-accounts').classList.add('active');
      if (tiers.budget)   document.getElementById('tier-budget').classList.add('active');
      if (tiers.subs)     document.getElementById('tier-subs').classList.add('active');
      if (tiers.goals)    document.getElementById('tier-goals').classList.add('active');

      var tierColor = score >= 75 ? 'var(--green)' : score >= 50 ? 'var(--teal)' : 'var(--blue)';
      document.querySelectorAll('.tier-label.active').forEach(function(el) {
        el.style.color = tierColor;
      });
    }

    // Animated counter (counts up from 0 to target)
    function animateCounter(el, target, suffix) {
      if (!el) return;
      suffix = suffix || '';
      var current = 0;
      var duration = 1200;
      var steps = 30;
      var increment = target / steps;
      var stepTime = duration / steps;
      var timer = setInterval(function() {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        el.textContent = Math.round(current) + suffix;
      }, stepTime);
    }

    // Animated currency counter (counts up from 0, formats as $X,XXX.XX)
    function animateCurrency(el, target) {
      if (!el || isNaN(target)) return;
      var current = 0;
      var duration = 1000;
      var steps = 25;
      var increment = target / steps;
      var stepTime = duration / steps;
      var neg = target < 0;
      var absTarget = Math.abs(target);
      var absCurrent = 0;
      var absIncrement = absTarget / steps;
      var timer = setInterval(function() {
        absCurrent += absIncrement;
        if (absCurrent >= absTarget) {
          absCurrent = absTarget;
          clearInterval(timer);
        }
        el.textContent = (neg ? '-' : '') + fmt(absCurrent);
      }, stepTime);
    }

    // Animated integer counter
    function animateInt(el, target) {
      if (!el || isNaN(target)) return;
      animateCounter(el, target, '');
    }

    computeWellness();

    // Charts — Chart.js loaded via blocking <script> tag above
    if (typeof Chart !== 'undefined') {
      loadCharts();
    } else {
      document.querySelectorAll('.chart-wrap').forEach(function(el) {
        el.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;">Chart library failed to load</div>';
      });
    }

    async function loadCharts() {
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
      const textColor = isDark ? 'rgba(240,235,227,0.5)' : 'rgba(26,26,46,0.5)';
      Chart.defaults.color = textColor;
      Chart.defaults.borderColor = gridColor;
      try {
        const txRes = await apiFetch('/api/transactions?months=6');
        const txData = await txRes.json();
        const monthlyMap = {};
        (txData.transactions || []).forEach(t => {
          if (t.amount > 0) {
            const m = t.date.slice(0, 7);
            monthlyMap[m] = (monthlyMap[m] || 0) + parseFloat(t.amount);
          }
        });
        const months = Object.keys(monthlyMap).sort();
        const amounts = months.map(m => monthlyMap[m]);
        const trendCtx = document.getElementById('trend-chart');
        if (trendCtx && months.length === 0) {
          trendCtx.parentElement.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;">No spending data yet</div>';
        }
        if (trendCtx && months.length > 0) {
          new Chart(trendCtx, {
            type: 'line',
            data: {
              labels: months.map(m => { const d = new Date(m + '-01'); return d.toLocaleString('default', { month: 'short', year: '2-digit' }); }),
              datasets: [{
                label: 'Spending',
                data: amounts,
                borderColor: '#d4a574',
                backgroundColor: 'rgba(212,165,116,0.1)',
                fill: true, tension: 0.4, pointRadius: 4,
                pointBackgroundColor: '#d4a574',
              }]
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                y: { beginAtZero: true, ticks: { callback: v => '$' + v.toLocaleString() }, grid: { color: gridColor } },
                x: { grid: { display: false } }
              }
            }
          });
        }
        const catMap = {};
        (txData.transactions || []).forEach(t => {
          if (t.amount > 0) {
            const cat = (t.personal_finance_category && t.personal_finance_category.primary) || t.category || 'Other';
            catMap[cat] = (catMap[cat] || 0) + parseFloat(t.amount);
          }
        });
        const cats = Object.entries(catMap).sort((a, b) => b[1] - a[1]).slice(0, 8);
        const pieColors = ['#d4a574', '#5a8f8f', '#c8856c', '#6fcf97', '#7fb5e6', '#f0c36d', '#eb6b6b', '#b08ed6'];
        const catCtx = document.getElementById('category-chart');
        if (catCtx && cats.length === 0) {
          catCtx.parentElement.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;">No category data yet</div>';
        }
        if (catCtx && cats.length > 0) {
          new Chart(catCtx, {
            type: 'doughnut',
            data: {
              labels: cats.map(c => c[0]),
              datasets: [{ data: cats.map(c => c[1].toFixed(2)), backgroundColor: pieColors.slice(0, cats.length), borderWidth: 0 }]
            },
            options: {
              responsive: true, maintainAspectRatio: false, cutout: '60%',
              plugins: {
                legend: { position: window.innerWidth <= 640 ? 'bottom' : 'right', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } },
                tooltip: { callbacks: { label: ctx => ctx.label + ': $' + parseFloat(ctx.raw).toLocaleString() } }
              }
            }
          });
        }
      } catch (e) { console.warn('Charts load error:', e); }
    }
  </script>
</body>
</html>
