<%- include('partials/foot') %>
  <script src="<%= basePath %>/vendor/chart.umd.js"></script>
  <script nonce="<%= nonce %>">if(typeof Chart==='undefined'){var s=document.createElement('script');s.src='/vendor/chart.umd.js?v=<%= v %>';document.head.appendChild(s);}</script>
  <script nonce="<%= nonce %>">
    const barColors = ['#c8856c','#d4a574','#5a8f8f','#6fcf97','#7fb5e6','#f0c36d','#eb6b6b','#b07cc6','#e8a87c','#85dcb0','#7bb5d4','#d4a0a0','#9fd4c9','#c4b28f','#a8c3d4'];

    // Build true 3D pyramid geometry — frustum layers with trapezoidal faces
    (function buildPyramidGeometry() {
      var container = document.getElementById('pyramid-3d');
      if (!container) return;
      var B = 75;   // half-base of pyramid
      var H = 212;  // total pyramid height (base to apex)
      var GAP = 10;  // vertical gap between layers
      // Layer vertical slices (from bottom)
      var layers = [
        { y0: 0, y1: 52 },     // base
        { y0: 62, y1: 110 },   // +10 gap
        { y0: 120, y1: 164 },  // +10 gap
        { y0: 174, y1: H }     // apex, +10 gap
      ];
      var ALPHA_DEG = Math.atan(B / H) * (180 / Math.PI); // ~19.5°
      var faceNames = ['lf-front', 'lf-right', 'lf-back', 'lf-left'];
      var faceRotY = [0, 90, 180, 270];
      var faceOpacities = [0.2, 0.15, 0.12, 0.15];
      var SVG_NS = 'http://www.w3.org/2000/svg';

      // Position base grid
      var base = document.getElementById('pyramid-base');
      if (base) {
        var baseW = B * 2;
        base.style.width = baseW + 'px';
        base.style.height = baseW + 'px';
        base.style.bottom = '0';
        base.style.left = (90 - B) + 'px';
      }

      layers.forEach(function(L, li) {
        var h = L.y1 - L.y0;
        var bw = B * (H - L.y0) / H;  // bottom half-width
        var tw = B * (H - L.y1) / H;  // top half-width (0 for apex)
        var diff = bw - tw;
        var sh = Math.sqrt(h * h + diff * diff); // slant height
        var avgZ = (bw + tw) / 2;
        var faceW = bw * 2;
        var isApex = tw < 0.5; // effectively zero = triangle

        // Create layer container (0×0 anchor at pyramid center, at layer vertical center)
        var layerEl = document.createElement('div');
        layerEl.className = 'pyramid-layer layer-' + li;
        layerEl.id = 'layer-' + li;
        // Position anchor at the vertical center of this layer
        layerEl.style.bottom = (L.y0 + h / 2) + 'px';
        container.insertBefore(layerEl, base);

        // Create 4 faces (front, right, back, left)
        for (var fi = 0; fi < 4; fi++) {
          var face = document.createElement('div');
          face.className = 'layer-face ' + faceNames[fi];
          // Size: width = bottom width (2*bw), height = slant height
          face.style.width = faceW + 'px';
          face.style.height = sh + 'px';
          // Center on the 0×0 anchor point
          face.style.left = -bw + 'px';
          face.style.top = (-sh / 2) + 'px';
          // Clip to trapezoid (or triangle for apex)
          if (isApex) {
            face.style.clipPath = 'polygon(50% 0%, 0% 100%, 100% 100%)';
          } else {
            var inset = (diff / faceW) * 100;
            face.style.clipPath = 'polygon(' + inset.toFixed(1) + '% 0%, ' + (100 - inset).toFixed(1) + '% 0%, 100% 100%, 0% 100%)';
          }
          // 3D transform: rotateY to orient face, translateZ to push outward, rotateX to tilt inward
          face.style.transform = 'rotateY(' + faceRotY[fi] + 'deg) translateZ(' + avgZ.toFixed(1) + 'px) rotateX(' + ALPHA_DEG.toFixed(1) + 'deg)';

          // Face fill gradient
          var fill = document.createElement('div');
          fill.className = 'face-fill';
          fill.style.background = 'linear-gradient(to top, rgba(200,133,108,' + faceOpacities[fi] + '), transparent 70%)';
          if (isApex) {
            fill.style.clipPath = 'polygon(50% 0%, 0% 100%, 100% 100%)';
          }
          face.appendChild(fill);

          // SVG wireframe edges
          var svg = document.createElementNS(SVG_NS, 'svg');
          svg.setAttribute('class', 'face-edges');
          svg.setAttribute('viewBox', '0 0 ' + faceW.toFixed(1) + ' ' + sh.toFixed(1));
          svg.setAttribute('xmlns', SVG_NS);
          if (isApex) {
            // Triangle: apex at top center, base at bottom
            var cx = bw;
            addLine(svg, cx, 0, 0, sh);
            addLine(svg, cx, 0, faceW, sh);
            addLine(svg, 0, sh, faceW, sh);
          } else {
            // Trapezoid: narrower at top
            addLine(svg, diff, 0, 0, sh);          // top-left to bottom-left
            addLine(svg, diff, 0, faceW - diff, 0); // top edge
            addLine(svg, faceW - diff, 0, faceW, sh); // top-right to bottom-right
            addLine(svg, 0, sh, faceW, sh);         // bottom edge
          }
          face.appendChild(svg);

          // Scanline
          var scan = document.createElement('div');
          scan.className = 'scanline';
          if (fi > 0) scan.style.animationDelay = fi + 's';
          face.appendChild(scan);

          layerEl.appendChild(face);
        }
      });

      function addLine(svg, x1, y1, x2, y2) {
        var line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', x1.toFixed(1));
        line.setAttribute('y1', y1.toFixed(1));
        line.setAttribute('x2', x2.toFixed(1));
        line.setAttribute('y2', y2.toFixed(1));
        svg.appendChild(line);
      }
    })();

    async function loadAccounts() {
      try {
        const [res, invRes] = await Promise.all([
          apiFetch('/api/accounts'),
          apiFetch('/api/investment-accounts'),
        ]);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const accounts = await res.json();
        const investments = invRes.ok ? await invRes.json() : [];
        const grid = document.getElementById('accounts-grid');

        animateInt(document.getElementById('acct-count'), accounts.length + investments.length);

        if (!accounts.length && !investments.length) {
          grid.innerHTML = '<div class="empty-msg">No accounts linked. <a href="/">Link an account</a> to get started.</div>';
          return;
        }

        let netBalance = 0;
        const hasBalances = accounts.some(a => a.available_balance !== null || a.current_balance !== null) || investments.length > 0;

        // Render a single account card. Pulled out of the grouping render
        // below so cash/credit/investment branches can share the same
        // markup without duplicating the per-card HTML.
        function renderAcctCard(a) {
          const isCredit = a.type === 'credit';
          const bal = isCredit
            ? parseFloat(a.current_balance || 0)
            : parseFloat(a.available_balance || a.current_balance || 0);
          const displayBal = isCredit ? -bal : bal;
          netBalance += displayBal;

          const balClass = !hasBalances ? 'neutral' : displayBal > 0 ? 'positive' : displayBal < 0 ? 'negative' : 'neutral';
          const balDisplay = hasBalances ? (displayBal < 0 ? '-' + fmt(Math.abs(displayBal)) : fmt(displayBal)) : '\u2014';

          let creditExtra = '';
          if (isCredit && hasBalances) {
            const owed = parseFloat(a.current_balance || 0);
            const avail = parseFloat(a.available_balance || 0);
            const limit = owed + avail;
            const util = limit > 0 ? Math.round((owed / limit) * 100) : 0;
            const utilColor = util <= 10 ? 'var(--green)' : util <= 30 ? 'var(--teal)' : util <= 50 ? 'var(--warm)' : 'var(--red)';
            creditExtra += '<div style="font-size:11px;margin-top:4px;color:var(--text-muted);">Utilization: <span style="color:' + utilColor + ';font-weight:500;">' + util + '%</span> of ' + fmt(limit) + '</div>';
            creditExtra += '<div style="font-size:11px;margin-top:4px;display:flex;align-items:center;gap:6px;color:var(--text-muted);">APR: <input type="number" step="0.01" min="0" max="99.99" value="' + (a.apr || '') + '" placeholder="\u2014" data-apr-account="' + a.id + '" style="width:60px;padding:2px 6px;font-size:11px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text);font-family:inherit;">%</div>';
          }
          return '<div class="acct-card">' +
            '<div class="acct-inst">' + esc(a.institution_name || 'Unknown') + '</div>' +
            '<div class="acct-name">' + esc(a.name) + (a.mask ? ' <span class="acct-mask">\u2022\u2022\u2022\u2022 ' + esc(a.mask) + '</span>' : '') + '</div>' +
            '<div class="acct-balance ' + balClass + '">' + balDisplay + '</div>' +
            '<div class="acct-type">' + esc(a.subtype || a.type || '') + '</div>' +
            creditExtra +
            ((a.is_manual || a.provider === 'manual') ? '<button class="btn-sm" data-edit-balance="' + a.id + '" style="margin-top:4px;font-size:10px;padding:3px 8px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--warm);cursor:pointer;font-family:inherit;">Update Balance</button>' : '') +
            (a.is_shared ? '<div style="margin-top:6px;font-size:10px;color:var(--teal);">Shared \u2022 Your split: ' + (a.spending_split_pct || 100) + '%</div>' : '') +
            '<button data-shared-toggle="' + a.id + '" style="margin-top:4px;font-size:10px;padding:3px 8px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text-muted);cursor:pointer;font-family:inherit;">' + (a.is_shared ? 'Edit Split' : 'Mark Shared') + '</button>' +
          '</div>';
        }

        // Group accounts: Cash (depository, non-investment), Credit, Investments,
        // Other. is_investment comes from the new SQL fragment in the API
        // response so Teller-linked brokerage/IRA/401k accounts surface under
        // their own header instead of mixed in with checking/savings.
        const cashAccts = accounts.filter(a => !a.is_investment && a.type === 'depository');
        const creditAccts = accounts.filter(a => a.type === 'credit');
        const investmentAccts = accounts.filter(a => a.is_investment);
        const otherAccts = accounts.filter(a => !a.is_investment && a.type !== 'depository' && a.type !== 'credit');

        const groupHeader = (label, count) =>
          '<div style="grid-column:1/-1;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin:8px 0 4px;padding-top:8px;border-top:1px solid var(--border);">' +
          label + ' <span style="color:var(--text-secondary);font-weight:400;">(' + count + ')</span></div>';

        let html = '';
        if (cashAccts.length) {
          html += groupHeader('Cash', cashAccts.length);
          html += cashAccts.map(renderAcctCard).join('');
        }
        if (creditAccts.length) {
          html += groupHeader('Credit', creditAccts.length);
          html += creditAccts.map(renderAcctCard).join('');
        }
        if (investmentAccts.length || investments.length) {
          html += groupHeader('Investments', investmentAccts.length + investments.length);
          html += investmentAccts.map(renderAcctCard).join('');
          // Manual + Plaid investments live in the investment_accounts table
          // (not linked_accounts) so they need their own simpler card render.
          html += investments.map(inv => {
            const bal = parseFloat(inv.balance);
            netBalance += bal;
            const balClass = bal > 0 ? 'positive' : bal < 0 ? 'negative' : 'neutral';
            return '<div class="acct-card">' +
              '<div class="acct-inst">' + esc(inv.institution || 'Investment') + '</div>' +
              '<div class="acct-name">' + esc(inv.name) + '</div>' +
              '<div class="acct-balance ' + balClass + '">' + fmt(bal) + '</div>' +
              '<div class="acct-type">' + esc(inv.account_type) + '</div>' +
            '</div>';
          }).join('');
        }
        if (otherAccts.length) {
          html += groupHeader('Other', otherAccts.length);
          html += otherAccts.map(renderAcctCard).join('');
        }

        grid.innerHTML = html;

        if (hasBalances) {
          animateCurrency(document.getElementById('net-balance'), netBalance);
        } else {
          document.getElementById('net-balance').textContent = '\u2014';
        }
        if (hasBalances) {
          document.getElementById('net-balance').className = 'value ' + (netBalance >= 0 ? 'green' : 'red');
        }
      } catch (e) {
        document.getElementById('accounts-grid').innerHTML = '<div class="empty-msg">Could not load accounts: ' + esc(e.message) + '</div>';
      }
    }

    async function editManualBalance(id) {
      var val = prompt('Enter current balance:');
      if (val === null) return;
      var num = parseFloat(val);
      if (isNaN(num)) return;
      try {
        await apiFetch('/api/accounts/' + id + '/balance', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ current_balance: num, available_balance: num }) });
        loadAccounts();
      } catch (e) {}
    }

    async function loadSpendingSummary() {
      try {
        const res = await apiFetch('/api/spending-summary?months=6');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();

        const monthBody = document.getElementById('monthly-body');
        if (data.monthly_trend.length) {
          monthBody.innerHTML = data.monthly_trend.map(m =>
            '<tr><td>' + fmtMonth(m.month) + '</td>' +
            '<td class="amount warm">' + fmt(m.total_spend) + '</td>' +
            '<td>' + m.txn_count + '</td>' +
            '<td class="amount">' + fmt(m.avg_transaction) + '</td></tr>'
          ).join('');

          const totalSpend = data.monthly_trend.reduce((s, m) => s + parseFloat(m.total_spend), 0);
          const avgMonthly = totalSpend / data.monthly_trend.length;
          animateCurrency(document.getElementById('avg-monthly'), avgMonthly);
          document.getElementById('avg-monthly-sub').textContent = data.monthly_trend.length + '-month avg';

          const totalDays = data.monthly_trend.length * 30;
          animateCurrency(document.getElementById('avg-daily'), totalSpend / totalDays);
        } else {
          monthBody.innerHTML = '<tr><td colspan="4" class="empty-msg">No spending data yet.</td></tr>';
        }

        const catBody = document.getElementById('category-body');
        if (data.by_category.length) {
          const maxCat = parseFloat(data.by_category[0].total);
          catBody.innerHTML = data.by_category.map((c, i) => {
            const pct = Math.round((parseFloat(c.total) / maxCat) * 100);
            const color = barColors[i % barColors.length];
            return '<tr><td>' + esc(c.category) + '</td>' +
              '<td class="amount warm">' + fmt(c.total) + '</td>' +
              '<td><div class="bar-container"><div class="bar-fill" style="width:' + pct + '%;background:' + color + '"></div></div></td></tr>';
          }).join('');
        } else {
          catBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No category data yet.</td></tr>';
        }

        const merchBody = document.getElementById('merchant-body');
        if (data.top_merchants.length) {
          merchBody.innerHTML = data.top_merchants.map(m =>
            '<tr><td>' + esc(m.merchant) + '</td>' +
            '<td class="amount warm">' + fmt(m.total_spent) + '</td>' +
            '<td>' + m.txn_count + '</td></tr>'
          ).join('');
        } else {
          merchBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No merchant data yet.</td></tr>';
        }

        const upBody = document.getElementById('upcoming-body');
        if (data.upcoming_subscriptions.length) {
          upBody.innerHTML = data.upcoming_subscriptions.map(s =>
            '<tr><td>' + esc(s.display_name) + '</td>' +
            '<td class="amount teal">' + fmt(s.amount) + '</td>' +
            '<td>' + fmtDate(s.next_expected) + '</td></tr>'
          ).join('');

          const subsMonthly = data.upcoming_subscriptions.reduce((s, sub) => s + parseFloat(sub.monthly_cost || 0), 0);
          animateCurrency(document.getElementById('subs-monthly'), subsMonthly);
          animateInt(document.getElementById('active-subs'), data.upcoming_subscriptions.length);
        } else {
          upBody.innerHTML = '<tr><td colspan="3" class="empty-msg">No upcoming charges.</td></tr>';
        }
        const recentBody = document.getElementById('recent-txn-body');
        if (data.recent_transactions && data.recent_transactions.length) {
          recentBody.innerHTML = data.recent_transactions.map(t => {
            const isPending = t.pending;
            const badge = isPending
              ? '<span class="badge-pending">PENDING</span>'
              : '<span class="badge-posted">POSTED</span>';
            const amtClass = parseFloat(t.amount) > 0 ? 'warm' : 'teal';
            return '<tr><td>' + fmtDate(t.date) + '</td>' +
              '<td>' + esc(t.description) + '</td>' +
              '<td style="font-size:11px;color:var(--text-muted)">' + esc(t.category) + '</td>' +
              '<td class="amount ' + amtClass + '">' + fmt(t.amount) + '</td>' +
              '<td class="hide-mobile">' + badge + '</td></tr>';
          }).join('');
        } else {
          recentBody.innerHTML = '<tr><td colspan="5" class="empty-msg">No transactions yet.</td></tr>';
        }

      } catch (e) {
        showMsg('Could not load spending data: ' + e.message, false);
      }
    }

    async function syncTransactions() {
      const btn = document.getElementById('sync-btn');
      btnLoading(btn, true);
      try {
        const res = await apiFetch('/api/sync', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          showMsg('Synced: ' + (data.transactions_added || 0) + ' transactions added.', true);
          loadSpendingSummary();
        } else {
          showMsg('Sync error: ' + (data.error || 'HTTP ' + res.status), false);
        }
      } catch (e) { showMsg('Sync failed: ' + e.message, false); }
      btnLoading(btn, false, 'Sync Transactions');
    }

    async function syncBalances() {
      const btn = document.getElementById('balance-btn');
      btnLoading(btn, true);
      try {
        const res = await apiFetch('/api/sync-balances', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          showMsg('Balances updated for ' + (data.accounts_updated || 0) + ' accounts.', true);
          loadAccounts();
        } else {
          showMsg('Balance sync error: ' + (data.error || 'HTTP ' + res.status), false);
        }
      } catch (e) { showMsg('Balance sync failed: ' + e.message, false); }
      btnLoading(btn, false, 'Refresh Balances');
    }

    async function runDetection() {
      const btn = document.getElementById('detect-btn');
      btnLoading(btn, true);
      try {
        const res = await apiFetch('/api/detect', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          showMsg('Detection complete: ' + (data.detected_count || 0) + ' subscriptions found.', true);
          loadSpendingSummary();
        } else {
          showMsg('Detection error: ' + (data.error || 'HTTP ' + res.status), false);
        }
      } catch (e) { showMsg('Detection failed: ' + e.message, false); }
      btnLoading(btn, false, 'Run Detection');
    }

    async function editManualBalance(id) {
      var val = prompt('Enter current balance:');
      if (val === null) return;
      var num = parseFloat(val);
      if (isNaN(num)) return;
      try {
        await apiFetch('/api/accounts/' + id + '/balance', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ current_balance: num, available_balance: num }) });
        loadAccounts();
      } catch (e) {}
    }

    async function toggleShared(id) {
      var pct = prompt('What % of spending on this account is yours?\n(e.g. 50 for a 50/50 shared card, 100 for fully yours)', '50');
      if (pct === null) return;
      var num = Math.max(0, Math.min(100, parseInt(pct) || 100));
      try {
        await apiFetch('/api/accounts/' + id + '/shared', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ is_shared: num < 100, spending_split_pct: num }) });
        loadAccounts();
        loadSpendingSummary();
      } catch (e) {}
    }

    async function setApr(accountId, value) {
      try {
        const apr = value === '' ? null : parseFloat(value);
        const res = await apiFetch('/api/accounts/' + accountId, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ apr: apr })
        });
        if (res.ok) showMsg('APR saved.', true);
        else { const d = await res.json().catch(() => ({})); showMsg(d.error || 'Failed to save APR', false); }
      } catch (e) { showMsg(e.message, false); }
    }

    async function loadForecast() {
      try {
        var res = await apiFetch('/api/forecast?days=30'); var data = await res.json();
        if (data.charge_count === 0) return;
        document.getElementById('forecast-section').style.display = 'block';
        document.getElementById('forecast-summary').innerHTML =
          '<strong>' + data.charge_count + ' charges</strong> totaling <strong style="color:var(--warm);">$' + data.total_expected.toFixed(2) +
          '</strong> expected in the next ' + data.forecast_days + ' days';
        var html = '<div class="table-wrap"><table style="width:100%;font-size:12px;border-collapse:collapse;">' +
          '<thead><tr><th style="text-align:left;padding:6px 0;border-bottom:1px solid var(--border);">Service</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Amount</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Date</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">In</th></tr></thead><tbody>';
        data.charges.forEach(function(c) {
          html += '<tr><td style="padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + esc(c.name) + '</td>' +
            '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:var(--warm);">$' + c.amount.toFixed(2) + '</td>' +
            '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + c.date + '</td>' +
            '<td style="text-align:right;padding:5px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:var(--text-muted);">' + c.days_away + 'd</td></tr>';
        });
        html += '</tbody></table></div>';
        document.getElementById('forecast-list').innerHTML = html;
      } catch {}
    }

    // --- Bind event handlers (CSP-safe) ---
    bindEvents([
      ['sync-btn', 'click', syncTransactions],
      ['balance-btn', 'click', syncBalances],
      ['detect-btn', 'click', runDetection],
    ]);
    onDelegate('accounts-grid', 'change', 'input[data-apr-account]', function() {
      setApr(parseInt(this.dataset.aprAccount), this.value);
    });
    onDelegate('accounts-grid', 'click', 'button[data-shared-toggle]', function() {
      toggleShared(parseInt(this.dataset.sharedToggle));
    });
    onDelegate('accounts-grid', 'click', 'button[data-edit-balance]', function() {
      editManualBalance(parseInt(this.dataset.editBalance));
    });

    // Initialize
    loadAccounts();
    loadSpendingSummary();
    loadForecast();

    // Load upcoming bills for calendar widget
    (async function loadCalendarWidget() {
      var body = document.getElementById('calendar-widget-body');
      if (!body) return;
      try {
        var now = new Date();
        var res = await apiFetch('/api/bill-calendar?year=' + now.getFullYear() + '&month=' + (now.getMonth() + 1));
        if (!res.ok) { body.textContent = 'Unable to load.'; return; }
        var data = await res.json();
        var today = now.getDate();
        var upcoming = [];
        for (var i = 0; i < data.days.length; i++) {
          var day = data.days[i];
          if (day.day >= today && day.events.length > 0) {
            for (var j = 0; j < day.events.length; j++) {
              upcoming.push({ day: day.day, event: day.events[j] });
            }
          }
          if (upcoming.length >= 6) break;
        }
        if (upcoming.length === 0) { body.textContent = 'No upcoming bills this month.'; return; }
        body.innerHTML = upcoming.map(function(u) {
          var ev = u.event;
          var cls = ev.is_income ? 'color:var(--green)' : 'color:var(--text-muted)';
          var prefix = ev.is_income ? '+' : '-';
          var paid = ev.is_paid ? ' style="text-decoration:line-through;opacity:0.5;"' : '';
          return '<div' + paid + ' style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);font-size:12px;">' +
            '<span>' + (ev.is_paid ? '\u2713 ' : '') + esc(ev.name) + ' <span style="color:var(--text-muted);font-size:11px;">(Day ' + u.day + ')</span></span>' +
            '<span style="' + cls + ';">' + prefix + '$' + Math.abs(ev.amount).toFixed(2) + '</span></div>';
        }).join('');
      } catch (e) { body.textContent = 'Unable to load.'; }
    })();

    // Load latest AI insight for the dashboard widget
    (async function loadInsightWidget() {
      var body = document.getElementById('insights-widget-body');
      var meta = document.getElementById('insights-widget-meta');
      if (!body) return;
      try {
        var res = await apiFetch('/api/insights');
        if (!res.ok) { body.textContent = 'No insights yet \u2014 generate from Settings.'; return; }
        var data = await res.json();
        if (!data.length) { body.textContent = 'No insights yet \u2014 generate from Settings.'; return; }
        var latest = data[0];
        var text = esc(latest.insight_text || '');
        text = text
          .replace(/^#{3}\s*(.+)$/gm, '<h4 style="margin:12px 0 6px;font-size:14px;font-weight:600;color:var(--text-primary);">$1</h4>')
          .replace(/^#{2}\s*(.+)$/gm, '<h3 style="margin:12px 0 6px;font-size:15px;font-weight:600;color:var(--text-primary);">$1</h3>')
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
          .replace(/^[\-\*] (.+)$/gm, '<li>$1</li>')
          .replace(/(<li>.*<\/li>)/gs, '<ul style="margin:4px 0 8px 16px;padding:0;">$1</ul>')
          .replace(/\n/g, '<br>');
        body.innerHTML = text;
        if (latest.created_at) {
          var d = new Date(latest.created_at);
          meta.textContent = '\u2014 ' + d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }
      } catch (e) { body.textContent = 'Unable to load insights.'; }
    })();

    // PWA
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});

    // ── Financial Pyramid — Separated Layers ──────────────────
    // Multi-color palette for layers (used in multi-color mode)
    var LAYER_COLORS = [
      { fill: '255,180,100', edge: '255,180,100' },  // orange (base)
      { fill: '130,190,90',  edge: '130,190,90' },   // green
      { fill: '100,175,230', edge: '100,175,230' },   // blue
      { fill: '230,120,160', edge: '230,120,160' },   // pink (apex)
    ];
    var SINGLE_FILL = '200,133,108'; // amber-orange

    // Data source configurations — labels + scoring functions
    var PYRAMID_MODES = {
      wellness: {
        title: 'Financial Wellness',
        tiers: ['Accounts', 'Budgets', 'Subs', 'Goals'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          try {
            var acctRes = await apiFetch('/api/accounts');
            var accounts = acctRes.ok ? await acctRes.json() : [];
            if (accounts.length > 0) { score += 25; tierScores[0] = 100; }
            try {
              var budRes = await apiFetch('/api/budgets');
              var budgets = budRes.ok ? await budRes.json() : [];
              if (budgets.length > 0) {
                var underBudget = budgets.filter(function(b) { return b.percent_used <= 100; }).length;
                var ratio = underBudget / budgets.length;
                score += Math.round(25 * ratio); tierScores[1] = Math.round(ratio * 100);
              }
            } catch (e) {}
            try {
              var subRes = await apiFetch('/api/subscriptions?filter=all');
              var subs = subRes.ok ? await subRes.json() : [];
              if (subs.length > 0) {
                score += 15; tierScores[2] = 60;
                var managed = subs.filter(function(s) { return s.is_dismissed || s.is_canceled; }).length;
                if (managed > 0) { var bonus = Math.min(10, Math.round(10 * (managed / subs.length))); score += bonus; tierScores[2] = 60 + Math.round(bonus * 4); }
              }
            } catch (e) {}
            try {
              var goalRes = await apiFetch('/api/goals');
              var goals = goalRes.ok ? await goalRes.json() : [];
              var activeGoals = goals.filter(function(g) { return g.is_active; });
              if (activeGoals.length > 0) {
                var avgProg = activeGoals.reduce(function(s, g) { return s + Math.min(100, g.percent_complete); }, 0) / activeGoals.length;
                score += Math.round(25 * (avgProg / 100)); tierScores[3] = Math.round(avgProg);
              }
            } catch (e) {}
            score = Math.min(100, score);
            if (score >= 90) statusMsg = 'Excellent financial health';
            else if (score >= 70) statusMsg = 'Strong financial foundation';
            else if (score >= 50) statusMsg = 'Building good habits';
            else if (score >= 25) statusMsg = 'Getting started on your journey';
            else statusMsg = 'Link accounts to begin tracking';
          } catch (e) { statusMsg = 'Could not compute score'; }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      },
      debt_payoff: {
        title: 'Debt Payoff',
        tiers: ['Progress', 'Paid Off', 'Remaining', 'Freedom'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          try {
            var acctRes = await apiFetch('/api/accounts');
            var accounts = acctRes.ok ? await acctRes.json() : [];
            var creditAccts = accounts.filter(function(a) { return a.type === 'credit' || a.subtype === 'credit_card'; });
            var totalDebt = 0;
            creditAccts.forEach(function(a) {
              totalDebt += Math.abs(parseFloat(a.current_balance || a.available_balance || 0));
            });

            // Get baseline from settings (or auto-set from current debt)
            var setRes = await apiFetch('/api/settings');
            var settings = setRes.ok ? await setRes.json() : {};
            var baseline = parseFloat(settings.debt_baseline_amount);
            if (!baseline || isNaN(baseline) || baseline <= 0) {
              // Auto-initialize baseline to current debt if not set
              if (totalDebt > 0) {
                baseline = totalDebt;
                apiFetch('/api/settings', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ debt_baseline_amount: totalDebt }) }).catch(function(){});
              } else {
                // No debt, no baseline — 100%
                score = 100; tierScores = [100,100,100,100];
                return { score: score, tierScores: tierScores, status: 'Debt-free!' };
              }
            }

            // Progress: how much of the baseline has been paid off
            var paidOff = Math.max(0, baseline - totalDebt);
            score = baseline > 0 ? Math.round((paidOff / baseline) * 100) : 100;
            score = Math.min(100, Math.max(0, score));

            // Distribute across 4 tiers as quartile milestones (25/50/75/100%)
            tierScores[0] = Math.min(100, Math.round(score * 4));         // fills at 25%
            tierScores[1] = Math.min(100, Math.max(0, (score - 25) * 4)); // fills at 50%
            tierScores[2] = Math.min(100, Math.max(0, (score - 50) * 4)); // fills at 75%
            tierScores[3] = Math.min(100, Math.max(0, (score - 75) * 4)); // fills at 100%

            var fmtDebt = '$' + totalDebt.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0});
            var fmtBase = '$' + baseline.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0});
            if (score >= 100) statusMsg = 'Debt-free! Started at ' + fmtBase;
            else if (score >= 75) statusMsg = fmtDebt + ' left — almost there!';
            else if (score >= 50) statusMsg = fmtDebt + ' remaining of ' + fmtBase;
            else if (score >= 25) statusMsg = fmtDebt + ' remaining — keep going';
            else statusMsg = fmtDebt + ' of ' + fmtBase + ' to pay off';
          } catch (e) { statusMsg = 'Could not compute score'; }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      },
      goal_progress: {
        title: 'Goal Progress',
        tiers: ['Goal 1', 'Goal 2', 'Goal 3', 'Overall'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          var tierLabels = ['Goal 1', 'Goal 2', 'Goal 3', 'Overall'];
          try {
            var goalRes = await apiFetch('/api/goals');
            var goals = goalRes.ok ? await goalRes.json() : [];
            var active = goals.filter(function(g) { return g.is_active; });
            if (active.length === 0) {
              statusMsg = 'Set goals to track progress';
            } else {
              // Show up to 3 individual goals, 4th tier = overall average
              var shown = active.slice(0, 3);
              var totalPct = 0;
              for (var i = 0; i < shown.length; i++) {
                var g = shown[i];
                var pct = Math.min(100, g.percent_complete || 0);
                tierScores[i] = Math.round(pct);
                totalPct += pct;
                tierLabels[i] = g.name.length > 12 ? g.name.substring(0, 11) + '…' : g.name;
              }
              // Overall average across ALL active goals (not just shown 3)
              var allAvg = active.reduce(function(s, g) { return s + Math.min(100, g.percent_complete || 0); }, 0) / active.length;
              tierScores[3] = Math.round(allAvg);
              score = Math.round(allAvg);

              if (score >= 90) statusMsg = 'Goals nearly achieved!';
              else if (score >= 70) statusMsg = 'Excellent goal progress';
              else if (score >= 50) statusMsg = 'On track with your goals';
              else if (score >= 25) statusMsg = 'Goals in early stages';
              else statusMsg = 'Just getting started';
              if (active.length > 3) statusMsg += ' (' + active.length + ' goals total)';
            }
          } catch (e) { statusMsg = 'Could not load goals'; }
          // Update tier labels dynamically
          for (var j = 0; j < 4; j++) {
            var lbl = document.getElementById('tier-' + j);
            if (lbl) lbl.textContent = tierLabels[j];
          }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      },
      spending_categories: {
        title: 'Spending Health',
        tiers: ['Essentials', 'Lifestyle', 'Subs', 'Savings'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          try {
            var sumRes = await apiFetch('/api/spending-summary');
            var summary = sumRes.ok ? await sumRes.json() : {};
            var cats = summary.categories || {};
            var total = Object.values(cats).reduce(function(s, v) { return s + v; }, 0) || 1;
            // Rough categorization
            var essentials = (cats['Groceries'] || 0) + (cats['Utilities'] || 0) + (cats['Housing'] || 0) + (cats['Insurance'] || 0);
            var lifestyle = (cats['Dining'] || 0) + (cats['Entertainment'] || 0) + (cats['Shopping'] || 0) + (cats['Travel'] || 0);
            var subscriptions = (cats['Subscriptions'] || 0) + (cats['Software'] || 0);
            // Ideal: essentials ~50%, lifestyle ~30%, subs ~10%, savings ~10%
            var essPct = essentials / total;
            tierScores[0] = Math.round(Math.max(0, 100 - Math.abs(essPct - 0.5) * 200));
            tierScores[1] = Math.round(Math.max(0, 100 - Math.max(0, (lifestyle / total - 0.3)) * 300));
            tierScores[2] = Math.round(Math.max(0, 100 - Math.max(0, (subscriptions / total - 0.1)) * 500));
            tierScores[3] = Math.round(Math.min(100, (1 - (essentials + lifestyle + subscriptions) / total) * 200));
            score = Math.round((tierScores[0] + tierScores[1] + tierScores[2] + tierScores[3]) / 4);
            if (score >= 80) statusMsg = 'Well-balanced spending';
            else if (score >= 60) statusMsg = 'Good spending habits';
            else if (score >= 40) statusMsg = 'Room for improvement';
            else statusMsg = 'Review your spending mix';
          } catch (e) { statusMsg = 'Could not analyze spending'; }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      },
      net_worth: {
        title: 'Net Worth',
        tiers: ['Cash', 'Credit', 'Assets', 'Growth'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          try {
            var acctRes = await apiFetch('/api/accounts');
            var accounts = acctRes.ok ? await acctRes.json() : [];
            var totalAssets = 0; var totalDebt = 0;
            accounts.forEach(function(a) {
              var bal = parseFloat(a.current_balance || a.available_balance || 0);
              if (a.type === 'credit' || a.subtype === 'credit_card') totalDebt += Math.abs(bal);
              else if (bal > 0) totalAssets += bal;
            });
            var netWorth = totalAssets - totalDebt;
            // Tier 0: Cash position (any positive balances)
            tierScores[0] = totalAssets > 0 ? Math.min(100, Math.round(totalAssets / 100)) : 0;
            // Tier 1: Credit utilization (lower debt = higher score)
            tierScores[1] = totalDebt === 0 ? 100 : Math.round(Math.max(0, (1 - totalDebt / Math.max(totalAssets, 1))) * 100);
            // Tier 2: Net worth positive
            tierScores[2] = netWorth > 0 ? Math.min(100, Math.round(netWorth / 50)) : 0;
            // Tier 3: Growth (check history)
            try {
              var nwRes = await apiFetch('/api/net-worth/history');
              var nwData = nwRes.ok ? await nwRes.json() : [];
              if (nwData.length >= 2) {
                var latest = parseFloat(nwData[nwData.length - 1].net_worth || 0);
                var previous = parseFloat(nwData[0].net_worth || 0);
                tierScores[3] = latest > previous ? Math.min(100, Math.round(((latest - previous) / Math.max(Math.abs(previous), 1)) * 100)) : 0;
              }
            } catch (e) {}
            score = Math.round((tierScores[0] + tierScores[1] + tierScores[2] + tierScores[3]) / 4);
            score = Math.min(100, Math.max(0, score));
            var fmtNw = netWorth >= 0 ? '$' + netWorth.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0}) : '-$' + Math.abs(netWorth).toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0});
            statusMsg = 'Net worth: ' + fmtNw;
          } catch (e) { statusMsg = 'Could not compute net worth'; }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      }
    };

    // Spawn rising neon orbs (teal/blue/cyan + amber/orange biased right)
    (function spawnOrbs() {
      var container = document.getElementById('pyramid-orbs');
      if (!container) return;
      var tealOrbs = ['orb-teal', 'orb-blue', 'orb-cyan'];
      var warmOrbs = ['orb-amber', 'orb-orange'];
      function createOrb() {
        var isWarm = Math.random() < 0.35;
        var orb = document.createElement('div');
        var cls = isWarm ? warmOrbs[Math.floor(Math.random() * warmOrbs.length)] : tealOrbs[Math.floor(Math.random() * tealOrbs.length)];
        orb.className = 'orb ' + cls;
        var size = 3 + Math.random() * 6;
        // Both warm and teal orbs spread evenly across left, center, and right
        var x = 90 + (Math.random() - 0.5) * 160;
        var duration = 3.5 + Math.random() * 3.5;
        var delay = Math.random() * 1.5;
        orb.style.cssText = 'width:' + size + 'px;height:' + size + 'px;left:' + x + 'px;bottom:40px;animation-duration:' + duration + 's;animation-delay:' + delay + 's;';
        container.appendChild(orb);
        setTimeout(function() { orb.remove(); }, (duration + delay) * 1000);
      }
      for (var i = 0; i < 10; i++) setTimeout(createOrb, i * 250);
      setInterval(function() { createOrb(); }, 800);
    })();

    // Current pyramid state
    var currentPyramidMode = 'wellness';
    var currentColorMode = 'single';

    // Load pyramid settings and compute
    async function computeWellness(overrideSource) {
      var dataSource = overrideSource || currentPyramidMode;
      var colorMode = currentColorMode;

      if (!overrideSource) {
        try {
          var setRes = await apiFetch('/api/settings');
          if (setRes.ok) {
            var settings = await setRes.json();
            dataSource = settings.pyramid_data_source || 'wellness';
            colorMode = settings.pyramid_color_mode || 'single';
            currentPyramidMode = dataSource;
            currentColorMode = colorMode;
            // Pre-fill debt baseline input
            var baselineInput = document.getElementById('debt-baseline-input');
            if (baselineInput && settings.debt_baseline_amount) {
              baselineInput.value = Math.round(parseFloat(settings.debt_baseline_amount));
            }
          }
        } catch (e) {}
      }

      // Update switcher active state
      var btns = document.querySelectorAll('#pyramid-switcher button[data-mode]');
      btns.forEach(function(b) {
        b.classList.toggle('active', b.dataset.mode === dataSource);
      });

      // Show/hide debt baseline control
      var baselineCtrl = document.getElementById('debt-baseline-ctrl');
      if (baselineCtrl) baselineCtrl.style.display = dataSource === 'debt_payoff' ? 'flex' : 'none';

      var mode = PYRAMID_MODES[dataSource] || PYRAMID_MODES.wellness;

      // Update title and tier labels
      var titleEl = document.getElementById('pyramid-title');
      if (titleEl) titleEl.textContent = mode.title;
      for (var t = 0; t < 4; t++) {
        var lbl = document.getElementById('tier-' + t);
        if (lbl) lbl.textContent = mode.tiers[t];
      }

      var result = await mode.compute();
      updatePyramid(result.score, result.tierScores, result.status, colorMode);
    }

    // Pyramid view switcher
    document.getElementById('pyramid-switcher').addEventListener('click', function(e) {
      var btn = e.target.closest('button[data-mode]');
      if (!btn) return;
      var mode = btn.dataset.mode;
      currentPyramidMode = mode;
      // Persist to settings
      apiFetch('/api/settings', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ pyramid_data_source: mode }) }).catch(function(){});
      computeWellness(mode);
    });

    // Debt baseline save
    document.getElementById('debt-baseline-save').addEventListener('click', function() {
      var val = parseFloat(document.getElementById('debt-baseline-input').value);
      if (isNaN(val) || val < 0) return;
      apiFetch('/api/settings', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ debt_baseline_amount: val }) })
        .then(function() { computeWellness('debt_payoff'); });
    });

    var isMobile = window.matchMedia('(max-width: 640px)').matches;

    function updatePyramid(score, tierScores, statusMsg, colorMode) {
      var fill = score / 100;

      // Neon edge color based on overall score
      var neonRgb;
      if (score >= 75) neonRgb = '111,207,151';
      else if (score >= 50) neonRgb = '90,143,143';
      else if (score >= 25) neonRgb = '127,181,230';
      else neonRgb = '90,143,143';

      var glowSize = Math.round(4 + fill * 8);

      // Update each layer independently
      for (var layerIdx = 0; layerIdx < 4; layerIdx++) {
        var layer = document.getElementById('layer-' + layerIdx);
        if (!layer) continue;
        var tierFill = (tierScores[layerIdx] || 0) / 100;

        // Choose fill color: single (amber) or multi-color per layer
        var fillRgb = colorMode === 'multi' ? LAYER_COLORS[layerIdx].fill : SINGLE_FILL;
        var edgeRgb = colorMode === 'multi' ? LAYER_COLORS[layerIdx].edge : neonRgb;
        var strokeColor = 'rgba(' + edgeRgb + ',' + (0.5 + tierFill * 0.5) + ')';
        var layerGlow = Math.round(3 + tierFill * 6);

        // Compute layer-level dim factor (applied per-face to avoid breaking preserve-3d)
        var layerDim = tierFill > 0 ? (0.6 + tierFill * 0.4) : 0.3;

        // Update faces within this layer — opacity set per-face, never on layer container
        var faces = layer.querySelectorAll('.layer-face');
        var faceOpacities = [1, 0.9, 0.65, 0.9];
        faces.forEach(function(face, fi) {
          face.style.opacity = faceOpacities[fi] * layerDim;
          // Edge lines
          face.querySelectorAll('.face-edges line').forEach(function(line) {
            line.setAttribute('stroke', strokeColor);
            if (!isMobile) {
              line.style.filter = 'drop-shadow(0 0 ' + layerGlow + 'px rgba(' + edgeRgb + ',0.6)) drop-shadow(0 0 ' + (layerGlow * 2) + 'px rgba(' + edgeRgb + ',0.3))';
            }
          });
          // Fill glow — intensity based on tier score
          var faceFill = face.querySelector('.face-fill');
          if (faceFill) {
            faceFill.style.opacity = 0.3 + tierFill * 0.7;
            faceFill.style.background = 'linear-gradient(to top, rgba(' + fillRgb + ',' + (0.15 + tierFill * 0.35) + ') 0%, rgba(' + fillRgb + ',0.05) 80%, transparent 100%)';
          }
        });

        // Activate tier label
        var lbl = document.getElementById('tier-' + layerIdx);
        if (lbl) {
          if (tierFill > 0) {
            lbl.classList.add('active');
            lbl.style.color = colorMode === 'multi' ? 'rgb(' + LAYER_COLORS[layerIdx].edge + ')' : (score >= 75 ? 'var(--green)' : score >= 50 ? 'var(--teal)' : 'var(--blue)');
          } else {
            lbl.classList.remove('active');
          }
        }
      }

      // Update base neon glow
      var base = document.querySelector('.pyramid-base');
      if (base) {
        base.style.borderColor = 'rgba(' + neonRgb + ',' + (0.3 + fill * 0.4) + ')';
        base.style.boxShadow = 'inset 0 0 ' + Math.round(15 + fill * 25) + 'px rgba(' + neonRgb + ',0.08), 0 0 ' + Math.round(6 + fill * 15) + 'px rgba(' + neonRgb + ',' + (0.15 + fill * 0.25) + ')';
      }

      // Update glow underneath
      var glow = document.getElementById('pyramid-glow');
      if (glow) {
        glow.style.opacity = 0.3 + fill * 0.7;
        if (colorMode === 'multi') {
          glow.style.background = 'radial-gradient(ellipse, rgba(' + LAYER_COLORS[0].fill + ',0.35) 0%, rgba(' + LAYER_COLORS[2].fill + ',0.15) 40%, transparent 65%)';
        } else {
          glow.style.background = 'radial-gradient(ellipse, rgba(' + SINGLE_FILL + ',' + (0.3 + fill * 0.25) + ') 0%, rgba(' + neonRgb + ',' + (0.15 + fill * 0.1) + ') 40%, transparent 65%)';
        }
      }

      // Animate score number
      animateCounter(document.getElementById('wellness-score'), score, '%');

      // Score color
      var scoreEl = document.getElementById('wellness-score');
      if (score >= 75) { scoreEl.style.color = 'var(--green)'; scoreEl.style.textShadow = '0 0 20px rgba(111,207,151,0.4)'; }
      else if (score >= 50) { scoreEl.style.color = 'var(--teal)'; scoreEl.style.textShadow = '0 0 20px rgba(90,143,143,0.4)'; }
      else if (score >= 25) { scoreEl.style.color = 'var(--blue)'; scoreEl.style.textShadow = '0 0 20px rgba(127,181,230,0.4)'; }
      else { scoreEl.style.color = 'var(--teal)'; scoreEl.style.textShadow = '0 0 15px rgba(90,143,143,0.3)'; }

      document.getElementById('wellness-status').textContent = statusMsg;
    }

    function animateCounter(el, target, suffix) {
      if (!el) return;
      suffix = suffix || '';
      var current = 0;
      var duration = 1200;
      var steps = 30;
      var increment = target / steps;
      var stepTime = duration / steps;
      var timer = setInterval(function() {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        el.textContent = Math.round(current) + suffix;
      }, stepTime);
    }

    // Animated currency counter (counts up from 0, formats as $X,XXX.XX)
    function animateCurrency(el, target) {
      if (!el || isNaN(target)) return;
      var current = 0;
      var duration = 1000;
      var steps = 25;
      var increment = target / steps;
      var stepTime = duration / steps;
      var neg = target < 0;
      var absTarget = Math.abs(target);
      var absCurrent = 0;
      var absIncrement = absTarget / steps;
      var timer = setInterval(function() {
        absCurrent += absIncrement;
        if (absCurrent >= absTarget) {
          absCurrent = absTarget;
          clearInterval(timer);
        }
        el.textContent = (neg ? '-' : '') + fmt(absCurrent);
      }, stepTime);
    }

    // Animated integer counter
    function animateInt(el, target) {
      if (!el || isNaN(target)) return;
      animateCounter(el, target, '');
    }

