          apiFetch('/api/whats-new/seen', { method: 'POST' }).catch(function() {});
        }, 4000);
      } catch (e) { /* silently hide */ }
    })();

    // PWA — use the shared helper so the SW URL + scope respect BASE_PATH
    // under the unified shell. Hardcoding '/sw.js' here registered at root
    // scope under /perfin/* and 404'd because the shell doesn't serve /sw.js.
    if (typeof registerSW === 'function') registerSW();

    // ── Financial Pyramid — Separated Layers ──────────────────
    // Multi-color palette for layers (used in multi-color mode)
    var LAYER_COLORS = [
      { fill: '255,180,100', edge: '255,180,100' },  // orange (base)
      { fill: '130,190,90',  edge: '130,190,90' },   // green
      { fill: '100,175,230', edge: '100,175,230' },   // blue
      { fill: '230,120,160', edge: '230,120,160' },   // pink (apex)
    ];
    var SINGLE_FILL = '200,133,108'; // amber-orange

    // Data source configurations — labels + scoring functions
    var PYRAMID_MODES = {
      wellness: {
        title: 'Financial Wellness',
        tiers: ['Accounts', 'Budgets', 'Subs', 'Goals'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          try {
            var acctRes = await apiFetch('/api/accounts');
            var accounts = acctRes.ok ? await acctRes.json() : [];
            if (accounts.length > 0) { score += 25; tierScores[0] = 100; }
            try {
              var budRes = await apiFetch('/api/budgets');
              var budgets = budRes.ok ? await budRes.json() : [];
              if (budgets.length > 0) {
                var underBudget = budgets.filter(function(b) { return b.percent_used <= 100; }).length;
                var ratio = underBudget / budgets.length;
                score += Math.round(25 * ratio); tierScores[1] = Math.round(ratio * 100);
              }
            } catch (e) {}
            try {
              var subRes = await apiFetch('/api/subscriptions?filter=all');
              var subs = subRes.ok ? await subRes.json() : [];
              if (subs.length > 0) {
                score += 15; tierScores[2] = 60;
                var managed = subs.filter(function(s) { return s.is_dismissed || s.is_canceled; }).length;
                if (managed > 0) { var bonus = Math.min(10, Math.round(10 * (managed / subs.length))); score += bonus; tierScores[2] = 60 + Math.round(bonus * 4); }
              }
            } catch (e) {}
            try {
              var goalRes = await apiFetch('/api/goals');
              var goals = goalRes.ok ? await goalRes.json() : [];
              var activeGoals = goals.filter(function(g) { return g.is_active; });
              if (activeGoals.length > 0) {
                var avgProg = activeGoals.reduce(function(s, g) { return s + Math.min(100, g.percent_complete); }, 0) / activeGoals.length;
                score += Math.round(25 * (avgProg / 100)); tierScores[3] = Math.round(avgProg);
              }
            } catch (e) {}
            score = Math.min(100, score);
            if (score >= 90) statusMsg = 'Excellent financial health';
            else if (score >= 70) statusMsg = 'Strong financial foundation';
            else if (score >= 50) statusMsg = 'Building good habits';
            else if (score >= 25) statusMsg = 'Getting started on your journey';
            else statusMsg = 'Link accounts to begin tracking';
          } catch (e) { statusMsg = 'Could not compute score'; }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      },
      debt_payoff: {
        title: 'Debt Payoff',
        tiers: ['Progress', 'Paid Off', 'Remaining', 'Freedom'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          try {
            var acctRes = await apiFetch('/api/accounts');
            var accounts = acctRes.ok ? await acctRes.json() : [];
            var creditAccts = accounts.filter(function(a) { return a.type === 'credit' || a.subtype === 'credit_card'; });
            var totalDebt = 0;
            creditAccts.forEach(function(a) {
              totalDebt += Math.abs(parseFloat(a.current_balance || a.available_balance || 0));
            });

            // Get baseline from settings (or auto-set from current debt)
            var setRes = await apiFetch('/api/settings');
            var settings = setRes.ok ? await setRes.json() : {};
            var baseline = parseFloat(settings.debt_baseline_amount);
            if (!baseline || isNaN(baseline) || baseline <= 0) {
              // Auto-initialize baseline to current debt if not set
              if (totalDebt > 0) {
                baseline = totalDebt;
                apiFetch('/api/settings', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ debt_baseline_amount: totalDebt }) }).catch(function(){});
              } else {
                // No debt, no baseline — 100%
                score = 100; tierScores = [100,100,100,100];
                return { score: score, tierScores: tierScores, status: 'Debt-free!' };
              }
            }

            // Progress: how much of the baseline has been paid off
            var paidOff = Math.max(0, baseline - totalDebt);
            score = baseline > 0 ? Math.round((paidOff / baseline) * 100) : 100;
            score = Math.min(100, Math.max(0, score));

            // Distribute across 4 tiers as quartile milestones (25/50/75/100%)
            tierScores[0] = Math.min(100, Math.round(score * 4));         // fills at 25%
            tierScores[1] = Math.min(100, Math.max(0, (score - 25) * 4)); // fills at 50%
            tierScores[2] = Math.min(100, Math.max(0, (score - 50) * 4)); // fills at 75%
            tierScores[3] = Math.min(100, Math.max(0, (score - 75) * 4)); // fills at 100%

            var fmtDebt = '$' + totalDebt.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0});
            var fmtBase = '$' + baseline.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0});
            if (score >= 100) statusMsg = 'Debt-free! Started at ' + fmtBase;
            else if (score >= 75) statusMsg = fmtDebt + ' left — almost there!';
            else if (score >= 50) statusMsg = fmtDebt + ' remaining of ' + fmtBase;
            else if (score >= 25) statusMsg = fmtDebt + ' remaining — keep going';
            else statusMsg = fmtDebt + ' of ' + fmtBase + ' to pay off';
          } catch (e) { statusMsg = 'Could not compute score'; }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      },
      goal_progress: {
        title: 'Goal Progress',
        tiers: ['Goal 1', 'Goal 2', 'Goal 3', 'Overall'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          var tierLabels = ['Goal 1', 'Goal 2', 'Goal 3', 'Overall'];
          try {
            var goalRes = await apiFetch('/api/goals');
            var goals = goalRes.ok ? await goalRes.json() : [];
            var active = goals.filter(function(g) { return g.is_active; });
            if (active.length === 0) {
              statusMsg = 'Set goals to track progress';
            } else {
              // Show up to 3 individual goals, 4th tier = overall average
              var shown = active.slice(0, 3);
              var totalPct = 0;
              for (var i = 0; i < shown.length; i++) {
                var g = shown[i];
                var pct = Math.min(100, g.percent_complete || 0);
                tierScores[i] = Math.round(pct);
                totalPct += pct;
                tierLabels[i] = g.name.length > 12 ? g.name.substring(0, 11) + '…' : g.name;
              }
              // Overall average across ALL active goals (not just shown 3)
              var allAvg = active.reduce(function(s, g) { return s + Math.min(100, g.percent_complete || 0); }, 0) / active.length;
              tierScores[3] = Math.round(allAvg);
              score = Math.round(allAvg);

              if (score >= 90) statusMsg = 'Goals nearly achieved!';
              else if (score >= 70) statusMsg = 'Excellent goal progress';
              else if (score >= 50) statusMsg = 'On track with your goals';
              else if (score >= 25) statusMsg = 'Goals in early stages';
              else statusMsg = 'Just getting started';
              if (active.length > 3) statusMsg += ' (' + active.length + ' goals total)';
            }
          } catch (e) { statusMsg = 'Could not load goals'; }
          // Update tier labels dynamically
          for (var j = 0; j < 4; j++) {
            var lbl = document.getElementById('tier-' + j);
            if (lbl) lbl.textContent = tierLabels[j];
          }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      },
      spending_categories: {
        title: 'Spending Health',
        tiers: ['Essentials', 'Lifestyle', 'Subs', 'Savings'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          try {
            var sumRes = await apiFetch('/api/spending-summary');
            var summary = sumRes.ok ? await sumRes.json() : {};
            var cats = summary.categories || {};
            var total = Object.values(cats).reduce(function(s, v) { return s + v; }, 0) || 1;
            // Rough categorization
            var essentials = (cats['Groceries'] || 0) + (cats['Utilities'] || 0) + (cats['Housing'] || 0) + (cats['Insurance'] || 0);
            var lifestyle = (cats['Dining'] || 0) + (cats['Entertainment'] || 0) + (cats['Shopping'] || 0) + (cats['Travel'] || 0);
            var subscriptions = (cats['Subscriptions'] || 0) + (cats['Software'] || 0);
            // Ideal: essentials ~50%, lifestyle ~30%, subs ~10%, savings ~10%
            var essPct = essentials / total;
            tierScores[0] = Math.round(Math.max(0, 100 - Math.abs(essPct - 0.5) * 200));
            tierScores[1] = Math.round(Math.max(0, 100 - Math.max(0, (lifestyle / total - 0.3)) * 300));
            tierScores[2] = Math.round(Math.max(0, 100 - Math.max(0, (subscriptions / total - 0.1)) * 500));
            tierScores[3] = Math.round(Math.min(100, (1 - (essentials + lifestyle + subscriptions) / total) * 200));
            score = Math.round((tierScores[0] + tierScores[1] + tierScores[2] + tierScores[3]) / 4);
            if (score >= 80) statusMsg = 'Well-balanced spending';
            else if (score >= 60) statusMsg = 'Good spending habits';
            else if (score >= 40) statusMsg = 'Room for improvement';
            else statusMsg = 'Review your spending mix';
          } catch (e) { statusMsg = 'Could not analyze spending'; }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      },
      net_worth: {
        title: 'Net Worth',
        tiers: ['Cash', 'Credit', 'Assets', 'Growth'],
        compute: async function() {
          var score = 0; var tierScores = [0,0,0,0]; var statusMsg = '';
          try {
            var acctRes = await apiFetch('/api/accounts');
            var accounts = acctRes.ok ? await acctRes.json() : [];
            var totalAssets = 0; var totalDebt = 0;
            accounts.forEach(function(a) {
              var bal = parseFloat(a.current_balance || a.available_balance || 0);
              if (a.type === 'credit' || a.subtype === 'credit_card') totalDebt += Math.abs(bal);
              else if (bal > 0) totalAssets += bal;
            });
            var netWorth = totalAssets - totalDebt;
            // Tier 0: Cash position (any positive balances)
            tierScores[0] = totalAssets > 0 ? Math.min(100, Math.round(totalAssets / 100)) : 0;
            // Tier 1: Credit utilization (lower debt = higher score)
            tierScores[1] = totalDebt === 0 ? 100 : Math.round(Math.max(0, (1 - totalDebt / Math.max(totalAssets, 1))) * 100);
            // Tier 2: Net worth positive
            tierScores[2] = netWorth > 0 ? Math.min(100, Math.round(netWorth / 50)) : 0;
            // Tier 3: Growth (check history)
            try {
              var nwRes = await apiFetch('/api/net-worth/history');
              var nwData = nwRes.ok ? await nwRes.json() : [];
              if (nwData.length >= 2) {
                var latest = parseFloat(nwData[nwData.length - 1].net_worth || 0);
                var previous = parseFloat(nwData[0].net_worth || 0);
                tierScores[3] = latest > previous ? Math.min(100, Math.round(((latest - previous) / Math.max(Math.abs(previous), 1)) * 100)) : 0;
              }
            } catch (e) {}
            score = Math.round((tierScores[0] + tierScores[1] + tierScores[2] + tierScores[3]) / 4);
            score = Math.min(100, Math.max(0, score));
            var fmtNw = netWorth >= 0 ? '$' + netWorth.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0}) : '-$' + Math.abs(netWorth).toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0});
            statusMsg = 'Net worth: ' + fmtNw;
          } catch (e) { statusMsg = 'Could not compute net worth'; }
          return { score: score, tierScores: tierScores, status: statusMsg };
        }
      }
    };

    // Spawn rising neon orbs (teal/blue/cyan + amber/orange biased right)
    (function spawnOrbs() {
      var container = document.getElementById('pyramid-orbs');
      if (!container) return;
      var tealOrbs = ['orb-teal', 'orb-blue', 'orb-cyan'];
      var warmOrbs = ['orb-amber', 'orb-orange'];
      function createOrb() {
        var isWarm = Math.random() < 0.35;
        var orb = document.createElement('div');
        var cls = isWarm ? warmOrbs[Math.floor(Math.random() * warmOrbs.length)] : tealOrbs[Math.floor(Math.random() * tealOrbs.length)];
        orb.className = 'orb ' + cls;
        var size = 3 + Math.random() * 6;
        // Both warm and teal orbs spread evenly across left, center, and right
        var x = 90 + (Math.random() - 0.5) * 160;
        var duration = 3.5 + Math.random() * 3.5;
        var delay = Math.random() * 1.5;
        orb.style.cssText = 'width:' + size + 'px;height:' + size + 'px;left:' + x + 'px;bottom:40px;animation-duration:' + duration + 's;animation-delay:' + delay + 's;';
        container.appendChild(orb);
        setTimeout(function() { orb.remove(); }, (duration + delay) * 1000);
      }
      for (var i = 0; i < 10; i++) setTimeout(createOrb, i * 250);
      setInterval(function() { createOrb(); }, 800);
    })();

    // Current pyramid state
    var currentPyramidMode = 'wellness';
    var currentColorMode = 'single';

    // Load pyramid settings and compute
    async function computeWellness(overrideSource) {
      var dataSource = overrideSource || currentPyramidMode;
      var colorMode = currentColorMode;

      if (!overrideSource) {
        try {
          var setRes = await apiFetch('/api/settings');
          if (setRes.ok) {
            var settings = await setRes.json();
            dataSource = settings.pyramid_data_source || 'wellness';
            colorMode = settings.pyramid_color_mode || 'single';
            currentPyramidMode = dataSource;
            currentColorMode = colorMode;
            // Pre-fill debt baseline input
            var baselineInput = document.getElementById('debt-baseline-input');
            if (baselineInput && settings.debt_baseline_amount) {
              baselineInput.value = Math.round(parseFloat(settings.debt_baseline_amount));
            }
          }
        } catch (e) {}
      }

      // Update switcher active state
      var btns = document.querySelectorAll('#pyramid-switcher button[data-mode]');
      btns.forEach(function(b) {
        b.classList.toggle('active', b.dataset.mode === dataSource);
      });

      // Show/hide debt baseline control
      var baselineCtrl = document.getElementById('debt-baseline-ctrl');
      if (baselineCtrl) baselineCtrl.style.display = dataSource === 'debt_payoff' ? 'flex' : 'none';

      var mode = PYRAMID_MODES[dataSource] || PYRAMID_MODES.wellness;

      // Update title and tier labels
      var titleEl = document.getElementById('pyramid-title');
      if (titleEl) titleEl.textContent = mode.title;
      for (var t = 0; t < 4; t++) {
        var lbl = document.getElementById('tier-' + t);
        if (lbl) lbl.textContent = mode.tiers[t];
      }

      var result = await mode.compute();
      updatePyramid(result.score, result.tierScores, result.status, colorMode);
    }

    // Pyramid view switcher
    document.getElementById('pyramid-switcher').addEventListener('click', function(e) {
      var btn = e.target.closest('button[data-mode]');
      if (!btn) return;
      var mode = btn.dataset.mode;
      currentPyramidMode = mode;
      // Persist to settings
      apiFetch('/api/settings', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ pyramid_data_source: mode }) }).catch(function(){});
      computeWellness(mode);
    });

    // Debt baseline save
    document.getElementById('debt-baseline-save').addEventListener('click', function() {
      var val = parseFloat(document.getElementById('debt-baseline-input').value);
      if (isNaN(val) || val < 0) return;
      apiFetch('/api/settings', { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ debt_baseline_amount: val }) })
        .then(function() { computeWellness('debt_payoff'); });
    });

    var isMobile = window.matchMedia('(max-width: 640px)').matches;

    function updatePyramid(score, tierScores, statusMsg, colorMode) {
      var fill = score / 100;

      // Neon edge color based on overall score
      var neonRgb;
      if (score >= 75) neonRgb = '111,207,151';
      else if (score >= 50) neonRgb = '90,143,143';
      else if (score >= 25) neonRgb = '127,181,230';
      else neonRgb = '90,143,143';

      var glowSize = Math.round(4 + fill * 8);

      // Update each layer independently
      for (var layerIdx = 0; layerIdx < 4; layerIdx++) {
        var layer = document.getElementById('layer-' + layerIdx);
        if (!layer) continue;
        var tierFill = (tierScores[layerIdx] || 0) / 100;

        // Choose fill color: single (amber) or multi-color per layer
        var fillRgb = colorMode === 'multi' ? LAYER_COLORS[layerIdx].fill : SINGLE_FILL;
        var edgeRgb = colorMode === 'multi' ? LAYER_COLORS[layerIdx].edge : neonRgb;
        var strokeColor = 'rgba(' + edgeRgb + ',' + (0.5 + tierFill * 0.5) + ')';
        var layerGlow = Math.round(3 + tierFill * 6);

        // Compute layer-level dim factor (applied per-face to avoid breaking preserve-3d)
        var layerDim = tierFill > 0 ? (0.6 + tierFill * 0.4) : 0.3;

        // Update faces within this layer — opacity set per-face, never on layer container
        var faces = layer.querySelectorAll('.layer-face');
        var faceOpacities = [1, 0.9, 0.65, 0.9];
        faces.forEach(function(face, fi) {
          face.style.opacity = faceOpacities[fi] * layerDim;
          // Edge lines
          face.querySelectorAll('.face-edges line').forEach(function(line) {
            line.setAttribute('stroke', strokeColor);
            if (!isMobile) {
              line.style.filter = 'drop-shadow(0 0 ' + layerGlow + 'px rgba(' + edgeRgb + ',0.6)) drop-shadow(0 0 ' + (layerGlow * 2) + 'px rgba(' + edgeRgb + ',0.3))';
            }
          });
          // Fill glow — intensity based on tier score
          var faceFill = face.querySelector('.face-fill');
          if (faceFill) {
            faceFill.style.opacity = 0.3 + tierFill * 0.7;
            faceFill.style.background = 'linear-gradient(to top, rgba(' + fillRgb + ',' + (0.15 + tierFill * 0.35) + ') 0%, rgba(' + fillRgb + ',0.05) 80%, transparent 100%)';
          }
        });

        // Activate tier label
        var lbl = document.getElementById('tier-' + layerIdx);
        if (lbl) {
          if (tierFill > 0) {
            lbl.classList.add('active');
            lbl.style.color = colorMode === 'multi' ? 'rgb(' + LAYER_COLORS[layerIdx].edge + ')' : (score >= 75 ? 'var(--green)' : score >= 50 ? 'var(--teal)' : 'var(--blue)');
          } else {
            lbl.classList.remove('active');
          }
        }
      }

      // Update base neon glow
      var base = document.querySelector('.pyramid-base');
      if (base) {
        base.style.borderColor = 'rgba(' + neonRgb + ',' + (0.3 + fill * 0.4) + ')';
        base.style.boxShadow = 'inset 0 0 ' + Math.round(15 + fill * 25) + 'px rgba(' + neonRgb + ',0.08), 0 0 ' + Math.round(6 + fill * 15) + 'px rgba(' + neonRgb + ',' + (0.15 + fill * 0.25) + ')';
      }

      // Update glow underneath
      var glow = document.getElementById('pyramid-glow');
      if (glow) {
        glow.style.opacity = 0.3 + fill * 0.7;
        if (colorMode === 'multi') {
          glow.style.background = 'radial-gradient(ellipse, rgba(' + LAYER_COLORS[0].fill + ',0.35) 0%, rgba(' + LAYER_COLORS[2].fill + ',0.15) 40%, transparent 65%)';
        } else {
          glow.style.background = 'radial-gradient(ellipse, rgba(' + SINGLE_FILL + ',' + (0.3 + fill * 0.25) + ') 0%, rgba(' + neonRgb + ',' + (0.15 + fill * 0.1) + ') 40%, transparent 65%)';
        }
      }

      // Animate score number
      animateCounter(document.getElementById('wellness-score'), score, '%');

      // Score color
      var scoreEl = document.getElementById('wellness-score');
      if (score >= 75) { scoreEl.style.color = 'var(--green)'; scoreEl.style.textShadow = '0 0 20px rgba(111,207,151,0.4)'; }
      else if (score >= 50) { scoreEl.style.color = 'var(--teal)'; scoreEl.style.textShadow = '0 0 20px rgba(90,143,143,0.4)'; }
      else if (score >= 25) { scoreEl.style.color = 'var(--blue)'; scoreEl.style.textShadow = '0 0 20px rgba(127,181,230,0.4)'; }
      else { scoreEl.style.color = 'var(--teal)'; scoreEl.style.textShadow = '0 0 15px rgba(90,143,143,0.3)'; }

      document.getElementById('wellness-status').textContent = statusMsg;
    }

    function animateCounter(el, target, suffix) {
      if (!el) return;
      suffix = suffix || '';
      var current = 0;
      var duration = 1200;
      var steps = 30;
      var increment = target / steps;
      var stepTime = duration / steps;
      var timer = setInterval(function() {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        el.textContent = Math.round(current) + suffix;
      }, stepTime);
    }

    // Animated currency counter (counts up from 0, formats as $X,XXX.XX)
    function animateCurrency(el, target) {
      if (!el || isNaN(target)) return;
      var current = 0;
      var duration = 1000;
      var steps = 25;
      var increment = target / steps;
      var stepTime = duration / steps;
      var neg = target < 0;
      var absTarget = Math.abs(target);
      var absCurrent = 0;
      var absIncrement = absTarget / steps;
      var timer = setInterval(function() {
        absCurrent += absIncrement;
        if (absCurrent >= absTarget) {
          absCurrent = absTarget;
          clearInterval(timer);
        }
        el.textContent = (neg ? '-' : '') + fmt(absCurrent);
      }, stepTime);
    }

    // Animated integer counter
    function animateInt(el, target) {
      if (!el || isNaN(target)) return;
      animateCounter(el, target, '');
    }

    // --- CSV Import Reminder ---
