<%- include('partials/head', { title: 'Dashboard', extraStyles: `
    .container { max-width: 1060px; }
    .top-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
                 gap: 16px; margin-bottom: 36px; }
    .accounts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
                     gap: 12px; margin-bottom: 28px; animation: fadeInUp 0.4s ease both; animation-delay: 0.25s; }
    .acct-card { padding: 18px; border-radius: var(--radius); background: var(--surface);
                 border: 1px solid var(--border); transition: all 0.2s; }
    .acct-card:hover { border-color: var(--border-hover); }
    .acct-card .acct-inst { font-size: 10px; color: var(--text-muted); text-transform: uppercase;
                            letter-spacing: 1px; font-weight: 500; }
    .acct-card .acct-name { font-size: 14px; font-weight: 400; margin-top: 4px; }
    .acct-card .acct-mask { color: var(--text-muted); font-weight: 300; }
    .acct-card .acct-balance { font-size: 22px; font-weight: 300; margin-top: 10px;
                               font-variant-numeric: tabular-nums; }
    .acct-card .acct-balance.positive { color: var(--green); }
    .acct-card .acct-balance.negative { color: var(--red); }
    .acct-card .acct-balance.neutral { color: var(--warm-glow); }
    .acct-card .acct-type { font-size: 10px; color: var(--text-muted); margin-top: 4px;
                            text-transform: uppercase; letter-spacing: 0.5px; font-weight: 400; }
    .bar-container { width: 100%; height: 6px; background: rgba(255,255,255,0.06);
                     border-radius: 3px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 3px; transition: width 0.5s ease; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
    @media (max-width: 768px) { .two-col { grid-template-columns: 1fr; } }
    .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 28px;
                   animation: fadeInUp 0.4s ease both; animation-delay: 0.15s; }
    .chart-card { padding: 20px; border-radius: var(--radius); background: var(--surface);
                  border: 1px solid var(--border); backdrop-filter: blur(12px); }
    .chart-card h3 { font-size: 10px; font-weight: 500; color: var(--text-muted); text-transform: uppercase;
                     letter-spacing: 1.5px; margin-bottom: 16px; }
    .chart-card canvas { width: 100% !important; display: block; }
    .chart-wrap { position: relative; width: 100%; height: 240px; }
    @media (max-width: 640px) {
      .charts-grid { grid-template-columns: 1fr; }
      .two-col { grid-template-columns: 1fr; }
      .accounts-grid { grid-template-columns: 1fr; }
      .chart-wrap { height: 220px; }
    }

    /* ── Pyramid View Switcher ── */
    .pyramid-wrapper { display: flex; align-items: flex-start; justify-content: center; gap: 12px; }
    .pyramid-switcher { display: flex; flex-direction: column; gap: 6px; padding-top: 40px; }
    .pyramid-switcher button {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      color: var(--text-muted); font-size: 10px; padding: 8px 12px; cursor: pointer;
      text-transform: uppercase; letter-spacing: 0.8px; font-weight: 500;
      transition: all 0.2s; white-space: nowrap; text-align: left;
    }
    .pyramid-switcher button:hover { border-color: var(--border-hover); color: var(--text); }
    .pyramid-switcher button.active {
      border-color: var(--teal); color: var(--teal);
      box-shadow: 0 0 8px rgba(90,143,143,0.2);
    }
    .pyramid-debt-baseline {
      margin-top: 8px; font-size: 10px; color: var(--text-muted);
      display: flex; align-items: center; gap: 4px;
    }
    .pyramid-debt-baseline input {
      width: 90px; background: var(--surface); border: 1px solid var(--border);
      border-radius: 4px; padding: 3px 6px; color: var(--text); font-size: 10px;
      font-variant-numeric: tabular-nums;
    }
    .pyramid-debt-baseline button {
      background: var(--teal); border: none; border-radius: 4px; padding: 3px 8px;
      color: #1a1a2e; font-size: 9px; font-weight: 600; cursor: pointer;
    }
    @media (max-width: 640px) {
      .pyramid-wrapper { flex-direction: column; align-items: center; }
      .pyramid-switcher { flex-direction: row; flex-wrap: wrap; justify-content: center; padding-top: 0; }
    }

    /* ── Recent Transactions ── */
    .recent-txn-table { width: 100%; border-collapse: collapse; }
    .recent-txn-table th { font-size: 10px; font-weight: 500; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 1px; text-align: left; padding: 6px 8px;
      border-bottom: 1px solid var(--border); }
    .recent-txn-table td { padding: 8px; font-size: 13px; border-bottom: 1px solid var(--border); }
    .badge-pending { display: inline-block; font-size: 9px; padding: 1px 6px; border-radius: 8px;
      background: var(--warm-glow); color: #1a1a2e; font-weight: 600; letter-spacing: 0.5px; }
    .badge-posted { display: inline-block; font-size: 9px; padding: 1px 6px; border-radius: 8px;
      background: var(--green); color: #1a1a2e; font-weight: 600; letter-spacing: 0.5px; }

    /* ── Financial Pyramid — Separated Layers with Neon Hologram ── */
    .wellness-section {
      display: flex; flex-direction: column; align-items: center;
      margin-bottom: 44px; animation: fadeInUp 0.6s ease both; animation-delay: 0.08s;
    }
    .wellness-section h3 {
      font-size: 10px; font-weight: 500; color: var(--text-muted); text-transform: uppercase;
      letter-spacing: 2px; margin-bottom: 8px;
    }
    .pyramid-stage {
      position: relative; width: 340px; height: 360px;
      display: flex; align-items: center; justify-content: center;
    }
    .pyramid-scene {
      perspective: 700px; width: 180px; height: 260px;
      position: relative;
    }
    .pyramid-3d {
      width: 180px; height: 260px; position: relative;
      transform-style: preserve-3d;
      transform: rotateX(-20deg) rotateY(45deg);
      animation: pyramidSpin 20s linear infinite;
      will-change: transform;
    }
    @keyframes pyramidSpin {
      from { transform: rotateX(-20deg) rotateY(45deg); }
      to   { transform: rotateX(-20deg) rotateY(405deg); }
    }

    /* Each layer is an anchor point at the pyramid center axis */
    .pyramid-layer {
      position: absolute;
      left: 90px; /* center of 180px parent */
      width: 0; height: 0;
      transform-style: preserve-3d;
      /* NEVER set opacity on this element — it flattens preserve-3d children */
    }

    /* Trapezoidal/triangular faces — positioned and transformed by JS */
    .layer-face {
      position: absolute;
      background: transparent;
      transform-origin: center center;
      transition: opacity 1.5s ease;
    }
    .layer-face .face-fill {
      position: absolute; inset: 0;
      transition: background 1.5s ease, opacity 1.5s ease;
      opacity: 0.8;
    }
    .layer-face .face-edges {
      position: absolute; inset: 0; overflow: visible;
    }
    .layer-face .face-edges line {
      stroke: rgba(90,143,143,0.8);
      stroke-width: 1.5;
      filter: drop-shadow(0 0 4px rgba(90,143,143,0.6)) drop-shadow(0 0 8px rgba(90,143,143,0.3));
      transition: stroke 1s, filter 1s;
      animation: edgePulse 3s ease-in-out infinite;
    }
    @keyframes edgePulse {
      0%, 100% { opacity: 0.75; }
      50%      { opacity: 1; }
    }

    /* Scanline sweep within each face */
    .layer-face .scanline {
      position: absolute; bottom: 0; left: 0; width: 100%; height: 3px;
      background: linear-gradient(90deg, transparent 0%, rgba(90,143,143,0.9) 20%, rgba(127,181,230,1) 50%, rgba(90,143,143,0.9) 80%, transparent 100%);
      filter: blur(1.5px); opacity: 0;
      animation: scanSweep 4s ease-in-out infinite;
    }
    @keyframes scanSweep {
      0%   { bottom: 0%; opacity: 0; }
      10%  { opacity: 0.9; }
      90%  { opacity: 0.5; }
      100% { bottom: 95%; opacity: 0; }
    }

    /* Neon wireframe base — sized/positioned by JS */
    .pyramid-base {
      position: absolute;
      transform-style: preserve-3d;
      transform: rotateX(-90deg) translateZ(0px);
      background: transparent;
      border: 1px solid rgba(90,143,143,0.4);
      box-shadow: inset 0 0 20px rgba(90,143,143,0.08), 0 0 8px rgba(90,143,143,0.15);
      animation: basePulse 3s ease-in-out infinite;
    }
    .pyramid-base::before {
      content: ''; position: absolute; inset: 0;
      background:
        linear-gradient(90deg, rgba(90,143,143,0.12) 1px, transparent 1px),
        linear-gradient(0deg, rgba(90,143,143,0.12) 1px, transparent 1px);
      background-size: 37px 37px;
    }
    @keyframes basePulse {
      0%, 100% { border-color: rgba(90,143,143,0.3); box-shadow: inset 0 0 20px rgba(90,143,143,0.05), 0 0 8px rgba(90,143,143,0.1); }
      50%      { border-color: rgba(90,143,143,0.6); box-shadow: inset 0 0 30px rgba(90,143,143,0.1), 0 0 15px rgba(90,143,143,0.25); }
    }

    /* Holographic container — no opacity/filter to preserve 3D context */
    .pyramid-holo {
      position: absolute; inset: 0; pointer-events: none;
      transform-style: preserve-3d;
    }
    /* Flicker applied per-face via edge pulse instead */

    /* Neon glow underneath */
    .pyramid-glow {
      position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%);
      width: 240px; height: 55px; border-radius: 50%;
      background: radial-gradient(ellipse, rgba(90,143,143,0.5) 0%, rgba(127,181,230,0.2) 30%, transparent 65%);
      filter: blur(16px); animation: glowPulse 3s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes glowPulse {
      0%, 100% { opacity: 0.5; transform: translateX(-50%) scale(1); }
      50%      { opacity: 1; transform: translateX(-50%) scale(1.12); }
    }

    /* Rising orbs */
    .pyramid-orbs {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none; overflow: hidden;
    }
    .orb {
      position: absolute; border-radius: 50%; opacity: 0;
      animation: orbRise linear infinite;
    }
    .orb.orb-teal {
      background: radial-gradient(circle, rgba(90,143,143,1) 0%, rgba(90,143,143,0.4) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(90,143,143,0.6);
    }
    .orb.orb-blue {
      background: radial-gradient(circle, rgba(127,181,230,1) 0%, rgba(127,181,230,0.4) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(127,181,230,0.6);
    }
    .orb.orb-cyan {
      background: radial-gradient(circle, rgba(100,220,220,1) 0%, rgba(100,220,220,0.3) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(100,220,220,0.5);
    }
    @keyframes orbRise {
      0%   { opacity: 0; transform: translateY(0) scale(0.6); }
      12%  { opacity: 0.9; }
      70%  { opacity: 0.4; }
      100% { opacity: 0; transform: translateY(-320px) scale(0.15); }
    }

    /* Score display */
    .wellness-score {
      font-size: 38px; font-weight: 200; color: var(--teal);
      margin-top: 6px; font-variant-numeric: tabular-nums;
      letter-spacing: -1px; transition: color 0.5s;
      text-shadow: 0 0 20px rgba(90,143,143,0.3);
    }
    .wellness-status {
      font-size: 12px; color: var(--text-muted); font-weight: 300;
      margin-top: 2px; letter-spacing: 0.3px; text-align: center;
      max-width: 240px; transition: color 0.5s;
    }

    .orb.orb-amber {
      background: radial-gradient(circle, rgba(212,165,116,1) 0%, rgba(200,133,108,0.5) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(212,165,116,0.6);
    }
    .orb.orb-orange {
      background: radial-gradient(circle, rgba(230,160,80,1) 0%, rgba(200,133,108,0.4) 50%, transparent 100%);
      box-shadow: 0 0 6px rgba(230,160,80,0.5);
    }

    /* Tier labels — pushed further right to avoid overlap during rotation */
    .pyramid-tiers {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none;
    }
    .tier-label {
      position: absolute; font-size: 9px; font-weight: 500;
      text-transform: uppercase; letter-spacing: 1.2px;
      color: var(--text-muted); white-space: nowrap;
      transition: color 0.5s, opacity 0.5s, text-shadow 0.5s; opacity: 0.4;
    }
    .tier-label.active { opacity: 1; text-shadow: 0 0 8px currentColor; }
    .tier-label.t-0 { bottom: 68px; right: -58px; }
    .tier-label.t-1 { bottom: 128px; right: -52px; }
    .tier-label.t-2 { bottom: 184px; right: -44px; }
    .tier-label.t-3 { bottom: 236px; right: -36px; }

    /* Light theme adjustments */
    [data-theme="light"] .layer-face .face-edges line {
      stroke: rgba(61,114,114,0.7);
      filter: drop-shadow(0 0 3px rgba(61,114,114,0.4)) drop-shadow(0 0 6px rgba(61,114,114,0.2));
    }
    [data-theme="light"] .pyramid-base {
      border-color: rgba(61,114,114,0.35);
    }
    [data-theme="light"] .pyramid-glow {
      background: radial-gradient(ellipse, rgba(61,114,114,0.35) 0%, rgba(74,138,191,0.15) 30%, transparent 65%);
    }
    [data-theme="light"] .orb.orb-teal {
      background: radial-gradient(circle, rgba(61,114,114,0.9) 0%, rgba(61,114,114,0.3) 50%, transparent 100%);
    }
    [data-theme="light"] .orb.orb-blue {
      background: radial-gradient(circle, rgba(74,138,191,0.9) 0%, rgba(74,138,191,0.3) 50%, transparent 100%);
    }
    [data-theme="light"] .orb.orb-amber {
      background: radial-gradient(circle, rgba(176,122,74,0.9) 0%, rgba(160,104,76,0.4) 50%, transparent 100%);
    }
    [data-theme="light"] .orb.orb-orange {
      background: radial-gradient(circle, rgba(190,130,50,0.9) 0%, rgba(160,104,76,0.3) 50%, transparent 100%);
    }

    @media (max-width: 640px) {
      .pyramid-stage { width: 280px; height: 310px; }
      .pyramid-scene { transform: scale(0.78); }
      .tier-label { display: none; }
      /* Mobile perf: stop rotation, remove expensive filters/shadows */
      .pyramid-3d { animation: none; }
      .layer-face .face-edges line {
        filter: none !important;
        stroke-width: 1;
      }
      .layer-face .scanline { display: none; }
      .pyramid-glow { filter: none; }
      .orb { box-shadow: none; }
      @keyframes basePulse {
        0%, 100% { border-color: rgba(90,143,143,0.4); }
        50%      { border-color: rgba(90,143,143,0.6); }
      }
    }
    /* Respect reduced-motion preference */
    @media (prefers-reduced-motion: reduce) {
      .pyramid-3d { animation: none; }
      .layer-face .scanline { display: none; }
      .orb { display: none; }
    }
` }) %>
<%- include('partials/nav', { activePage: 'dashboard' }) %>

  <h1>Dashboard</h1>
  <p class="subtitle">Personal finance overview</p>

  <!-- Financial Pyramid — Separated Layers -->
  <div class="wellness-section">
    <h3 id="pyramid-title">Financial Wellness</h3>
    <div class="pyramid-wrapper">
    <div class="pyramid-switcher" id="pyramid-switcher">
      <button class="active" data-mode="wellness" title="Overall financial health">Wellness</button>
      <button data-mode="debt_payoff" title="Credit card debt payoff progress">Debt</button>
      <button data-mode="goal_progress" title="Individual goal progress">Goals</button>
      <button data-mode="spending_categories" title="Spending category balance">Spending</button>
      <button data-mode="net_worth" title="Net worth breakdown">Net Worth</button>
      <div class="pyramid-debt-baseline" id="debt-baseline-ctrl" style="display:none;">
        <span>Baseline $</span>
        <input type="number" id="debt-baseline-input" placeholder="0" min="0" step="100">
        <button id="debt-baseline-save">Set</button>
      </div>
    </div>
    <div class="pyramid-stage">
      <div class="pyramid-orbs" id="pyramid-orbs"></div>
      <div class="pyramid-scene">
        <div class="pyramid-holo">
          <div class="pyramid-3d" id="pyramid-3d">
            <!-- Layers generated by buildPyramidGeometry() -->
            <div class="pyramid-base" id="pyramid-base"></div>
          </div>
        </div>
      </div>
      <div class="pyramid-glow" id="pyramid-glow"></div>
      <div class="pyramid-tiers" id="pyramid-tiers">
        <div class="tier-label t-0" id="tier-0">Accounts</div>
        <div class="tier-label t-1" id="tier-1">Budgets</div>
        <div class="tier-label t-2" id="tier-2">Subs</div>
        <div class="tier-label t-3" id="tier-3">Goals</div>
      </div>
    </div>
    </div><!-- .pyramid-wrapper -->
    <div class="wellness-score" id="wellness-score">--</div>
    <div class="wellness-status" id="wellness-status">Calculating...</div>
  </div>

  <!-- Charts -->
  <div class="charts-grid">
    <div class="chart-card">
      <h3>Monthly Spending Trend</h3>
      <div class="chart-wrap"><canvas id="trend-chart" role="img" aria-label="Line chart showing monthly spending trend over time"></canvas></div>
    </div>
    <div class="chart-card">
      <h3>Spending by Category</h3>
      <div class="chart-wrap"><canvas id="category-chart" role="img" aria-label="Doughnut chart showing spending breakdown by category"></canvas></div>
    </div>
  </div>

  <div class="actions">
    <button class="primary" id="sync-btn">Sync Transactions</button>
    <button id="balance-btn">Refresh Balances</button>
    <button id="detect-btn">Run Detection</button>
  </div>

  <div id="status-msg" class="status-msg"></div>

  <!-- Summary cards -->
  <div class="top-cards" id="summary-cards">
    <div class="card"><div class="label">Net Balance</div><div class="value warm" id="net-balance">--</div></div>
    <div class="card"><div class="label">Monthly Spend</div><div class="value warm" id="avg-monthly">--</div><div class="sub" id="avg-monthly-sub"></div></div>
    <div class="card"><div class="label">Subscriptions /mo</div><div class="value teal" id="subs-monthly">--</div></div>
    <div class="card"><div class="label">Active Subs</div><div class="value teal" id="active-subs">--</div></div>
    <div class="card"><div class="label">Avg Daily Spend</div><div class="value warm" id="avg-daily">--</div></div>
    <div class="card"><div class="label">Linked Accounts</div><div class="value teal" id="acct-count">--</div></div>
  </div>

  <!-- Account balances -->
  <div id="accounts-section" style="margin-bottom:28px;">
    <div style="font-size:10px;font-weight:500;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:14px;">Account Balances</div>
    <div class="accounts-grid" id="accounts-grid">
      <div class="empty-msg">Loading accounts...</div>
    </div>
  </div>

  <!-- Recent Transactions -->
  <div class="section" style="margin-bottom:28px; animation: fadeInUp 0.4s ease both; animation-delay: 0.3s;">
    <h2>Recent Transactions</h2>
    <div class="table-wrap">
    <table class="recent-txn-table">
      <thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Amount</th><th class="hide-mobile">Status</th></tr></thead>
      <tbody id="recent-txn-body"><tr><td colspan="5" class="empty-msg">Loading...</td></tr></tbody>
    </table>
    </div>
  </div>

  <!-- Two-column: Monthly trend + Categories -->
  <div class="two-col">
    <div class="section">
      <h2>Monthly Spending</h2>
      <div class="table-wrap">
      <table>
        <thead><tr><th>Month</th><th>Total</th><th>Txns</th><th>Avg</th></tr></thead>
        <tbody id="monthly-body"><tr><td colspan="4" class="empty-msg">Loading...</td></tr></tbody>
      </table>
      </div>
    </div>
    <div class="section">
      <h2>Spending by Category</h2>
      <div class="table-wrap">
      <table>
        <thead><tr><th>Category</th><th>Total</th><th style="width:30%">Share</th></tr></thead>
        <tbody id="category-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
      </div>
    </div>
  </div>

  <!-- Two-column: Top merchants + Upcoming subscriptions -->
  <div class="two-col">
    <div class="section">
      <h2>Top Merchants</h2>
      <div class="table-wrap">
      <table>
        <thead><tr><th>Merchant</th><th>Total</th><th>Txns</th></tr></thead>
        <tbody id="merchant-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
      </div>
    </div>
    <div class="section">
      <h2>Upcoming Charges</h2>
      <div class="table-wrap">
      <table>
        <thead><tr><th>Service</th><th>Amount</th><th>Next</th></tr></thead>
        <tbody id="upcoming-body"><tr><td colspan="3" class="empty-msg">Loading...</td></tr></tbody>
      </table>
      </div>
    </div>
  </div>

  <!-- 30-day forecast -->
  <div class="section" id="forecast-section" style="display:none;">
    <h2>Next 30 Days Forecast</h2>
    <div id="forecast-summary" style="font-size:13px;color:var(--text-muted);margin-bottom:12px;"></div>
    <div id="forecast-list"></div>
  </div>

  <!-- CSV Import Reminder Banner -->
  <div id="csv-reminder-banner" style="display:none;padding:14px 18px;background:var(--yellow-bg);border:1px solid rgba(240,195,109,0.2);border-radius:var(--radius);margin-bottom:20px;font-size:13px;color:var(--yellow);font-weight:400;">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <div id="csv-reminder-text"></div>
      <a href="/" style="color:var(--warm);font-weight:500;text-decoration:none;white-space:nowrap;margin-left:12px;">Import CSV &rarr;</a>
    </div>
  </div>

  <!-- Budget Velocity Alerts -->
  <div id="budget-alerts-section" style="display:none;margin-bottom:20px;">
    <div id="budget-alerts-list"></div>
  </div>

  <!-- AI Memory — surfaces the structured running summary so the user can
       see what the AI is currently tracking (post-S5 visibility). Auto-hides
       when no summary exists. -->
  <div class="section" id="ai-memory-section" style="display:none;margin-bottom:28px;">
    <details>
      <summary style="cursor:pointer;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <h2 style="margin:0;display:inline;">AI Memory</h2>
        <span id="ai-memory-counts" style="font-size:11px;color:var(--text-muted);"></span>
      </summary>
      <div style="margin-top:12px;font-size:12px;">
