        html += '<div class="table-wrap"><table style="width:100%;font-size:12px;border-collapse:collapse;">';
        html += '<thead><tr><th style="text-align:left;padding:6px 0;border-bottom:1px solid var(--border);">Month</th>';
        html += '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Income</th>';
