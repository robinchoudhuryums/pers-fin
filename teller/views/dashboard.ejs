    // Render a tiny inline SVG sparkline from a series of numbers. Returns
    // an HTML string. No Chart.js dependency — keeps this widget cheap.
    function renderSparkline(values, width, height) {
      if (!values || values.length < 2) return '';
      var w = width || 80, h = height || 20;
      var min = Math.min.apply(null, values);
      var max = Math.max.apply(null, values);
      var range = max - min || 1;
      var step = w / (values.length - 1);
      var points = values.map(function(v, i) {
        var x = (i * step).toFixed(1);
        var y = (h - ((v - min) / range) * h).toFixed(1);
        return x + ',' + y;
      }).join(' ');
      var trend = values[values.length - 1] >= values[0] ? 'var(--green)' : 'var(--red)';
      return '<svg width="' + w + '" height="' + h + '" style="display:block;margin-top:4px;">' +
        '<polyline points="' + points + '" fill="none" stroke="' + trend + '" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }

    async function loadInvestments() {
      try {
        var res = await apiFetch('/api/investments');
        if (!res.ok) return;
        var data = await res.json();
        if (!data.accounts || data.accounts.length === 0) {
          // Hide the entire section if no investment accounts exist
          var sec = document.getElementById('investments-section');
          if (sec) sec.style.display = 'none';
          return;
        }
        document.getElementById('investments-total').textContent = fmt(data.total_value);
        // Per-source totals
        var bySrc = data.by_source || {};
        var srcEl = document.getElementById('investments-by-source');
        var srcParts = [];
        if (bySrc.teller > 0) srcParts.push('<span>Teller: <strong style="color:var(--text);">' + fmt(bySrc.teller) + '</strong></span>');
        if (bySrc.plaid > 0) srcParts.push('<span>Plaid: <strong style="color:var(--text);">' + fmt(bySrc.plaid) + '</strong></span>');
        if (bySrc.manual > 0) srcParts.push('<span>Manual: <strong style="color:var(--text);">' + fmt(bySrc.manual) + '</strong></span>');
        srcEl.innerHTML = srcParts.join('');

        // Per-account list (initial render — sparklines fetch lazily below)
        var listEl = document.getElementById('investments-list');
        listEl.innerHTML = data.accounts.map(function(a) {
          var sparkId = 'spark-' + a.source + '-' + a.id;
          var holdingsBadge = a.supports_holdings
            ? '<span style="font-size:9px;padding:1px 5px;border-radius:3px;background:var(--green-bg);color:var(--green);margin-left:4px;">holdings</span>'
            : '';
          // History pages exist for both linked and investment sources;
          // 'manual' rows live in investment_accounts, so source=investment.
          var histSource = a.source === 'teller' ? 'linked' : 'investment';
          var histHref = (window.BASE_PATH || '') + '/accounts/' + a.id + '/history?source=' + histSource;
          // Remove control only for investment_accounts-backed rows (plaid +
          // manual). Teller rows come from linked_accounts and aren't deletable
          // via /api/investment-accounts/:id. Lets the user clear a stale/zombie
          // duplicate (e.g. an old Plaid account_id or a manual placeholder)
          // that lingers at $0 after the live account re-synced under a new row.
          var removeBtn = a.source === 'teller'
            ? ''
            : '<button type="button" class="inv-remove" data-id="' + a.id + '" data-name="' + esc(a.name) + '" ' +
              'title="Remove this investment account" ' +
              'style="position:absolute;top:6px;right:6px;border:none;background:transparent;color:var(--text-muted);cursor:pointer;font-size:14px;line-height:1;padding:2px 4px;">&times;</button>';
          return '<div class="acct-card" style="padding:10px;position:relative;">' +
            removeBtn +
            '<div class="acct-inst" style="font-size:10px;">' + esc(a.institution || a.source) + holdingsBadge + '</div>' +
            '<div class="acct-name" style="font-size:13px;">' + esc(a.name) + '</div>' +
            '<div class="acct-balance positive" style="font-size:18px;">' + fmt(a.balance) + '</div>' +
            '<div class="acct-type" style="font-size:10px;">' + esc(a.account_type || '') + '</div>' +
            '<div id="' + sparkId + '" style="height:20px;"></div>' +
            '<a href="' + histHref + '" style="display:block;margin-top:6px;font-size:10px;color:var(--teal);text-decoration:none;">View history &rarr;</a>' +
          '</div>';
        }).join('');

        // Wire the remove buttons (CSP forbids inline onclick — bind here).
        Array.prototype.forEach.call(listEl.querySelectorAll('.inv-remove'), function(btn) {
          btn.addEventListener('click', async function() {
            var id = btn.getAttribute('data-id');
            var name = btn.getAttribute('data-name') || 'this account';
            if (!confirm('Remove "' + name + '" from your investment accounts? ' +
                'If it is a live Plaid account it will reappear on the next holdings sync.')) return;
            try {
              var dres = await apiFetch('/api/investment-accounts/' + id, { method: 'DELETE' });
              if (dres.ok) { showMsg('Removed ' + name + '.', true); loadInvestments(); }
              else { showMsg('Could not remove account (HTTP ' + dres.status + ').', false); }
            } catch (e) { showMsg('Could not remove account.', false); }
          });
        });

        // Lazy-load sparklines per account from balance-history endpoint.
        // Cap concurrency loosely by serializing — investment accounts are
        // typically <10 per user so this is fine without a queue.
        for (var i = 0; i < data.accounts.length; i++) {
          (function(a) {
            var url = '/api/accounts/' + a.id + '/balance-history?source=' + a.source + '&months=6';
            apiFetch(url).then(function(r) {
              if (!r.ok) return;
              return r.json();
            }).then(function(hist) {
              if (!hist || !hist.snapshots || hist.snapshots.length < 2) return;
              var values = hist.snapshots.map(function(s) { return s.balance; });
              var el = document.getElementById('spark-' + a.source + '-' + a.id);
              if (el) el.innerHTML = renderSparkline(values, 200, 20);
            }).catch(function() {});
          })(data.accounts[i]);
        }
      } catch (e) { /* non-critical */ }
    }

    // Categorization engagement loop — surfaces transactions that would
    // otherwise go to AI on the next /api/categorize call. User can review
    // 5-10 at a time, set a category, and optionally create a rule so the
    // same merchant pattern auto-categorizes next time. Drives down AI cost
    // over time as the rule base grows.
    var REVIEW_CATEGORIES = [
      "Food & Drink", "Groceries", "Transportation", "Gas & Fuel",
      "Shopping", "Entertainment", "Health & Fitness", "Healthcare",
      "Housing", "Utilities", "Insurance", "Education",
      "Travel", "Personal Care", "Gifts & Donations", "Fees & Charges",
      "Transfer", "Income", "Investment", "Subscription", "Other",
    ];
    async function loadReviewQueue() {
      try {
        var res = await apiFetch('/api/categorize/review-queue?limit=8');
        if (!res.ok) return;
        var data = await res.json();
        var section = document.getElementById('review-queue-section');
        if (!data.transactions || data.transactions.length === 0) {
          section.style.display = 'none';
          return;
        }
        section.style.display = 'block';
        document.getElementById('review-queue-count').textContent =
          data.count + (data.count === 1 ? ' transaction' : ' transactions');
        renderReviewQueue(data.transactions);
      } catch (e) { /* non-critical */ }
    }
    function renderReviewQueue(txns) {
      var listEl = document.getElementById('review-queue-list');
      var optHtml = REVIEW_CATEGORIES.map(function(c) {
        return '<option value="' + esc(c) + '">' + esc(c) + '</option>';
      }).join('');
      listEl.innerHTML = txns.map(function(t) {
        var rid = 'rev-' + t.transaction_id.replace(/[^a-zA-Z0-9]/g, '_');
        var defaultCat = t.suggested_category || REVIEW_CATEGORIES[0];
        var hint = t.hint ? ' <span style="font-size:10px;color:var(--text-muted);">[' + esc(t.hint) + ']</span>' : '';
        return '<div id="' + rid + '" style="display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--border);font-size:12px;">' +
          '<div style="flex:1;min-width:0;">' +
            '<div style="font-weight:500;color:var(--text);">' + esc(t.merchant || '(no merchant)') + hint + '</div>' +
            '<div style="font-size:11px;color:var(--text-muted);">' + esc(t.date) + ' &middot; ' + fmt(t.amount) + '</div>' +
          '</div>' +
          '<select data-cat-select="' + esc(t.transaction_id) + '" style="padding:4px 6px;font-size:11px;border:1px solid var(--border);border-radius:4px;background:transparent;color:var(--text);font-family:inherit;">' +
            optHtml.replace('value="' + esc(defaultCat) + '"', 'value="' + esc(defaultCat) + '" selected') +
          '</select>' +
          '<label style="display:flex;align-items:center;gap:4px;font-size:10px;color:var(--text-muted);cursor:pointer;">' +
            '<input type="checkbox" data-cat-rule="' + esc(t.transaction_id) + '" checked> Remember' +
          '</label>' +
          '<button data-cat-apply="' + esc(t.transaction_id) + '" style="padding:4px 10px;font-size:11px;border:1px solid var(--green);border-radius:4px;background:transparent;color:var(--green);cursor:pointer;font-family:inherit;">Apply</button>' +
        '</div>';
      }).join('');
    }
    onDelegate('review-queue-list', 'click', '[data-cat-apply]', async function() {
      var txnId = this.getAttribute('data-cat-apply');
      var sel = document.querySelector('[data-cat-select="' + txnId.replace(/"/g, '\\"') + '"]');
      var ruleCb = document.querySelector('[data-cat-rule="' + txnId.replace(/"/g, '\\"') + '"]');
      if (!sel) return;
      var category = sel.value;
      var createRule = ruleCb ? ruleCb.checked : false;
      this.disabled = true;
      this.textContent = 'Applying…';
      try {
        var res = await apiFetch('/api/categorize/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            transaction_id: txnId,
            category: category,
            create_rule: createRule,
            match_type: 'contains',
          }),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        // Remove the row and re-fetch the queue if it's now empty.
        var rid = 'rev-' + txnId.replace(/[^a-zA-Z0-9]/g, '_');
        var row = document.getElementById(rid);
        if (row) row.remove();
        var remaining = document.querySelectorAll('#review-queue-list > div').length;
        if (remaining === 0) loadReviewQueue();
      } catch (e) {
        this.disabled = false;
        this.textContent = 'Apply';
      }
    });

    // AI Memory widget — renders the structured running summary's actual
    // trends / pending_actions / alerts / completed_goals lists. Until now
    // the user only saw counts in Settings; this surfaces the content the
    // AI is actually reasoning over so users can verify or correct it.
    async function loadAiMemory() {
      try {
        var res = await apiFetch('/api/insights/status');
        if (!res.ok) return;
        var st = await res.json();
        var s = st.running_summary;
        var counts = st.running_summary_counts || {};
        var section = document.getElementById('ai-memory-section');
        var total = (counts.trends || 0) + (counts.completed_goals || 0) + (counts.pending_actions || 0) + (counts.alerts || 0);
        if (!s || total === 0) {
          section.style.display = 'none';
          return;
        }
        section.style.display = 'block';
        var countLabel = (counts.trends || 0) + ' trend' + (counts.trends === 1 ? '' : 's') + ' · ' +
          (counts.completed_goals || 0) + ' goal' + (counts.completed_goals === 1 ? '' : 's') + ' · ' +
          (counts.pending_actions || 0) + ' action' + (counts.pending_actions === 1 ? '' : 's') + ' · ' +
          (counts.alerts || 0) + ' alert' + (counts.alerts === 1 ? '' : 's');
        document.getElementById('ai-memory-counts').textContent = countLabel;

        function listCard(title, items, render, emptyMsg) {
          var body = items && items.length
            ? '<ul style="margin:0;padding-left:16px;line-height:1.5;">' + items.map(render).join('') + '</ul>'
            : '<div style="color:var(--text-muted);font-style:italic;">' + emptyMsg + '</div>';
          return '<div class="card" style="padding:12px;">' +
            '<div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:8px;">' + esc(title) + '</div>' +
            body + '</div>';
        }

        var trendsHtml = listCard('Trends', s.trends, function(t) {
          var arrow = t.direction === 'up' ? '↑' : t.direction === 'down' ? '↓' : '→';
          var arrowColor = t.direction === 'up' ? 'var(--green)' : t.direction === 'down' ? 'var(--red)' : 'var(--text-muted)';
          return '<li><strong>' + esc(t.category) + '</strong> <span style="color:' + arrowColor + ';">' + arrow + '</span>' +
            (t.magnitude ? ' <span style="color:var(--text-muted);">' + esc(t.magnitude) + '</span>' : '') +
            (t.since_when ? ' <span style="font-size:10px;color:var(--text-muted);">since ' + esc(t.since_when) + '</span>' : '') +
            '</li>';
        }, 'No trends tracked yet');

        var actionsHtml = listCard('Pending Actions', s.pending_actions, function(a) {
          var urgencyColor = a.urgency === 'high' ? 'var(--red)' : a.urgency === 'medium' ? 'var(--warm)' : 'var(--text-muted)';
          return '<li>' + esc(a.description) +
            (a.urgency ? ' <span style="font-size:10px;color:' + urgencyColor + ';font-weight:500;">[' + esc(a.urgency) + ']</span>' : '') +
            '</li>';
        }, 'No pending actions');

        var alertsHtml = listCard('Alerts', s.alerts, function(a) {
          var sevColor = a.severity === 'critical' ? 'var(--red)' : a.severity === 'warning' ? 'var(--warm)' : 'var(--text-muted)';
          return '<li>' + esc(a.message) +
            (a.severity ? ' <span style="font-size:10px;color:' + sevColor + ';font-weight:500;">[' + esc(a.severity) + ']</span>' : '') +
            '</li>';
        }, 'No active alerts');

        var goalsHtml = listCard('Completed Goals', s.completed_goals, function(g) {
          return '<li>' + esc(g.goal_name) +
            (g.completed_date ? ' <span style="font-size:10px;color:var(--text-muted);">' + esc(g.completed_date) + '</span>' : '') +
            '</li>';
        }, 'No completed goals yet');

        document.getElementById('ai-memory-grid').innerHTML = trendsHtml + actionsHtml + alertsHtml + goalsHtml;
      } catch (e) { /* non-critical */ }
    }

    // Shared-card settlement (who-owes-who on a joint card). Only renders
    // when at least one is_shared account exists. Defaults to current month
    // but lets the user pick the prior 3 from a small dropdown — most users
    // check the first week of a new month, when they want last month's tally.
    function fmtMoney(n) {
      var x = parseFloat(n || 0);
      return (x < 0 ? '-$' : '$') + Math.abs(x).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function monthLabel(ym) {
      var parts = ym.split('-');
      var d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, 1);
      return d.toLocaleString('en-US', { month: 'long', year: 'numeric' });
    }
    function buildSettlementMonthOptions() {
      var sel = document.getElementById('settlement-month-pick');
      if (!sel || sel.options.length) return;
      var now = new Date();
      for (var i = 0; i < 6; i++) {
        var d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        var ym = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
        var opt = document.createElement('option');
        opt.value = ym;
        opt.textContent = monthLabel(ym) + (i === 0 ? ' (current)' : '');
        // Default to the previous month if it's the first week — that's
        // when the user typically checks who owes what for the statement.
        if (i === (now.getDate() <= 7 && now.getMonth() !== d.getMonth() ? 0 : (now.getDate() <= 7 ? 1 : 0))) {
          opt.selected = true;
        }
        sel.appendChild(opt);
      }
      sel.addEventListener('change', function() { loadSettlement(); });
    }
    async function loadSettlement() {
      buildSettlementMonthOptions();
      var section = document.getElementById('settlement-section');
      var headline = document.getElementById('settlement-headline');
      var body = document.getElementById('settlement-body');
      var sel = document.getElementById('settlement-month-pick');
      var month = sel ? sel.value : '';
      try {
        // Pull the shared-card settlement AND the housing even-up for the SAME
        // month, then combine into one net "settle up with [partner]" figure.
        var qs = month ? ('?month=' + month) : '';
        var hqs = month ? ('?month=' + month) : '';
        var results = await Promise.all([
          apiFetch('/api/shared-settlement' + qs).then(function(r){ return r.ok ? r.json() : null; }).catch(function(){ return null; }),
          apiFetch('/api/housing/split' + hqs).then(function(r){ return r.ok ? r.json() : null; }).catch(function(){ return null; })
        ]);
        var d = results[0] || { month: month, accounts: [] };
        var housing = results[1] && results[1].enabled ? results[1] : null;
        var hasShared = d.accounts && d.accounts.length;
        if (!hasShared && !housing) { section.style.display = 'none'; return; }
        section.style.display = '';
        var partner = (d && d.partner_name) || (housing && housing.partner_name) || 'Partner';

        // Net convention: positive = partner owes you (partner sends you).
        // Shared card: you pay the statement, partner reimburses their share.
        var sharedNet = hasShared ? d.accounts.reduce(function(s, a){ return s + (a.partner_share || 0); }, 0) : 0;
        // Housing even-up: 'you_send_partner' is money OUT (negative).
        var housingSigned = 0;
        if (housing) housingSigned = housing.direction === 'you_send_partner' ? -housing.transfer : housing.transfer;
        var net = Math.round((sharedNet + housingSigned) * 100) / 100;
        var netLabel, netColor;
        if (Math.abs(net) < 0.01) { netLabel = "You're square with " + esc(partner) + ' this month'; netColor = 'var(--teal)'; }
        else if (net > 0) { netLabel = esc(partner) + ' sends you <strong>' + fmtMoney(net) + '</strong>'; netColor = 'var(--teal)'; }
        else { netLabel = 'Send ' + esc(partner) + ' <strong>' + fmtMoney(Math.abs(net)) + '</strong>'; netColor = 'var(--warm)'; }
        var parts = [];
        if (hasShared) parts.push('Shared card ' + fmtMoney(sharedNet) + ' (' + esc(partner) + ' owes you)');
        if (housing) parts.push('Housing even-up ' + fmtMoney(Math.abs(housing.transfer)) + ' (' + (housing.direction === 'you_send_partner' ? 'you owe' : esc(partner) + ' owes') + ')');
        headline.innerHTML =
          '<div style="padding:14px;background:var(--card);border:1px solid var(--card-border);border-radius:8px;">' +
            '<div style="font-size:11px;color:var(--text-muted);">Net to settle up &middot; ' + monthLabel(d.month || month) + '</div>' +
            '<div style="font-size:26px;font-weight:600;color:' + netColor + ';margin-top:2px;">' + netLabel + '</div>' +
            (parts.length > 1 ? '<div style="font-size:11px;color:var(--text-muted);margin-top:6px;">' + parts.join(' &nbsp;+&nbsp; ') + '</div>' : '') +
          '</div>';

        // Housing even-up detail card (rendered above the per-card breakdown).
        var housingCard = '';
        if (housing) {
          var hWho = housing.direction === 'you_send_partner' ? ('Send ' + esc(partner)) : (esc(partner) + ' sends you');
          housingCard =
            '<div style="margin-bottom:14px;padding:14px;background:var(--card);border:1px solid var(--card-border);border-radius:8px;">' +
              '<div style="display:flex;justify-content:space-between;align-items:baseline;">' +
                '<strong style="font-size:14px;">Rent &amp; Utilities even-up</strong>' +
                '<a href="/housing" style="font-size:11px;color:var(--teal);text-decoration:none;">Rent page &rarr;</a>' +
              '</div>' +
              '<div style="font-size:18px;color:var(--teal);font-weight:500;margin-top:6px;">' + hWho + ' ' + fmtMoney(housing.transfer) + '</div>' +
              '<div style="font-size:11px;color:var(--text-muted);margin-top:4px;">Rent + utilities ' + fmtMoney(housing.rent_utilities) + ' &minus; car ' + fmtMoney(housing.car) + ', split evenly &middot; each bears ' + fmtMoney(housing.each_share) + '</div>' +
            '</div>';
        }

        var cards = (hasShared ? d.accounts.map(function(a) {
          var explainer = a.txn_count === 0
            ? '<div style="color:var(--text-muted);padding:8px 0;">No charges on this card in ' + monthLabel(d.month) + '.</div>'
            : (
              '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px;">' +
                '<div style="padding:10px;background:var(--bg-elevated);border:1px solid var(--card-border);border-radius:6px;">' +
                  '<div style="font-size:11px;color:var(--text-muted);">You owe</div>' +
                  '<div style="font-size:20px;color:var(--warm);font-weight:500;margin-top:2px;">' + fmtMoney(a.your_share) + '</div>' +
                  '<div style="font-size:10px;color:var(--text-muted);margin-top:4px;">' + a.split_pct + '% of ' + fmtMoney(a.shared_total) + ' shared + ' + fmtMoney(a.your_personal_total) + ' personal</div>' +
                '</div>' +
                '<div style="padding:10px;background:var(--bg-elevated);border:1px solid var(--card-border);border-radius:6px;">' +
                  '<div style="font-size:11px;color:var(--text-muted);">' + esc(partner) + ' owes</div>' +
                  '<div style="font-size:20px;color:var(--teal);font-weight:500;margin-top:2px;">' + fmtMoney(a.partner_share) + '</div>' +
                  '<div style="font-size:10px;color:var(--text-muted);margin-top:4px;">' + (100 - a.split_pct) + '% of ' + fmtMoney(a.shared_total) + ' shared + ' + fmtMoney(a.partner_personal_total) + ' personal</div>' +
                '</div>' +
              '</div>' +
              '<div style="font-size:11px;color:var(--text-muted);margin-top:8px;display:flex;justify-content:space-between;">' +
                '<span>Total charges: <strong>' + fmtMoney(a.total_charges) + '</strong> across ' + a.txn_count + ' transactions</span>' +
                '<a href="/transactions?account_id=' + a.account_id + '&month=' + d.month + '" style="color:var(--teal);text-decoration:none;">Review &rarr;</a>' +
              '</div>'
            );
          return (
            '<div style="margin-bottom:14px;padding:14px;background:var(--card);border:1px solid var(--card-border);border-radius:8px;">' +
              '<div style="display:flex;justify-content:space-between;align-items:baseline;">' +
                '<strong style="font-size:14px;">' + esc(a.account_name) + '</strong>' +
                '<span style="font-size:11px;color:var(--text-muted);">' + monthLabel(d.month) + '</span>' +
              '</div>' +
              explainer +
            '</div>'
          );
        }).join('') : '');

        // Expandable breakdown: housing even-up + per-shared-card detail.
        var detail = housingCard + cards;
        body.innerHTML = detail
          ? ('<details><summary style="cursor:pointer;font-size:12px;color:var(--text-muted);margin-bottom:10px;">Show breakdown</summary>' + detail + '</details>')
          : '';
      } catch (e) { /* non-critical */ }
    }

    // Rent & Utilities widget — current balance owed to the payee. Auto-hides
    // when the ledger isn't configured. Backed by GET /api/housing/ledger.
    async function loadHousingWidget() {
      var section = document.getElementById('housing-widget-section');
      var body = document.getElementById('housing-widget-body');
      if (!section || !body) return;
      try {
        var r = await apiFetch('/api/housing/ledger');
        if (!r.ok) return;
        var d = await r.json();
        if (!d.config || !d.config.enabled || !d.config.payee_name) { section.style.display = 'none'; return; }
        var unpaid = (d.obligations || []).filter(function(o){ return o.status === 'unpaid'; }).length;
        var awaiting = d.awaiting_count || 0;
        var bits = [];
        bits.push(unpaid + ' unpaid item' + (unpaid === 1 ? '' : 's'));
        if (awaiting) bits.push('<span style="color:var(--yellow,#d9b25f);">' + awaiting + ' awaiting bill</span>');
        var color = d.balance > 0 ? 'var(--warm)' : 'var(--green)';
        body.innerHTML =
          '<div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap;">' +
            '<div>' +
              '<div style="font-size:11px;color:var(--text-muted);">Owed to ' + esc(d.config.payee_name) + '</div>' +
              '<div style="font-size:26px;font-weight:600;color:' + color + ';margin-top:2px;">' + fmtMoney(d.balance) + '</div>' +
            '</div>' +
            '<div style="font-size:11px;color:var(--text-muted);text-align:right;">' + bits.join(' &middot; ') + '</div>' +
          '</div>' +
          (awaiting ? '<div style="font-size:11px;color:var(--text-muted);margin-top:8px;">Enter the latest utility amount on the Rent page to keep the balance accurate.</div>' : '');
        section.style.display = '';
      } catch (e) { /* non-critical */ }
    }

    // Ask Perfin — NL Q&A
    (function initAsk() {
      var input = document.getElementById('ask-input');
      var btn = document.getElementById('ask-btn');
      var out = document.getElementById('ask-answer');
      var meta = document.getElementById('ask-meta');
      if (!input || !btn) return;
      async function ask() {
        var q = input.value.trim();
        if (!q) return;
        btn.disabled = true;
        out.style.display = 'block';
        out.textContent = 'Thinking…';
        meta.textContent = '';
        try {
          var r = await apiFetch('/api/ask', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: q }),
          });
          var data = await r.json().catch(function() { return {}; });
          if (!r.ok) { out.textContent = data.error || ('Error ' + r.status); return; }
          out.textContent = data.answer;
          meta.textContent = (data.tools_used && data.tools_used.length ? 'Checked: ' + data.tools_used.join(', ') + ' · ' : '') +
            '~$' + (data.estimated_cost_usd || 0).toFixed(4);
        } catch (e) {
          out.textContent = 'Request failed: ' + e.message;
        } finally {
          btn.disabled = false;
        }
      }
      btn.addEventListener('click', ask);
      input.addEventListener('keydown', function(e) { if (e.key === 'Enter') ask(); });
    })();

    // Collapsible dashboard sections — persisted per-section in localStorage.
    (function initCollapsibles() {
      document.querySelectorAll('.section.collapsible').forEach(function(sec) {
        var key = 'perfin_collapse_' + (sec.getAttribute('data-collapse-key') || '');
        var h2 = sec.querySelector('h2');
        if (!h2) return;
        h2.setAttribute('tabindex', '0');
        h2.setAttribute('role', 'button');
        function apply(collapsed) {
          sec.classList.toggle('collapsed', collapsed);
          h2.setAttribute('aria-expanded', String(!collapsed));
        }
        var saved = false;
        try { saved = localStorage.getItem(key) === '1'; } catch (_) {}
        apply(saved);
        function toggle() {
          var c = !sec.classList.contains('collapsed');
          apply(c);
          try { c ? localStorage.setItem(key, '1') : localStorage.removeItem(key); } catch (_) {}
        }
        h2.addEventListener('click', function(e) {
          if (e.target.closest('select, button, input, a')) return;
          toggle();
        });
        h2.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
        });
      });
    })();

    // Dashboard widget visibility
    async function applyWidgetVisibility() {
      try {
        var res = await apiFetch('/api/settings');
        if (!res.ok) return;
        var s = await res.json();
        var w = s.dashboard_widgets || {};
        // Map widget keys to section IDs
        var map = {
          pyramid: '.wellness-section',
          accounts: '#accounts-section',
          charts: '.charts-grid',
          ask: '#ask-section',
          forecast: '#forecast-section',
          savingsRate: '#savings-rate-section',
          cashFlow: '#cashflow-section',
          yoy: '#yoy-section',
          investments: '#investments-section',
          reviewQueue: '#review-queue-section',
          aiMemory: '#ai-memory-section',
          settlement: '#settlement-section',
          housing: '#housing-widget-section',
        };
        Object.entries(map).forEach(function(e) {
          var key = e[0], selector = e[1];
          if (w[key] === false) {
            var el = document.querySelector(selector);
            if (el) el.style.display = 'none';
          }
        });
      } catch (e) { /* non-critical */ }
    }
    applyWidgetVisibility();

    // Load new dashboard widgets
    loadCsvReminder();
    loadBudgetAlerts();
    loadSavingsRate();
    loadCashFlow();
    loadYoY();
    loadInvestments();
    loadReviewQueue();
    loadAiMemory();
    loadSettlement();
    loadHousingWidget();

    computeWellness();

    // Charts — Chart.js loaded via blocking <script> tag above
    if (typeof Chart !== 'undefined') {
      loadCharts();
    } else {
      document.querySelectorAll('.chart-wrap').forEach(function(el) {
        el.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;">Chart library failed to load</div>';
      });
    }

    async function loadCharts() {
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
      const textColor = isDark ? 'rgba(240,235,227,0.5)' : 'rgba(26,26,46,0.5)';
      Chart.defaults.color = textColor;
      Chart.defaults.borderColor = gridColor;
      try {
        const txRes = await apiFetch('/api/transactions?months=6');
        const txData = await txRes.json();
        const monthlyMap = {};
        (txData.transactions || []).forEach(t => {
          if (t.amount > 0) {
            const m = t.date.slice(0, 7);
            monthlyMap[m] = (monthlyMap[m] || 0) + parseFloat(t.amount);
          }
        });
        const months = Object.keys(monthlyMap).sort();
        const amounts = months.map(m => monthlyMap[m]);
        const trendCtx = document.getElementById('trend-chart');
        if (trendCtx && months.length === 0) {
          trendCtx.parentElement.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;">No spending data yet</div>';
        }
        if (trendCtx && months.length > 0) {
          new Chart(trendCtx, {
            type: 'line',
            data: {
              labels: months.map(m => { const d = new Date(m + '-01'); return d.toLocaleString('default', { month: 'short', year: '2-digit' }); }),
              datasets: [{
                label: 'Spending',
                data: amounts,
                borderColor: '#d4a574',
                backgroundColor: 'rgba(212,165,116,0.1)',
                fill: true, tension: 0.4, pointRadius: 4,
                pointBackgroundColor: '#d4a574',
              }]
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                y: { beginAtZero: true, ticks: { callback: v => '$' + v.toLocaleString() }, grid: { color: gridColor } },
                x: { grid: { display: false } }
              }
            }
          });
        }
        const catMap = {};
        (txData.transactions || []).forEach(t => {
          if (t.amount > 0) {
            const cat = (t.personal_finance_category && t.personal_finance_category.primary) || t.category || 'Other';
            catMap[cat] = (catMap[cat] || 0) + parseFloat(t.amount);
          }
        });
        const cats = Object.entries(catMap).sort((a, b) => b[1] - a[1]).slice(0, 8);
        const pieColors = ['#d4a574', '#5a8f8f', '#c8856c', '#6fcf97', '#7fb5e6', '#f0c36d', '#eb6b6b', '#b08ed6'];
        const catCtx = document.getElementById('category-chart');
        if (catCtx && cats.length === 0) {
          catCtx.parentElement.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;">No category data yet</div>';
        }
        if (catCtx && cats.length > 0) {
          new Chart(catCtx, {
            type: 'doughnut',
            data: {
              labels: cats.map(c => c[0]),
              datasets: [{ data: cats.map(c => c[1].toFixed(2)), backgroundColor: pieColors.slice(0, cats.length), borderWidth: 0 }]
            },
            options: {
              responsive: true, maintainAspectRatio: false, cutout: '60%',
              plugins: {
                legend: { position: window.innerWidth <= 640 ? 'bottom' : 'right', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } },
                tooltip: { callbacks: { label: ctx => ctx.label + ': $' + parseFloat(ctx.raw).toLocaleString() } }
              }
            }
          });
        }
      } catch (e) { console.warn('Charts load error:', e); }
    }
  </script>
</body>
</html>
