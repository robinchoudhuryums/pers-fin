        if (!res.ok) return;
        var data = await res.json();
        if (data.due && data.reminders.length > 0) {
          var banner = document.getElementById('csv-reminder-banner');
          banner.style.display = 'block';
          document.getElementById('csv-reminder-text').innerHTML =
