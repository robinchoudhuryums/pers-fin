        html += '<div class="card"><div class="label">' + data.month_name + ' ' + comp.previous_year + '</div><div class="value teal">' + fmt(comp.previous_total) + '</div></div>';
        html += '</div>';
        if (comp.category_changes.length > 0) {
          html += '<div class="table-wrap"><table style="width:100%;font-size:12px;border-collapse:collapse;">';
          html += '<thead><tr><th style="text-align:left;padding:6px 0;border-bottom:1px solid var(--border);">Category</th>';
          html += '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">' + comp.current_year + '</th>';
          html += '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">' + comp.previous_year + '</th>';
          html += '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Change</th></tr></thead><tbody>';
          comp.category_changes.slice(0, 10).forEach(function(c) {
