    // Load upcoming bills for calendar widget
    (async function loadCalendarWidget() {
      var body = document.getElementById('calendar-widget-body');
      if (!body) return;
      try {
        var now = new Date();
        var res = await apiFetch('/api/bill-calendar?year=' + now.getFullYear() + '&month=' + (now.getMonth() + 1));
        if (!res.ok) { body.textContent = 'Unable to load.'; return; }
        var data = await res.json();
        var today = now.getDate();
        var upcoming = [];
        for (var i = 0; i < data.days.length; i++) {
          var day = data.days[i];
          if (day.day >= today && day.events.length > 0) {
            for (var j = 0; j < day.events.length; j++) {
              upcoming.push({ day: day.day, event: day.events[j] });
            }
          }
          if (upcoming.length >= 6) break;
        }
        if (upcoming.length === 0) { body.textContent = 'No upcoming bills this month.'; return; }
        body.innerHTML = upcoming.map(function(u) {
          var ev = u.event;
          var cls = ev.is_income ? 'color:var(--green)' : 'color:var(--text-muted)';
          var prefix = ev.is_income ? '+' : '-';
          var paid = ev.is_paid ? ' style="text-decoration:line-through;opacity:0.5;"' : '';
          return '<div' + paid + ' style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);font-size:12px;">' +
            '<span>' + (ev.is_paid ? '\u2713 ' : '') + esc(ev.name) + ' <span style="color:var(--text-muted);font-size:11px;">(Day ' + u.day + ')</span></span>' +
            '<span style="' + cls + ';">' + prefix + '$' + Math.abs(ev.amount).toFixed(2) + '</span></div>';
        }).join('');
      } catch (e) { body.textContent = 'Unable to load.'; }
    })();

    // Quick Add Bill modal — captures bills not in transaction history (e.g.
