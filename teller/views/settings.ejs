    // ---- Target allocation editor (Follow-on for #8) ----
    // In-memory model is a plain object {asset_class: pct}. Rows are
    // rendered from it; add/remove mutate the model and re-render. Save
    // PATCHes the whole map.
    var TARGET_ALLOC = {};
    function renderTargetAlloc() {
      var rows = document.getElementById('target-alloc-rows');
      var sum = document.getElementById('target-alloc-sum');
      if (!rows) return;
      var entries = Object.entries(TARGET_ALLOC);
      if (entries.length === 0) {
        rows.innerHTML = '<div style="font-size:12px;color:var(--text-muted);font-style:italic;">No targets set — add a class below to start tracking drift.</div>';
        if (sum) sum.textContent = '';
        return;
      }
      rows.innerHTML = entries.map(function(e) {
        var cls = e[0], pct = e[1];
        return '<div style="display:flex;align-items:center;gap:8px;">' +
          '<span style="flex:1 1 auto;text-transform:capitalize;font-size:13px;color:var(--text);">' + esc(cls) + '</span>' +
          '<input type="number" min="0" max="100" step="0.1" value="' + Number(pct) +
            '" data-target-class="' + esc(cls) + '" ' +
            'style="width:80px;padding:6px 8px;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:6px;font-family:inherit;font-size:12px;text-align:center;">' +
          '<span style="font-size:11px;color:var(--text-muted);">%</span>' +
          '<button class="btn btn-sm" data-remove-class="' + esc(cls) + '" title="Remove" style="min-width:36px;">×</button>' +
        '</div>';
      }).join('');
      var total = entries.reduce(function(s, e) { return s + Number(e[1]); }, 0);
      if (sum) {
        sum.textContent = 'sum: ' + total.toFixed(1) + '%';
        sum.style.color = Math.abs(total - 100) < 0.5 ? 'var(--green)' :
                          (total > 100 ? 'var(--red)' : 'var(--text-muted)');
      }
      // Wire input changes back to the model
      rows.querySelectorAll('input[data-target-class]').forEach(function(inp) {
        inp.addEventListener('input', function() {
          var cls = this.getAttribute('data-target-class');
          var v = parseFloat(this.value);
          if (Number.isFinite(v)) TARGET_ALLOC[cls] = v;
          var tot = Object.values(TARGET_ALLOC).reduce(function(s, x) { return s + Number(x); }, 0);
          if (sum) {
            sum.textContent = 'sum: ' + tot.toFixed(1) + '%';
            sum.style.color = Math.abs(tot - 100) < 0.5 ? 'var(--green)' :
                              (tot > 100 ? 'var(--red)' : 'var(--text-muted)');
          }
        });
      });
      rows.querySelectorAll('button[data-remove-class]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var cls = this.getAttribute('data-remove-class');
          delete TARGET_ALLOC[cls];
          renderTargetAlloc();
        });
      });
    }

