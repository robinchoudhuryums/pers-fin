<%- include('partials/head', { title: 'Settings', extraStyles: `
    .container { max-width: 860px; }
    @media (max-width: 640px) { .container { max-width: 100%; } }
    .insight-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 20px; margin-top: 12px; backdrop-filter: blur(12px); }
    .insight-card h3 { font-size: 14px; font-weight: 400; margin-bottom: 10px; }
    .insight-text { font-size: 13px; line-height: 1.7; color: var(--text-muted); font-weight: 300; }
    .insight-text strong { color: var(--text); font-weight: 500; }
    .insight-text li { margin-left: 16px; margin-bottom: 6px; }
    .insight-meta { font-size: 11px; color: var(--text-muted); margin-top: 10px; }
    select, input[type="number"] { padding: 8px 12px; font-size: 13px; border: 1px solid var(--border);
      border-radius: 8px; background: transparent; color: var(--text); font-family: inherit; font-weight: 300; }
    select:focus, input[type="number"]:focus { outline: none; border-color: var(--warm); }
    select option { background: var(--bg); }
    input[type="number"] { width: 80px; text-align: center; }
    #modules-container label:hover { border-color: var(--border-hover) !important; }
` }) %>
<%- include('partials/nav', { activePage: 'settings' }) %>
  <h1>Settings</h1>
  <p class="subtitle">Preferences and configuration</p>
  <div id="status-msg" class="status-msg"></div>

  <h3 class="settings-group-title" style="font-size:12px;text-transform:uppercase;letter-spacing:1.5px;color:var(--warm, #d4a574);margin:24px 0 12px;font-weight:500;">Appearance &amp; Display</h3>
  <div class="section"><h2>Appearance</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Theme</div><div class="desc">Switch between dark (night) and light (day) mode</div></div>
      <div class="setting-control">
        <select id="theme-select">
          <option value="dark">Night Mode</option><option value="light">Day Mode</option>
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Dashboard Range</div><div class="desc">Months of spending shown in charts</div></div>
      <div class="setting-control">
        <select id="months-select">
          <option value="3">3 months</option><option value="6">6 months</option>
          <option value="12">12 months</option><option value="24">24 months</option>
        </select>
      </div>
    </div>
  </div>

  <div class="section"><h2>Pyramid Visualization</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Data Source</div><div class="desc">What the pyramid tiers represent</div></div>
      <div class="setting-control">
        <select id="pyramid-source-select">
          <option value="wellness">Financial Wellness</option>
          <option value="debt_payoff">Debt Payoff</option>
          <option value="goal_progress">Goal Progress</option>
          <option value="spending_categories">Spending Categories</option>
          <option value="net_worth">Net Worth</option>
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Color Mode</div><div class="desc">Single amber-orange or multi-color per tier</div></div>
      <div class="setting-control">
        <select id="pyramid-color-select">
          <option value="single">Single Color (Amber)</option>
          <option value="multi">Multi-Color</option>
        </select>
      </div>
    </div>
  </div>

  <div class="section" id="install-section" style="display:none;"><h2>Install App</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Add to Home Screen</div><div class="desc" id="install-desc">Install Perfin as a standalone app for faster access and offline fallback</div></div>
      <div class="setting-control"><button class="btn primary" id="install-btn">Install</button></div>
    </div>
  </div>

  <h3 class="settings-group-title" style="font-size:12px;text-transform:uppercase;letter-spacing:1.5px;color:var(--warm, #d4a574);margin:24px 0 12px;font-weight:500;">Security</h3>
  <div class="section"><h2>Security</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Session Timeout</div><div class="desc">Minutes before requiring password again (1-1440)</div></div>
      <div class="setting-control">
        <input type="number" id="timeout-input" min="1" max="1440" value="15">
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">App Idle Timeout</div><div class="desc">Minutes of inactivity before the unified-shell PIN is required again. Refreshes on every request you make, so an active session never times out mid-use. (5-10080)</div></div>
      <div class="setting-control">
        <input type="number" id="shell-idle-input" min="5" max="10080" value="60">
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Sign Out</div><div class="desc">End your current session</div></div>
      <div class="setting-control"><button class="btn danger" id="logout-btn">Sign Out</button></div>
    </div>
  </div>

  <div class="section" id="biometric-section" style="display:none;"><h2>Biometric Login</h2>
    <div class="setting-row" style="flex-direction:column;align-items:stretch;">
      <div class="setting-info" style="margin-bottom:10px;">
        <div class="name">Registered Devices</div>
        <div class="desc" id="biometric-desc">Use FaceID, TouchID, or a passkey to sign in. Registered credentials work for both standalone and shell login.</div>
      </div>
      <div id="biometric-list" style="font-size:12px;color:var(--text-muted);margin-bottom:10px;">Loading…</div>
      <div style="display:flex;gap:10px;">
        <button class="btn primary" id="biometric-register-btn">Register This Device</button>
      </div>
      <div id="biometric-status" style="margin-top:8px;font-size:12px;"></div>
    </div>
  </div>

  <h3 class="settings-group-title" style="font-size:12px;text-transform:uppercase;letter-spacing:1.5px;color:var(--warm, #d4a574);margin:24px 0 12px;font-weight:500;">AI &amp; Intelligence</h3>
  <div class="section"><h2>AI Insights</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">API Status</div><div class="desc" id="api-status-desc">Checking...</div></div>
      <div class="setting-control"><span id="api-status-badge" style="font-size:11px;font-weight:600;padding:3px 10px;border-radius:6px;letter-spacing:0.5px;text-transform:uppercase;">--</span></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Monthly AI Analysis</div><div class="desc">Financial insights powered by Claude (~$0.02/month)</div></div>
      <div class="setting-control">
        <label class="toggle"><input type="checkbox" id="insights-toggle"><span class="slider"></span></label>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Generate Now</div><div class="desc">Run AI analysis on current data</div></div>
      <div class="setting-control"><button class="btn primary" id="insights-btn">Generate</button></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">AI Model</div><div class="desc">Haiku (~$0.005/run), Sonnet (~$0.02/run), Opus (~$0.10/run). Always uses latest version.</div></div>
      <div class="setting-control">
        <select id="model-select">
          <option value="haiku">Haiku</option><option value="sonnet">Sonnet</option><option value="opus">Opus</option>
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Analysis Cadence</div><div class="desc" id="cadence-desc">How often automated analysis runs. More frequent = finer trend tracking.</div></div>
      <div class="setting-control">
        <select id="cadence-select">
          <option value="7">Weekly</option><option value="14">Every 2 weeks</option>
          <option value="30">Monthly</option><option value="60">Every 2 months</option>
          <option value="90">Quarterly</option>
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info">
        <div class="name">Weekly Digest Email</div>
        <div class="desc">Mail a digest of the running summary (trends, pending actions, alerts) once per week via Per-sistant.</div>
        <div id="weekly-digest-prereq" style="display:none;margin-top:6px;font-size:11px;padding:6px 10px;border-radius:6px;background:rgba(235,107,107,0.08);border:1px solid rgba(235,107,107,0.3);color:var(--red, #eb6b6b);">
          Per-sistant webhook isn't configured — digest will silently no-op until you set the URL + secret in Per-sistant integration below.
        </div>
      </div>
      <div class="setting-control">
        <label class="toggle"><input type="checkbox" id="weekly-digest-toggle"><span class="slider"></span></label>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Digest Day</div><div class="desc">Day of week the digest fires (when enabled).</div></div>
      <div class="setting-control">
        <select id="weekly-digest-day-select">
          <option value="0">Sunday</option><option value="1">Monday</option>
          <option value="2">Tuesday</option><option value="3">Wednesday</option>
          <option value="4">Thursday</option><option value="5">Friday</option>
          <option value="6">Saturday</option>
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info">
        <div class="name">Daily Activity Digest</div>
        <div class="desc">Mail a once-per-day digest of new transactions, balance changes, new subscriptions, and notifications from the last 24h. Skipped silently when nothing's new.</div>
      </div>
      <div class="setting-control">
        <label class="toggle"><input type="checkbox" id="daily-digest-toggle"><span class="slider"></span></label>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">ZIP Code</div><div class="desc">For regional rate comparisons (utility costs vs your area's average)</div></div>
      <div class="setting-control">
        <input type="text" id="zip-input" maxlength="5" placeholder="e.g. 10001" style="width:80px;padding:8px 12px;font-size:13px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;text-align:center;">
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Partner Name</div><div class="desc">Used in the Shared Card Settlement widget — e.g. "Sarah owes you $X" instead of "Partner owes you $X"</div></div>
      <div class="setting-control">
        <input type="text" id="partner-name-input" maxlength="50" placeholder="e.g. Sarah" style="width:140px;padding:8px 12px;font-size:13px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;">
      </div>
    </div>
    <div class="setting-row" style="flex-direction:column;align-items:stretch;">
      <div class="setting-info" style="margin-bottom:12px;"><div class="name">Insight Modules</div><div class="desc">Toggle analysis features. Each adds a small amount of context to the AI prompt.</div></div>
      <div id="modules-container" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;"></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Monthly Budget Cap</div><div class="desc" id="budget-desc">Limits AI API spend per month (insights + categorize + rebuild share one cap). The cap is checked before each AI call, so the final call of the month can finish slightly over it — that overshoot is expected and blocks all further calls until the month resets.</div></div>
      <div class="setting-control" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <span id="budget-status" style="font-size:12px;color:var(--text-muted);">--</span>
        <span style="font-size:12px;color:var(--text-muted);">$</span>
        <input id="budget-cap-input" type="number" min="0.01" max="100" step="0.01" inputmode="decimal"
               aria-label="Monthly AI budget cap in dollars" style="width:80px;">
        <button id="budget-cap-save" type="button">Save</button>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Long-Term Memory</div><div class="desc" id="memory-desc">AI maintains a cumulative summary across analyses for context continuity</div></div>
      <div class="setting-control"><span id="memory-status" style="font-size:12px;color:var(--text-muted);">--</span></div>
    </div>
    <div class="setting-row">
      <div class="setting-info">
        <div class="name">AI Accuracy</div>
        <div class="desc" id="audit-accuracy-desc">Share of recent insight runs (last 90 days) with zero critical findings from the post-generation auditor</div>
      </div>
      <div class="setting-control" style="text-align:right;">
        <span id="audit-accuracy-pct" style="font-size:14px;font-weight:600;color:var(--text-muted);">--</span>
        <div id="audit-accuracy-detail" style="font-size:11px;color:var(--text-muted);margin-top:2px;">No audited runs yet</div>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Reset AI Context</div><div class="desc">Clear long-term memory — next analysis starts fresh with no prior context</div></div>
      <div class="setting-control"><button class="btn danger" id="reset-btn">Reset</button></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Rebuild AI Context</div><div class="desc">Regenerate long-term memory by re-reading all historical analyses</div></div>
      <div class="setting-control"><button class="btn primary" id="rebuild-btn">Rebuild</button></div>
    </div>
  </div>

  <div id="insights-container"></div>

  <div class="section"><h2>Transaction Categorization</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">ML Categorization</div><div class="desc" id="cat-desc">Use AI to auto-categorize uncategorized transactions (uses Haiku, ~$0.002/batch)</div><div id="cat-progress" style="font-size:11px;color:var(--teal);margin-top:4px;"></div></div>
      <div class="setting-control"><button class="btn primary" id="categorize-btn">Categorize</button></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Uncategorized</div><div class="desc">Transactions without a category assignment</div></div>
      <div class="setting-control"><span id="uncat-count" style="font-size:12px;color:var(--text-muted);">--</span></div>
    </div>
    <div class="setting-row">
      <div class="setting-info">
        <div class="name">AI Accuracy</div>
        <div class="desc">Verify a sample of AI-assigned categories to track how accurate ML categorization is.</div>
        <div id="cat-accuracy-stat" style="font-size:12px;color:var(--text-muted);margin-top:4px;">--</div>
      </div>
      <div class="setting-control"><button class="btn" id="cat-verify-btn">Verify a sample</button></div>
    </div>
    <div id="cat-verify-panel" style="display:none;padding:8px 0;"></div>
  </div>

  <div class="section"><h2>API Usage History</h2>
    <div id="usage-summary" style="padding:10px 0;font-size:13px;color:var(--text-muted);font-weight:300;">Loading...</div>
    <div id="usage-history" style="max-height:260px;overflow-y:auto;"></div>
  </div>

  <h3 class="settings-group-title" style="font-size:12px;text-transform:uppercase;letter-spacing:1.5px;color:var(--warm, #d4a574);margin:24px 0 12px;font-weight:500;">Notifications &amp; Automation</h3>
  <div class="section"><h2>Push Notifications</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Enable Notifications</div><div class="desc" id="push-desc">Get alerts for anomalies, upcoming charges, and goal milestones</div></div>
      <div class="setting-control"><button class="btn primary" id="push-btn">Enable</button></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Test Notification</div><div class="desc">Send a test push notification to verify setup</div></div>
      <div class="setting-control"><button class="btn" id="test-push-btn" disabled>Test</button></div>
    </div>
  </div>

  <div class="section"><h2>Keep-Alive</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Keep Awake</div><div class="desc">External cron pings the app every 14 min during active hours to prevent Render sleep</div></div>
      <div class="setting-control">
        <label class="toggle"><input type="checkbox" id="keepalive-toggle"><span class="slider"></span></label>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Active Hours</div><div class="desc" id="keepalive-hours-desc">Hours when keep-alive runs (saves Render free tier hours)</div></div>
      <div class="setting-control" style="display:flex;gap:6px;align-items:center;">
        <select id="keepalive-start">
        </select>
        <span style="color:var(--text-muted);font-size:12px;">to</span>
        <select id="keepalive-end">
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Timezone</div><div class="desc">Your local timezone for active hour scheduling</div></div>
      <div class="setting-control">
        <select id="keepalive-tz">
          <option value="America/New_York">Eastern (ET)</option>
          <option value="America/Chicago">Central (CT)</option>
          <option value="America/Denver">Mountain (MT)</option>
          <option value="America/Los_Angeles">Pacific (PT)</option>
          <option value="America/Anchorage">Alaska (AKT)</option>
          <option value="Pacific/Honolulu">Hawaii (HT)</option>
          <option value="Europe/London">London (GMT/BST)</option>
          <option value="Europe/Berlin">Central Europe (CET)</option>
          <option value="Asia/Tokyo">Tokyo (JST)</option>
          <option value="UTC">UTC</option>
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Monthly Hours Estimate</div><div class="desc">Estimated Render hours this app will use per month</div></div>
      <div class="setting-control"><span id="keepalive-estimate" style="font-size:12px;color:var(--text-muted);">--</span></div>
    </div>
  </div>

  <div class="section"><h2>CSV Import Reminders</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Import Reminders</div><div class="desc">Show dashboard banner when manual accounts haven't had a CSV import recently</div></div>
      <div class="setting-control">
        <label class="toggle"><input type="checkbox" id="csv-reminder-toggle"><span class="slider"></span></label>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Reminder Interval</div><div class="desc">Days between reminders</div></div>
      <div class="setting-control">
        <select id="csv-reminder-days">
          <option value="7">Every 7 days</option><option value="14">Every 14 days</option>
          <option value="21">Every 21 days</option><option value="30">Every 30 days</option>
        </select>
      </div>
    </div>
  </div>

  <div class="section"><h2>Bank Auto-Sync</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Automatic Transaction Sync</div><div class="desc">Pull new transactions and account balances on a schedule without clicking Sync</div></div>
      <div class="setting-control">
        <label class="toggle"><input type="checkbox" id="auto-sync-toggle"><span class="slider"></span></label>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Sync Interval</div><div class="desc">How often to fetch new transactions (process must be awake — enable Keep-Alive on free-tier Render)</div></div>
      <div class="setting-control">
        <select id="auto-sync-interval-select">
          <option value="1">Every hour</option>
          <option value="3">Every 3 hours</option>
          <option value="6" selected>Every 6 hours</option>
          <option value="12">Every 12 hours</option>
          <option value="24">Daily</option>
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Last Auto-Sync</div><div class="desc">Most recent scheduled sync run</div></div>
      <div class="setting-control"><span id="auto-sync-last" style="font-size:12px;color:var(--text-muted);">Never</span></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Sync Notifications</div><div class="desc">Show a notification after each auto-sync completes</div></div>
      <div class="setting-control">
        <label class="toggle"><input type="checkbox" id="sync-notif-toggle" checked><span class="slider"></span></label>
      </div>
    </div>
  </div>

  <div class="section"><h2>Sync Health</h2>
    <div id="data-health-body" style="font-size:13px;color:var(--text-muted);">Loading…</div>
    <div class="setting-row" style="margin-top:12px;">
      <div class="setting-info"><div class="name">Reconcile Now</div><div class="desc">Re-fetch the last 90 days from every linked bank to recover any missed transactions. Safe to run anytime — duplicates are ignored.</div></div>
      <div class="setting-control"><button class="btn" id="reconcile-btn">Reconcile</button></div>
    </div>
  </div>

  <div class="section"><h2>Google Sheets Auto-Sync</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Auto-Sync</div><div class="desc">Automatically sync data to Google Sheets on a schedule</div></div>
      <div class="setting-control">
        <label class="toggle"><input type="checkbox" id="sheets-auto-toggle"><span class="slider"></span></label>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Sync Interval</div><div class="desc">How often to auto-push to Sheets</div></div>
      <div class="setting-control">
        <select id="sheets-interval-select">
          <option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option>
        </select>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Last Auto-Sync</div><div class="desc" id="sheets-last-sync-desc">--</div></div>
      <div class="setting-control"><span id="sheets-last-sync" style="font-size:12px;color:var(--text-muted);">Never</span></div>
    </div>
  </div>

  <div class="section"><h2>Dashboard Widgets</h2>
    <div class="setting-row" style="flex-direction:column;align-items:stretch;">
      <div class="setting-info" style="margin-bottom:12px;"><div class="name">Visible Sections</div><div class="desc">Choose which dashboard sections to show</div></div>
      <div id="widget-toggles" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;"></div>
    </div>
  </div>

  <!-- Target allocation (Follow-on for #8). API-only until now; this form
       lets the user enter target percentages per security_type (etf, equity,
       bond, etc.) so /api/investments/performance can compute drift. -->
  <div class="section" id="target-allocation-section"><h2>Target Allocation</h2>
    <div class="setting-row" style="flex-direction:column;align-items:stretch;">
      <div class="setting-info" style="margin-bottom:8px;">
        <div class="name">Target asset-class weights</div>
        <div class="desc">
          Set target % per asset class (security_type from your Plaid holdings).
          The Investments widget will surface drift = actual − target for each class.
          Values are 0-100; sum doesn't have to equal 100, but a balanced sum tends to be most useful.
        </div>
      </div>
      <div id="target-alloc-rows" style="display:flex;flex-direction:column;gap:8px;"></div>
      <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
        <input id="target-alloc-new-class" placeholder="asset class (e.g. equity)"
               style="flex:1 1 160px;min-width:140px;padding:8px 10px;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:6px;font-family:inherit;font-size:13px;">
        <input id="target-alloc-new-pct" type="number" min="0" max="100" step="0.1" placeholder="%"
               style="width:80px;padding:8px 10px;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:6px;font-family:inherit;font-size:13px;text-align:center;">
        <button class="btn" id="target-alloc-add-btn" style="min-width:90px;">+ Add</button>
      </div>
      <div style="margin-top:10px;display:flex;align-items:center;gap:12px;">
        <button class="btn primary" id="target-alloc-save-btn">Save</button>
        <span id="target-alloc-status" style="font-size:11px;color:var(--text-muted);"></span>
        <span id="target-alloc-sum" style="font-size:11px;color:var(--text-muted);margin-left:auto;"></span>
      </div>
    </div>
  </div>

  <!-- Watchlist editor. Tracks user-curated merchants / categories /
       keywords. The Google Sheets sync renders these + their last 90 days
       of matching transactions into the Watchlist tab. -->
  <div class="section" id="watchlist-section"><h2>Watchlist</h2>
    <div class="setting-row" style="flex-direction:column;align-items:stretch;">
      <div class="setting-info" style="margin-bottom:8px;">
        <div class="name">Monitored items</div>
        <div class="desc">
          Add a merchant ("Amazon"), category ("Food and Drink"), or keyword to monitor.
          The Watchlist tab in Google Sheets shows matching transactions over the last 90 days.
        </div>
      </div>
      <div id="watchlist-rows" style="display:flex;flex-direction:column;gap:6px;"></div>
      <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
        <select id="watchlist-new-type" style="padding:8px 10px;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:6px;font-family:inherit;font-size:13px;min-width:120px;">
          <option value="merchant">Merchant</option>
          <option value="category">Category</option>
          <option value="keyword">Keyword</option>
        </select>
        <input id="watchlist-new-value" placeholder="e.g. Amazon, Food and Drink, refund" style="flex:1 1 200px;min-width:140px;padding:8px 10px;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:6px;font-family:inherit;font-size:13px;">
        <button class="btn" id="watchlist-add-btn" style="min-width:90px;">+ Add</button>
      </div>
      <div id="watchlist-status" style="margin-top:6px;font-size:11px;color:var(--text-muted);"></div>
    </div>
  </div>

  <h3 class="settings-group-title" style="font-size:12px;text-transform:uppercase;letter-spacing:1.5px;color:var(--warm, #d4a574);margin:24px 0 12px;font-weight:500;">Data &amp; Export</h3>
  <div class="section"><h2>Data</h2>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Export Transactions</div><div class="desc">Download as CSV</div></div>
      <div class="setting-control"><a href="<%= basePath %>/api/export?type=transactions"><button class="btn">Export</button></a></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Export Subscriptions</div><div class="desc">Download as CSV</div></div>
      <div class="setting-control"><a href="<%= basePath %>/api/export?type=subscriptions"><button class="btn">Export</button></a></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Tax Report</div><div class="desc">Year-end deduction summary for tax prep</div></div>
      <div class="setting-control" style="display:flex;gap:6px;">
        <select id="tax-year-select" style="padding:8px 12px;font-size:13px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font-family:inherit;"></select>
        <a id="tax-csv-link" href="#"><button class="btn">CSV</button></a>
        <a id="tax-json-link" href="#"><button class="btn">JSON</button></a>
        <a id="tax-pdf-link" href="#"><button class="btn">PDF</button></a>
      </div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Export for Claude Chat</div><div class="desc">Download a structured data summary to paste into a Claude conversation for deep-dive analysis</div></div>
      <div class="setting-control"><a href="<%= basePath %>/api/context-export" download><button class="btn primary">Export Context</button></a></div>
    </div>
    <div class="setting-row">
      <div class="setting-info"><div class="name">Save Net Worth Snapshot</div><div class="desc">Record today's net worth from current account balances</div></div>
      <div class="setting-control"><button class="btn" id="snapshot-btn">Snapshot</button></div>
    </div>
  </div>
<%- include('partials/foot') %>
  <script nonce="<%= nonce %>">
    function applyTheme(t) { document.documentElement.setAttribute('data-theme', t); localStorage.setItem('perfin-theme', t); }
    async function loadSettings() {
      try {
        const res = await apiFetch('/api/settings'); if (!res.ok) return;
        const s = await res.json();
        document.getElementById('theme-select').value = s.theme || 'dark';
        document.getElementById('months-select').value = s.dashboard_months || 6;
        document.getElementById('timeout-input').value = s.session_timeout_minutes || 15;
        document.getElementById('shell-idle-input').value = s.shell_idle_timeout_minutes || 60;
        document.getElementById('insights-toggle').checked = s.insights_enabled || false;
        document.getElementById('model-select').value = s.insights_model || 'sonnet';
        document.getElementById('cadence-select').value = s.insights_cadence_days || 30;
        document.getElementById('keepalive-toggle').checked = s.keep_alive_enabled || false;
        document.getElementById('keepalive-start').value = s.keep_alive_start != null ? s.keep_alive_start : 6;
        document.getElementById('keepalive-end').value = s.keep_alive_end != null ? s.keep_alive_end : 0;
        document.getElementById('keepalive-tz').value = s.keep_alive_timezone || 'America/New_York';
        updateKeepAliveEstimate();
        document.getElementById('zip-input').value = s.zip_code || '';
        var pn = document.getElementById('partner-name-input');
        if (pn) pn.value = s.partner_name || '';
        document.getElementById('pyramid-source-select').value = s.pyramid_data_source || 'wellness';
        document.getElementById('pyramid-color-select').value = s.pyramid_color_mode || 'single';
        // New settings
        document.getElementById('csv-reminder-toggle').checked = s.csv_reminder_enabled !== false;
        document.getElementById('csv-reminder-days').value = s.csv_reminder_days || 14;
        document.getElementById('sheets-auto-toggle').checked = s.sheets_auto_sync_enabled || false;
        document.getElementById('sheets-interval-select').value = s.sheets_auto_sync_interval || 'weekly';
        if (s.sheets_last_auto_sync) {
          document.getElementById('sheets-last-sync').textContent = new Date(s.sheets_last_auto_sync).toLocaleString();
        }
        // Bank auto-sync
        document.getElementById('auto-sync-toggle').checked = !!s.auto_sync_enabled;
        document.getElementById('auto-sync-interval-select').value = String(s.auto_sync_interval_hours || 6);
        document.getElementById('sync-notif-toggle').checked = s.sync_notifications_enabled !== false;
        // S2: weekly digest controls. Show a prereq warning when the
        // Per-sistant webhook isn't configured (#16) — without it the
        // digest silently no-ops at the sender.
        document.getElementById('weekly-digest-toggle').checked = !!s.weekly_digest_enabled;
        document.getElementById('weekly-digest-day-select').value = String(s.weekly_digest_day ?? 1);
        var digestPrereq = document.getElementById('weekly-digest-prereq');
        if (digestPrereq) {
          // Under the unified shell (embedded), digests deliver in-process via
          // the wired Per-sistant pool — no webhook config needed. Only warn in
          // standalone deployments where the HTTP webhook is the only path.
          var hasWebhook = !!(s.persistent_url && s.persistent_webhook_enabled);
          digestPrereq.style.display = (s.embedded || hasWebhook) ? 'none' : 'block';
        }
        // #19: daily digest control
        var dailyToggle = document.getElementById('daily-digest-toggle');
        if (dailyToggle) dailyToggle.checked = !!s.daily_digest_enabled;
        // Follow-on for #8: target allocation editor
        var ta = s.target_allocation_pct;
        if (typeof ta === 'string') { try { ta = JSON.parse(ta); } catch { ta = {}; } }
        TARGET_ALLOC = ta || {};
        renderTargetAlloc();
        document.getElementById('auto-sync-last').textContent = s.last_auto_sync_at
          ? new Date(s.last_auto_sync_at).toLocaleString()
          : 'Never';
        renderWidgetToggles(s.dashboard_widgets || {});
        // Render insight module toggles
        const mods = s.insight_modules || {};
        const avail = s.available_modules || {};
        const mc = document.getElementById('modules-container');
        if (mc && Object.keys(avail).length > 0) {
          mc.innerHTML = Object.entries(avail).map(function(e) {
            var key = e[0], mod = e[1];
            var checked = mods[key] !== false ? 'checked' : '';
            var needs = mod.requires_zip ? (s.zip_code ? '' : ' (needs ZIP)') : '';
            return '<label style="display:flex;align-items:flex-start;gap:8px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;cursor:pointer;font-size:12px;transition:border-color 0.2s;">' +
              '<input type="checkbox" ' + checked + ' data-module="' + esc(key) + '" style="margin-top:2px;">' +
              '<span><span style="font-weight:400;">' + esc(mod.label) + '</span>' + needs +
              '<br><span style="color:var(--text-muted);font-weight:300;font-size:11px;">' + esc(mod.description) +
              ' (~+' + parseInt(mod.extra_tokens) + ' tokens)</span></span></label>';
          }).join('');
        }
        applyTheme(s.theme || 'dark');
        // Show memory status \u2014 prefer the structured summary's per-section
        // counts when available so the user sees what the AI is tracking
        // ("3 trends \u00b7 2 goals \u00b7 5 actions \u00b7 1 alert") rather than a vague
        // word count. Falls back to legacy text-summary word count.
        const memEl = document.getElementById('memory-status');
        if (memEl) {
          var j = s.insights_running_summary_json;
          if (typeof j === 'string') { try { j = JSON.parse(j); } catch { j = null; } }
          if (j && typeof j === 'object') {
            var t = (j.trends || []).length, g = (j.completed_goals || []).length,
                a = (j.pending_actions || []).length, al = (j.alerts || []).length;
            memEl.innerHTML =
              '<span style="color:var(--green);">Active</span> &middot; ' +
              t + ' trend' + (t === 1 ? '' : 's') + ' &middot; ' +
              g + ' goal' + (g === 1 ? '' : 's') + ' &middot; ' +
              a + ' action' + (a === 1 ? '' : 's') + ' &middot; ' +
              al + ' alert' + (al === 1 ? '' : 's');
          } else if (s.insights_running_summary) {
            memEl.innerHTML = '<span style="color:var(--green);">Active</span> (' + s.insights_running_summary.split(/\s+/).length + ' words, legacy text format)';
          } else {
            memEl.textContent = 'Not yet initialized \u2014 runs after first analysis';
          }
        }
      } catch {}
      // Check AI API status
      try {
        const sRes = await apiFetch('/api/insights/status');
        const st = await sRes.json();
        const badge = document.getElementById('api-status-badge');
        const desc = document.getElementById('api-status-desc');
        const budgetEl = document.getElementById('budget-status');
        if (st.configured) {
          badge.textContent = 'Active';
          badge.style.background = 'var(--green-bg)'; badge.style.color = 'var(--green)';
          desc.textContent = 'ANTHROPIC_API_KEY is configured and ready';
          if (budgetEl) budgetEl.textContent = '$' + (st.estimated_cost_cents / 100).toFixed(3) + ' of $' + (st.budget_cents / 100).toFixed(2) + ' cap used this month';
          var capInput = document.getElementById('budget-cap-input');
          if (capInput && !capInput.value) capInput.value = (st.budget_cents / 100).toFixed(2);
        } else {
          badge.textContent = 'Not Set';
          badge.style.background = 'var(--yellow-bg)'; badge.style.color = 'var(--yellow)';
          desc.textContent = st.reason + ' \u2014 insights will not run until configured';
          if (budgetEl) budgetEl.textContent = 'N/A';
        }
        // Audit accuracy panel \u2014 surfaces post-generation validation results
        // collected by services/ai-audit.js. "Clean" = zero critical findings.
        const acc = st.audit_accuracy;
        const accEl = document.getElementById('audit-accuracy-pct');
        const detEl = document.getElementById('audit-accuracy-detail');
        if (acc && accEl && detEl) {
          if (acc.total_audited_runs === 0 || acc.accuracy_pct === null) {
            accEl.textContent = '\u2014';
            accEl.style.color = 'var(--text-muted)';
            detEl.textContent = 'No audited runs in the last ' + acc.window_days + ' days';
          } else {
            accEl.textContent = acc.accuracy_pct.toFixed(1) + '%';
            // Color code: green \u226590, yellow 70-89, red <70
            const color = acc.accuracy_pct >= 90 ? 'var(--green)'
              : acc.accuracy_pct >= 70 ? 'var(--yellow)'
              : 'var(--red)';
            accEl.style.color = color;
            const sev = acc.findings_by_severity || {};
            const parts = [acc.clean_runs + ' of ' + acc.total_audited_runs + ' runs clean'];
            if (sev.critical) parts.push(sev.critical + ' critical');
            if (sev.warning) parts.push(sev.warning + ' warning');
            detEl.textContent = parts.join(' \u00b7 ');
          }
        }
      } catch {}
    }
    async function updateSetting(key, value) {
      try {
        const body = {}; body[key] = value;
        const res = await apiFetch('/api/settings', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (res.ok) { showMsg('Setting saved.', true); if (key === 'theme') applyTheme(value); }
        else { const d = await res.json().catch(() => ({})); showMsg(d.error || 'Failed', false); }
      } catch (e) { showMsg(e.message, false); }
    }
    // Monthly AI budget cap — dollars in the input, cents over the wire.
    (function wireBudgetCap() {
      var saveBtn = document.getElementById('budget-cap-save');
      var input = document.getElementById('budget-cap-input');
      if (!saveBtn || !input) return;
      saveBtn.addEventListener('click', async function() {
        var dollars = parseFloat(input.value);
        if (!isFinite(dollars) || dollars < 0.01 || dollars > 100) {
          showMsg('Cap must be between $0.01 and $100', false);
          return;
        }
        await updateSetting('ai_monthly_budget_cents', Math.round(dollars * 100));
        loadSettings(); // refresh the "$X of $Y cap" line with the new cap
      });
    })();
    async function toggleModule(key, enabled) {
      try {
        const res = await apiFetch('/api/settings'); const s = await res.json();
        var mods = s.insight_modules || {};
        mods[key] = enabled;
        await updateSetting('insight_modules', mods);
      } catch (e) { showMsg(e.message, false); }
    }
    async function logout() { await fetch('/api/logout', { method: 'POST' }); window.location.href = '<%= basePath %>/login'; }
    async function generateInsights() {
      const btn = document.getElementById('insights-btn');
      btn.classList.add('btn-loading'); btn.disabled = true;
      try {
        const res = await apiFetch('/api/insights', { method: 'POST' });
        const data = await res.json();
        if (res.ok) {
          var modList = (data.modules_used || []).length > 0 ? ' Modules: ' + data.modules_used.join(', ') + '.' : '';
          showMsg('Insights generated (' + (data.tokens_used || 0) + ' tokens).' + modList, true);
          renderInsight(data.insight);
        }
        else showMsg(data.error || 'Failed', false);
      } catch (e) { showMsg(e.message, false); }
      btn.classList.remove('btn-loading'); btn.disabled = false;
    }
    function renderInsight(text) {
      let safe = esc(text);
      let html = safe
        .replace(/^#{3}\s*(.+)$/gm, '<h4 style="margin:16px 0 8px;font-size:15px;font-weight:600;color:var(--text-primary);">$1</h4>')
        .replace(/^#{2}\s*(.+)$/gm, '<h3 style="margin:16px 0 8px;font-size:17px;font-weight:600;color:var(--text-primary);">$1</h3>')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/^[\-\*] (.+)$/gm, '<li>$1</li>')
        .replace(/(<li>.*<\/li>)/gs, '<ul style="margin:4px 0 8px 16px;padding:0;">$1</ul>')
        .replace(/\n/g, '<br>');
      document.getElementById('insights-container').innerHTML =
        '<div class="insight-card"><h3>AI Financial Insights</h3><div class="insight-text">' + html +
        '</div><div class="insight-meta">Generated just now</div></div>';
    }
    async function loadInsights() {
      try {
        const res = await apiFetch('/api/insights'); const data = await res.json();
        if (data.length > 0) {
          renderInsight(data[0].insight_text);
          const meta = document.querySelector('.insight-meta');
          if (meta) meta.textContent = 'Generated ' + new Date(data[0].created_at).toLocaleDateString();
        }
      } catch {}
    }
    async function loadUsageHistory() {
      try {
        const res = await apiFetch('/api/insights/usage');
        const data = await res.json();
        const sumEl = document.getElementById('usage-summary');
        const t = data.totals;
        sumEl.innerHTML = '<span style="color:var(--text)">' + t.total_runs + ' total runs</span> &middot; ' +
          Number(t.total_tokens).toLocaleString() + ' tokens &middot; <span style="color:var(--warm)">$' +
          parseFloat(t.total_cost_usd).toFixed(4) + ' estimated total</span>';
        const histEl = document.getElementById('usage-history');
        if (data.history.length === 0) { histEl.innerHTML = '<div style="font-size:12px;color:var(--text-muted);padding:8px 0;">No AI insights generated yet.</div>'; return; }
        let html = '<div class="table-wrap"><table style="width:100%;font-size:12px;border-collapse:collapse;">' +
          '<tr style="color:var(--text-muted);text-transform:uppercase;font-size:10px;letter-spacing:1px;">' +
          '<th style="text-align:left;padding:6px 0;border-bottom:1px solid var(--border);">Date</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Tokens</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Est. Cost</th>' +
          '<th style="text-align:right;padding:6px 0;border-bottom:1px solid var(--border);">Model</th></tr>';
        data.history.forEach(function(row) {
          html += '<tr style="font-weight:300;">' +
            '<td style="padding:6px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + new Date(row.created_at).toLocaleDateString() + '</td>' +
            '<td style="text-align:right;padding:6px 0;border-bottom:1px solid rgba(128,128,128,0.06);">' + (row.tokens_used || 0).toLocaleString() + '</td>' +
            '<td style="text-align:right;padding:6px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:var(--warm);">$' + parseFloat(row.estimated_cost_usd || 0).toFixed(4) + '</td>' +
            '<td style="text-align:right;padding:6px 0;border-bottom:1px solid rgba(128,128,128,0.06);color:var(--text-muted);font-size:11px;">' + esc((row.model_used || '').replace('claude-', '').split('-202')[0]) + '</td></tr>';
        });
        html += '</table></div>';
        histEl.innerHTML = html;
      } catch {}
    }
    async function resetContext() {
      if (!confirm('Clear all long-term AI memory? Next analysis will start fresh with no prior context.')) return;
      const btn = document.getElementById('reset-btn');
      btn.classList.add('btn-loading'); btn.disabled = true;
      try {
        const res = await apiFetch('/api/insights/reset', { method: 'POST' });
        const data = await res.json();
        if (res.ok) { showMsg(data.message, true); document.getElementById('memory-status').textContent = 'Cleared \u2014 will reinitialize on next analysis'; }
        else showMsg(data.error || 'Failed', false);
      } catch (e) { showMsg(e.message, false); }
      btn.classList.remove('btn-loading'); btn.disabled = false;
    }
    async function rebuildContext() {
      if (!confirm('Rebuild long-term memory from all historical analyses? This uses a small API call to synthesize past insights.')) return;
      const btn = document.getElementById('rebuild-btn');
      btn.classList.add('btn-loading'); btn.disabled = true;
      try {
        const res = await apiFetch('/api/insights/rebuild', { method: 'POST' });
        const data = await res.json();
        if (res.ok) {
          showMsg(data.message + (data.tokens_used ? ' (' + data.tokens_used + ' tokens)' : ''), true);
          const memEl = document.getElementById('memory-status');
          if (data.summary) memEl.innerHTML = '<span style="color:var(--green);">Active</span> (' + data.summary.split(/\s+/).length + ' words)';
          else memEl.textContent = 'No historical data to rebuild from';
        } else showMsg(data.error || 'Failed', false);
      } catch (e) { showMsg(e.message, false); }
      btn.classList.remove('btn-loading'); btn.disabled = false;
    }
    // Populate hour selectors for keep-alive
    (function() {
      var startSel = document.getElementById('keepalive-start');
      var endSel = document.getElementById('keepalive-end');
      if (!startSel || !endSel) return;
      for (var h = 0; h < 24; h++) {
        var label = (h === 0 ? '12 AM' : h < 12 ? h + ' AM' : h === 12 ? '12 PM' : (h - 12) + ' PM');
        startSel.innerHTML += '<option value="' + h + '">' + label + '</option>';
        endSel.innerHTML += '<option value="' + h + '">' + (h === 0 ? 'Midnight' : label) + '</option>';
      }
    })();
    function updateKeepAliveEstimate() {
      var enabled = document.getElementById('keepalive-toggle').checked;
      var el = document.getElementById('keepalive-estimate');
      if (!enabled) { el.textContent = 'Disabled \u2014 app sleeps after 15 min idle'; return; }
      var start = parseInt(document.getElementById('keepalive-start').value);
      var end = parseInt(document.getElementById('keepalive-end').value);
      var hours;
      if (start === end) hours = 24;
      else if (start < end) hours = end - start;
      else hours = (24 - start) + end;
      var monthly = hours * 30;
      var color = monthly > 375 ? 'var(--red)' : monthly > 300 ? 'var(--yellow)' : 'var(--green)';
      el.innerHTML = '<span style="color:' + color + ';">' + monthly + ' hrs/mo</span> (' + hours + ' hrs/day)' +
        (monthly > 375 ? ' <span style="color:var(--red);font-size:11px;">\u2014 tight if running 2 apps on Render free tier (750 hrs shared)</span>' : '');
    }
    // Override updateSetting to also refresh estimate
    var _origUpdate = updateSetting;
    updateSetting = async function(key, value) {
      await _origUpdate(key, value);
      if (key.startsWith('keep_alive')) updateKeepAliveEstimate();
    };
    async function saveSnapshot() {
      const btn = document.getElementById('snapshot-btn');
      btn.classList.add('btn-loading'); btn.disabled = true;
      try {
        const res = await apiFetch('/api/net-worth/snapshot', { method: 'POST' });
        const data = await res.json();
        if (res.ok) showMsg('Net worth snapshot saved: $' + parseFloat(data.net_worth).toLocaleString(), true);
        else showMsg(data.error || 'Failed', false);
      } catch (e) { showMsg(e.message, false); }
      btn.classList.remove('btn-loading'); btn.disabled = false;
    }
    async function loadCatStatus() {
      try {
        const res = await apiFetch('/api/categorize/status'); const d = await res.json();
        document.getElementById('uncat-count').textContent = d.uncategorized + ' transactions';
        if (!d.ai_available) document.getElementById('categorize-btn').disabled = true;
      } catch {}
    }
    async function runCategorize() {
      var btn = document.getElementById('categorize-btn');
      var prog = document.getElementById('cat-progress');
      btn.classList.add('btn-loading'); btn.disabled = true;
      var t0 = Date.now();
      // Poll live progress so the user sees it's actually working (rules/map/AI
      // counts + elapsed) instead of a blind spinner.
      var poll = setInterval(async function () {
        try {
          var pr = await apiFetch('/api/categorize/progress');
          if (!pr.ok) return;
          var p = await pr.json();
          if (!prog) return;
          var secs = Math.round((Date.now() - t0) / 1000);
          if (p.running === false) { prog.textContent = ''; return; }
          var done = (p.by_rules || 0) + (p.by_teller_map || 0) + (p.by_ai || 0);
          var phase = p.phase === 'ai' ? 'AI categorizing' : 'Applying rules';
          prog.textContent = phase + '… ' + done + ' done (' + (p.by_rules || 0) + ' rules · ' + (p.by_teller_map || 0) + ' map · ' + (p.by_ai || 0) + ' AI) · ' + secs + 's';
        } catch (e) { /* keep polling */ }
      }, 1500);
      try {
        var res = await apiFetch('/api/categorize', { method: 'POST' });
        var data = await res.json();
        if (res.ok) {
          showMsg('Categorized ' + data.categorized + ' transactions (' + data.categorized_by_rules + ' rules, ' + data.categorized_by_teller_map + ' map, ' + data.categorized_by_ai + ' AI; ~$' + data.estimated_cost + '). ' + data.remaining + ' remaining.' + (data.budget_hit ? ' AI budget cap reached — raise it to keep going.' : ''), true);
          loadCatStatus();
          loadCatAccuracy();
        } else showMsg(data.error || 'Failed', false);
      } catch (e) { showMsg(e.message, false); }
      finally {
        clearInterval(poll);
        if (prog) prog.textContent = '';
        btn.classList.remove('btn-loading'); btn.disabled = false;
      }
    }
    async function loadCatAccuracy() {
      try {
        var res = await apiFetch('/api/categorize/accuracy');
        if (!res.ok) return;
        var d = await res.json();
        var el = document.getElementById('cat-accuracy-stat');
        if (!el) return;
        if (d.verified > 0) {
          el.textContent = d.accuracy_pct + '% accurate (' + d.correct + '/' + d.verified + ' verified · ' + d.unverified + ' unverified of ' + d.ai_total + ' AI-tagged)';
        } else if (d.ai_total > 0) {
          el.textContent = 'No samples verified yet · ' + d.ai_total + ' AI-tagged transactions';
        } else {
          el.textContent = 'No AI-categorized transactions yet — run Categorize first.';
        }
      } catch (e) { /* non-critical */ }
    }
    function escAttr(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
