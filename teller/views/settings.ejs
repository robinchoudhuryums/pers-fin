      ['theme-select', 'change', function() { updateSetting('theme', this.value); }],
      ['months-select', 'change', function() { updateSetting('dashboard_months', parseInt(this.value)); }],
      ['timeout-input', 'change', function() { updateSetting('session_timeout_minutes', parseInt(this.value)); }],
      ['shell-idle-input', 'change', function() { updateSetting('shell_idle_timeout_minutes', parseInt(this.value)); }],
      ['logout-btn', 'click', logout],
      ['biometric-register-btn', 'click', registerBiometric],
      ['insights-toggle', 'change', function() { updateSetting('insights_enabled', this.checked); }],
      ['insights-btn', 'click', generateInsights],
      ['model-select', 'change', function() { updateSetting('insights_model', this.value); }],
      ['cadence-select', 'change', function() { updateSetting('insights_cadence_days', parseInt(this.value)); }],
      ['zip-input', 'change', function() { updateSetting('zip_code', this.value); }],
      ['partner-name-input', 'change', function() { updateSetting('partner_name', this.value); }],
      ['reset-btn', 'click', resetContext],
      ['rebuild-btn', 'click', rebuildContext],
      ['categorize-btn', 'click', runCategorize],
      ['cat-verify-btn', 'click', loadAccuracySample],
      ['push-btn', 'click', togglePush],
      ['test-push-btn', 'click', testPush],
      ['keepalive-toggle', 'change', function() { updateSetting('keep_alive_enabled', this.checked); }],
      ['keepalive-start', 'change', function() { updateSetting('keep_alive_start', parseInt(this.value)); }],
      ['keepalive-end', 'change', function() { updateSetting('keep_alive_end', parseInt(this.value)); }],
      ['keepalive-tz', 'change', function() { updateSetting('keep_alive_timezone', this.value); }],
      ['pyramid-source-select', 'change', function() { updateSetting('pyramid_data_source', this.value); }],
      ['pyramid-color-select', 'change', function() { updateSetting('pyramid_color_mode', this.value); }],
      ['snapshot-btn', 'click', saveSnapshot],
      ['csv-reminder-toggle', 'change', function() { updateSetting('csv_reminder_enabled', this.checked); }],
      ['csv-reminder-days', 'change', function() { updateSetting('csv_reminder_days', parseInt(this.value)); }],
      ['sheets-auto-toggle', 'change', function() { updateSetting('sheets_auto_sync_enabled', this.checked); }],
      ['sheets-interval-select', 'change', function() { updateSetting('sheets_auto_sync_interval', this.value); }],
      ['auto-sync-toggle', 'change', function() { updateSetting('auto_sync_enabled', this.checked); }],
      ['auto-sync-interval-select', 'change', function() { updateSetting('auto_sync_interval_hours', parseInt(this.value)); }],
      ['sync-notif-toggle', 'change', function() { updateSetting('sync_notifications_enabled', this.checked); }],
      ['weekly-digest-toggle', 'change', function() { updateSetting('weekly_digest_enabled', this.checked); }],
      ['weekly-digest-day-select', 'change', function() { updateSetting('weekly_digest_day', parseInt(this.value)); }],
      ['daily-digest-toggle', 'change', function() { updateSetting('daily_digest_enabled', this.checked); }],
      ['install-btn', 'click', async function() {
        const result = await perfinPromptInstall();
        if (result && result.outcome === 'accepted') showMsg('Installing Perfin…', true);
        else if (result && result.outcome === 'unavailable') showMsg('Install prompt not available — use your browser menu: Share → Add to Home Screen (iOS) or ⋮ → Install (Chrome).', false);
      }],
    ]);

    // Install prompt visibility:
    // - Already installed?   Hide the section.
    // - Browser emitted beforeinstallprompt? Show "Install" button.
    // - Neither (iOS Safari / not eligible)? Show instructions instead.
    (function() {
      var section = document.getElementById('install-section');
      if (!section) return;
      if (perfinIsInstalled()) { section.style.display = 'none'; return; }
      function show(ready) {
        section.style.display = '';
        var desc = document.getElementById('install-desc');
        var btn = document.getElementById('install-btn');
        if (ready) {
          btn.style.display = '';
          desc.textContent = 'Install Perfin as a standalone app for faster access and offline fallback';
        } else {
          btn.style.display = 'none';
          desc.textContent = 'On iOS Safari, tap Share → "Add to Home Screen". On Android Chrome, use ⋮ → "Install app".';
        }
      }
      if (window._perfinInstallPrompt) show(true);
      else show(false);
      window.addEventListener('perfin:installable', function() { show(true); });
      window.addEventListener('perfin:installed', function() { section.style.display = 'none'; });
    })();
    // Event delegation for dynamically generated module checkboxes
    onDelegate('modules-container', 'change', 'input[data-module]', function() {
      toggleModule(this.dataset.module, this.checked);
    });
    // Event delegation for widget toggles
    onDelegate('widget-toggles', 'change', 'input[data-widget]', function() {
      var key = this.dataset.widget;
      var enabled = this.checked;
      (async function() {
        try {
          var res = await apiFetch('/api/settings'); var s = await res.json();
          var widgets = s.dashboard_widgets || {};
          widgets[key] = enabled;
          await updateSetting('dashboard_widgets', widgets);
        } catch (e) { showMsg(e.message, false); }
      })();
    });
    onDelegate('biometric-list', 'click', '[data-bio-remove]', function() {
      removeBiometricCredential(this.getAttribute('data-bio-remove'), this.getAttribute('data-bio-name'));
    });

    function dhAge(sec) {
      if (sec == null) return 'never';
      if (sec < 3600) return Math.max(1, Math.round(sec / 60)) + 'm ago';
      if (sec < 86400) return Math.round(sec / 3600) + 'h ago';
      return Math.round(sec / 86400) + 'd ago';
    }
    function dhDot(level) {
      var c = level === 'fresh' ? 'var(--green,#4caf50)' : level === 'aging' ? 'var(--warm,#d4a574)' : 'var(--red,#eb6b6b)';
      return '<span style="color:' + c + ';">●</span> ';
    }
    async function loadDataHealth() {
      var el = document.getElementById('data-health-body');
      if (!el) return;
      try {
        var res = await apiFetch('/api/data-health');
        if (!res.ok) { el.textContent = 'Unavailable'; return; }
        var h = await res.json();
        var f = h.freshness || {};
        var out = '';
        out += '<div style="font-weight:600;margin-bottom:8px;color:' + (h.ok ? 'var(--green,#4caf50)' : 'var(--red,#eb6b6b)') + ';">'
             + (h.ok ? 'All systems healthy' : 'Attention needed') + '</div>';
        out += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 16px;margin-bottom:8px;">'
             + '<div>' + dhDot(f.transactions && f.transactions.level) + 'Transactions: ' + dhAge(f.transactions && f.transactions.age_seconds) + '</div>'
             + '<div>' + dhDot(f.balances && f.balances.level) + 'Balances: ' + dhAge(f.balances && f.balances.age_seconds) + '</div>'
             + '<div>' + dhDot(f.auto_sync && f.auto_sync.level) + 'Auto-sync: ' + dhAge(f.auto_sync && f.auto_sync.age_seconds) + '</div>'
             + '<div>' + dhDot(f.insights && f.insights.level) + 'Insights: ' + dhAge(f.insights && f.insights.age_seconds) + '</div>'
             + '</div>';
        var p = h.providers || { teller: {}, plaid: {} };
        out += '<div style="margin-bottom:6px;">Teller: ' + (p.teller.total || 0) + ' linked'
             + (p.teller.disconnected ? ', <span style="color:var(--red,#eb6b6b);">' + p.teller.disconnected + ' disconnected</span>' : '')
             + ' · Plaid: ' + (p.plaid.total || 0) + ' linked'
             + (p.plaid.not_good ? ', <span style="color:var(--red,#eb6b6b);">' + p.plaid.not_good + ' need re-auth</span>' : '')
             + '</div>';
        if (h.issues && h.issues.length) {
          out += '<ul style="margin:6px 0;padding-left:18px;">' + h.issues.map(function (i) {
            var c = i.severity === 'info' ? 'var(--text-muted)' : 'var(--red,#eb6b6b)';
            return '<li style="color:' + c + ';">' + esc(i.message) + '</li>';
          }).join('') + '</ul>';
        }
        if (h.last_reconcile_at) {
          out += '<div style="font-size:11px;color:var(--text-muted);margin-top:4px;">Last reconcile: ' + new Date(h.last_reconcile_at).toLocaleString() + '</div>';
        }
        el.innerHTML = out;
      } catch (e) { el.textContent = 'Unavailable'; }
    }
    (function () {
      var rb = document.getElementById('reconcile-btn');
      if (!rb) return;
      var reconcilePoll = null;
      function pollReconcile(prev) {
        reconcilePoll = setInterval(async function () {
          try {
            var sres = await apiFetch('/api/sync/reconcile/status');
            if (!sres.ok) return;
            var st = await sres.json();
            if (st.running) {
              // Live subtext on the button: current phase + elapsed seconds.
              var secs = st.started_at ? Math.round((Date.now() - new Date(st.started_at).getTime()) / 1000) : 0;
              rb.textContent = (st.phase || 'Reconciling') + '… ' + secs + 's';
              return;
            }
            clearInterval(reconcilePoll); reconcilePoll = null;
            rb.disabled = false; rb.textContent = prev;
            if (st.error) showMsg('Reconcile finished with errors: ' + st.error, false);
            else showMsg('Reconcile complete.', true);
            loadDataHealth();
          } catch (e) { /* keep polling */ }
        }, 4000);
      }
      rb.addEventListener('click', async function () {
        rb.disabled = true; var prev = rb.textContent; rb.textContent = 'Reconciling…';
        try {
          // Run in the background — the Plaid leg re-walks up to 2 years of
          // history and can take a while. We poll for completion and also push
          // a notification when done, so the user can navigate away.
          var res = await apiFetch('/api/sync/reconcile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ days: 90, provider: 'all', background: true }),
          });
          var j = await res.json();
          if (res.status === 202 || j.started) {
            showMsg('Reconcile started — this can take a minute; you’ll get a notification when it finishes.', true);
            pollReconcile(prev);
          } else if (res.status === 409) {
            showMsg('A reconcile is already running.', false);
            pollReconcile(prev);
          } else {
            showMsg(j.error || 'Reconcile failed', false);
            rb.disabled = false; rb.textContent = prev;
          }
        } catch (e) {
          showMsg(e.message, false);
          rb.disabled = false; rb.textContent = prev;
        }
      });
    })();

    checkPushStatus();
    loadSettings(); loadInsights(); loadUsageHistory(); loadCatStatus(); loadCatAccuracy(); loadBiometricCredentials(); loadDataHealth();
  </script>
</body></html>
