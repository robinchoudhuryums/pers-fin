<%
  // basePath is "" standalone, "/perfin" mounted. Prefix nav hrefs so
  // browser navigation lands on the right tool (otherwise "/dashboard"
  // would hit the shell's landing page).
  var __basePath = typeof basePath !== 'undefined' ? basePath : '';
  // `embedded` is set by the basePath middleware in server.js when this
  // app is mounted under the unified shell. Used to show the cross-app
  // link to Per-sistant.
  var __embedded = typeof embedded !== 'undefined' && embedded;
%>
  <nav class="topnav" aria-label="Main navigation">
    <div class="logo"><span class="logo-icon" aria-hidden="true"></span>Perfin</div>
    <div class="nav-links" role="list">
      <a href="<%= __basePath %>/dashboard"<%= activePage === 'dashboard' ? ' class="active"' : '' %>>Dashboard</a>
      <a href="<%= __basePath %>/subscriptions"<%= activePage === 'subscriptions' ? ' class="active"' : '' %>>Subscriptions</a>
      <a href="<%= __basePath %>/transactions"<%= activePage === 'transactions' ? ' class="active"' : '' %>>Transactions</a>
      <a href="<%= __basePath %>/goals"<%= activePage === 'goals' ? ' class="active"' : '' %>>Goals</a>
      <a href="<%= __basePath %>/budgets"<%= activePage === 'budgets' ? ' class="active"' : '' %>>Budgets</a>
      <a href="<%= __basePath %>/accounts"<%= activePage === 'accounts' ? ' class="active"' : '' %>>Accounts</a>
      <a href="<%= __basePath %>/settings"<%= activePage === 'settings' ? ' class="active"' : '' %>>Settings</a>
    </div>
<% if (__embedded) { %>
    <a href="/per-sistant" class="cross-app-link" id="cross-app-link" data-atrans="cosmic" title="Switch to Per-sistant" aria-label="Switch to Per-sistant" style="display:inline-flex;align-items:center;justify-content:center;padding:4px;border:1px solid var(--border);border-radius:6px;margin-right:8px;line-height:0;">
      <img src="/per-sistant/android-chrome-mask-crop.png" alt="" aria-hidden="true" width="22" height="22" style="display:block;object-fit:contain;">
    </a>
<% } %>
    <div class="nav-sync-badge" id="nav-sync-badge" title="Most recent sync — updated by auto-sync or the Sync button"></div>
    <div class="nav-notification-bell" id="nav-notif-bell" title="Notifications" style="cursor:pointer;position:relative;padding:4px 8px;display:flex;align-items:center;">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="display:block;">
        <circle cx="10" cy="10" r="8.5" stroke="var(--warm, #d4a574)" stroke-width="1.5" fill="none"/>
        <circle cx="10" cy="10" r="4" stroke="var(--warm, #d4a574)" stroke-width="1.2" fill="none"/>
        <circle cx="10" cy="10" r="1.5" fill="var(--warm, #d4a574)"/>
      </svg>
      <span id="nav-notif-count" style="display:none;position:absolute;top:-2px;right:-2px;background:var(--red);color:#fff;border-radius:50%;font-size:9px;min-width:16px;height:16px;line-height:16px;text-align:center;"></span>
    </div>
  </nav>
<% if (__embedded) { %>
  <!-- Cross-app cosmic transition overlay (Perfin → Per-sistant). Decorations
       are populated by transition.js on init. The cross-app link gets a
       data-atrans="cosmic" attribute below to bind the click handler. -->
  <div class="atrans-overlay atrans--cosmic" id="atrans-cosmic" aria-hidden="true">
    <div class="atrans-particles"></div>
    <div class="atrans-stage">
      <div class="atrans-stars"></div>
      <div class="atrans-nebula"></div>
      <div class="atrans-ring"></div>
      <div class="atrans-art-wrap">
        <div class="atrans-art"><img src="/per-sistant/android-chrome-mask-crop.png" alt="" aria-hidden="true"></div>
        <div class="atrans-scanline"></div>
      </div>
    </div>
  </div>
  <script src="/shell-static/transition.js?v=2" defer></script>
<% } %>
  <!-- Notification backdrop (dim layer behind the panel on mobile bottom-sheet). -->
  <div id="notif-backdrop" class="notif-backdrop" hidden></div>

  <!-- Notification dropdown panel. CSS class drives layout so the mobile
       media query can convert it into a bottom sheet without inline-style
       fights. Drag handle is shown on mobile only. -->
  <div id="notif-panel" class="notif-panel" hidden>
    <div class="notif-grabber" aria-hidden="true"></div>
    <div class="notif-header">
      <strong>Notifications</strong>
      <button id="notif-mark-all" class="notif-mark-all">Mark all read</button>
    </div>
    <div id="notif-list" class="notif-list"></div>
    <!-- Debug mode toggle. Persists in localStorage so it survives page
         reloads. When on, an on-screen log panel captures console output,
         uncaught exceptions, and iframe attachments — useful for
         debugging issues on devices without easy DevTools access. -->
    <div class="notif-footer">
      <span class="notif-footer-label">Debug mode</span>
      <label class="notif-footer-toggle">
        <input type="checkbox" id="nav-debug-toggle">
        <span id="nav-debug-state">off</span>
      </label>
    </div>
  </div>
  <main id="main-content">
  <script nonce="<%= nonce %>">
    // Populate the "Last synced Xm ago" badge from /api/settings.last_auto_sync_at.
    // Purely informational — no action; graceful no-op if the API call fails.
    (async function() {
      var el = document.getElementById('nav-sync-badge');
      if (!el) return;
      function fmtAgo(iso) {
        if (!iso) return '';
        var s = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
        if (s < 60) return 'just synced';
        if (s < 3600) return Math.floor(s / 60) + 'm ago';
        if (s < 86400) return Math.floor(s / 3600) + 'h ago';
        return Math.floor(s / 86400) + 'd ago';
      }
      try {
        var r = await apiFetch('/api/settings');
        if (!r.ok) return;
        var s = await r.json();
        // Show the most recent sync timestamp (max of all sources)
        var candidates = [s.last_auto_sync_at, s.last_txn_sync_at, s.last_balance_sync_at].filter(Boolean);
        var latestSync = candidates.length ? candidates.reduce(function(a, b) { return new Date(a) > new Date(b) ? a : b; }) : null;
        if (latestSync) el.textContent = 'Synced ' + fmtAgo(latestSync);
        // Build detailed tooltip
        var tips = [];
        if (s.last_txn_sync_at) tips.push('Transactions: ' + fmtAgo(s.last_txn_sync_at));
        if (s.last_balance_sync_at) tips.push('Balances: ' + fmtAgo(s.last_balance_sync_at));
        if (s.last_auto_sync_at) tips.push('Auto-sync: ' + fmtAgo(s.last_auto_sync_at));
        if (tips.length) el.title = tips.join('\n');
        // Visual staleness — warn if data is older than 24 hours
        if (latestSync) {
          var ageHrs = (Date.now() - new Date(latestSync).getTime()) / 3600000;
          if (ageHrs > 24) el.style.color = 'var(--red)';
          else if (ageHrs > 6) el.style.color = 'var(--yellow, #f0c36d)';
        }
      } catch (_) {}
    })();

    // Notification bell — load unread count and toggle panel
    (async function() {
      var bell = document.getElementById('nav-notif-bell');
      var badge = document.getElementById('nav-notif-count');
      var panel = document.getElementById('notif-panel');
      var list = document.getElementById('notif-list');
      if (!bell || !panel) return;

      async function loadNotifs() {
        try {
          var r = await apiFetch('/api/notifications?limit=20');
          if (!r.ok) return;
          var data = await r.json();
          if (data.unread_count > 0) {
            badge.textContent = data.unread_count > 9 ? '9+' : data.unread_count;
            badge.style.display = '';
          } else {
            badge.style.display = 'none';
          }
          if (!panel.hidden) renderList(data.notifications);
        } catch (_) {}
      }

      function renderList(notifs) {
        if (!notifs.length) { list.innerHTML = '<div style="padding:16px;text-align:center;color:var(--text-muted);font-size:13px;">No notifications</div>'; return; }
        list.innerHTML = notifs.map(function(n) {
          var ago = fmtAgo(n.created_at);
          var bg = n.is_read ? '' : 'background:rgba(95,191,191,0.05);';
          return '<div data-nid="' + n.id + '" style="padding:10px 16px;border-bottom:1px solid var(--border);cursor:pointer;font-size:12px;' + bg + '">' +
            '<div style="font-weight:' + (n.is_read ? '400' : '600') + ';">' + esc(n.title) + '</div>' +
            '<div style="color:var(--text-muted);margin-top:2px;">' + esc(n.body) + '</div>' +
            '<div style="color:var(--text-muted);font-size:10px;margin-top:4px;">' + ago + '</div>' +
          '</div>';
        }).join('');
      }

      function fmtAgo(iso) {
        if (!iso) return '';
        var s = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
        if (s < 60) return 'just now';
        if (s < 3600) return Math.floor(s / 60) + 'm ago';
        if (s < 86400) return Math.floor(s / 3600) + 'h ago';
        return Math.floor(s / 86400) + 'd ago';
      }

      var backdrop = document.getElementById('notif-backdrop');
      function openPanel() {
        panel.hidden = false;
        if (backdrop) backdrop.hidden = false;
      }
      function closePanel() {
        panel.hidden = true;
        if (backdrop) backdrop.hidden = true;
      }
      bell.addEventListener('click', async function(e) {
        e.stopPropagation();
        if (panel.hidden) {
          openPanel();
          try {
            var r = await apiFetch('/api/notifications?limit=20');
            if (r.ok) { var data = await r.json(); renderList(data.notifications); }
          } catch (_) {}
        } else {
          closePanel();
        }
      });

      if (backdrop) backdrop.addEventListener('click', closePanel);

      document.addEventListener('click', function(e) {
        if (panel.hidden) return;
        if (!panel.contains(e.target) && !bell.contains(e.target)) closePanel();
      });
      // ESC also closes (useful on desktop, harmless on mobile).
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !panel.hidden) closePanel();
      });

      // Click notification to mark read
      list.addEventListener('click', async function(e) {
        var item = e.target.closest('[data-nid]');
        if (!item) return;
        var nid = item.getAttribute('data-nid');
        try {
          await apiFetch('/api/notifications/' + nid + '/read', { method: 'PATCH' });
          loadNotifs();
        } catch (_) {}
      });

      document.getElementById('notif-mark-all').addEventListener('click', async function() {
        try {
          await apiFetch('/api/notifications/read-all', { method: 'POST' });
          loadNotifs();
        } catch (_) {}
      });

      // Debug-mode toggle wiring. The actual on-screen log overlay lives
      // in perfin-shared.js; it auto-activates on page load when the
      // localStorage flag is set. Toggling here just sets/clears the flag
      // and prompts a reload so the overlay can attach (or detach).
      var debugToggle = document.getElementById('nav-debug-toggle');
      var debugState = document.getElementById('nav-debug-state');
      function refreshDebugToggle() {
        var on = false;
        try { on = localStorage.getItem('perfin_debug') === '1'; } catch (_) {}
        debugToggle.checked = on;
        debugState.textContent = on ? 'on' : 'off';
        debugState.style.color = on ? 'var(--green)' : 'var(--text-muted)';
      }
      refreshDebugToggle();
      debugToggle.addEventListener('change', function() {
        try {
          if (this.checked) localStorage.setItem('perfin_debug', '1');
          else localStorage.removeItem('perfin_debug');
        } catch (_) {}
        refreshDebugToggle();
        // Reload so the overlay (de)activates on the new state.
        setTimeout(function() { location.reload(); }, 250);
      });

      loadNotifs();
    })();
  </script>
