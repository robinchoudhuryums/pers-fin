      <a href="/dashboard"<%= activePage === 'dashboard' ? ' class="active"' : '' %>>Dashboard</a>
      <a href="/subscriptions"<%= activePage === 'subscriptions' ? ' class="active"' : '' %>>Subscriptions</a>
