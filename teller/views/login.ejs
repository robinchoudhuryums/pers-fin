  <div class="login-card">
    <div class="login-logo"><span class="login-logo-icon" aria-hidden="true"></span>Perfin</div>
    <h1>Welcome back</h1>
    <% if (isPin) { %>
    <p>Enter your PIN</p>
    <div class="pin-dots" id="pin-dots"></div>
    <div class="pin-pad" id="pin-pad"></div>
    <div id="error" class="error-msg"></div>
    <% } else { %>
    <p>Enter your password to continue</p>
    <form id="login-form">
      <input type="password" id="password" placeholder="Password" autofocus required>
      <button type="submit">Sign In</button>
    </form>
    <div id="error" class="error-msg"></div>
    <% } %>
    <% if (hasWebauthn) { %>
    <div class="biometric-divider"><span>or</span></div>
    <button class="faceid-btn" id="faceid-btn" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 3H5a2 2 0 0 0-2 2v2"/>
        <path d="M17 3h2a2 2 0 0 1 2 2v2"/>
        <path d="M7 21H5a2 2 0 0 1-2-2v-2"/>
        <path d="M17 21h2a2 2 0 0 0 2-2v-2"/>
        <circle cx="9" cy="10" r="0.5" fill="currentColor" stroke="none"/>
        <circle cx="15" cy="10" r="0.5" fill="currentColor" stroke="none"/>
        <path d="M9.5 15a3.5 3.5 0 0 0 5 0"/>
      </svg>
      Sign in with Biometrics
    </button>
    <% } %>
  </div>
  <script nonce="<%= nonce %>">
    var AUTH_MODE = '<%= authMode %>';
    var HAS_WEBAUTHN = <%= hasWebauthn ? 'true' : 'false' %>;
    var errEl = document.getElementById('error');
    var overlay = document.getElementById('materialize-overlay');
    var helmetSvg = document.getElementById('helmet-svg');
    var bioScan = document.getElementById('bio-scan');
    var bioStatus = document.getElementById('bio-scan-status');

    // For biometric flow: show scan first, then transition to helmet
    function playBiometricMaterialize() {
      helmetSvg.style.display = 'none';
      overlay.classList.add('active');
      bioScan.classList.add('active');
      bioStatus.textContent = 'Scanning';
    }

    function biometricSuccess() {
      bioStatus.textContent = 'Verified';
      bioScan.classList.add('bio-scan-success');
      // After brief success flash, shrink scan and reveal helmet
      setTimeout(function() {
        bioScan.classList.add('shrink');
        setTimeout(function() {
          bioScan.style.display = 'none';
          helmetSvg.style.display = '';
          // Force reflow to restart helmet animations
          void helmetSvg.offsetWidth;
          // Helmet draws after scan shrinks, then HUD effects play
          setTimeout(function() {
            window.location.href = '/dashboard';
          }, 2200);
        }, 500);
      }, 600);
    }

    function biometricFail(msg) {
      overlay.classList.remove('active');
      bioScan.classList.remove('active', 'bio-scan-success', 'shrink');
      bioScan.style.display = '';
      helmetSvg.style.display = '';
      errEl.textContent = msg || 'Biometric verification failed';
      errEl.style.display = 'block';
      var btn = document.getElementById('faceid-btn');
      if (btn) btn.disabled = false;
    }

    // Generate ambient particles and burst particles on load
    (function() {
      var particlesEl = document.getElementById('overlay-particles');
      for (var p = 0; p < 20; p++) {
        var dot = document.createElement('div');
        dot.className = 'overlay-particle';
        dot.style.cssText = 'left:' + (5 + Math.random() * 90) + '%;bottom:' + (Math.random() * 40) + '%;--dur:' + (2.5 + Math.random() * 3) + 's;--delay:' + (Math.random() * 2) + 's;width:' + (1 + Math.random() * 2) + 'px;height:' + (1 + Math.random() * 2) + 'px;';
        particlesEl.appendChild(dot);
      }
      var burstEl = document.getElementById('burst-container');
      for (var b = 0; b < 12; b++) {
        var angle = (b / 12) * Math.PI * 2;
        var dist = 60 + Math.random() * 40;
        var bDot = document.createElement('div');
        bDot.className = 'burst-particle';
        bDot.style.setProperty('--burst-dir', 'translate(' + Math.round(Math.cos(angle) * dist) + 'px,' + Math.round(Math.sin(angle) * dist) + 'px)');
        burstEl.appendChild(bDot);
      }
    })();

    // Standard PIN/password flow
    function playMaterialize() {
      bioScan.style.display = 'none';
      overlay.classList.add('active');
      setTimeout(function() {
        window.location.href = '/dashboard';
      }, 2200);
    }

    async function doLogin(value) {
      try {
        var res = await fetch('/api/login', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: value }),
        });
        var data = await res.json();
        if (res.ok) {
          playMaterialize();
          return null;
        }
        else return data.error || 'Invalid ' + AUTH_MODE;
      } catch(e) { return 'Connection error'; }
    }

    // ── WebAuthn / Biometric login ──
    if (HAS_WEBAUTHN) {
      document.getElementById('faceid-btn').addEventListener('click', async function() {
        this.disabled = true;
        errEl.style.display = 'none';
        playBiometricMaterialize();

        try {
          // 1. Get authentication options from server
          var optRes = await fetch('/api/webauthn/authenticate-options', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
          });
          if (!optRes.ok) {
            var optErr = await optRes.json();
            throw new Error(optErr.error || 'Failed to get auth options');
          }
          var options = await optRes.json();

          // 2. Convert base64url fields to ArrayBuffer for WebAuthn API
          options.challenge = base64urlToBuffer(options.challenge);
          if (options.allowCredentials) {
            options.allowCredentials = options.allowCredentials.map(function(c) {
              return { id: base64urlToBuffer(c.id), type: c.type };
            });
          }

          // 3. Prompt biometric (FaceID / fingerprint / etc.)
          bioStatus.textContent = 'Verifying';
          var credential = await navigator.credentials.get({ publicKey: options });

          // 4. Send response to server for verification
          var authBody = {
            id: credential.id,
            rawId: bufferToBase64url(credential.rawId),
            type: credential.type,
            response: {
              authenticatorData: bufferToBase64url(credential.response.authenticatorData),
              clientDataJSON: bufferToBase64url(credential.response.clientDataJSON),
              signature: bufferToBase64url(credential.response.signature),
            },
          };
          if (credential.response.userHandle) {
            authBody.response.userHandle = bufferToBase64url(credential.response.userHandle);
          }

          var verRes = await fetch('/api/webauthn/authenticate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(authBody),
          });
          if (!verRes.ok) {
            var verErr = await verRes.json();
            throw new Error(verErr.error || 'Verification failed');
          }

          // 5. Success — play helmet animation
          biometricSuccess();
        } catch(err) {
          if (err.name === 'NotAllowedError') {
            biometricFail('Biometric cancelled');
          } else {
            biometricFail(err.message || 'Biometric login failed');
          }
        }
      });
    }

    // ── Base64url helpers ──
    function base64urlToBuffer(str) {
      var base64 = str.replace(/-/g, '+').replace(/_/g, '/');
      while (base64.length % 4) base64 += '=';
      var binary = atob(base64);
      var bytes = new Uint8Array(binary.length);
      for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      return bytes.buffer;
    }
    function bufferToBase64url(buf) {
      var bytes = new Uint8Array(buf);
      var binary = '';
      for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
    }

    // ── PIN pad logic ──
    if (AUTH_MODE === 'pin') {
      var pinLen = 8;
      var pin = '';
      var submitting = false;
      var dotsEl = document.getElementById('pin-dots');
      var dotsHtml = '';
      for (var i = 0; i < pinLen; i++) dotsHtml += '<div class="pin-dot" id="dot-' + i + '"></div>';
      dotsEl.innerHTML = dotsHtml;
      var padEl = document.getElementById('pin-pad');
      var padHtml = '';
      [1,2,3,4,5,6,7,8,9].forEach(function(n) {
        padHtml += '<button class="pin-key" type="button" data-digit="' + n + '">' + n + '</button>';
      });
      padHtml += '<button class="pin-key fn" type="button" data-action="clear">Clear</button>';
      padHtml += '<button class="pin-key" type="button" data-digit="0">0</button>';
      padHtml += '<button class="pin-key fn" type="button" data-action="submit" style="color:var(--warm);">Go</button>';
      padEl.innerHTML = padHtml;
      function updateDots() {
        for (var j = 0; j < pinLen; j++) {
          document.getElementById('dot-' + j).className = 'pin-dot' + (j < pin.length ? ' filled' : '');
        }
      }
      function handleDigit(n) {
        if (pin.length >= pinLen || submitting) return;
        pin += n;
        updateDots();
        errEl.style.display = 'none';
      }
      async function submitPin() {
        if (!pin.length || submitting) return;
        submitting = true;
        var err = await doLogin(pin);
        if (err) {
          for (var j = 0; j < pinLen; j++) {
            if (j < pin.length) document.getElementById('dot-' + j).className = 'pin-dot error';
          }
          dotsEl.classList.add('shake');
          errEl.textContent = err; errEl.style.display = 'block';
          setTimeout(function() { pin = ''; submitting = false; updateDots(); dotsEl.classList.remove('shake'); }, 600);
        }
      }
      padEl.addEventListener('click', function(e) {
        var btn = e.target.closest('button');
        if (!btn) return;
        e.preventDefault();
        if (btn.dataset.digit !== undefined) handleDigit(btn.dataset.digit);
        else if (btn.dataset.action === 'clear') { pin = ''; updateDots(); errEl.style.display = 'none'; }
        else if (btn.dataset.action === 'submit') submitPin();
      });
    } else if (AUTH_MODE === 'password') {
      document.getElementById('login-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        var err = await doLogin(document.getElementById('password').value);
        if (err) { errEl.textContent = err; errEl.style.display = 'block'; }
      });
    }
  </script>
</body></html>
