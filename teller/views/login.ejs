<%- include('partials/head', { title: 'Login', extraStyles: `
    body { display: flex; align-items: center; justify-content: center; overflow: hidden; }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.96); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes dotPop {
      0% { transform: scale(1); }
      50% { transform: scale(1.3); }
      100% { transform: scale(1); }
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .login-card { position: relative; z-index: 1; width: 100%; max-width: 360px; padding: 44px 32px;
      background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
      backdrop-filter: blur(16px); text-align: center;
      animation: scaleIn 0.4s ease both; }
    .login-logo { font-weight: 300; font-size: 13px; letter-spacing: 2px; text-transform: uppercase;
            color: var(--text-muted); margin-bottom: 28px; animation: fadeInUp 0.4s ease both; animation-delay: 0.1s;
            display: flex; align-items: center; justify-content: center; gap: 8px; }
    .login-logo-icon {
      display: inline-block; width: 18px; height: 18px;
      background: #c8a86c;
      -webkit-mask: url(/logo.svg) center / contain no-repeat;
      mask: url(/logo.svg) center / contain no-repeat;
      mask-mode: alpha; -webkit-mask-mode: alpha;
      filter: drop-shadow(0 0 4px rgba(200,168,108,0.4));
    }
    h1 { font-size: 26px; font-weight: 300; letter-spacing: -0.3px; margin-bottom: 6px;
         animation: fadeInUp 0.4s ease both; animation-delay: 0.15s; }
    p { color: var(--text-muted); font-size: 14px; font-weight: 300; margin-bottom: 24px;
        animation: fadeInUp 0.4s ease both; animation-delay: 0.2s; }
    input[type="password"] { width: 100%; padding: 12px 16px; font-size: 14px; font-weight: 300;
      border: 1px solid var(--border); border-radius: 8px; background: transparent;
      color: var(--text); font-family: inherit; }
    input:focus { outline: none; border-color: var(--warm); }
    button[type="submit"] { width: 100%; margin-top: 14px; padding: 12px; font-size: 13px; font-weight: 500;
      border: 1px solid var(--warm); border-radius: 8px; cursor: pointer;
      background: transparent; color: var(--warm); text-transform: uppercase;
      letter-spacing: 1px; font-family: inherit; transition: all 0.2s; }
    button[type="submit"]:hover { background: rgba(212,165,116,0.1); color: var(--text); }
    .error-msg { margin-top: 14px; padding: 10px; border-radius: 6px;
      background: var(--red-bg); color: var(--red); font-size: 13px; display: none; }
    .pin-dots { display: flex; justify-content: center; gap: 12px; margin-bottom: 24px;
                animation: fadeInUp 0.4s ease both; animation-delay: 0.25s; }
    .pin-dot { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--border);
      transition: all 0.2s; }
    .pin-dot.filled { background: var(--warm); border-color: var(--warm); animation: dotPop 0.2s ease; }
    .pin-dot.error { border-color: var(--red); background: var(--red); }
    .pin-dots.shake { animation: shake 0.4s ease; }
    .pin-pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 240px; margin: 0 auto;
               animation: fadeInUp 0.4s ease both; animation-delay: 0.3s; }
    .pin-key { padding: 16px; font-size: 22px; font-weight: 300; border: 1px solid var(--border);
      border-radius: 10px; background: transparent; color: var(--text); cursor: pointer;
      font-family: inherit; transition: all 0.15s; user-select: none; -webkit-user-select: none;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
    .pin-key:hover { border-color: var(--warm); }
    .pin-key:active { background: rgba(212,165,116,0.1); transform: scale(0.95); }
    .pin-key.fn { font-size: 12px; font-weight: 400; letter-spacing: 0.5px; text-transform: uppercase;
      color: var(--text-muted); border-color: transparent; }
    .pin-key.fn:hover { color: var(--text); }

    /* ── FaceID / Biometric button ── */
    .biometric-divider { display: flex; align-items: center; gap: 12px; margin: 20px 0 16px;
      animation: fadeInUp 0.4s ease both; animation-delay: 0.35s; }
    .biometric-divider::before, .biometric-divider::after {
      content: ""; flex: 1; height: 1px; background: var(--border); }
    .biometric-divider span { font-size: 11px; color: var(--text-muted); text-transform: uppercase;
      letter-spacing: 1px; font-weight: 400; }
    .faceid-btn { width: 100%; padding: 14px; font-size: 13px; font-weight: 500;
      border: 1px solid #a0dad0; border-radius: 8px; cursor: pointer;
      background: transparent; color: #a0dad0; text-transform: uppercase;
      letter-spacing: 1px; font-family: inherit; transition: all 0.2s;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      animation: fadeInUp 0.4s ease both; animation-delay: 0.4s; }
    .faceid-btn:hover { background: rgba(160,218,208,0.08); }
    .faceid-btn:active { transform: scale(0.98); }
    .faceid-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .faceid-btn svg { width: 22px; height: 22px; }

    /* ── Materialize overlay ── */
    .materialize-overlay {
      position: fixed; inset: 0; z-index: 9999;
      display: flex; align-items: center; justify-content: center; flex-direction: column;
      background: var(--bg); opacity: 0; pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .materialize-overlay.active { opacity: 1; pointer-events: all; }
    .materialize-overlay .helmet-svg { width: 120px; height: 144px; }
    .materialize-overlay .helmet-stroke {
      fill: none; stroke: #c8a86c; stroke-width: 2;
      stroke-dasharray: 1; stroke-dashoffset: 1;
      filter: drop-shadow(0 0 10px rgba(200,168,108,0.7)) drop-shadow(0 0 20px rgba(200,168,108,0.4));
    }
    .materialize-overlay .helmet-fill {
      fill: #c8a86c; opacity: 0;
    }
    .materialize-overlay.active .helmet-stroke {
      animation: drawHelmet 1.2s ease-out 0.15s forwards;
    }
    .materialize-overlay.active .helmet-fill {
      animation: fillHelmet 0.6s ease-in 1.1s forwards;
    }
    @keyframes drawHelmet {
      to { stroke-dashoffset: 0; }
    }
    @keyframes fillHelmet {
      0%  { opacity: 0; filter: drop-shadow(0 0 0 transparent); }
      60% { opacity: 0.7; filter: drop-shadow(0 0 24px rgba(200,168,108,0.6)); }
      100% { opacity: 1; filter: drop-shadow(0 0 14px rgba(200,168,108,0.4)); }
    }

    /* ── Biometric scan animation ── */
    .bio-scan-container {
      position: absolute; display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.3s ease;
    }
    .bio-scan-container.active { opacity: 1; }
    .bio-scan-container.shrink {
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      transform: scale(0);
      opacity: 0;
    }
    .bio-scan-ring {
      width: 140px; height: 140px; border-radius: 50%;
      border: 2px solid rgba(160,218,208,0.3);
      position: relative;
    }
    .bio-scan-ring::before {
      content: ""; position: absolute; inset: -4px; border-radius: 50%;
      border: 2px solid transparent; border-top-color: #a0dad0;
      animation: bioSpin 1.2s linear infinite;
      filter: drop-shadow(0 0 8px rgba(160,218,208,0.6));
    }
    .bio-scan-ring::after {
      content: ""; position: absolute; inset: 8px; border-radius: 50%;
      border: 1px solid rgba(160,218,208,0.15);
    }
    @keyframes bioSpin {
      to { transform: rotate(360deg); }
    }
    .bio-scan-line {
      position: absolute; left: 15%; right: 15%; height: 2px;
      background: linear-gradient(90deg, transparent, #a0dad0, transparent);
      filter: drop-shadow(0 0 6px rgba(160,218,208,0.8));
      animation: bioScanLine 2s ease-in-out infinite;
    }
    @keyframes bioScanLine {
      0%, 100% { top: 20%; opacity: 0.3; }
      50% { top: 75%; opacity: 1; }
    }
    .bio-scan-icon {
      position: absolute; display: flex; align-items: center; justify-content: center;
    }
    .bio-scan-icon svg { width: 48px; height: 48px; opacity: 0.6; }
    .bio-scan-dots {
      position: absolute; width: 100%; height: 100%;
    }
    .bio-scan-dots span {
      position: absolute; width: 3px; height: 3px; border-radius: 50%;
      background: #a0dad0; opacity: 0;
      animation: bioDotPulse 2s ease-in-out infinite;
    }
    .bio-scan-dots span:nth-child(1) { top: 30%; left: 35%; animation-delay: 0s; }
    .bio-scan-dots span:nth-child(2) { top: 30%; left: 62%; animation-delay: 0.2s; }
    .bio-scan-dots span:nth-child(3) { top: 45%; left: 28%; animation-delay: 0.4s; }
    .bio-scan-dots span:nth-child(4) { top: 45%; left: 70%; animation-delay: 0.3s; }
    .bio-scan-dots span:nth-child(5) { top: 58%; left: 42%; animation-delay: 0.5s; }
    .bio-scan-dots span:nth-child(6) { top: 58%; left: 56%; animation-delay: 0.1s; }
    .bio-scan-dots span:nth-child(7) { top: 68%; left: 49%; animation-delay: 0.6s; }
    @keyframes bioDotPulse {
      0%, 100% { opacity: 0; transform: scale(0.5); }
      50% { opacity: 0.8; transform: scale(1.5); }
    }
    .bio-scan-status {
      position: absolute; bottom: -36px; font-size: 11px; font-weight: 400;
      color: #a0dad0; letter-spacing: 1.5px; text-transform: uppercase;
      opacity: 0; animation: fadeInUp 0.3s ease forwards;
    }
    .bio-scan-success .bio-scan-ring {
      border-color: #a0dad0;
      box-shadow: 0 0 20px rgba(160,218,208,0.4), inset 0 0 20px rgba(160,218,208,0.1);
      transition: all 0.3s ease;
    }
    .bio-scan-success .bio-scan-ring::before {
      border-top-color: #a0dad0; border-right-color: #a0dad0;
      border-bottom-color: #a0dad0; border-left-color: #a0dad0;
      animation: none;
    }

    /* ── Ambient floating particles ── */
    .overlay-particles {
      position: absolute; inset: 0; overflow: hidden; pointer-events: none;
    }
    .overlay-particle {
      position: absolute; width: 2px; height: 2px; border-radius: 50%;
      background: #a0dad0; opacity: 0;
    }
    .materialize-overlay.active .overlay-particle {
      animation: floatParticle var(--dur) ease-in-out var(--delay) infinite;
    }
    @keyframes floatParticle {
      0% { opacity: 0; transform: translateY(0) scale(0.5); }
      20% { opacity: 0.6; }
      80% { opacity: 0.3; }
      100% { opacity: 0; transform: translateY(-120px) scale(0); }
    }

    /* ── Pulse rings (expand from helmet center) ── */
    .pulse-ring {
      position: absolute; width: 80px; height: 80px; border-radius: 50%;
      border: 1px solid rgba(160,218,208,0.5); opacity: 0; pointer-events: none;
    }
    .materialize-overlay.active .pulse-ring {
      animation: pulseExpand 1s ease-out forwards;
    }
    .pulse-ring:nth-child(1) { animation-delay: 1.2s !important; }
    .pulse-ring:nth-child(2) { animation-delay: 1.4s !important; }
    .pulse-ring:nth-child(3) { animation-delay: 1.6s !important; }
    @keyframes pulseExpand {
      0% { opacity: 0.6; transform: scale(1); }
      100% { opacity: 0; transform: scale(4); }
    }

    /* ── Particle burst (explode outward) ── */
    .burst-container {
      position: absolute; pointer-events: none;
    }
    .burst-particle {
      position: absolute; width: 3px; height: 3px; border-radius: 50%;
      background: #a0dad0; opacity: 0;
    }
    .materialize-overlay.active .burst-particle {
      animation: burstOut 0.8s ease-out 1.5s forwards;
    }
    @keyframes burstOut {
      0% { opacity: 1; transform: translate(0,0) scale(1); }
      100% { opacity: 0; transform: var(--burst-dir) scale(0); }
    }

    /* ── Glitch / digital noise ── */
    .glitch-overlay {
      position: absolute; inset: 0; opacity: 0; pointer-events: none; mix-blend-mode: screen;
      background: repeating-linear-gradient(
        0deg,
        rgba(160,218,208,0.03) 0px,
        rgba(160,218,208,0.03) 1px,
        transparent 1px,
        transparent 3px
      );
    }
    .materialize-overlay.active .glitch-overlay {
      animation: glitchFlicker 0.3s steps(4) 0s forwards;
    }
    @keyframes glitchFlicker {
      0% { opacity: 0.8; transform: translate(2px, -1px) scaleY(1.01); }
      25% { opacity: 0.6; transform: translate(-3px, 1px) scaleY(0.99); }
      50% { opacity: 0.9; transform: translate(1px, 2px) scaleX(1.01); }
      75% { opacity: 0.4; transform: translate(-1px, -2px) scaleY(1.02); }
      100% { opacity: 0; transform: translate(0, 0) scale(1); }
    }

    /* ── Horizontal scan line across overlay ── */
    .hud-scanline {
      position: absolute; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(160,218,208,0.3) 20%, rgba(160,218,208,0.6) 50%, rgba(160,218,208,0.3) 80%, transparent 100%);
      opacity: 0; pointer-events: none;
    }
    .materialize-overlay.active .hud-scanline {
      animation: scanDown 1.8s ease-in-out 0.1s forwards;
    }
    @keyframes scanDown {
      0% { top: 20%; opacity: 0; }
      10% { opacity: 0.7; }
      90% { opacity: 0.3; }
      100% { top: 80%; opacity: 0; }
    }

` }) %>
  <!-- Materialize animation overlay -->
  <div class="materialize-overlay" id="materialize-overlay">
    <!-- Ambient floating particles -->
    <div class="overlay-particles" id="overlay-particles"></div>
    <!-- Glitch noise -->
    <div class="glitch-overlay"></div>
    <!-- Horizontal scan line -->
    <div class="hud-scanline"></div>
    <!-- Pulse rings -->
    <div class="pulse-ring"></div>
    <div class="pulse-ring"></div>
    <div class="pulse-ring"></div>
    <!-- Particle burst -->
    <div class="burst-container" id="burst-container"></div>
    <!-- Biometric scan (shown first for FaceID flow, then shrinks into helmet) -->
    <div class="bio-scan-container" id="bio-scan">
      <div class="bio-scan-ring">
        <div class="bio-scan-line"></div>
        <div class="bio-scan-dots">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="bio-scan-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#a0dad0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Face scan corners -->
            <path d="M7 3H5a2 2 0 0 0-2 2v2"/>
            <path d="M17 3h2a2 2 0 0 1 2 2v2"/>
            <path d="M7 21H5a2 2 0 0 1-2-2v-2"/>
            <path d="M17 21h2a2 2 0 0 0 2-2v-2"/>
            <!-- Face features -->
            <circle cx="9" cy="10" r="0.5" fill="#a0dad0" stroke="none"/>
            <circle cx="15" cy="10" r="0.5" fill="#a0dad0" stroke="none"/>
            <path d="M9.5 15a3.5 3.5 0 0 0 5 0"/>
          </svg>
        </div>
      </div>
      <div class="bio-scan-status" id="bio-scan-status">Scanning</div>
    </div>
    <!-- Helmet SVG (hidden initially for biometric flow, always used for PIN/password) -->
    <svg class="helmet-svg" id="helmet-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
