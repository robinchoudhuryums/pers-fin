<%- include('partials/head', { title: 'Transactions', extraStyles: `
    .container { max-width: 1060px; }
    .search-bar { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; margin-bottom: 20px;
                  padding: 20px; background: var(--surface); border: 1px solid var(--border);
                  border-radius: var(--radius); backdrop-filter: blur(12px); }
    .search-bar .field { display: flex; flex-direction: column; gap: 4px; }
    .search-bar label { font-size: 9px; font-weight: 500; color: var(--text-muted);
                        text-transform: uppercase; letter-spacing: 1px; }
    .search-bar input, .search-bar select { padding: 7px 12px; font-size: 13px; border: 1px solid var(--border);
      border-radius: 6px; background: transparent; color: var(--text); font-family: inherit; font-weight: 300; }
    .search-bar input:focus, .search-bar select:focus { outline: none; border-color: var(--warm); }
    .search-bar input::placeholder { color: var(--text-muted); }
    #search-input { width: 200px; }
    .amount-range { display: flex; gap: 4px; align-items: center; }
    .amount-range input { width: 80px; }
    .date-range { display: flex; gap: 4px; align-items: center; }
    .date-range input { width: 130px; }
    .bulk-bar { display: flex; gap: 10px; align-items: center; padding: 12px 16px; margin-bottom: 12px;
                background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius);
                font-size: 12px; display: none; }
    .bulk-bar select { padding: 5px 10px; font-size: 12px; border: 1px solid var(--border);
      border-radius: 6px; background: transparent; color: var(--text); font-family: inherit; }
    .txn-table { width: 100%; border-collapse: collapse; }
    .txn-table th { font-size: 10px; font-weight: 500; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 1px; text-align: left; padding: 8px;
      border-bottom: 1px solid var(--border); }
    .txn-table td { padding: 8px; font-size: 13px; border-bottom: 1px solid var(--border); font-weight: 300; }
    .txn-table tr:hover { background: rgba(255,255,255,0.02); }
    .txn-table .amount.debit { color: var(--warm); }
    .txn-table .amount.credit { color: var(--green); }
    .txn-cat { font-size: 11px; color: var(--text-muted); }
    .pagination { display: flex; gap: 10px; align-items: center; justify-content: center;
                  margin-top: 16px; font-size: 13px; color: var(--text-muted); }
    .pagination button { padding: 6px 14px; }
    .result-count { font-size: 12px; color: var(--text-muted); margin-bottom: 12px; }
    .dup-section { margin-top: 32px; }
    .dup-card { padding: 14px; background: var(--surface); border: 1px solid var(--border);
                border-radius: var(--radius); margin-bottom: 8px; font-size: 13px; font-weight: 300;
                display: flex; justify-content: space-between; align-items: center; }
    .dup-info { flex: 1; }
    /* Split modal */
    .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 100;
      display: flex; align-items: center; justify-content: center; }
    .modal { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 20px; max-width: 560px; width: calc(100% - 40px); max-height: 85vh; overflow: auto; }
    .modal h3 { margin: 0 0 10px; font-weight: 400; }
    .modal .edit-field { margin-bottom: 12px; }
    .modal .edit-field label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); display: block; margin-bottom: 4px; }
    .modal .edit-field input, .modal .edit-field select { width: 100%; padding: 8px 10px; font-size: 13px; border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--text); font-family: inherit; box-sizing: border-box; }
    .modal .parent-info { font-size: 12px; color: var(--text-muted); margin-bottom: 16px; }
    .modal .split-row { display: grid; grid-template-columns: 100px 1fr 24px; gap: 6px; margin-bottom: 6px; align-items: center; }
    .modal .split-row input, .modal .split-row select { padding: 6px 10px; font-size: 13px; border: 1px solid var(--border);
      border-radius: 6px; background: transparent; color: var(--text); font-family: inherit; }
    .modal .split-row .del { background: transparent; border: 0; color: var(--text-muted); cursor: pointer; font-size: 16px; }
    .modal .totals { margin: 12px 0; font-size: 12px; color: var(--text-muted); }
    .modal .totals .ok { color: var(--green); }
    .modal .totals .bad { color: var(--red); }
    .modal .actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
    .row-actions { display: flex; gap: 4px; }
    .row-actions .btn-xs { padding: 3px 8px; font-size: 11px; border: 1px solid var(--border); border-radius: 6px;
      background: transparent; color: var(--text-muted); cursor: pointer; }
    .row-actions .btn-xs:hover { color: var(--text); border-color: var(--warm); }
    tr.has-splits td { border-bottom: 0; }
    tr.split-line td { font-size: 12px; color: var(--text-muted); padding-left: 36px; }
    @media (max-width: 640px) {
      #search-input { width: 100%; }
      .search-bar { flex-direction: column; }
      .search-bar .field { width: 100%; }
      .search-bar input, .search-bar select { width: 100%; }
      .hide-mobile { display: none; }
    }
` }) %>
<%- include('partials/nav', { activePage: 'transactions' }) %>

  <h1>Transactions</h1>
  <p class="subtitle">Search, filter, and categorize transactions</p>
  <div id="status-msg" class="status-msg"></div>

  <div class="search-bar">
    <div class="field" style="flex:1;min-width:180px;">
      <label>Search</label>
      <input type="text" id="search-input" placeholder="Merchant name...">
    </div>
    <div class="field">
      <label>Category</label>
      <select id="filter-category">
        <option value="">All</option>
        <option value="Food & Drink">Food & Drink</option>
        <option value="Groceries">Groceries</option>
        <option value="Transportation">Transportation</option>
        <option value="Gas & Fuel">Gas & Fuel</option>
        <option value="Shopping">Shopping</option>
        <option value="Entertainment">Entertainment</option>
        <option value="Health & Fitness">Health & Fitness</option>
        <option value="Healthcare">Healthcare</option>
        <option value="Housing">Housing</option>
        <option value="Utilities">Utilities</option>
        <option value="Insurance">Insurance</option>
        <option value="Education">Education</option>
        <option value="Travel">Travel</option>
        <option value="Personal Care">Personal Care</option>
        <option value="Gifts & Donations">Gifts & Donations</option>
        <option value="Fees & Charges">Fees & Charges</option>
        <option value="Transfer">Transfer</option>
        <option value="Income">Income</option>
        <option value="Investment">Investment</option>
        <option value="Subscription">Subscription</option>
        <option value="Uncategorized">Uncategorized</option>
      </select>
    </div>
    <div class="field">
      <label>Amount Range</label>
      <div class="amount-range">
        <input type="number" id="filter-min" placeholder="Min" step="0.01">
        <span style="color:var(--text-muted);">-</span>
        <input type="number" id="filter-max" placeholder="Max" step="0.01">
      </div>
    </div>
    <div class="field">
      <label>Date Range</label>
      <div class="date-range">
        <input type="date" id="filter-start">
        <span style="color:var(--text-muted);">to</span>
        <input type="date" id="filter-end">
      </div>
    </div>
    <div class="field">
      <label>&nbsp;</label>
      <button class="btn primary" id="search-btn">Search</button>
    </div>
  </div>

  <div class="bulk-bar" id="bulk-bar">
    <input type="checkbox" id="select-all">
    <span id="selected-count">0 selected</span>
    <select id="bulk-category">
      <option value="">Set category...</option>
      <option value="Food & Drink">Food & Drink</option>
      <option value="Groceries">Groceries</option>
      <option value="Transportation">Transportation</option>
      <option value="Gas & Fuel">Gas & Fuel</option>
      <option value="Shopping">Shopping</option>
      <option value="Entertainment">Entertainment</option>
      <option value="Health & Fitness">Health & Fitness</option>
      <option value="Healthcare">Healthcare</option>
      <option value="Housing">Housing</option>
      <option value="Utilities">Utilities</option>
      <option value="Insurance">Insurance</option>
      <option value="Education">Education</option>
      <option value="Travel">Travel</option>
      <option value="Personal Care">Personal Care</option>
      <option value="Gifts & Donations">Gifts & Donations</option>
      <option value="Fees & Charges">Fees & Charges</option>
      <option value="Transfer">Transfer</option>
      <option value="Income">Income</option>
      <option value="Subscription">Subscription</option>
      <option value="Other">Other</option>
    </select>
    <button class="btn primary btn-sm" id="bulk-apply-btn">Apply</button>
  </div>

  <div id="result-count" class="result-count"></div>
  <div class="table-wrap">
    <table class="txn-table">
      <thead>
        <tr>
          <th style="width:30px;"><input type="checkbox" id="header-check"></th>
          <th>Date</th>
          <th>Merchant</th>
          <th>Category</th>
          <th>Amount</th>
          <th class="hide-mobile">Account</th>
          <th style="width:70px;"></th>
        </tr>
      </thead>
      <tbody id="txn-body">
        <tr><td colspan="7" class="empty">Loading...</td></tr>
      </tbody>
    </table>
  </div>

  <div class="pagination" id="pagination"></div>

  <div class="dup-section" id="dup-section" style="display:none;">
    <h2>Potential Duplicates</h2>
    <p class="subtitle">Transactions with same date, amount, and merchant across different accounts</p>
    <div id="dup-list"></div>
  </div>

<%- include('partials/foot', { apiKey: apiKey }) %>
  <script src="<%= basePath %>/transactions.js?v=<%= v %>" defer></script>
</body></html>
