<%- include('partials/head', { title: 'Link Account', extraStyles: `
    .container { max-width: 640px; }
    .topnav { margin-bottom: 48px; }
    h2 { font-size: 28px; font-weight: 300; letter-spacing: -0.3px; margin-bottom: 8px; }
    h3 { font-size: 10px; font-weight: 500; margin-bottom: 12px; color: var(--text-muted);
         text-transform: uppercase; letter-spacing: 1.5px; }
    p { color: var(--text-muted); font-size: 15px; line-height: 1.6; margin-bottom: 24px; font-weight: 300; }
    button { padding: 12px 28px; font-size: 12px; font-weight: 500; cursor: pointer;
             border: 1px solid var(--warm); background: transparent; color: var(--warm);
             border-radius: 8px; transition: all 0.2s; text-transform: uppercase; letter-spacing: 1px;
             font-family: inherit; }
    button:hover { background: rgba(212,165,116,0.1); color: var(--text); }
    button:disabled { opacity: 0.4; cursor: not-allowed; }
    /* Page-local #status div is kept for backward compat but hidden — the
       page's showStatus() now routes through the shared toast stack. */
    #status { display: none !important; }
    #items { margin-top: 36px; }
    .item { padding: 16px 18px; margin: 8px 0; background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); font-size: 14px; font-weight: 300; transition: all 0.2s;
            backdrop-filter: blur(12px); display: flex; align-items: center; justify-content: space-between; }
    .item:hover { border-color: var(--border-hover); background: var(--surface-2); }
    .item-info { flex: 1; }
    .item-actions { flex-shrink: 0; margin-left: 12px; }
    .section-divider { margin: 48px 0; border: none; border-top: 1px solid var(--border); }
    .csv-section { margin-top: 8px; }
    .csv-form { display: flex; flex-direction: column; gap: 18px; max-width: 420px; }
    .csv-form label { font-weight: 500; font-size: 10px; color: var(--text-muted);
                      text-transform: uppercase; letter-spacing: 1.5px; }
    .csv-form select, .csv-form input[type="text"] {
      padding: 10px 14px; font-size: 14px; border: 1px solid var(--border); border-radius: 8px;
      background: transparent; color: var(--text); width: 100%; font-weight: 300; transition: border-color 0.2s; }
    .csv-form select:focus, .csv-form input:focus { outline: none; border-color: var(--warm); }
    .csv-form select option { background: #131620; color: var(--text); }
    .csv-form input[type="file"] { font-size: 13px; color: var(--text-muted); }
    .csv-form .field { display: flex; flex-direction: column; gap: 8px; }
    .csv-form input::placeholder { color: var(--text-muted); }
    .csv-imports { margin-top: 32px; }
    .csv-import-entry { padding: 14px 18px; margin: 6px 0; background: var(--surface);
                        border: 1px solid var(--border); border-radius: var(--radius);
                        font-size: 13px; font-weight: 300; backdrop-filter: blur(12px); }
    .btn-unlink { padding: 5px 12px; font-size: 10px; font-weight: 500; letter-spacing: 0.5px;
                  border: 1px solid rgba(235,107,107,0.25); border-radius: 6px; cursor: pointer;
                  background: transparent; color: var(--red); text-transform: uppercase;
                  transition: all 0.2s; font-family: inherit; }
    .btn-unlink:hover { background: var(--red-bg); }
` }) %>
  <script nonce="<%= nonce %>">
    window._tellerLoaded = false;
    window._tellerError = null;
    window._plaidLoaded = false;
    // Load Teller SDK dynamically to avoid inline onload/onerror (CSP)
    (function() {
      var s = document.createElement('script');
      s.src = 'https://cdn.teller.io/connect/connect.js';
      s.onload = function() { window._tellerLoaded = true; };
      s.onerror = function() { window._tellerError = 'Script load failed'; };
      document.head.appendChild(s);
      // Load Plaid Link SDK in parallel
      var p = document.createElement('script');
      p.src = 'https://cdn.plaid.com/link/v2/stable/link-initialize.js';
      p.onload = function() { window._plaidLoaded = true; };
      document.head.appendChild(p);
    })();
  </script>
<%- include('partials/nav', { activePage: 'accounts' }) %>

  <h1>Link Accounts</h1>
  <p>Connect a financial institution to start tracking recurring charges automatically.</p>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
    <button id="link-btn">Link via Teller</button>
    <button id="plaid-hosted-btn">Link via Plaid</button>
  </div>
  <div style="font-size:11px;color:var(--text-muted);margin-bottom:16px;">
    <strong>Teller</strong> — most major banks (Chase, BofA, Wells Fargo, etc.).<br>
    <strong>Plaid</strong> — Capital One, Discover, Amex, Schwab, and other banks Teller doesn't cover.
    Pulls up to 2 years of history and auto-links investment accounts (holdings + cost basis) when available.
    Opens as a full-page Plaid-hosted flow that works reliably on both desktop and mobile.
  </div>
  <div id="status"></div>
  <div id="items"><h3>Linked Institutions</h3><div id="items-list" style="color:var(--text-muted);font-size:14px;font-weight:300;">Loading...</div></div>

  <hr class="section-divider">

  <div class="csv-section">
    <h2>Import from CSV</h2>
    <p>Upload a CSV export from your bank. Supports Chase, Wells Fargo, Capital One, Discover, Schwab, and generic formats.</p>
    <div class="csv-form">
      <div class="field">
        <label for="csv-institution">Bank / Institution</label>
        <select id="csv-institution">
          <option value="Chase">Chase</option>
          <option value="Wells Fargo">Wells Fargo</option>
          <option value="Capital One">Capital One</option>
          <option value="Discover">Discover</option>
          <option value="Charles Schwab">Charles Schwab</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <input type="text" id="csv-custom-institution" placeholder="Institution name" style="display:none">

      <div class="field">
        <label for="csv-account-label">Account Label</label>
        <input type="text" id="csv-account-label" placeholder="e.g. Chase Checking, WF Visa">
      </div>

      <div class="field">
        <label for="csv-file">CSV File</label>
        <input type="file" id="csv-file" accept=".csv">
      </div>

      <button id="csv-upload-btn">Upload & Import</button>
    </div>
    <div id="csv-status" style="margin-top:12px;padding:14px 18px;border-radius:8px;display:none;font-size:13px;"></div>
    <div class="csv-imports">
      <h3>Import History</h3>
      <div id="csv-imports-list" style="color:var(--text-muted);font-size:14px;font-weight:300;">Loading...</div>
    </div>
  </div>

  <hr class="section-divider">

  <div class="csv-section">
    <h2>Manual Accounts</h2>
    <p>Add accounts that can't be linked via Teller (e.g., Discover, local banks)</p>
    <div class="csv-form" id="manual-acct-form">
      <div class="field">
        <label>Account Name</label>
        <input type="text" id="manual-name" placeholder="e.g. Discover It Card">
      </div>
      <div class="field">
        <label>Institution</label>
        <input type="text" id="manual-institution" placeholder="e.g. Discover">
      </div>
      <div class="field">
        <label>Type</label>
        <select id="manual-type">
          <option value="credit">Credit Card</option>
          <option value="depository">Bank Account</option>
        </select>
      </div>
      <div class="field">
        <label>Current Balance ($)</label>
        <input type="number" id="manual-balance" step="0.01" placeholder="0.00">
      </div>
      <div class="field">
        <label>Credit Limit (optional)</label>
        <input type="number" id="manual-limit" step="0.01" placeholder="e.g. 5000">
      </div>
      <button id="add-manual-acct-btn">Add Account</button>
    </div>
    <div id="manual-accounts-list" style="margin-top:16px;color:var(--text-muted);font-size:14px;font-weight:300;">Loading...</div>
  </div>

  <hr class="section-divider">

  <div class="csv-section">
    <h2>Investment Accounts</h2>
    <p>Track brokerage, retirement, and other investment accounts. Link via Plaid or add manually.</p>
    <div style="margin-bottom:16px;">
      <button id="plaid-inv-btn" style="display:none;">Link Investment Account via Plaid</button>
    </div>
    <div class="csv-form" id="inv-form">
      <div class="field">
        <label>Account Name</label>
        <input type="text" id="inv-name" placeholder="e.g. Fidelity 401(k)">
      </div>
      <div class="field">
        <label>Institution</label>
        <input type="text" id="inv-institution" placeholder="e.g. Fidelity">
      </div>
      <div class="field">
        <label>Type</label>
        <select id="inv-type">
          <option value="brokerage">Brokerage</option>
          <option value="401k">401(k)</option>
          <option value="ira">IRA</option>
          <option value="roth_ira">Roth IRA</option>
          <option value="retirement">Other Retirement</option>
          <option value="529">529 Plan</option>
          <option value="hsa">HSA</option>
          <option value="crypto">Crypto</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="field">
        <label>Current Balance ($)</label>
        <input type="number" id="inv-balance" step="0.01" placeholder="50000">
      </div>
      <button id="add-inv-btn">Add Account</button>
    </div>
    <div id="inv-list" style="margin-top:16px;color:var(--text-muted);font-size:14px;font-weight:300;">Loading...</div>
  </div>
<%- include('partials/foot') %>
  <script nonce="<%= nonce %>">
    const statusEl  = document.getElementById('status');
    const itemsList = document.getElementById('items-list');

    // Delegate to the shared toast stack so feedback stacks consistently
    // with the rest of the app instead of overwriting a page-local element.
    function showStatus(msg, ok) {
      if (typeof showMsg === 'function') showMsg(msg, !!ok);
    }

    async function loadItems() {
      try {
        const res = await apiFetch('/api/items');
        if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error(err.error || 'HTTP ' + res.status); }
        const items = await res.json();
        if (!items.length) { itemsList.textContent = 'No institutions linked yet.'; return; }
        itemsList.innerHTML = items.map(i =>
          '<div class="item">' +
            '<div class="item-info"><strong>' + esc(i.institution_name) + '</strong>' +
            ' (' + esc(i.provider || 'teller') + ') \u2014 ' +
            i.accounts.length + ' account(s) \u2014 Status: ' + esc(i.status) + '</div>' +
            '<div class="item-actions"><button class="btn-unlink" data-action="unlink" data-id="' + i.id + '" data-provider="' + esc(i.provider || 'teller') + '" data-name="' + esc(i.institution_name || '') + '">Unlink</button></div>' +
          '</div>'
        ).join('');
      } catch (e) {
        itemsList.textContent = 'Could not load items: ' + e.message;
        showStatus('Failed to load linked accounts: ' + e.message, false);
      }
    }

    async function unlinkAccount(id, name, provider) {
      console.log('[unlink] click', { id: id, name: name, provider: provider });
      var confirmed = confirm('Unlink ' + name + '? This will remove the enrollment and all associated transactions.');
      console.log('[unlink] confirm result', confirmed);
      if (!confirmed) return;
      try {
        var endpoint = provider === 'plaid' ? '/api/items/' + id : '/api/enrollments/' + id;
        console.log('[unlink] DELETE', endpoint);
        var res = await apiFetch(endpoint, { method: 'DELETE' });
        console.log('[unlink] response status', res.status);
        if (res.ok) {
          showStatus('Unlinked ' + name + ' successfully.', true);
          loadItems();
        } else {
          var data = await res.json().catch(function() { return {}; });
          console.error('[unlink] failed', res.status, data);
          showStatus('Failed to unlink: ' + (data.error || 'HTTP ' + res.status), false);
        }
      } catch (e) {
        console.error('[unlink] exception', e);
        showStatus('Failed to unlink: ' + e.message, false);
      }
    }

    function startLink() {
      if (typeof TellerConnect === 'undefined') {
        var detail = window._tellerError || (window._tellerLoaded ? 'Script loaded but TellerConnect not defined' : 'Script tag did not execute');
        showStatus('Teller Connect SDK failed to load (' + detail + '). Check browser console for CSP or network errors.', false);
        console.error('TellerConnect undefined. _tellerLoaded:', window._tellerLoaded, '_tellerError:', window._tellerError);
        return;
      }
      var appId = "<%= tellerAppId %>";
      if (!appId) {
        showStatus('Teller Application ID is not configured. Set TELLER_APPLICATION_ID in your environment variables.', false);
        return;
      }
      try {
        var tellerConnect = TellerConnect.setup({
          applicationId: appId,
          environment: "<%= tellerEnv %>",
          onInit: function() {},
          onSuccess: async function(enrollment) {
            showStatus('Enrolling...', true);
            try {
              const res = await apiFetch('/api/enroll', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  accessToken: enrollment.accessToken,
                  enrollment: {
                    id: enrollment.enrollment.id,
                    institution: enrollment.enrollment.institution,
                  },
                }),
              });
              const data = await res.json();
              if (res.ok) {
                showStatus('Linked ' + data.institution + ' (' + data.accounts_linked + ' accounts)', true);
                loadItems();
              } else {
                showStatus('Enrollment failed: ' + (data.error || 'HTTP ' + res.status), false);
              }
            } catch (e) { showStatus('Enrollment failed: Could not reach server. ' + e.message, false); }
          },
          onExit: function() {},
          onFailure: function(failure) {
            showStatus('Teller Connect error: ' + (failure.message || JSON.stringify(failure)), false);
          },
        });
        tellerConnect.open();
      } catch (e) {
        showStatus('Failed to open Teller Connect: ' + e.message, false);
      }
    }

    // CSV import
    const csvInstitution = document.getElementById('csv-institution');
    const csvCustom = document.getElementById('csv-custom-institution');
    const csvStatusEl = document.getElementById('csv-status');

    csvInstitution.addEventListener('change', () => {
      csvCustom.style.display = csvInstitution.value === 'Other' ? 'block' : 'none';
    });

    function showCsvStatus(msg, ok) {
      csvStatusEl.textContent = msg;
      csvStatusEl.className = ok ? 'success' : 'error';
      csvStatusEl.style.display = 'block';
      if (csvStatusEl._timer) clearTimeout(csvStatusEl._timer);
      if (ok) { csvStatusEl._timer = setTimeout(() => { csvStatusEl.style.display = 'none'; }, 8000); }
    }

    async function uploadCsv() {
      const fileInput = document.getElementById('csv-file');
      const file = fileInput.files[0];
      if (!file) { showCsvStatus('Please select a CSV file.', false); return; }
      const institution = csvInstitution.value === 'Other'
        ? csvCustom.value.trim() || 'Unknown'
        : csvInstitution.value;
      const accountLabel = document.getElementById('csv-account-label').value.trim()
        || institution + ' Account';
      const formData = new FormData();
      formData.append('file', file);
      formData.append('institution', institution);
      formData.append('account_label', accountLabel);
      const btn = document.getElementById('csv-upload-btn');
      btnLoading(btn, true);
      showCsvStatus('Importing...', true);
      try {
        const resp = await apiFetch('/api/import-csv', { method: 'POST', body: formData });
        const data = await resp.json();
        if (resp.ok) {
          showCsvStatus('Imported ' + data.rows_imported + ' transactions (' + data.rows_skipped +
            ' skipped) \u2014 Format: ' + data.format_detected, true);
          loadCsvImports(); loadItems();
        } else showCsvStatus('Import failed: ' + (data.error || 'HTTP ' + resp.status), false);
      } catch (e) { showCsvStatus('Import failed: Could not reach server. ' + e.message, false); }
      btnLoading(btn, false, 'Upload & Import');
    }

    async function loadCsvImports() {
      const list = document.getElementById('csv-imports-list');
      try {
        const res = await apiFetch('/api/csv-imports');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const imports = await res.json();
        if (!imports.length) { list.textContent = 'No CSV imports yet.'; return; }
        list.innerHTML = imports.map(i =>
          '<div class="csv-import-entry"><strong>' + esc(i.institution) + '</strong> \u2014 ' +
          esc(i.account_label) + ' \u2014 ' + i.rows_imported + ' rows \u2014 ' +
          new Date(i.imported_at).toLocaleDateString() + ' \u2014 <em>' + esc(i.filename) + '</em></div>'
        ).join('');
      } catch (e) { list.textContent = 'Could not load import history.'; }
    }

    // Manual accounts
    async function loadManualAccounts() {
      var list = document.getElementById('manual-accounts-list');
      try {
        var res = await apiFetch('/api/accounts');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        var allAccts = await res.json();
        var manualAccts = allAccts.filter(function(a) { return a.is_manual; });
        if (!manualAccts.length) { list.textContent = 'No manual accounts added yet.'; return; }
        list.innerHTML = manualAccts.map(function(a) {
          var bal = parseFloat(a.current_balance || 0);
          var balStr = '$' + Math.abs(bal).toLocaleString('en-US', {minimumFractionDigits: 2});
          if (a.type === 'credit') balStr = '-' + balStr;
          var limitStr = a.credit_limit ? ' / Limit: $' + parseFloat(a.credit_limit).toLocaleString('en-US', {minimumFractionDigits: 2}) : '';
          return '<div class="item">' +
            '<div class="item-info"><strong>' + esc(a.name) + '</strong>' +
            ' (' + esc(a.institution_name || 'Manual') + ')' +
            ' \u2014 ' + esc(a.subtype || a.type) +
            ' \u2014 <span style="color:' + (a.type === 'credit' ? 'var(--red)' : 'var(--green)') + ';font-weight:400;">' + balStr + '</span>' +
            limitStr + '</div>' +
            '<div class="item-actions" style="display:flex;gap:6px;">' +
              '<button class="btn-unlink" style="border-color:var(--border);color:var(--warm);" data-action="update-manual" data-id="' + a.id + '">Update Balance</button>' +
              '<button class="btn-unlink" data-action="delete-manual" data-id="' + a.id + '" data-name="' + esc(a.name) + '">Remove</button>' +
            '</div></div>';
        }).join('');
      } catch (e) { list.textContent = 'Could not load manual accounts.'; }
    }

    async function addManualAccount() {
      var name = document.getElementById('manual-name').value.trim();
      var balance = parseFloat(document.getElementById('manual-balance').value);
      if (!name) { showStatus('Account name is required.', false); return; }
      try {
        var res = await apiFetch('/api/accounts/manual', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: name,
            institution_name: document.getElementById('manual-institution').value.trim() || null,
            type: document.getElementById('manual-type').value,
            current_balance: balance || 0,
            available_balance: balance || 0,
            credit_limit: parseFloat(document.getElementById('manual-limit').value) || null,
          }),
        });
        if (res.ok) {
          showStatus('Manual account added.', true);
          document.getElementById('manual-name').value = '';
          document.getElementById('manual-institution').value = '';
          document.getElementById('manual-balance').value = '';
          document.getElementById('manual-limit').value = '';
          loadManualAccounts();
        } else { var d = await res.json(); showStatus(d.error || 'Failed', false); }
      } catch (e) { showStatus(e.message, false); }
    }

    async function updateManualBalance(id) {
      var val = prompt('Enter current balance ($):');
      if (val === null) return;
      var num = parseFloat(val);
      if (isNaN(num)) { showStatus('Invalid number.', false); return; }
      try {
        var res = await apiFetch('/api/accounts/' + id + '/balance', {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ current_balance: num, available_balance: num }),
        });
        if (res.ok) { showStatus('Balance updated.', true); loadManualAccounts(); }
        else showStatus('Failed to update.', false);
      } catch (e) { showStatus(e.message, false); }
    }

    async function deleteManualAccount(id, name) {
      if (!confirm('Remove ' + name + '?')) return;
      try {
        await apiFetch('/api/accounts/manual/' + id, { method: 'DELETE' });
        showStatus('Removed ' + name + '.', true); loadManualAccounts();
      } catch (e) { showStatus(e.message, false); }
    }

    // Investment accounts
    async function loadInvestments() {
      const list = document.getElementById('inv-list');
      try {
        const res = await apiFetch('/api/investment-accounts');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const accts = await res.json();
        if (!accts.length) { list.textContent = 'No investment accounts added yet.'; return; }
        list.innerHTML = accts.map(a =>
          '<div class="item">' +
            '<div class="item-info"><strong>' + esc(a.name) + '</strong>' +
            (a.institution ? ' (' + esc(a.institution) + ')' : '') +
            ' \u2014 ' + esc(a.account_type) + ' \u2014 <span style="color:var(--green);font-weight:400;">$' +
            parseFloat(a.balance).toLocaleString('en-US', {minimumFractionDigits: 2}) + '</span></div>' +
            '<div class="item-actions" style="display:flex;gap:6px;">' +
              '<button class="btn-unlink" style="border-color:var(--border);color:var(--warm);" data-action="update-inv" data-id="' + a.id + '">Update</button>' +
              '<button class="btn-unlink" data-action="delete-inv" data-id="' + a.id + '" data-name="' + esc(a.name) + '">Remove</button>' +
            '</div></div>'
        ).join('');
      } catch (e) { list.textContent = 'Could not load investment accounts.'; }
    }

    async function addInvestment() {
      const name = document.getElementById('inv-name').value.trim();
      const balance = parseFloat(document.getElementById('inv-balance').value);
      if (!name) { showStatus('Account name is required.', false); return; }
      try {
        const res = await apiFetch('/api/investment-accounts', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            institution: document.getElementById('inv-institution').value.trim() || null,
            account_type: document.getElementById('inv-type').value,
            balance: balance || 0,
          }),
        });
        if (res.ok) {
          showStatus('Investment account added.', true);
          document.getElementById('inv-name').value = '';
          document.getElementById('inv-institution').value = '';
          document.getElementById('inv-balance').value = '';
          loadInvestments();
        } else { const d = await res.json(); showStatus(d.error || 'Failed', false); }
      } catch (e) { showStatus(e.message, false); }
    }

    async function updateInvestment(id) {
      const val = prompt('Enter current balance ($):');
      if (val === null) return;
      try {
        const res = await apiFetch('/api/investment-accounts/' + id, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ balance: parseFloat(val) }),
        });
        if (res.ok) { showStatus('Balance updated.', true); loadInvestments(); }
        else showStatus('Failed to update.', false);
      } catch (e) { showStatus(e.message, false); }
    }

    async function deleteInvestment(id, name) {
      console.log('[delete-inv] click', { id: id, name: name });
      var confirmed = confirm('Remove ' + name + '?');
      console.log('[delete-inv] confirm result', confirmed);
      if (!confirmed) return;
      try {
        console.log('[delete-inv] DELETE /api/investment-accounts/' + id);
        var res = await apiFetch('/api/investment-accounts/' + id, { method: 'DELETE' });
        console.log('[delete-inv] response status', res.status);
        if (res.ok) {
          showStatus('Removed ' + name + '.', true);
          loadInvestments();
        } else {
          var data = await res.json().catch(function() { return {}; });
          console.error('[delete-inv] failed', res.status, data);
          showStatus('Failed to remove: ' + (data.error || 'HTTP ' + res.status), false);
        }
      } catch (e) {
        console.error('[delete-inv] exception', e);
        showStatus(e.message, false);
      }
    }

    // Plaid investment linking
    async function checkPlaid() {
      try {
        var res = await apiFetch('/api/plaid/status'); var d = await res.json();
        if (d.configured) document.getElementById('plaid-inv-btn').style.display = 'inline-block';
      } catch {}
    }
    async function linkPlaidInvestments() {
      try {
        var res = await apiFetch('/api/plaid/link-token', { method: 'POST' });
        var d = await res.json();
        if (!res.ok) { showStatus(d.error || 'Failed', false); return; }
        if (!window.Plaid) {
          await new Promise(function(resolve, reject) {
            var s = document.createElement('script');
            s.src = 'https://cdn.plaid.com/link/v2/stable/link-initialize.js';
            s.onload = resolve; s.onerror = reject;
            document.head.appendChild(s);
          });
        }
        var handler = window.Plaid.create({
          token: d.link_token,
          onSuccess: async function(public_token, metadata) {
            try {
              var exRes = await apiFetch('/api/plaid/exchange', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ public_token: public_token, institution: metadata.institution })
              });
              var exData = await exRes.json();
              if (exRes.ok) {
                showStatus('Linked ' + exData.accounts_stored + ' investment accounts with ' + exData.holdings_stored + ' holdings.', true);
                loadInvestments();
              } else showStatus(exData.error || 'Failed', false);
            } catch (e) { showStatus(e.message, false); }
          },
          onExit: function() {}
        });
        handler.open();
      } catch (e) { showStatus(e.message, false); }
    }

    // --- Plaid transactions link (for Capital One, Discover, etc.) ---
    //
    // Two-phase OAuth flow:
    //   Phase 1 — initial open:
    //     • Persist link_token + redirect URL in sessionStorage
    //     • Open Plaid Link normally
    //     • Banks that DON'T require OAuth (most credit unions) complete in
    //       the popup and call onSuccess directly.
    //     • Banks that DO require OAuth (Capital One, Chase, many others)
    //       redirect the browser to the bank's login page, then back to
    //       /perfin/accounts?oauth_state_id=<state>.
    //   Phase 2 — OAuth return (handlePlaidOAuthReturn below):
    //     • Detects the oauth_state_id query param on page load
    //     • Recovers the persisted link_token from sessionStorage
    //     • Reinitializes Plaid Link with `receivedRedirectUri` so Plaid
    //       knows to resume the OAuth flow instead of starting fresh.
    var PLAID_LINK_TOKEN_KEY = 'perfin_plaid_link_token';

    function buildPlaidHandler(linkToken, receivedRedirectUri) {
      return Plaid.create({
        token: linkToken,
        receivedRedirectUri: receivedRedirectUri || null,
        onLoad: function() { console.log('Plaid Link loaded'); },
        onSuccess: async function(public_token, metadata) {
          try {
            showStatus('Linking accounts...', true);
            var exRes = await apiFetch('/api/plaid/exchange-transactions', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ public_token: public_token, institution: metadata.institution }),
            });
            var exData = await exRes.json();
            sessionStorage.removeItem(PLAID_LINK_TOKEN_KEY);
            if (exRes.ok) {
              showStatus('Linked ' + exData.accounts_linked + ' accounts, synced ' + exData.transactions_added + ' transactions from ' + exData.institution + '.', true);
              loadItems();
            } else {
              showStatus(exData.error || 'Exchange failed', false);
            }
          } catch (e) { showStatus(e.message, false); }
        },
        onExit: function(err, metadata) {
          console.log('Plaid onExit:', { err: err, metadata: metadata });
          sessionStorage.removeItem(PLAID_LINK_TOKEN_KEY);
          if (err) {
            var msg = 'Plaid: ' + (err.display_message || err.error_message || err.error_code || JSON.stringify(err));
            showStatus(msg, false);
          }
        },
        onEvent: function(eventName, metadata) {
          console.log('Plaid event:', eventName, metadata);
        },
      });
    }

    // Pre-fetched Plaid handler — built on page load so the click handler
    // can call .open() synchronously. iOS Safari loses the "user gesture"
    // context across async work, so without this, the modal silently fails
    // to open on iPhone (works on desktop where popup blocking is laxer).
    // Plaid docs explicitly recommend this approach.
    var _plaidHandler = null;
    var _plaidHandlerError = null;

    async function prebuildPlaidHandler() {
      if (!window._plaidLoaded || typeof Plaid === 'undefined') {
        // SDK not yet loaded — wait and retry once more, then give up.
        setTimeout(prebuildPlaidHandler, 1500);
        return;
      }
      try {
        var redirectUri = (window.location.origin + window.location.pathname).replace(/\/+$/, '');
        console.log('[Plaid] Pre-fetching link token, redirect_uri:', redirectUri);
        var tokenRes = await apiFetch('/api/plaid/link-token-transactions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ redirect_uri: redirectUri }),
        });
        if (!tokenRes.ok) {
          var err = await tokenRes.json().catch(function() { return {}; });
          // Show the exact redirect_uri we sent so the user can compare
          // it letter-by-letter against what's registered in Plaid Dashboard.
          // INVALID_REDIRECT_URI fails on the tiniest mismatch (case, trailing
          // slash, extra space, www vs no-www, http vs https, etc.).
          var msg = (err.error || ('Token request failed: HTTP ' + tokenRes.status))
            + ' | Sent redirect_uri: "' + redirectUri + '" — verify this exact string is in Plaid Dashboard → API → Allowed redirect URIs for the PRODUCTION environment.';
          _plaidHandlerError = msg;
          console.error('[Plaid] Pre-fetch token request failed:', err, 'redirect_uri sent:', redirectUri);
          return;
        }
        var tokenData = await tokenRes.json();
        if (!tokenData.link_token) {
          _plaidHandlerError = 'No link_token returned by server';
          return;
        }
        sessionStorage.setItem(PLAID_LINK_TOKEN_KEY, tokenData.link_token);
        _plaidHandler = buildPlaidHandler(tokenData.link_token);
        console.log('[Plaid] Handler pre-built and ready');
      } catch (e) {
        _plaidHandlerError = 'Failed to pre-build Plaid handler: ' + e.message;
        console.error('[Plaid] Pre-build exception:', e);
      }
    }

    function linkPlaidTransactions() {
      // CRITICAL: do as little as possible before .open() to preserve the
      // iOS Safari user-gesture window. Any toast/log/DOM work happens
      // AFTER, deferred via setTimeout so it doesn't consume gesture credit.
      if (_plaidHandler) {
        _plaidHandler.open();
        setTimeout(function() {
          console.log('[Plaid] Link button clicked; handler.open() returned');
          showStatus('Opening Plaid...', true);
        }, 0);
        return;
      }
      if (_plaidHandlerError) {
        showStatus(_plaidHandlerError, false);
        return;
      }
      // SDK or token still loading. Tell the user and retry the pre-build.
      showStatus('Plaid is still initializing — try again in a moment.', false);
      prebuildPlaidHandler();
    }

    // Kick off the pre-fetch once the page settles. The Plaid SDK loads
    // dynamically (see head injection above) so we give it a moment to
    // arrive before requesting the link token.
    setTimeout(prebuildPlaidHandler, 800);

    // Mobile-friendly hosted flow: full-page redirect to a Plaid-hosted
    // page instead of an iframe modal. Works around iOS Safari's iframe
    // incompatibility where the modal opens but stays display:none.
    async function linkPlaidHosted() {
      showStatus('Generating Plaid link...', true);
      try {
        var redirectUri = (window.location.origin + window.location.pathname).replace(/\/+$/, '');
        var res = await apiFetch('/api/plaid/hosted-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ redirect_uri: redirectUri }),
        });
        var data = await res.json();
        if (!res.ok) {
          showStatus(data.error || 'Failed to generate hosted link', false);
          return;
        }
        if (!data.hosted_link_url) {
          showStatus('Server did not return hosted_link_url: ' + JSON.stringify(data), false);
          return;
        }
        // Stash the link token so the return handler can complete the
        // OAuth handshake if needed.
        sessionStorage.setItem(PLAID_LINK_TOKEN_KEY, data.link_token);
        sessionStorage.setItem('perfin_plaid_hosted', '1');
        window.location.href = data.hosted_link_url;
      } catch (e) {
        showStatus('Failed to start hosted Plaid link: ' + e.message, false);
      }
    }

    // Hosted-link return handler — after the user completes the flow on
    // Plaid's hosted page, they redirect back here. The public_token
    // isn't in the URL (hosted link doesn't pass it through); instead we
    // call /api/plaid/hosted-link-complete which uses linkTokenGet on
    // the server to fetch the link session's public_token and complete
    // the exchange.
    async function handlePlaidHostedReturn() {
      if (sessionStorage.getItem('perfin_plaid_hosted') !== '1') return;
      var linkToken = sessionStorage.getItem(PLAID_LINK_TOKEN_KEY);
      if (!linkToken) return;
      sessionStorage.removeItem('perfin_plaid_hosted');
      sessionStorage.removeItem(PLAID_LINK_TOKEN_KEY);
      // Clean URL params so reload doesn't re-fire.
      var clean = window.location.origin + window.location.pathname;
      window.history.replaceState({}, '', clean);
      showStatus('Completing Plaid link...', true);
      try {
        var res = await apiFetch('/api/plaid/hosted-link-complete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ link_token: linkToken }),
        });
        var data = await res.json();
        if (res.ok) {
          showStatus('Linked ' + data.accounts_linked + ' accounts from ' + data.institution +
            ', synced ' + data.transactions_added + ' transactions.', true);
          loadItems();
        } else {
          showStatus(data.error || 'Failed to finalize Plaid link', false);
        }
      } catch (e) {
        showStatus('Failed to finalize: ' + e.message, false);
      }
    }
    setTimeout(handlePlaidHostedReturn, 100);

    // Auto-detect OAuth return on page load.
    function handlePlaidOAuthReturn() {
      var params = new URLSearchParams(window.location.search);
      if (!params.has('oauth_state_id')) return;
      var linkToken = sessionStorage.getItem(PLAID_LINK_TOKEN_KEY);
      if (!linkToken) {
        showStatus('Plaid OAuth return detected, but no link token in session storage. Try linking again.', false);
        return;
      }
      if (!window._plaidLoaded || typeof Plaid === 'undefined') {
        // SDK not ready yet — wait and retry once.
        setTimeout(handlePlaidOAuthReturn, 500);
        return;
      }
      showStatus('Completing Plaid OAuth handshake...', true);
      var handler = buildPlaidHandler(linkToken, window.location.href);
      handler.open();
      // Clean the query param from the URL so a reload doesn't re-trigger.
      var clean = window.location.origin + window.location.pathname;
      window.history.replaceState({}, '', clean);
    }
    // Defer until after the page settles so showStatus + SDK are ready.
    setTimeout(handlePlaidOAuthReturn, 100);

    // --- Bind event handlers (CSP-safe) ---
    bindEvents([
      ['link-btn', 'click', startLink],
      ['plaid-hosted-btn', 'click', linkPlaidHosted],
      ['csv-upload-btn', 'click', uploadCsv],
      ['plaid-inv-btn', 'click', linkPlaidInvestments],
      ['add-inv-btn', 'click', addInvestment],
      ['add-manual-acct-btn', 'click', addManualAccount],
    ]);
    // Event delegation for dynamically generated unlink/investment buttons
    onDelegate('items-list', 'click', '[data-action="unlink"]', function() {
      unlinkAccount(parseInt(this.dataset.id), this.dataset.name, this.dataset.provider);
    });
    onDelegate('inv-list', 'click', '[data-action]', function() {
      var action = this.dataset.action;
      var id = parseInt(this.dataset.id);
      if (action === 'update-inv') updateInvestment(id);
      else if (action === 'delete-inv') deleteInvestment(id, this.dataset.name);
    });
    onDelegate('manual-accounts-list', 'click', '[data-action]', function() {
      var action = this.dataset.action;
      var id = parseInt(this.dataset.id);
      if (action === 'update-manual') updateManualBalance(id);
      else if (action === 'delete-manual') deleteManualAccount(id, this.dataset.name);
    });

    checkPlaid();
    loadItems();
    loadCsvImports();
    loadManualAccounts();
    loadInvestments();
  </script>
</body>
</html>
