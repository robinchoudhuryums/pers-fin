{
  "description": "Shared design values for Perfin and Per-sistant (design pass D6, decision 9). This file is a spec, not a runtime stylesheet: each app declares these values in its own CSS under the variable names listed in `apps`, and tests/design-tokens.test.js fails when a declaration drifts from the spec. Values listed under `app_specific` belong to one app and are never compared.",
  "version": 1,
  "shared": {
    "status": {
      "dark": { "ok": "#6fcf97", "warn": "#f0c36d", "danger": "#eb6b6b", "info": "#7fb5e6" },
      "light": { "ok": "#2d9f5f", "warn": "#c49a2a", "danger": "#c94444", "info": "#4a8abf" }
    },
    "type": { "xs": "12px", "sm": "13px", "base": "14px", "md": "16px", "lg": "20px", "xl": "28px" },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px" },
    "radius": { "card": "12px", "control": "8px", "pill": "999px" },
    "button_height": { "sm": "32px", "md": "40px", "touch": "44px" }
  },
  "apps": {
    "perfin": {
      "source": "teller/public/perfin-shared.css",
      "scopes": { "base": ":root", "dark": ":root", "light": "[data-theme=\"light\"]" },
      "names": {
        "status.ok": "--green", "status.warn": "--yellow", "status.danger": "--red", "status.info": "--blue",
        "type.xs": "--fs-xs", "type.sm": "--fs-sm", "type.base": "--fs-base", "type.md": "--fs-md", "type.lg": "--fs-lg", "type.xl": "--fs-xl",
        "space.1": "--space-1", "space.2": "--space-2", "space.3": "--space-3", "space.4": "--space-4", "space.5": "--space-5", "space.6": "--space-6",
        "radius.card": "--radius-card", "radius.control": "--radius-control", "radius.pill": "--radius-pill",
        "button_height.sm": "--btn-h-sm", "button_height.md": "--btn-h", "button_height.touch": "--btn-h-touch"
      }
    },
    "per-sistant": {
      "source": "apps/per-sistant/views/css.js",
      "scopes": { "base": ":root", "light": ":root", "dark": "body[data-mode=\"dark\"]" },
      "names": {
        "status.ok": "--status-ok", "status.warn": "--status-warn", "status.danger": "--status-danger", "status.info": "--status-info",
        "type.xs": "--fs-xs", "type.sm": "--fs-sm", "type.base": "--fs-base", "type.md": "--fs-md", "type.lg": "--fs-lg", "type.xl": "--fs-xl",
        "space.1": "--space-1", "space.2": "--space-2", "space.3": "--space-3", "space.4": "--space-4", "space.5": "--space-5", "space.6": "--space-6",
        "radius.card": "--radius-card", "radius.control": "--radius-control", "radius.pill": "--radius-pill",
        "button_height.sm": "--btn-h-sm", "button_height.md": "--btn-h", "button_height.touch": "--btn-h-touch"
      }
    }
  },
  "app_specific": {
    "perfin": ["--bg", "--surface", "--surface-2", "--surface-solid", "--border", "--text", "--text-muted", "--warm", "--teal", "--on-warm", "--on-teal"],
    "per-sistant": ["--paper", "--paper-2", "--paper-card", "--ink", "--muted", "--line", "--accent", "--accent-soft", "--display", "--ui", "--mono"]
  }
}
