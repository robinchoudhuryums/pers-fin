# ============================================================================
# Personal Subscription Tracker — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Teller ---
# TELLER_ENV options:
#   sandbox     — free, simulated accounts (no real banks)
#   development — connects to real banks, free up to 100 enrollments
#   production  — full production (requires Teller sales contact)
TELLER_ENV=development
TELLER_APPLICATION_ID=your_teller_application_id
# Paths to your Teller mTLS certificate and private key
# Generate these in the Teller Dashboard under Settings > Certificates
TELLER_CERT_PATH=./certificate.pem
TELLER_KEY_PATH=./private_key.pem

# --- Plaid (legacy — keep if you have/get Plaid production access) ---
# PLAID_ENV=production
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET_SANDBOX=your_plaid_sandbox_secret
# PLAID_SECRET_DEV=your_plaid_development_secret
# PLAID_SECRET_PROD=your_plaid_production_secret

# --- Neon Postgres ---
# Use the pgBouncer pooled connection string from your Neon dashboard.
# It should look like: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?pgbouncer=true&sslmode=require
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?pgbouncer=true&sslmode=require

# --- Access Token Encryption ---
# Used to encrypt/decrypt Teller/Plaid access tokens stored in Postgres.
# Generate a strong passphrase: openssl rand -base64 32
TOKEN_ENCRYPTION_PASSPHRASE=generate-a-strong-passphrase-here

# --- Email Alerts ---
ALERT_EMAIL=you@example.com

# --- Google Sheets Integration ---
# 1. Create a Google Cloud project, enable the Google Sheets API
# 2. Create a Service Account and download the JSON key file
# 3. Share your spreadsheet with the service account email (Editor)
# 4. The spreadsheet ID is the long string in the URL:
#    https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account-key.json

# --- Server ---
PORT=3000
