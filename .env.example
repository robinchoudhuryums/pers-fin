# ============================================================================
# Personal Finance Tracker (Perfin) — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Teller ---
# TELLER_ENV options:
#   sandbox     — free, simulated accounts (no real banks)
#   development — connects to real banks, free up to 100 enrollments
#   production  — full production (requires Teller sales contact)
TELLER_ENV=development
TELLER_APPLICATION_ID=your_teller_application_id

# Teller mTLS certificate. Use ONE of:
#   (a) File paths (local dev / Fly.io files):
TELLER_CERT_PATH=./certificate.pem
TELLER_KEY_PATH=./private_key.pem
#   (b) Base64-encoded PEM contents (Render env vars; matches render.yaml):
# TELLER_CERT=base64-of-certificate.pem
# TELLER_KEY=base64-of-private_key.pem
#   (c) Raw PEM contents written to disk by docker-entrypoint.sh (Docker):
# TELLER_CERT_CONTENT=-----BEGIN CERTIFICATE-----...
# TELLER_KEY_CONTENT=-----BEGIN PRIVATE KEY-----...

# --- Plaid (used by routes/investments.js for brokerage/retirement holdings) ---
# Optional. Set these to enable Plaid investment account linking + holdings sync.
# PLAID_ENV=production
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET_SANDBOX=your_plaid_sandbox_secret
# PLAID_SECRET_DEV=your_plaid_development_secret
# PLAID_SECRET_PROD=your_plaid_production_secret

# --- Neon Postgres ---
# Use the pgBouncer pooled connection string from your Neon dashboard.
# It should look like: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?pgbouncer=true&sslmode=require
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?pgbouncer=true&sslmode=require

# --- At-rest encryption passphrase ---
# Used to encrypt/decrypt Teller/Plaid access tokens AND the Per-sistant
# webhook HMAC secret stored in Postgres (pgcrypto pgp_sym_encrypt).
# Generate a strong passphrase: openssl rand -base64 32
TOKEN_ENCRYPTION_PASSPHRASE=generate-a-strong-passphrase-here

# --- Google Sheets Integration (optional) ---
# 1. Create a Google Cloud project, enable the Google Sheets API
# 2. Create a Service Account and download the JSON key file
# 3. Share your spreadsheet with the service account email (Editor)
# 4. The spreadsheet ID is the long string in the URL:
#    https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account-key.json

# --- Server ---
PORT=3000

# --- Authentication ---
# Set ONE of these to enable login screen. Omit both to run without auth (dev mode).
# SESSION_PASSWORD — full password, shows text input on login
# SESSION_PIN — numeric PIN (4-6 digits), shows PIN pad on login
SESSION_PASSWORD=your_secure_password_here
# SESSION_PIN=1234
# SESSION_SECRET=auto_generated_if_not_set

# Optional: protect /api/* endpoints with a header-only API key
# (sessions still authenticate browser users; this is for external tools)
# API_KEY=generate-with-openssl-rand-base64-32
# Comma-separated CORS allow-list for cross-origin API access (no origin = same-origin only)
# ALLOWED_ORIGINS=https://example.com,https://other.example.com

# --- AI Insights (optional) ---
# Set to enable monthly financial analysis via Claude API (~$0.02/month)
# ANTHROPIC_API_KEY=sk-ant-...
# Monthly spending cap in cents (default: 50 = $0.50/month). At ~$0.02/run this allows ~25 runs.
# INSIGHTS_MONTHLY_BUDGET_CENTS=50

# --- Web Push notifications (optional) ---
# Required for anomaly / budget / goal-milestone push notifications.
# Generate a VAPID keypair:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=BHe...
# VAPID_PRIVATE_KEY=...
# VAPID_EMAIL=mailto:you@example.com

# --- Per-sistant integration (optional companion app) ---
# URL of the Per-sistant instance for cross-app webhooks and SSO.
# PERSISTENT_URL=https://your-persistent.example.com
# HMAC secret used to sign outbound webhook payloads to Per-sistant.
# Generate with: openssl rand -base64 32
# PERSISTENT_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32

# --- Cross-app SSO ---
# REQUIRED if Per-sistant integration is in use. Both Perfin and Per-sistant
# must set the SAME value. Tokens minted on either side validate on the other.
# Generate with: openssl rand -base64 32
# SSO_SECRET=generate-with-openssl-rand-base64-32
