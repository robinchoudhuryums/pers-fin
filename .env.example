# ============================================================================
# Unified Perfin + Per-sistant Shell — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Layout (post-merge): one Node process serves both apps.
#   shell/index.js          PIN gate + landing tile picker
#   teller/server.js        Perfin (mounted at /perfin)
#   apps/per-sistant/...    Per-sistant (mounted at /per-sistant)
#
# A single .env at the repo root is read by all three. Each section
# below is grouped by which sub-app consumes it.

# ============================================================================
# --- Shell (unified PIN auth + landing) -------------------------------------
# ============================================================================
# Required for the landing-page PIN gate. Both sub-apps trust this gate
# when mounted; their per-app session checks bail out via the embedded flag.
SHELL_PIN=1234
# Random ~32+ char string. Signs the shell session cookie.
# Rotate to invalidate every active session.
# Generate with: openssl rand -hex 32
SHELL_SECRET=generate-with-openssl-rand-hex-32
# Optional override of the listener port (defaults to PORT or 3000)
# SHELL_PORT=3000

# ============================================================================
# --- Teller (Perfin sub-app) ------------------------------------------------
# ============================================================================
# TELLER_ENV options:
#   sandbox     — free, simulated accounts (no real banks)
#   development — connects to real banks, free up to 100 enrollments
#   production  — full production (requires Teller sales contact)
TELLER_ENV=development
TELLER_APPLICATION_ID=your_teller_application_id

# Teller mTLS certificate. Use ONE of:
#   (a) File paths (local dev / Fly.io files):
TELLER_CERT_PATH=./certificate.pem
TELLER_KEY_PATH=./private_key.pem
#   (b) Base64-encoded PEM contents (Render env vars; matches render.yaml):
# TELLER_CERT=base64-of-certificate.pem
# TELLER_KEY=base64-of-private_key.pem
#   (c) Raw PEM contents written to disk by docker-entrypoint.sh (Docker):
# TELLER_CERT_CONTENT=-----BEGIN CERTIFICATE-----...
# TELLER_KEY_CONTENT=-----BEGIN PRIVATE KEY-----...

# --- Plaid (used by routes/investments.js for brokerage/retirement holdings) ---
# Optional. Set these to enable Plaid investment account linking + holdings sync.
# PLAID_ENV=production
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET_SANDBOX=your_plaid_sandbox_secret
# PLAID_SECRET_DEV=your_plaid_development_secret
# PLAID_SECRET_PROD=your_plaid_production_secret

# Per-app session/PIN — only needed for STANDALONE Perfin runs.
# Under the unified shell, the shell's PIN gate authenticates and these
# are ignored (each sub-app's requireAuth bails on the embedded flag).
# SESSION_PASSWORD=your_secure_password_here
# SESSION_PIN=1234
# SESSION_SECRET=auto_generated_if_not_set

# Optional: protect /api/* endpoints with a header-only API key
# (sessions still authenticate browser users; this is for external tools).
# Bypassed when running embedded under the shell.
# API_KEY=generate-with-openssl-rand-base64-32
# Comma-separated CORS allow-list for cross-origin API access (no origin = same-origin only)
# ALLOWED_ORIGINS=https://example.com,https://other.example.com

# ============================================================================
# --- Per-sistant (sub-app at /per-sistant) ----------------------------------
# ============================================================================
# Per-sistant's separate Neon database. When the unified shell runs, both
# Perfin (NEON_DATABASE_URL) and Per-sistant (PERSISTENT_DATABASE_URL)
# point at distinct Neon instances. Per-sistant falls back to
# NEON_DATABASE_URL only when running standalone (legacy path).
PERSISTENT_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/persistent?pgbouncer=true&sslmode=require

# SMTP for email scheduling (Per-sistant feature).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@example.com

# ============================================================================
# --- Databases --------------------------------------------------------------
# ============================================================================
# Perfin's Neon database. Use the pgBouncer pooled connection string.
# It should look like: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?pgbouncer=true&sslmode=require
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/perfin?pgbouncer=true&sslmode=require

# At-rest encryption passphrase. Used to encrypt/decrypt Teller/Plaid
# access tokens AND the Per-sistant webhook HMAC secret stored in
# Postgres (pgcrypto pgp_sym_encrypt).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_PASSPHRASE=generate-a-strong-passphrase-here

# ============================================================================
# --- Google Sheets Integration (Perfin, optional) ---------------------------
# ============================================================================
# 1. Create a Google Cloud project, enable the Google Sheets API
# 2. Create a Service Account and download the JSON key file
# 3. Share your spreadsheet with the service account email (Editor)
# 4. The spreadsheet ID is the long string in the URL:
#    https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account-key.json

# ============================================================================
# --- AI Insights (Perfin, optional) -----------------------------------------
# ============================================================================
# Set to enable monthly financial analysis via Claude API (~$0.02/month)
# ANTHROPIC_API_KEY=sk-ant-...
# Monthly spending cap in cents (default: 50 = $0.50/month). At ~$0.02/run this allows ~25 runs.
# INSIGHTS_MONTHLY_BUDGET_CENTS=50

# ============================================================================
# --- Web Push notifications (Perfin, optional) ------------------------------
# ============================================================================
# Required for anomaly / budget / goal-milestone push notifications.
# Generate a VAPID keypair:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=BHe...
# VAPID_PRIVATE_KEY=...
# VAPID_EMAIL=mailto:you@example.com

# ============================================================================
# --- Cross-app integration (legacy / standalone) ----------------------------
# ============================================================================
# These were used when Perfin and Per-sistant ran as two separate Render
# services and talked over HTTPS+HMAC. Under the unified shell they're
# in-process and these vars are unused — keep them set if you want to
# preserve a fallback to standalone mode.
# PERSISTENT_URL=https://your-persistent.example.com
# PERSISTENT_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32
# SSO_SECRET=generate-with-openssl-rand-base64-32
